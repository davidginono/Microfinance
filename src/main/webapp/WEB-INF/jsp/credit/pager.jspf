<div data-table-pagination data-table-for="${tableKey}" data-page="${records.page}"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?records.page>0:records.hasNext}"><c:url value="${pagePath}" var="pageUrl"><c:param name="page" value="${records.page+step}"/><c:if test="${not empty sort}"><c:param name="sort" value="${sort}"/></c:if><c:if test="${not empty search}"><c:param name="search" value="${search}"/></c:if><c:if test="${not empty feature}"><c:param name="feature" value="${feature}"/></c:if><c:if test="${not empty assetId}"><c:param name="assetId" value="${assetId}"/></c:if></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div>
