<%@ include file="head.jspf" %>
<c:set var="tableKey" value="credit-${register}"/><c:set var="pagePath" value="/finance/credit/${register}"/><c:url value="${pagePath}" var="registerUrl"/>
<section class="erp-table-wrap" data-resource-table="${tableKey}" data-group-register data-table-selection="single">
<h2><spring:message code="credit.title.${register}"/></h2>
<div class="accounting-actions" data-table-toolbar-for="${tableKey}"><button type="button" class="app-btn btn-neutral" data-table-command data-group-command="view" disabled><spring:message code="group.open"/></button><span class="sr-only" data-group-selection-status aria-live="polite"></span>
<c:if test="${register=='collateral'}"><sec:authorize access="@access.has(principal,'COLLATERAL_CREATE')"><a class="app-btn btn-launch" href="${registerUrl}/new"><spring:message code="credit.createAsset"/></a></sec:authorize></c:if>
<c:if test="${register=='collections'}"><sec:authorize access="@access.has(principal,'COLLECTIONS_CREATE')"><a class="app-btn btn-launch" href="<c:url value='/finance/credit/loans?feature=COLLECTIONS'/>"><spring:message code="credit.createCase"/></a></sec:authorize></c:if></div>
<form method="get" action="${registerUrl}" data-table-filter-for="${tableKey}"><label class="sr-only" for="creditSearch"><spring:message code="common.search"/></label><input class="aws-control" id="creditSearch" name="search" value="<c:out value='${search}'/>" maxlength="100"/><input type="hidden" name="sort" value="<c:out value='${sort}'/>"/><button class="app-btn btn-neutral" type="submit"><spring:message code="common.search"/></button></form>
<c:choose><c:when test="${register=='guarantors'}"><c:set var="columns" value="${['loan','borrower','guarantor','liability','status']}"/></c:when><c:when test="${register=='collateral'}"><c:set var="columns" value="${['code','description','owner','value','pledged','expires']}"/></c:when><c:otherwise><c:set var="columns" value="${['loan','borrower','officer','arrears','oldest','next','state']}"/></c:otherwise></c:choose>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><span class="sr-only"><spring:message code="voucher.select"/></span></th><c:forEach items="${columns}" var="column"><th scope="col" data-table-sort-asc="${column}_asc" data-table-sort-desc="${column}_desc"><spring:message code="credit.field.${column}"/><c:if test="${column=='liability'||column=='value'||column=='pledged'||column=='arrears'}"> (TZS)</c:if></th></c:forEach></tr></thead><tbody>
<c:forEach items="${records.rows}" var="row"><tr data-group-row="${row.id}" data-target="${registerUrl}/${row.id}"><td><input type="checkbox" aria-label="<spring:message code='voucher.select'/> <c:out value='${register=="collateral"?row.code:row.loanNumber}'/>"/></td>
<c:choose><c:when test="${register=='guarantors'}"><td data-group-identity><c:out value="${row.loanNumber}"/></td><td><c:out value="${row.borrower}"/></td><td><a class="resource-table-id-link" href="${registerUrl}/${row.id}"><c:out value="${row.guarantor}"/></a></td><td><c:choose><c:when test="${row.liability==null}"><spring:message code="credit.unavailable"/></c:when><c:otherwise><fmt:formatNumber value="${row.liability}" minFractionDigits="2" maxFractionDigits="2"/></c:otherwise></c:choose></td><td><spring:message code="credit.guarantee.${row.status}"/></td></c:when>
<c:when test="${register=='collateral'}"><td data-group-identity><a class="resource-table-id-link" href="${registerUrl}/${row.id}"><c:out value="${row.code}"/></a></td><td><c:out value="${row.description}"/></td><td><c:out value="${row.owner}"/></td><td><c:choose><c:when test="${row.value==null}"><spring:message code="credit.unavailable"/></c:when><c:otherwise><fmt:formatNumber value="${row.value}" minFractionDigits="2" maxFractionDigits="2"/></c:otherwise></c:choose></td><td><fmt:formatNumber value="${row.pledged}" minFractionDigits="2" maxFractionDigits="2"/></td><td><c:out value="${appTime:display(row.validThrough)}"/></td></c:when>
<c:otherwise><td data-group-identity><a class="resource-table-id-link" href="${registerUrl}/${row.id}"><c:out value="${row.loanNumber}"/></a></td><td><c:out value="${row.borrower}"/></td><td><c:out value="${row.officer}"/></td><td><c:choose><c:when test="${row.arrears==null}"><spring:message code="credit.unavailable"/></c:when><c:otherwise><fmt:formatNumber value="${row.arrears}" minFractionDigits="2" maxFractionDigits="2"/></c:otherwise></c:choose></td><td><c:out value="${appTime:display(row.oldestDue)}"/></td><td><c:out value="${appTime:display(row.nextAction)}"/></td><td><spring:message code="credit.state.${row.state}"/></td></c:otherwise></c:choose></tr></c:forEach>
<c:if test="${empty records.rows}"><tr><td colspan="${columns.size()+1}"><spring:message code="${empty search?'credit.empty':'credit.noMatches'}"/></td></tr></c:if></tbody></table></div><%@ include file="pager.jspf" %></section>
<script src="<c:url value='/js/group-lending.js'/>" defer></script><%@ include file="../fragments/footer.jspf" %>
