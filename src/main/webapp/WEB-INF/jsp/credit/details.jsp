<%@ include file="head.jspf" %>
<h1><spring:message code="credit.detail.${detail}"/></h1>
<c:if test="${not empty loan}"><%@ include file="loan-facts.jspf" %></c:if>
<c:choose><c:when test="${detail=='guarantor'}"><section class="erp-resource-section"><h2><spring:message code="credit.field.guarantor"/></h2><dl class="erp-detail-facts"><c:forEach items="${['guarantor','borrower','loanNumber']}" var="field"><div><dt><spring:message code="credit.field.${field}"/></dt><dd><c:out value="${guarantee[field]}"/></dd></div></c:forEach><div><dt><spring:message code="credit.field.liability"/> (TZS)</dt><dd><c:choose><c:when test="${guarantee.liability==null}"><spring:message code="credit.unavailable"/></c:when><c:otherwise><fmt:formatNumber value="${guarantee.liability}" minFractionDigits="2" maxFractionDigits="2"/></c:otherwise></c:choose></dd></div></dl><c:if test="${not empty guarantee.capacityError}"><p role="status"><spring:message code="${guarantee.capacityError}"/></p></c:if><sec:authorize access="@access.has(principal,'GUARANTOR_CAPACITY_CREATE')"><div class="accounting-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/credit/guarantors/${guarantee.id}/assess'/>"><spring:message code="credit.assess"/></a></div></sec:authorize></section><c:set var="historyPath" value="/finance/credit/guarantors/${guarantee.id}"/></c:when>
<c:when test="${detail=='collateral'}"><section class="erp-resource-section"><h2><spring:message code="credit.asset"/></h2><dl class="erp-detail-facts"><c:forEach items="${['code','description','owner','ownerEvidence']}" var="field"><div><dt><spring:message code="credit.field.${field}"/></dt><dd><c:out value="${asset[field]}"/></dd></div></c:forEach><c:forEach items="${['value','encumbrance','pledged']}" var="field"><div><dt><spring:message code="credit.field.${field}"/> (TZS)</dt><dd><c:choose><c:when test="${asset[field]==null}"><spring:message code="credit.unavailable"/></c:when><c:otherwise><fmt:formatNumber value="${asset[field]}" minFractionDigits="2" maxFractionDigits="2"/></c:otherwise></c:choose></dd></div></c:forEach><div><dt><spring:message code="credit.field.validThrough"/></dt><dd><c:out value="${appTime:display(asset.validThrough)}"/></dd></div></dl>
<c:if test="${asset.value!=null and asset.pledged>asset.value-asset.encumbrance}"><p role="status"><spring:message code="credit.collateralShortfall"/></p></c:if><div class="accounting-actions"><sec:authorize access="@access.has(principal,'COLLATERAL_UPDATE')"><a class="app-btn btn-neutral" href="<c:url value='/finance/credit/collateral/${asset.id}/events/new'/>"><spring:message code="credit.update"/></a></sec:authorize><sec:authorize access="@access.has(principal,'COLLATERAL_RELEASE')"><a class="app-btn btn-neutral" href="<c:url value='/finance/credit/collateral/${asset.id}/events/new?kind=RELEASE'/>"><spring:message code="credit.kind.RELEASE"/></a></sec:authorize><sec:authorize access="@access.has(principal,'COLLATERAL_RECOVERY')"><a class="app-btn btn-neutral" href="<c:url value='/finance/credit/collateral/${asset.id}/events/new?kind=RECOVERY'/>"><spring:message code="credit.kind.RECOVERY"/></a></sec:authorize></div></section>
<section class="erp-table-wrap" data-resource-table="credit-pledges"><h2><spring:message code="credit.pledges"/></h2><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-order="loan"><spring:message code="credit.field.loan"/></th><th data-table-order="amount"><spring:message code="credit.field.pledged"/> (TZS)</th></tr></thead><tbody><c:forEach items="${pledges.rows}" var="pledge"><tr><td><a class="resource-table-id-link" href="<c:url value='/finance/credit/loans/${pledge.loanId}?feature=COLLATERAL'/>"><c:out value="${pledge.number}"/></a></td><td><fmt:formatNumber value="${pledge.amount}" minFractionDigits="2" maxFractionDigits="2"/></td></tr></c:forEach><c:if test="${empty pledges.rows}"><tr><td colspan="2"><spring:message code="credit.empty"/></td></tr></c:if></tbody></table></div><div data-table-pagination data-table-for="credit-pledges" data-page="${pledges.page}"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?pledges.page>0:pledges.hasNext}"><c:url value="/finance/credit/collateral/${asset.id}" var="pledgeUrl"><c:param name="pledgePage" value="${pledges.page+step}"/><c:param name="page" value="${records.page}"/></c:url><a href="<c:out value='${pledgeUrl}'/>" data-page-direction="${step==-1?'previous':'next'}"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div></section><c:set var="historyPath" value="/finance/credit/collateral/${asset.id}"/></c:when>
<c:when test="${detail=='collection'}"><section class="erp-resource-section"><h2><spring:message code="credit.case"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="credit.field.officer"/></dt><dd><c:out value="${collectionCase.officer}"/></dd></div><div><dt><spring:message code="credit.field.reason"/></dt><dd><c:out value="${collectionCase.reason}"/></dd></div><div><dt><spring:message code="credit.field.state"/></dt><dd><spring:message code="credit.state.${collectionCase.state}"/></dd></div><div><dt><spring:message code="credit.field.nextAction"/></dt><dd><c:out value="${appTime:display(collectionCase.nextAction)}"/></dd></div></dl><sec:authorize access="@access.has(principal,'COLLECTIONS_UPDATE')"><div class="accounting-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/credit/collections/${collectionCase.id}/events/new'/>"><spring:message code="credit.followUp"/></a></div></sec:authorize></section><c:set var="historyPath" value="/finance/credit/collections/${collectionCase.id}"/></c:when></c:choose>
<c:if test="${detail!='loan'}"><section class="erp-resource-section"><h2><spring:message code="credit.history"/></h2><c:if test="${empty records.rows}"><p><spring:message code="credit.empty"/></p></c:if><c:forEach items="${records.rows}" var="record"><article><h3><c:choose><c:when test="${detail=='guarantor'}"><spring:message code="credit.form.assessment"/></c:when><c:otherwise><spring:message code="credit.kind.${record.kind}"/></c:otherwise></c:choose> · <c:out value="${appTime:display(record.recordedAt)}"/></h3><dl class="erp-detail-facts">
<c:choose><c:when test="${detail=='guarantor'}"><c:forEach items="${['income','expenses','otherDebt','capacity']}" var="field"><div><dt><spring:message code="credit.field.${field}"/> (TZS)</dt><dd><fmt:formatNumber value="${record[field]}" minFractionDigits="2" maxFractionDigits="2"/></dd></div></c:forEach><c:forEach items="${['assessedOn','validThrough']}" var="field"><div><dt><spring:message code="credit.field.${field}"/></dt><dd><c:out value="${appTime:display(record[field])}"/></dd></div></c:forEach><div><dt><spring:message code="credit.field.policyReference"/></dt><dd><c:out value="${record.policyReference}"/></dd></div></c:when>
<c:when test="${detail=='collateral'}"><c:if test="${not empty record.loanNumber}"><div><dt><spring:message code="credit.field.loan"/></dt><dd><c:out value="${record.loanNumber}"/></dd></div></c:if><c:forEach items="${['amount','encumbrance']}" var="field"><c:if test="${record[field]!=null}"><div><dt><spring:message code="credit.field.${field}"/> (TZS)</dt><dd><fmt:formatNumber value="${record[field]}" minFractionDigits="2" maxFractionDigits="2"/></dd></div></c:if></c:forEach><c:if test="${record.validThrough!=null}"><div><dt><spring:message code="credit.field.validThrough"/></dt><dd><c:out value="${appTime:display(record.validThrough)}"/></dd></div></c:if><div><dt><spring:message code="credit.field.reason"/></dt><dd><c:out value="${record.reason}"/></dd></div></c:when>
<c:otherwise><c:if test="${record.amount!=null}"><div><dt><spring:message code="credit.field.amount"/> (TZS)</dt><dd><fmt:formatNumber value="${record.amount}" minFractionDigits="2" maxFractionDigits="2"/></dd></div><div><dt><spring:message code="credit.field.promiseOn"/></dt><dd><c:out value="${appTime:display(record.promiseOn)}"/></dd></div></c:if><c:if test="${not empty record.officer}"><div><dt><spring:message code="credit.field.officer"/></dt><dd><c:out value="${record.officer}"/></dd></div></c:if><div><dt><spring:message code="credit.field.nextAction"/></dt><dd><c:out value="${appTime:display(record.nextAction)}"/></dd></div></c:otherwise></c:choose>
<c:if test="${detail!='guarantor'}"><div><dt><spring:message code="credit.field.effectiveDate"/></dt><dd><c:out value="${appTime:display(record.effectiveDate)}"/></dd></div></c:if><div><dt><spring:message code="credit.field.evidence"/></dt><dd><c:out value="${record.evidence}"/></dd></div><div><dt><spring:message code="credit.field.actor"/></dt><dd><c:out value="${record.actor}"/></dd></div></dl></article></c:forEach>
<nav aria-label="<spring:message code='credit.history'/>"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?records.page>0:records.hasNext}"><c:url value="${historyPath}" var="historyUrl"><c:param name="page" value="${records.page+step}"/><c:if test="${not empty pledges}"><c:param name="pledgePage" value="${pledges.page}"/></c:if></c:url><a class="app-btn btn-neutral" href="<c:out value='${historyUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></nav></section></c:if><%@ include file="../fragments/footer.jspf" %>
