<%@ include file="head.jspf" %><sec:authorize access="@access.has(principal,'CREDIT_CONTROLS_CONFIGURE')" var="canConfigureCreditPolicy"/>
<c:choose><c:when test="${formKind=='policy'}"><c:set var="modelName" value="policyForm"/></c:when><c:when test="${formKind=='assessment'}"><c:set var="modelName" value="assessmentForm"/></c:when><c:when test="${formKind=='asset'}"><c:set var="modelName" value="assetForm"/></c:when><c:when test="${formKind=='collateralEvent'}"><c:set var="modelName" value="collateralForm"/></c:when><c:when test="${formKind=='case'}"><c:set var="modelName" value="caseForm"/></c:when><c:otherwise><c:set var="modelName" value="collectionForm"/></c:otherwise></c:choose>
<c:choose><c:when test="${formKind=='policy'}"><c:set var="returnPath" value="/finance/credit/policy"/></c:when><c:when test="${formKind=='assessment'}"><c:set var="returnPath" value="/finance/credit/guarantors/${guarantee.id}"/></c:when><c:when test="${formKind=='asset'}"><c:set var="returnPath" value="/finance/credit/collateral"/></c:when><c:when test="${formKind=='collateralEvent'}"><c:set var="returnPath" value="/finance/credit/collateral/${asset.id}"/></c:when><c:when test="${formKind=='case'}"><c:set var="returnPath" value="/finance/credit/collections"/></c:when><c:otherwise><c:set var="returnPath" value="/finance/credit/collections/${collectionCase.id}"/></c:otherwise></c:choose>
<div class="accounting-workspace accounting-create"><nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb'/>"><a class="erp-page-path__link" href="<c:url value='${returnPath}'/>"><spring:message code="credit.details"/></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="credit.form.${formKind}"/></span></nav><h1><spring:message code="credit.form.${formKind}"/></h1>
<c:if test="${not empty loan}"><%@ include file="loan-facts.jspf" %></c:if>
<c:if test="${not empty guarantee}"><section class="erp-resource-section"><h2><spring:message code="credit.title.guarantors"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="credit.field.guarantor"/></dt><dd><c:out value="${guarantee.guarantor}"/></dd></div><div><dt><spring:message code="credit.field.loan"/></dt><dd><c:out value="${guarantee.loanNumber}"/></dd></div><div><dt><spring:message code="credit.field.liability"/> (TZS)</dt><dd><c:choose><c:when test="${guarantee.liability==null}"><spring:message code="credit.unavailable"/></c:when><c:otherwise><fmt:formatNumber value="${guarantee.liability}" minFractionDigits="2" maxFractionDigits="2"/></c:otherwise></c:choose></dd></div></dl></section></c:if>
<form:form method="post" modelAttribute="${modelName}" cssClass="accounting-form" data-credit-form="${formKind}" data-accounting-dirty-form="true"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><form:hidden path="requestKey"/>
<c:if test="${formKind=='policy' and not canConfigureCreditPolicy}"><fieldset class="credit-readonly" disabled></c:if><section class="erp-resource-section"><h2><spring:message code="credit.form.${formKind}"/></h2><div class="accounting-grid">
<c:choose>
<c:when test="${formKind=='policy'}"><form:hidden path="expectedRevision"/><c:forEach items="${['reminderDaysBefore','reminderEveryDays']}" var="field"><label data-credit-reminder-setting><spring:message code="credit.field.${field}"/><form:input path="${field}" type="number" min="${field=='reminderEveryDays'?1:0}" max="30" step="1" cssClass="aws-control"/><form:errors path="${field}" cssClass="field-error"/></label></c:forEach><c:forEach items="${['capacityRequired','collateralRequired','remindersEnabled','verified']}" var="field"><label class="aws-settings-checkbox-row"><form:checkbox path="${field}" cssClass="aws-settings-checkbox"/><span><spring:message code="credit.field.${field}"/></span><form:errors path="${field}" cssClass="field-error"/></label></c:forEach><label><spring:message code="credit.field.reference"/><form:input path="reference" maxlength="500" cssClass="aws-control"/><form:errors path="reference" cssClass="field-error"/></label></c:when>
<c:when test="${formKind=='assessment'}"><c:forEach items="${['income','expenses','otherDebt','capacity']}" var="field"><label><spring:message code="credit.field.${field}"/> (TZS)<form:input path="${field}" type="number" step="0.01" min="0" cssClass="aws-control"/><form:errors path="${field}" cssClass="field-error"/></label></c:forEach><c:forEach items="${['assessedOn','validThrough']}" var="field"><label><spring:message code="credit.field.${field}"/><form:input path="${field}" type="date" cssClass="aws-control"/><form:errors path="${field}" cssClass="field-error"/></label></c:forEach><label><spring:message code="credit.field.policyReference"/><form:input path="policyReference" maxlength="500" cssClass="aws-control"/><form:errors path="policyReference" cssClass="field-error"/></label><label><spring:message code="credit.field.evidence"/><form:textarea path="evidence" maxlength="1000" cssClass="aws-control"/><form:errors path="evidence" cssClass="field-error"/></label><label class="aws-settings-checkbox-row"><form:checkbox path="verified" cssClass="aws-settings-checkbox"/><span><spring:message code="credit.field.verified"/></span><form:errors path="verified" cssClass="field-error"/></label></c:when>
<c:when test="${formKind=='asset'}"><c:forEach items="${['code','description','owner','ownerEvidence']}" var="field"><label><spring:message code="credit.field.${field}"/><form:input path="${field}" maxlength="${field=='code'?100:field=='owner'?255:1000}" cssClass="aws-control"/><form:errors path="${field}" cssClass="field-error"/></label></c:forEach><label class="aws-settings-checkbox-row"><form:checkbox path="verified" cssClass="aws-settings-checkbox"/><span><spring:message code="credit.field.ownershipChecked"/></span><form:errors path="verified" cssClass="field-error"/></label></c:when>
<c:when test="${formKind=='collateralEvent'}"><form:hidden path="expectedSequence"/><label><spring:message code="credit.field.kind"/><form:select path="kind" cssClass="aws-control" data-credit-kind="true"><sec:authorize access="@access.has(principal,'COLLATERAL_UPDATE')"><c:forEach items="${['VALUATION','PLEDGE','CUSTODY']}" var="kind"><form:option value="${kind}"><spring:message code="credit.kind.${kind}"/></form:option></c:forEach></sec:authorize><sec:authorize access="@access.has(principal,'COLLATERAL_RELEASE')"><form:option value="RELEASE"><spring:message code="credit.kind.RELEASE"/></form:option></sec:authorize><sec:authorize access="@access.has(principal,'COLLATERAL_RECOVERY')"><form:option value="RECOVERY"><spring:message code="credit.kind.RECOVERY"/></form:option></sec:authorize></form:select></label>
<div data-credit-kinds="PLEDGE RELEASE RECOVERY" data-loan-choice data-choice-url="<c:url value='/finance/credit/choices/loans/COLLATERAL'/>"><label><spring:message code="credit.field.loan"/><form:select path="loanId" cssClass="aws-control" data-choice-select="true" data-searchable="true"><form:option value=""><spring:message code="credit.chooseLoan"/></form:option><c:if test="${not empty loan}"><form:option value="${loan.id}"><c:out value="${loan.number}"/> · <c:out value="${loan.borrower}"/></form:option></c:if></form:select><form:errors path="loanId" cssClass="field-error"/></label><p role="alert" data-choice-error data-search-label="<spring:message code='credit.chooseLoan'/>" data-error="<spring:message code='credit.lookupError'/>"></p></div>
<label data-credit-kinds="VALUATION PLEDGE"><spring:message code="credit.field.amount"/> (TZS)<form:input path="amount" type="number" min="0" step="0.01" cssClass="aws-control"/><form:errors path="amount" cssClass="field-error"/></label><label data-credit-kinds="VALUATION"><spring:message code="credit.field.encumbrance"/> (TZS)<form:input path="encumbrance" type="number" min="0" step="0.01" cssClass="aws-control"/><form:errors path="encumbrance" cssClass="field-error"/></label><label data-credit-kinds="VALUATION"><spring:message code="credit.field.validThrough"/><form:input path="validThrough" type="date" cssClass="aws-control"/><form:errors path="validThrough" cssClass="field-error"/></label><label><spring:message code="credit.field.effectiveDate"/><form:input path="effectiveDate" type="date" cssClass="aws-control"/><form:errors path="effectiveDate" cssClass="field-error"/></label><c:forEach items="${['evidence','reason']}" var="field"><label><spring:message code="credit.field.${field}"/><form:textarea path="${field}" maxlength="1000" cssClass="aws-control"/><form:errors path="${field}" cssClass="field-error"/></label></c:forEach><label class="aws-settings-checkbox-row"><form:checkbox path="verified" cssClass="aws-settings-checkbox"/><span><spring:message code="credit.field.verified"/></span><form:errors path="verified" cssClass="field-error"/></label><p data-credit-kinds="RECOVERY" role="note"><spring:message code="credit.recoveryBoundary"/></p></c:when>
<c:otherwise><c:if test="${formKind=='case'}"><form:hidden path="loanId"/></c:if><c:if test="${formKind=='followUp'}"><form:hidden path="expectedSequence"/><label><spring:message code="credit.field.kind"/><form:select path="kind" cssClass="aws-control" data-credit-kind="true"><c:choose><c:when test="${collectionCase.state=='CLOSE'}"><form:option value="REOPEN"><spring:message code="credit.kind.REOPEN"/></form:option></c:when><c:otherwise><c:forEach items="${['CONTACT','PROMISE','DISPUTE','NOTICE','ASSIGN','CLOSE']}" var="kind"><form:option value="${kind}"><spring:message code="credit.kind.${kind}"/></form:option></c:forEach><c:if test="${collectionCase.state=='DISPUTE'}"><form:option value="RESOLVE"><spring:message code="credit.kind.RESOLVE"/></form:option></c:if></c:otherwise></c:choose></form:select></label><label><spring:message code="credit.field.effectiveDate"/><form:input path="effectiveDate" type="date" cssClass="aws-control"/><form:errors path="effectiveDate" cssClass="field-error"/></label></c:if>
<div data-credit-kinds="ASSIGN" data-loan-choice data-choice-url="<c:url value='/finance/credit/choices/officers'/>"><label><spring:message code="credit.field.assignedTo"/><form:select path="assignedTo" cssClass="aws-control" data-choice-select="true" data-searchable="true"><form:option value=""><spring:message code="credit.chooseOfficer"/></form:option><c:if test="${not empty selectedOfficer}"><form:option value="${selectedOfficer.id}"><c:out value="${selectedOfficer.label}"/></form:option></c:if><c:forEach items="${officers.rows}" var="officer"><c:if test="${selectedOfficer==null||selectedOfficer.id!=officer.id}"><form:option value="${officer.id}"><c:out value="${officer.label}"/></form:option></c:if></c:forEach></form:select><form:errors path="assignedTo" cssClass="field-error"/></label><p role="alert" data-choice-error data-search-label="<spring:message code='credit.chooseOfficer'/>" data-error="<spring:message code='credit.lookupError'/>"></p></div>
<label data-credit-kinds="CONTACT PROMISE DISPUTE RESOLVE NOTICE ASSIGN REOPEN"><spring:message code="credit.field.nextAction"/><form:input path="nextAction" type="date" cssClass="aws-control"/><form:errors path="nextAction" cssClass="field-error"/></label><c:if test="${formKind=='case'}"><label><spring:message code="credit.field.reason"/><form:textarea path="reason" maxlength="1000" cssClass="aws-control"/><form:errors path="reason" cssClass="field-error"/></label></c:if><c:if test="${formKind=='followUp'}"><label data-credit-kinds="PROMISE"><spring:message code="credit.field.amount"/> (TZS)<form:input path="amount" type="number" min="0" step="0.01" cssClass="aws-control"/><form:errors path="amount" cssClass="field-error"/></label><label data-credit-kinds="PROMISE"><spring:message code="credit.field.promiseOn"/><form:input path="promiseOn" type="date" cssClass="aws-control"/><form:errors path="promiseOn" cssClass="field-error"/></label><label><spring:message code="credit.field.evidence"/><form:textarea path="evidence" maxlength="1000" cssClass="aws-control"/><form:errors path="evidence" cssClass="field-error"/></label></c:if></c:otherwise>
</c:choose></div></section><c:if test="${formKind=='policy' and not canConfigureCreditPolicy}"></fieldset></c:if>
<spring:hasBindErrors name="${modelName}"><c:forEach items="${errors.globalErrors}" var="error"><p role="alert" class="field-error"><spring:message message="${error}"/></p></c:forEach></spring:hasBindErrors>
<div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" href="<c:url value='${returnPath}'/>"><spring:message code="common.cancel"/></a><c:if test="${formKind!='policy' or canConfigureCreditPolicy}"><button class="app-btn btn-launch" type="submit"><spring:message code="credit.save"/></button></c:if></div></form:form></div>
<script src="<c:url value='/js/loan-recording.js'/>" defer></script><script src="<c:url value='/js/credit-controls.js'/>" defer></script><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
