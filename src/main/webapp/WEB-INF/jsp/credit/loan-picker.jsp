<%@ include file="head.jspf" %><c:set var="tableKey" value="credit-loan-picker"/><c:set var="pagePath" value="/finance/credit/loans"/>
<section class="erp-table-wrap" data-resource-table="${tableKey}"><h2><spring:message code="credit.chooseLoan"/></h2><form method="get" action="<c:url value='${pagePath}'/>" data-table-filter-for="${tableKey}"><input type="hidden" name="feature" value="<c:out value='${feature}'/>"/><c:if test="${not empty assetId}"><input type="hidden" name="assetId" value="${assetId}"/></c:if><label class="sr-only" for="loanSearch"><spring:message code="common.search"/></label><input class="aws-control" name="search" id="loanSearch" maxlength="100" value="<c:out value='${search}'/>"/><button class="app-btn btn-neutral"><spring:message code="common.search"/></button></form>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><c:forEach items="${['loan','borrower','arrears']}" var="field"><th scope="col" data-table-order="${field}"><spring:message code="credit.field.${field}"/><c:if test="${field=='arrears'}"> (TZS)</c:if></th></c:forEach></tr></thead><tbody><c:forEach items="${records.rows}" var="row"><c:url value="${feature=='COLLECTIONS'?'/finance/credit/collections/new':'/finance/credit/collateral/'.concat(assetId).concat('/events/new')}" var="choiceUrl"><c:param name="loanId" value="${row.id}"/><c:if test="${feature=='COLLATERAL'}"><c:param name="kind" value="PLEDGE"/></c:if></c:url><tr><td><a class="resource-table-id-link" href="<c:out value='${choiceUrl}'/>"><c:out value="${row.number}"/></a></td><td><c:out value="${row.borrower}"/></td><td><c:choose><c:when test="${row.tracked}"><fmt:formatNumber value="${row.arrears}" minFractionDigits="2" maxFractionDigits="2"/></c:when><c:otherwise><spring:message code="credit.unavailable"/></c:otherwise></c:choose></td></tr></c:forEach><c:if test="${empty records.rows}"><tr><td colspan="3"><spring:message code="credit.noMatches"/></td></tr></c:if></tbody></table></div><%@ include file="pager.jspf" %></section><%@ include file="../fragments/footer.jspf" %>
