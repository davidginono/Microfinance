<section class="erp-resource-section"><h2><spring:message code="credit.loan"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="credit.field.loan"/></dt><dd><c:out value="${loan.number}"/></dd></div><div><dt><spring:message code="credit.field.borrower"/></dt><dd><c:out value="${loan.borrower}"/></dd></div>
<c:choose><c:when test="${loan.tracked}"><c:forEach items="${['principal','dueInterest','futureInterest','charges','arrears']}" var="field"><div><dt><spring:message code="credit.field.${field}"/> (TZS)</dt><dd><fmt:formatNumber value="${loan[field]}" minFractionDigits="2" maxFractionDigits="2"/></dd></div></c:forEach><div><dt><spring:message code="credit.field.oldest"/></dt><dd><c:out value="${appTime:display(loan.oldestDue)}"/></dd></div><div><dt><spring:message code="credit.field.nextDue"/></dt><dd><c:out value="${appTime:display(loan.nextDue)}"/></dd></div></c:when><c:otherwise><div><dt><spring:message code="credit.balances"/></dt><dd><spring:message code="credit.unavailable"/></dd></div></c:otherwise></c:choose></dl></section>
