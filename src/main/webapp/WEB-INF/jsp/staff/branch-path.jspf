<c:url value="/staff/branches" var="branchOverview"><c:param name="branch" value="${branch.id}" /></c:url>
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb' />">
    <a class="erp-page-path__link" href="<c:out value='${branchOverview}' />"><spring:message code="branches.oversight" /></a>
    <span aria-hidden="true">›</span><span><c:out value="${branch.id}" /></span>
    <span aria-hidden="true">›</span>
    <c:choose>
        <c:when test="${not empty branchDetailLabel}">
            <c:url value="/staff/branches/${branchSection}" var="branchSectionUrl"><c:param name="branch" value="${branch.id}" /></c:url>
            <a class="erp-page-path__link" href="<c:out value='${branchSectionUrl}' />"><spring:message code="branches.section.${branchSection}" /></a>
            <span aria-hidden="true">›</span><span aria-current="page"><spring:message code="${branchDetailLabel}" /></span>
        </c:when>
        <c:otherwise><span aria-current="page"><spring:message code="branches.section.${branchSection}" /></span></c:otherwise>
    </c:choose>
</nav>
