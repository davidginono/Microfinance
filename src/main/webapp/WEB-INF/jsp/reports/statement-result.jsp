<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../fragments/header.jspf" %>
<%@ include file="../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/statement-designer.css' />" />
<div class="statement-designer">
 <h1 class="erp-page-title"><c:choose><c:when test="${pageContext.response.locale.language eq 'sw'}"><c:out value="${result.definition.titleSw}" /></c:when><c:otherwise><c:out value="${result.definition.titleEn}" /></c:otherwise></c:choose></h1>
 <p><span class="statement-status"><spring:message code="statement.status.${result.status}" /></span> · TZS · <c:out value="${result.from}" /> — <c:out value="${result.through}" /></p>
 <p><spring:message code="statement.cutoff" />: <c:out value="${result.recordedCutoff}" /> · <spring:message code="statement.mappingVersion" />: <c:out value="${result.mappingVersion}" /></p>
 <c:if test="${result.definition.comparison}"><p><spring:message code="statement.comparison" />: <c:out value="${result.comparisonFrom}" /> — <c:out value="${result.comparisonThrough}" /> · <spring:message code="statement.cutoff" />: <c:out value="${result.comparisonCutoff}" /></p></c:if><c:if test="${not empty statementSuccess}"><p role="status"><spring:message code="${statementSuccess}" /></p></c:if>
 <div class="erp-table-wrap"><div class="erp-table-scroll" data-view-position-key="financial-statement-result"><table class="erp-table"><thead><tr><th><spring:message code="statement.line" /></th><th class="statement-number"><spring:message code="statement.current" /></th><c:if test="${result.definition.comparison}"><th class="statement-number"><spring:message code="statement.comparison" /></th></c:if></tr></thead><tbody>
 <c:forEach items="${result.getVisibleRows()}" var="row"><tr class="${row.mandatory ? 'statement-required' : ''}"><td><c:choose><c:when test="${row.mandatory and row.id.startsWith('REQUIRED_')}"><spring:message code="statement.total.${row.id.substring(9)}" /></c:when><c:when test="${pageContext.response.locale.language eq 'sw'}"><c:out value="${row.labelSw}" /></c:when><c:otherwise><c:out value="${row.labelEn}" /></c:otherwise></c:choose><c:if test="${row.kind eq 'NOTE' and not row.collapsed}"><p><c:out value="${pageContext.response.locale.language eq 'sw' ? row.noteSw : row.noteEn}" /></p></c:if></td><td class="statement-number"><c:choose><c:when test="${row.unit eq 'NONE'}"></c:when><c:when test="${row.status eq 'KNOWN'}"><fmt:formatNumber value="${row.current}" minFractionDigits="${row.unit eq 'RATIO' ? 6 : 2}" maxFractionDigits="${row.unit eq 'RATIO' ? 6 : 2}" /><c:if test="${row.unit eq 'RATIO'}"> (<spring:message code="statement.ratio" />)</c:if></c:when><c:otherwise><spring:message code="statement.value.${row.status}" /></c:otherwise></c:choose></td><c:if test="${result.definition.comparison}"><td class="statement-number"><c:choose><c:when test="${row.unit eq 'NONE'}"></c:when><c:when test="${row.comparisonStatus eq 'KNOWN'}"><fmt:formatNumber value="${row.comparison}" minFractionDigits="2" maxFractionDigits="6" /></c:when><c:otherwise><spring:message code="statement.value.${row.comparisonStatus}" /></c:otherwise></c:choose></td></c:if></tr></c:forEach>
 </tbody></table></div></div>
 <h2><spring:message code="statement.disclosures" /></h2><p><spring:message code="statement.disclosure.fixed" /></p>
 <c:forEach items="${result.disclosures}" var="disclosure"><p class="statement-disclosure"><c:choose><c:when test="${disclosure eq 'REVIEWED_DIFFERENCES_RETAINED' or disclosure eq 'REVIEWED_COVERAGE'}"><spring:message code="statement.coverage.reviewed" /></c:when><c:when test="${disclosure eq 'INCOMPLETE_NOT_AUTHORITATIVE'}"><spring:message code="statement.coverage.incomplete" /></c:when><c:when test="${disclosure eq 'RESTATEMENT'}"><spring:message code="statement.disclosure.restatement" /></c:when><c:when test="${disclosure.startsWith('ACCOUNTING_BASIS: ')}"><spring:message code="statement.disclosure.basis" />: <c:out value="${disclosure.substring(18)}" /></c:when><c:when test="${disclosure.startsWith('COMPARISON_POLICY: ')}"><spring:message code="statement.comparisonPolicy" />: <c:out value="${disclosure.substring(19)}" /></c:when><c:when test="${disclosure.startsWith('REVIEWED_DIFFERENCE: ')}"><spring:message code="statement.disclosure.difference" />: <c:out value="${disclosure.substring(21)}" /></c:when></c:choose></p></c:forEach>
 <c:if test="${not empty result.id}"><p><spring:message code="statement.documentReference" />: <c:out value="${result.id}" /></p><sec:authorize access="hasAuthority('STATEMENT_EXPORT')"><a class="app-btn btn-neutral" href="<c:url value='/finance/statement-outputs?result=${result.id}' />"><spring:message code="statement.generateFiles" /></a></sec:authorize> <sec:authorize access="hasAuthority('REGULATORY_SUBMISSION_CREATE')"><a class="app-btn btn-neutral" href="<c:url value='/reports/statements/regulatory?result=${result.id}' />"><spring:message code="statement.prepareSubmission" /></a></sec:authorize></c:if>
</div><%@ include file="../fragments/footer.jspf" %>
