<%@ include file="head.jspf" %>
<c:url value="${applicationRoot}" var="root"/>
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb'/>"><a class="erp-page-path__link" href="${root}"><spring:message code="applications.title"/></a><span aria-hidden="true">&#8250;</span><span aria-current="page"><spring:message code="applications.create"/></span></nav>
<h1 class="erp-page-title"><spring:message code="applications.create"/></h1>
<form:form modelAttribute="applicationForm" method="post" action="${root}/save" enctype="multipart/form-data" cssClass="accounting-create-form" data-workspace-submit="recover" data-resource-form-page="true" data-portal-recover="${portalWorkspace}" data-client-application="true" data-root="${root}">
<c:forEach items="${['principalAmount','interestAmount','applicationFee','insuranceFee','processingFee','totalDeductions','periodicRepaymentAmount','interestRate','interestMethod','repaymentFrequency']}" var="key"><span hidden data-quote-label="${key}"><spring:message code="applications.quote.${key}"/></span></c:forEach>
<form:hidden path="requestKey"/><form:hidden path="expectedVersion"/><form:hidden path="applicationId"/>
<c:forEach items="${['DAYS','MONTHS','YEARS','MONTHLY','WEEKLY','FLAT_RATE','REDUCING_BALANCE']}" var="key"><span hidden data-application-value="${key}"><spring:message code="applications.value.${key}"/></span></c:forEach>
<span hidden data-application-value="true"><spring:message code="common.yes"/></span><span hidden data-application-value="false"><spring:message code="common.no"/></span>
<div class="application-tabs" role="tablist" aria-label="<spring:message code='applications.title'/>"><c:forEach items="${['information','guarantors','collateral','documents']}" var="tab"><button type="button" role="tab" aria-selected="${tab=='information'}" aria-controls="application-${tab}" id="tab-${tab}" data-application-tab="${tab}"><spring:message code="applications.${tab}"/></button></c:forEach></div>
<section class="erp-resource-section application-panel" id="application-information" role="tabpanel" aria-labelledby="tab-information" data-application-panel="information"><h2><spring:message code="applications.information"/></h2><div class="application-grid">
<div><label for="clientId"><spring:message code="applications.client"/> *</label><c:choose><c:when test="${not empty selectedClient}"><form:hidden path="clientId"/><p><c:out value="${selectedClient.label}"/></p></c:when><c:otherwise><input class="aws-control" type="search" data-choice-search="clientId" aria-label="<spring:message code='common.search'/>"/><form:select path="clientId" id="clientId" cssClass="aws-control" data-application-choice="clients"><form:option value=""><spring:message code="applications.select"/></form:option><c:forEach items="${clients}" var="choice"><form:option value="${choice.id}"><c:out value="${choice.label}"/></form:option></c:forEach></form:select></c:otherwise></c:choose></div>
<div><label for="productId"><spring:message code="applications.product"/> *</label><input class="aws-control" type="search" data-choice-search="productId" aria-label="<spring:message code='common.search'/>"/><form:select path="productId" id="productId" cssClass="aws-control" data-application-choice="products"><form:option value=""><spring:message code="applications.select"/></form:option><c:forEach items="${products}" var="choice"><form:option value="${choice.id}"><c:out value="${choice.label}"/></form:option></c:forEach></form:select></div>
<div><label for="applicationDate"><spring:message code="applications.date"/> *</label><form:input path="applicationDate" type="date" cssClass="aws-control"/></div>
<c:if test="${not portalWorkspace}"><div><label for="loanOfficerId"><spring:message code="applications.officer"/></label><input class="aws-control" type="search" data-choice-search="loanOfficerId" aria-label="<spring:message code='common.search'/>"/><form:select path="loanOfficerId" id="loanOfficerId" cssClass="aws-control" data-application-choice="officers"><form:option value=""><spring:message code="applications.select"/></form:option><c:forEach items="${officers}" var="choice"><form:option value="${choice.id}"><c:out value="${choice.label}"/></form:option></c:forEach></form:select></div></c:if>
<c:forEach items="${['amount','tenureValue','income','expenses','otherDebt']}" var="field"><div><label for="${field}"><spring:message code="applications.${field}"/> <c:if test="${field=='amount' or field=='tenureValue'}">*</c:if></label><form:input path="${field}" type="number" min="0" step="${field=='tenureValue'?'1':'0.01'}" cssClass="aws-control"/></div></c:forEach>
<div><label for="tenureUnit"><spring:message code="applications.tenureUnit"/></label><form:select path="tenureUnit" cssClass="aws-control"><c:forEach items="${['DAYS','MONTHS','YEARS']}" var="unit"><form:option value="${unit}"><spring:message code="recording.tenure.${unit}"/></form:option></c:forEach></form:select></div>
<c:forEach items="${['purpose','business','useOfFunds']}" var="field"><div class="application-wide"><label for="${field}"><spring:message code="applications.${field}"/></label><form:textarea path="${field}" maxlength="${field=='purpose'?255:field=='business'?1000:2000}" rows="2" cssClass="aws-control"/></div></c:forEach>
</div><p class="text-sm"><spring:message code="applications.declared"/></p><div class="application-grid" data-product-fields><c:forEach items="${productForm.fields}" var="field"><c:if test="${field.name!='purpose' and field.name!='business' and field.name!='monthlyIncome' and field.name!='monthlyExpenses' and field.name!='otherDebtRepayments' and field.name!='collateralDescription' and field.name!='collateralEstimatedValue'}"><div><label><spring:message code="${field.labelKey}" text="${field.name}"/> ${field.required?'*':''}</label><c:choose><c:when test="${not empty field.enumOptions or field.type=='boolean'}"><select class="aws-control" name="fields[<c:out value='${field.name}'/>]"><option value=""><spring:message code="applications.select"/></option><c:choose><c:when test="${field.type=='boolean'}"><option value="true" ${applicationForm.fields[field.name]=='true'?'selected':''}><spring:message code="common.yes"/></option><option value="false" ${applicationForm.fields[field.name]=='false'?'selected':''}><spring:message code="common.no"/></option></c:when><c:otherwise><c:forEach items="${field.enumOptions}" var="option"><option value="<c:out value='${option}'/>" ${applicationForm.fields[field.name]==option?'selected':''}><c:out value="${option}"/></option></c:forEach></c:otherwise></c:choose></select></c:when><c:when test="${field.type=='textarea'}"><textarea class="aws-control" name="fields[<c:out value='${field.name}'/>]" maxlength="1000" rows="2"><c:out value="${applicationForm.fields[field.name]}"/></textarea></c:when><c:otherwise><input class="aws-control" name="fields[<c:out value='${field.name}'/>]" value="<c:out value='${applicationForm.fields[field.name]}'/>" type="${field.type=='number' or field.type=='integer'?'number':'text'}" step="${field.type=='integer'?'1':'0.01'}" maxlength="1000"/></c:otherwise></c:choose></div></c:if></c:forEach></div>
<p data-product-summary aria-live="polite" data-guarantors="<spring:message code='applications.guarantors'/>" data-prefix="<spring:message code='applications.productTerms'/>"></p><button type="button" class="app-btn btn-neutral" data-application-quote><spring:message code="applications.quote"/></button><dl class="erp-detail-facts" data-quote-output aria-live="polite"></dl></section>
<section class="erp-resource-section application-panel" id="application-guarantors" role="tabpanel" aria-labelledby="tab-guarantors" data-application-panel="guarantors"><h2><spring:message code="applications.guarantors"/></h2><div data-repeat-list="guarantors"><c:forEach items="${applicationForm.guarantors}" var="row" varStatus="i"><div class="application-row" data-repeat-row><div class="application-grid"><div><label><spring:message code="applications.client"/></label><input type="search" class="aws-control" data-guarantor-search aria-label="<spring:message code='common.search'/>"/><form:select path="guarantors[${i.index}].clientId" cssClass="aws-control" data-application-choice="guarantors"><form:option value="${row.clientId}"><c:out value="${guarantorLabels[row.clientId]}"/></form:option></form:select></div><c:forEach items="${['relationship','business','location','phone']}" var="key"><div><label><spring:message code="applications.${key}"/></label><form:input path="guarantors[${i.index}].${key}" cssClass="aws-control" maxlength="255"/></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-remove-row><spring:message code="applications.remove"/></button></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-add-row="guarantors"><spring:message code="applications.add"/></button></section>
<section class="erp-resource-section application-panel" id="application-collateral" role="tabpanel" aria-labelledby="tab-collateral" data-application-panel="collateral"><h2><spring:message code="applications.collateral"/></h2><div data-repeat-list="collateral"><c:forEach items="${applicationForm.collateral}" var="row" varStatus="i"><div class="application-row" data-repeat-row><div class="application-grid"><c:forEach items="${['itemName','itemNumber','itemType','description','owner','phone','location','estimatedValue']}" var="key"><div><label><spring:message code="applications.${key}"/></label><form:input path="collateral[${i.index}].${key}" cssClass="aws-control" maxlength="500"/></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-remove-row><spring:message code="applications.remove"/></button></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-add-row="collateral"><spring:message code="applications.add"/></button></section>
<section class="erp-resource-section application-panel" id="application-documents" role="tabpanel" aria-labelledby="tab-documents" data-application-panel="documents"><h2><spring:message code="applications.documents"/></h2><p><spring:message code="applications.fileHelp"/></p><p data-required-documents aria-live="polite"></p><div data-repeat-list="documents"></div><button type="button" class="app-btn btn-neutral" data-add-row="documents"><spring:message code="applications.add"/></button></section>
<template data-row-template="guarantors"><div class="application-row" data-repeat-row><div class="application-grid"><div><label><spring:message code="applications.client"/></label><input type="search" class="aws-control" data-guarantor-search aria-label="<spring:message code='common.search'/>"/><select class="aws-control" data-field="clientId" data-application-choice="guarantors"><option value=""><spring:message code="applications.select"/></option></select></div><c:forEach items="${['relationship','business','location','phone']}" var="key"><div><label><spring:message code="applications.${key}"/></label><input class="aws-control" data-field="${key}" maxlength="255"/></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-remove-row><spring:message code="applications.remove"/></button></div></template>
<template data-row-template="collateral"><div class="application-row" data-repeat-row><div class="application-grid"><c:forEach items="${['itemName','itemNumber','itemType','description','owner','phone','location','estimatedValue']}" var="key"><div><label><spring:message code="applications.${key}"/></label><input class="aws-control" data-field="${key}" maxlength="500" <c:if test="${key=='estimatedValue'}">type="number" min="0" step="0.01"</c:if>/></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-remove-row><spring:message code="applications.remove"/></button></div></template>
<template data-row-template="documents"><div class="application-row" data-repeat-row><div class="application-grid"><div><label><spring:message code="applications.documentName"/></label><input class="aws-control" data-document-field="documentNames" maxlength="120"/></div><div><label><spring:message code="applications.documentType"/></label><select class="aws-control" data-document-field="documentTypes"><c:forEach items="${documentTypes}" var="type"><option value="${type}"><spring:message code="applications.document.${type}"/></option></c:forEach></select></div><div><label><spring:message code="applications.requirement"/></label><select class="aws-control" data-document-field="requiredAttachmentIds"><option value=""><spring:message code="applications.optional"/></option></select></div><div><label><spring:message code="applications.file"/></label><input class="aws-control" name="files" type="file" accept="application/pdf,image/png,image/jpeg"/></div></div><button type="button" class="app-btn btn-neutral" data-remove-row><spring:message code="applications.remove"/></button></div></template>
<div class="application-declaration"><form:checkbox path="declarationAccepted" id="declarationAccepted"/><label for="declarationAccepted"><spring:message code="applications.declaration"/></label></div>
<form:errors path="*" cssClass="field-error" element="div"/>
<p role="alert" class="field-error" data-application-error data-error-text="<spring:message code='applications.error.details'/>" hidden></p>
<div class="accounting-actions application-footer"><a class="app-btn btn-neutral" href="${root}"><spring:message code="common.cancel"/></a><button class="app-btn btn-neutral" name="command" value="DRAFT" formnovalidate><spring:message code="applications.save"/></button><button class="app-btn btn-launch" name="command" value="SUBMIT"><spring:message code="applications.submit"/></button></div>
</form:form><script src="<c:url value='/js/client-applications.js'/>" defer></script>
<%@ include file="../accounting/accounting-form-support.jspf" %>
<%@ include file="foot.jspf" %>
