<div class="application-grid">
    <c:forEach items="${borrowerProductFields}" var="field">
        <c:if test="${field.name == 'collateralDescription' or field.name == 'collateralEstimatedValue'}">
            <div>
                <label for="${field.name}"><spring:message code="${field.labelKey}" text="${field.name}"/> ${field.required ? '*' : ''}</label>
                <c:choose><c:when test="${field.name == 'collateralDescription'}">
                    <textarea id="${field.name}" name="${field.name}" class="aws-control" rows="2"><c:out value="${formValues[field.name]}"/></textarea>
                </c:when><c:otherwise>
                    <input id="${field.name}" name="${field.name}" class="aws-control" type="number" min="0" step="0.01" value="<c:out value='${formValues[field.name]}'/>"/>
                </c:otherwise></c:choose>
            </div>
        </c:if>
    </c:forEach>
    <c:forEach items="${['collateralItemNumber','collateralAssetType','collateralOwner','collateralLocation','collateralContactPhone']}" var="key">
        <div>
            <label for="${key}"><spring:message code="applications.${key}"/></label>
            <input id="${key}" name="${key}" class="aws-control" maxlength="255" value="<c:out value='${formValues[key]}'/>"/>
        </div>
    </c:forEach>
</div>
