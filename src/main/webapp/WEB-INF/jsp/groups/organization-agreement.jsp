<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="orgAgreement.title" /></h1></div>
<c:set var="s" value="${packet.snapshot}" /><c:set var="f" value="${s.financial}" />
<section class="erp-resource-section"><h2><spring:message code="group.organizationLoan" /></h2><div class="erp-panel-body"><p><spring:message code="orgAgreement.representation" /></p><dl class="erp-detail-facts">
<div><dt><spring:message code="group.name" /></dt><dd><c:out value="${s.organization.name}" /></dd></div>
<div><dt><spring:message code="group.loan" /></dt><dd><c:out value="${s.loan.number}" /></dd></div>
<div><dt><spring:message code="group.product" /></dt><dd><c:out value="${s.loan.product}" /></dd></div>
<div><dt><spring:message code="group.status" /></dt><dd><spring:message code="loan.status.${packet.loanStatus}" /></dd></div>
<div><dt><spring:message code="group.purpose" /></dt><dd><c:out value="${s.loan.purpose}" /></dd></div>
<div><dt><spring:message code="group.agreement" /></dt><dd><c:out value="${s.loan.agreementReference}" /></dd></div>
<div><dt><spring:message code="group.policyReference" /></dt><dd><c:out value="${s.loan.policyReference}" /></dd></div>
<div><dt><spring:message code="orgAgreement.signatures" /></dt><dd><c:out value="${packet.signedCount}" /> / <c:out value="${s.authority.requiredSignatures}" /></dd></div>
</dl></div></section>
<section class="erp-resource-section"><h2><spring:message code="group.organizationTerms" /></h2><dl class="erp-detail-facts">
<div><dt><spring:message code="group.principal" /></dt><dd><fmt:formatNumber value="${s.loan.principal}" minFractionDigits="2" maxFractionDigits="2" /></dd></div>
<div><dt><spring:message code="group.annualRate" /></dt><dd><fmt:formatNumber value="${f.interestRate*100}" maxFractionDigits="4" />%</dd></div>
<div><dt><spring:message code="orgAgreement.interestMethod" /></dt><dd><spring:message code="orgAgreement.method.${f.interestMethod}" /></dd></div>
<div><dt><spring:message code="group.tenure" /></dt><dd><c:out value="${f.tenureValue}" /> <spring:message code="group.unit.${f.tenureUnit}" /></dd></div>
<div><dt><spring:message code="group.instalment" /></dt><dd><c:out value="${f.periodicRepaymentAmount}" /> · <spring:message code="group.frequency.${f.repaymentFrequency}" /></dd></div>
<div><dt><spring:message code="group.maximumInstalment" /></dt><dd><c:out value="${f.maximumInstallmentAmount}" /></dd></div>
<div><dt><spring:message code="group.firstPaymentDate" /></dt><dd><c:out value="${appTime:display(s.loan.firstPaymentDate)}" /></dd></div>
<div><dt><spring:message code="group.contractualInterest" /></dt><dd><c:out value="${f.interestAmount}" /></dd></div>
<c:forEach items="${['recordedChargeTotal','recordedChargeDeductions','recordedNetCashEstimate','recordedTotalPayable']}" var="field"><div><dt><spring:message code="orgAgreement.${field}" /></dt><dd><c:out value="${f[field]}" /></dd></div></c:forEach>
</dl><c:if test="${not empty f.recordedCharges.terms}"><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="charges.kind" /></th><th><spring:message code="group.chargeAmount" /></th><th><spring:message code="group.chargeTiming" /></th><th><spring:message code="group.provider" /></th></tr></thead><tbody><c:forEach items="${f.recordedCharges.terms}" var="charge"><tr><td><spring:message code="charges.kind.${charge.kind}" /></td><td><c:out value="${charge.amount}" /></td><td><spring:message code="charges.timing.${charge.timing}" /></td><td><c:out value="${charge.provider}" /></td></tr></c:forEach></tbody></table></div></c:if></section>
<section class="erp-resource-section"><h2><spring:message code="prepayment.title" /></h2><div class="erp-panel-body"><p><spring:message code="prepayment.mandatory" /></p><dl class="erp-detail-facts"><div><dt><spring:message code="prepayment.schedule" /></dt><dd><spring:message code="prepayment.schedule.${f.prepaymentTerms.schedule}" /></dd></div><div><dt><spring:message code="prepayment.partialInterest" /></dt><dd><spring:message code="prepayment.partial.${f.prepaymentTerms.partialInterest}" /></dd></div><div><dt><spring:message code="prepayment.dayBasis" /></dt><dd><spring:message code="prepayment.basis.${f.prepaymentTerms.dayBasis}" /></dd></div></dl></div></section>
<section class="erp-resource-section"><h2><spring:message code="orgAgreement.payout" /></h2><dl class="erp-detail-facts">
<div><dt><spring:message code="group.provider" /></dt><dd><c:out value="${s.payout.provider}" /></dd></div>
<div><dt><spring:message code="orgAgreement.holder" /></dt><dd><c:out value="${s.payout.accountHolderName}" /></dd></div>
<div><dt><spring:message code="orgAgreement.account" /></dt><dd><c:out value="${s.payout.accountIdentifier}" /></dd></div>
</dl></section>
<section class="erp-table-wrap" data-resource-table="organization-agreement-schedule"><h2><spring:message code="orgAgreement.schedule" /></h2><p><spring:message code="orgAgreement.projection" /></p><c:if test="${f.tenureUnit=='DAYS'}"><p><spring:message code="orgAgreement.dayDates" /></p></c:if><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="orgAgreement.payment" /></th><th><spring:message code="orgAgreement.dueDate" /></th><th><spring:message code="group.principal" /></th><th><spring:message code="group.contractualInterest" /></th><th><spring:message code="group.chargeAmount" /></th></tr></thead><tbody><c:forEach items="${packet.schedule}" var="row"><tr><td><c:out value="${row.number}" /></td><td><c:out value="${appTime:display(row.date)}" /></td><td><c:out value="${row.principal}" /></td><td><c:out value="${row.interest}" /></td><td><c:out value="${row.amount}" /></td></tr></c:forEach></tbody></table></div><div data-table-pagination data-page="${packet.page}" data-table-for="organization-agreement-schedule"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?packet.page>0:packet.hasNext}"><c:url value="/app/group-loans/${packet.cycle}/organization-agreement" var="pageUrl"><c:param name="page" value="${packet.page+step}" /></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}' />"><spring:message code="${step==-1?'common.previous':'common.next'}" /></a></c:if></c:forEach></div></section>
<c:if test="${not empty consentError}"><p role="alert" class="coa-error"><spring:message code="${consentError}" /></p></c:if><c:if test="${consentCodeSent}"><p role="status"><spring:message code="group.otpSent" /></p></c:if>
<sec:authorize access="@access.has(principal,'MEMBER_LOANS_UPDATE')" var="canSignOrganization" />
<c:choose><c:when test="${packet.signed}"><p role="status"><spring:message code="orgAgreement.signed" /> · <c:out value="${appTime:display(packet.signedAt)}" /></p></c:when><c:when test="${not packet.canSign}"><p role="status"><spring:message code="group.error.organizationSigningClosed" /></p></c:when><c:otherwise>
<c:if test="${not packet.signatureReady}"><p role="alert" class="coa-error"><spring:message code="group.error.signature" /></p></c:if>
<c:if test="${not canSignOrganization}"><p role="alert" class="coa-error"><spring:message code="group.error.signingPermission" /></p></c:if>
<c:if test="${packet.otpRequired}"><c:url value="/app/group-loans/${packet.cycle}/organization-agreement/code" var="codeUrl" /><form action="${codeUrl}" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="packetHash" value="<c:out value='${packet.hash}' />" /><div class="accounting-actions"><button type="submit" class="app-btn btn-neutral" ${not packet.signatureReady or not canSignOrganization?'disabled':''}><spring:message code="group.requestCode" /></button></div></form></c:if>
<c:url value="/app/group-loans/${packet.cycle}/organization-agreement/sign" var="signUrl" /><form action="${signUrl}" method="post" class="accounting-create-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="packetHash" value="<c:out value='${packet.hash}' />" /><section class="accounting-form accounting-create-card"><h2><spring:message code="group.signatureTitle" /></h2><div class="erp-panel-body"><c:if test="${packet.otpRequired}"><label><spring:message code="group.otpCode" /><input name="otpCode" class="aws-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required /></label></c:if><label class="aws-settings-checkbox-row"><input type="checkbox" name="accepted" value="true" class="aws-settings-checkbox" required /><span class="aws-settings-checkbox-copy"><spring:message code="orgAgreement.acceptance" /></span></label></div></section><div class="accounting-actions accounting-form-actions"><button type="submit" class="app-btn btn-launch" ${not packet.signatureReady or not canSignOrganization?'disabled':''}><spring:message code="orgAgreement.sign" /></button></div></form>
</c:otherwise></c:choose>
<%@ include file="../fragments/footer.jspf" %>
