<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<nav class="erp-page-path"><a href="<c:url value='/finance/groups/cycles/${statement.cycle}' />"><spring:message code="group.cycle" /></a><span>›</span><span aria-current="page"><spring:message code="sharedStatement.title" /></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="sharedStatement.title" /></h1></div>
<section class="erp-resource-section"><h2><spring:message code="group.sharedFacility" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.loan" /></dt><dd><a class="resource-table-id-link" href="<c:url value='/finance/loan-records/${statement.parent.loan.id}' />"><c:out value="${statement.parent.loan.number}" /></a></dd></div><div><dt><spring:message code="group.status" /></dt><dd><spring:message code="recording.status.${statement.parent.loan.status}" /></dd></div><c:if test="${statement.funded}"><div><dt><spring:message code="sharedStatement.principal" /> (TZS)</dt><dd><fmt:formatNumber value="${statement.parent.loan.outstandingPrincipal}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.dueInterest" /> (TZS)</dt><dd><fmt:formatNumber value="${statement.parent.loan.dueInterest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="sharedStatement.charges" /> (TZS)</dt><dd><fmt:formatNumber value="${statement.parent.loan.charges}" minFractionDigits="2" maxFractionDigits="2" /></dd></div></c:if></dl><p><spring:message code="sharedStatement.disclosure" /></p><c:if test="${not statement.funded}"><p role="status"><spring:message code="sharedStatement.unfunded" /></p></c:if></section>
<section class="erp-resource-section"><h2><spring:message code="group.participants" /></h2><c:if test="${statement.funded and not statement.known()}"><p role="status"><spring:message code="sharedStatement.unknown" /></p></c:if><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="group.client" /></th><th><spring:message code="group.principal" /></th><th><spring:message code="sharedStatement.principal" /> (TZS)</th><th><spring:message code="sharedStatement.interest" /> (TZS)</th><th><spring:message code="sharedStatement.charges" /> (TZS)</th><th><spring:message code="sharedStatement.excluded" /> (TZS)</th><th><spring:message code="memberStatement.waived" /></th></tr></thead><tbody><c:forEach items="${statement.members}" var="member"><tr><td><a class="resource-table-id-link" href="<c:url value='/finance/groups/cycles/${statement.cycle}/allocations/${member.client}/statement' />"><c:out value="${member.number}" /></a> · <c:out value="${member.name}" /></td><td><fmt:formatNumber value="${member.principal}" minFractionDigits="2" maxFractionDigits="2" /></td><c:choose><c:when test="${statement.funded and member.known}"><td><fmt:formatNumber value="${member.remainingPrincipal()}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${member.remainingInterest()}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${member.remainingCharges()}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${member.excludedInterest}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${member.waivedInterest}" minFractionDigits="2" maxFractionDigits="2" /></td></c:when><c:otherwise><td>—</td><td>—</td><td>—</td><td>—</td><td>—</td></c:otherwise></c:choose></tr></c:forEach></tbody></table></div></section>
<%@ include file="../fragments/footer.jspf" %>
