<%@ page pageEncoding="UTF-8" %>
<c:if test="${groupDisclosure.rules.languageChoiceRequired}"><label><spring:message code="groupDisclosure.preferredLanguage" /><select name="preferredLanguage" class="aws-control" required><option value=""><spring:message code="voucher.choose" /></option><c:forEach items="${['SW','EN']}" var="choice"><c:if test="${groupDisclosure.rules.agreementLanguage=='BOTH' or groupDisclosure.rules.agreementLanguage==choice}"><option value="${choice}" ${preferredLanguage==choice?'selected':''}><spring:message code="orgDocument.language.${choice}" /></option></c:if></c:forEach></select></label></c:if>
