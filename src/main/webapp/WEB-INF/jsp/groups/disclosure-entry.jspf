<%@ page pageEncoding="UTF-8" %>
<c:if test="${disclosureRules.annualCostRequired}"><label><spring:message code="groupDisclosure.annualCost" /><form:input path="${disclosurePath}.annualCostPercent" type="number" min="0" max="100000" step="0.000001" cssClass="aws-control" /></label><label><spring:message code="groupDisclosure.costEvidence" /><form:input path="${disclosurePath}.costEvidence" maxlength="500" cssClass="aws-control" /></label><label><form:checkbox path="${disclosurePath}.costVerified" /><spring:message code="groupDisclosure.costVerified" /></label></c:if>
<c:if test="${disclosureRules.datedFeesRequired}"><label><spring:message code="groupDisclosure.feeEvidence" /><form:input path="${disclosurePath}.datedFeesEvidence" maxlength="500" cssClass="aws-control" /></label><label><form:checkbox path="${disclosurePath}.datedFeesVerified" /><spring:message code="groupDisclosure.feesVerified" /></label></c:if>
