<%@ page pageEncoding="UTF-8" %>
<c:if test="${disclosureRules.annualCostRequired}"><label><spring:message code="groupDisclosure.annualCost" /><form:input path="${disclosurePath}.annualCostPercent" type="number" min="0" max="100000" step="0.000001" cssClass="aws-control" /></label><label><spring:message code="groupDisclosure.costEvidence" /><form:input path="${disclosurePath}.costEvidence" maxlength="500" cssClass="aws-control" /></label><label class="aws-settings-checkbox-row"><form:checkbox path="${disclosurePath}.costVerified" cssClass="aws-settings-checkbox" /><span class="aws-settings-checkbox-copy"><spring:message code="groupDisclosure.costVerified" /></span></label></c:if>
<c:if test="${disclosureRules.datedFeesRequired}"><label><spring:message code="groupDisclosure.feeEvidence" /><form:input path="${disclosurePath}.datedFeesEvidence" maxlength="500" cssClass="aws-control" /></label><label class="aws-settings-checkbox-row"><form:checkbox path="${disclosurePath}.datedFeesVerified" cssClass="aws-settings-checkbox" /><span class="aws-settings-checkbox-copy"><spring:message code="groupDisclosure.feesVerified" /></span></label></c:if>
