<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<c:set var="cycle" value="${workspace.cycle}" /><c:set var="authority" value="${workspace.authority}" />
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb' />"><a class="erp-page-path__link" href="<c:url value='/finance/groups/${cycle.groupId}/cycles' />"><spring:message code="group.cycles" /></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="group.organizationLoan" /></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="group.organizationLoan" /></h1><sec:authorize access="@access.has(principal,'GROUP_LENDING_VIEW') and @access.has(principal,'LOAN_RECORDING_VIEW') and @access.has(principal,'LOAN_REPORTS_VIEW') and @access.has(principal,'FINANCIAL_REPORTS_VIEW')"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/cycles/${cycle.id}/statement'/>"><spring:message code="cycleStatement.title"/></a></sec:authorize><c:if test="${not empty workspace.loan}"><sec:authorize access="@access.has(principal,'GROUP_LENDING_VIEW') and @access.has(principal,'LOAN_RECORDING_VIEW')"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/cycles/${cycle.id}/personal-guarantees'/>"><spring:message code="personalGuarantee.title"/></a></sec:authorize></c:if></div>
<div class="accounting-workspace accounting-create-workspace">
<section class="erp-panel"><div class="erp-panel-header"><h2><spring:message code="group.summary" /></h2></div><div class="erp-panel-body"><dl class="erp-detail-facts">
<div><dt><spring:message code="group.name" /></dt><dd><c:out value="${cycle.groupName}" /></dd></div><div><dt><spring:message code="group.productRules" /></dt><dd><c:out value="${workspace.policy.product}" /></dd></div>
<div><dt><spring:message code="group.status" /></dt><dd><spring:message code="group.cycleState.${cycle.state}" /></dd></div><div><dt><spring:message code="group.agreement" /></dt><dd><c:out value="${workspace.policy.agreementReference}" /></dd></div>
</dl></div></section>
<c:if test="${not workspace.supported}"><div class="console-message" data-message-type="warning" role="status"><spring:message code="group.error.organizationPolicy" /></div></c:if>
<section class="erp-panel"><div class="erp-panel-header"><h2><spring:message code="authority.title" /></h2></div><div class="erp-panel-body"><c:if test="${not empty authority}"><dl class="erp-detail-facts">
<div><dt><spring:message code="authority.revision" /></dt><dd><a class="resource-table-id-link" href="<c:url value='/finance/groups/${cycle.groupId}/authority/${authority.id}' />"><c:out value="${authority.revision}" /></a></dd></div>
<div><dt><spring:message code="group.status" /></dt><dd><spring:message code="authority.state.${authority.state}" /></dd></div>
<div><dt><spring:message code="authority.principal" /></dt><dd>TZS <c:out value="${authority.maxPrincipal}" /></dd></div><div><dt><spring:message code="authority.requiredSignatures" /></dt><dd><c:out value="${authority.requiredSignatures}" /></dd></div>
<div><dt><spring:message code="authority.payoutHolder" /></dt><dd><c:out value="${authority.payoutHolder}" /></dd></div><div><dt><spring:message code="authority.payoutProvider" /></dt><dd><c:out value="${authority.payoutProvider}" /></dd></div><div><dt><spring:message code="authority.payoutIdentifier" /></dt><dd><c:out value="${authority.payoutIdentifier}" /></dd></div>
</dl></c:if><p><spring:message code="group.organizationAuthorityUse" /></p><c:if test="${cycle.state=='DRAFT' and workspace.supported}"><sec:authorize access="@access.has(principal,'GROUP_AUTHORITY_CREATE')"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/${cycle.groupId}/authority/new' />"><spring:message code="authority.record" /></a></sec:authorize></c:if></div></section>
<section class="erp-panel"><div class="erp-panel-header"><h2><spring:message code="orgDocument.title" /></h2></div><div class="erp-panel-body"><c:choose><c:when test="${not empty workspace.document}"><dl class="erp-detail-facts"><div><dt><spring:message code="orgDocument.reference" /></dt><dd><c:out value="${workspace.document.reference}" /></dd></div><div><dt><spring:message code="orgDocument.language" /></dt><dd><spring:message code="orgDocument.language.${workspace.document.language}" /></dd></div><div><dt><spring:message code="authority.revision" /></dt><dd><c:out value="${workspace.document.revision}" /></dd></div><div><dt><spring:message code="orgDocument.address" /></dt><dd><c:out value="${workspace.document.institutionName}" /> · <c:out value="${workspace.document.institutionAddress}" /></dd></div><div><dt><spring:message code="orgDocument.contact" /></dt><dd><c:out value="${workspace.document.contactPhone}" /> <c:out value="${workspace.document.contactEmail}" /></dd></div><div><dt><spring:message code="orgDocument.complaints" /></dt><dd><c:out value="${workspace.document.complaintPhone}" /> <c:out value="${workspace.document.complaintEmail}" /> <c:out value="${workspace.document.complaintAddress}" /></dd></div></dl><sec:authorize access="@access.has(principal,'LOAN_DOCUMENTS_VIEW') and @access.has(principal,'LOAN_DOCUMENTS_EXPORT')"><a class="app-btn btn-neutral" download target="_blank" rel="noopener" href="<c:url value='/finance/groups/cycles/${cycle.id}/organization/documents/${workspace.document.id}/pdf' />"><spring:message code="orgDocument.openTerms" /></a><c:if test="${not empty workspace.loan}"><sec:authorize access="@authz.canViewLoan(T(java.util.UUID).fromString('${workspace.loan.loanId}'),principal)"><a class="app-btn btn-neutral" download target="_blank" rel="noopener" data-native-navigation data-no-page-preloader="true" href="<c:url value='/documents/loan-applications/${workspace.loan.loanId}/print' />"><spring:message code="orgDocument.openAgreement" /></a></sec:authorize></c:if></sec:authorize></c:when><c:otherwise><p role="status"><spring:message code="group.error.documentRequired" /></p></c:otherwise></c:choose></div></section>
<c:choose><c:when test="${cycle.state=='DRAFT' and workspace.supported}">
<c:url value="/finance/groups/cycles/${cycle.id}/organization" var="saveUrl" />
<form:form id="organization-form" modelAttribute="cycleForm" action="${saveUrl}" method="post" enctype="multipart/form-data" cssClass="accounting-create-form" data-preserve-submit-command="true"><form:hidden path="requestKey" /><form:hidden path="policyId" /><form:hidden path="expectedVersion" /><form:hidden path="organization.authorityId" />
<div class="accounting-error-summary" role="alert" tabindex="-1"><form:errors path="*" element="p" cssClass="coa-error" /></div>
<div class="accounting-actions"><sec:authorize access="@access.has(principal,'GROUP_LENDING_UPDATE')"><button class="app-btn btn-neutral" type="submit" name="action" value="useCurrentAuthority" formnovalidate><spring:message code="group.useCurrentAuthority" /></button></sec:authorize></div>
<section class="accounting-form accounting-create-card"><h2><spring:message code="group.organizationTerms" /></h2><div class="accounting-grid erp-panel-body">
<label><spring:message code="group.representative" /><form:select path="organization.representativeId" cssClass="aws-control"><form:option value=""><spring:message code="voucher.choose" /></form:option><c:forEach items="${authority.signers}" var="person"><c:if test="${person.mayApply}"><form:option value="${person.clientId}"><c:out value="${person.number}" /> · <c:out value="${person.name}" /></form:option></c:if></c:forEach></form:select><form:errors path="organization.representativeId" cssClass="coa-error" /></label>
<label><spring:message code="group.applicationDate" /><form:input path="applicationDate" type="date" cssClass="aws-control" /><form:errors path="applicationDate" cssClass="coa-error" /></label>
<label><spring:message code="group.firstPaymentDate" /><form:input path="firstPaymentDate" type="date" cssClass="aws-control" /><form:errors path="firstPaymentDate" cssClass="coa-error" /></label>
<label><spring:message code="group.principal" /><form:input path="organization.principal" type="number" min="0.01" step="0.01" cssClass="aws-control" /><form:errors path="organization.principal" cssClass="coa-error" /></label>
<label><spring:message code="group.tenureUnit" /><form:select path="tenureUnit" cssClass="aws-control"><c:forEach items="${['DAYS','MONTHS','YEARS']}" var="unit"><form:option value="${unit}"><spring:message code="group.unit.${unit}" /></form:option></c:forEach></form:select></label>
<label><spring:message code="group.tenure" /><form:input path="tenureValue" type="number" min="1" cssClass="aws-control" /><form:errors path="tenureValue" cssClass="coa-error" /></label>
<label><spring:message code="group.purpose" /><form:input path="purpose" maxlength="500" cssClass="aws-control" /><form:errors path="purpose" cssClass="coa-error" /></label>
</div></section>
<section class="accounting-form accounting-create-card"><h2><spring:message code="group.organizationAssessment" /></h2><div class="accounting-grid erp-panel-body">
<label><spring:message code="group.business" /><form:textarea path="organization.business" maxlength="1000" cssClass="aws-control" /><form:errors path="organization.business" cssClass="coa-error" /></label>
<c:forEach items="${['income','expenses','otherDebt']}" var="field"><label><spring:message code="group.${field}" /><form:input path="organization.${field}" type="number" min="0" step="0.01" cssClass="aws-control" /><form:errors path="organization.${field}" cssClass="coa-error" /></label></c:forEach>
<label><spring:message code="group.assessmentEvidence" /><form:input path="organization.assessmentEvidence" maxlength="500" cssClass="aws-control" /><form:errors path="organization.assessmentEvidence" cssClass="coa-error" /></label>
<label><spring:message code="group.collateral" /><form:input path="organization.collateral" maxlength="500" cssClass="aws-control" /><form:errors path="organization.collateral" cssClass="coa-error" /></label>
<c:forEach items="${['collateralValue','insurancePremium']}" var="field"><label><spring:message code="group.${field}" /><form:input path="organization.${field}" type="number" min="0" step="0.01" cssClass="aws-control" /><form:errors path="organization.${field}" cssClass="coa-error" /></label></c:forEach>
<label><spring:message code="group.insuranceEvidence" /><form:input path="organization.insuranceEvidence" maxlength="500" cssClass="aws-control" /><form:errors path="organization.insuranceEvidence" cssClass="coa-error" /></label>
</div></section>
<sec:authorize access="@access.has(principal,'GROUP_LENDING_UPDATE') and @access.has(principal,'LOAN_RECORDING_CREATE')"><section class="accounting-form accounting-create-card"><h2><spring:message code="orgDocument.record" /></h2><div class="erp-panel-body"><spring:hasBindErrors name="documentForm"><div role="alert" class="accounting-error-summary"><c:forEach items="${errors.allErrors}" var="error"><p class="coa-error"><spring:message message="${error}" /></p></c:forEach></div></spring:hasBindErrors><input type="hidden" name="documentRequestKey" value="<c:out value='${documentForm.documentRequestKey}' />" /><input type="hidden" name="expectedDocumentId" value="<c:out value='${documentForm.expectedDocumentId}' />" /><div class="accounting-grid"><label><spring:message code="orgDocument.file" /><input class="aws-control" type="file" name="agreementPdf" accept="application/pdf,.pdf" /></label><label><spring:message code="orgDocument.language" /><select class="aws-control" name="documentLanguage"><option value=""><spring:message code="voucher.choose" /></option><c:forEach items="${['SW','EN','BOTH']}" var="language"><option value="${language}" ${documentForm.documentLanguage==language?'selected':''}><spring:message code="orgDocument.language.${language}" /></option></c:forEach></select></label><c:forEach items="${['documentReference','institutionAddress','contactPhone','contactEmail','complaintPhone','complaintEmail','complaintAddress']}" var="field"><label><spring:message code="orgDocument.${field}" /><input class="aws-control" name="${field}" value="<c:out value='${documentForm[field]}' />" maxlength="${field.endsWith('Email')?160:field.endsWith('Phone')?80:500}" type="${field.endsWith('Email')?'email':'text'}" /></label></c:forEach></div><label class="aws-settings-checkbox-row"><input type="checkbox" name="documentChecked" value="true" class="aws-settings-checkbox" ${documentForm.documentChecked?'checked':''} /><span class="aws-settings-checkbox-copy"><spring:message code="orgDocument.checked" /></span></label><div class="accounting-actions"><button class="app-btn btn-neutral" type="submit" name="action" value="recordDocument" formnovalidate><spring:message code="orgDocument.record" /></button></div></div></section></sec:authorize>
<div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/${cycle.groupId}/cycles' />"><spring:message code="common.cancel" /></a><sec:authorize access="@access.has(principal,'GROUP_LENDING_UPDATE')"><button class="app-btn btn-neutral" type="submit" name="action" value="save"><spring:message code="group.saveDraft" /></button></sec:authorize><sec:authorize access="@access.has(principal,'GROUP_LENDING_SUBMIT') and @access.has(principal,'LOAN_RECORDING_CREATE')"><button class="app-btn btn-launch" type="submit" name="action" value="submit" ${empty workspace.document?'disabled':''}><spring:message code="group.send" /></button></sec:authorize></div>
</form:form></c:when><c:otherwise>
<c:if test="${not empty workspace.loan}"><section class="erp-panel"><div class="erp-panel-header"><h2><spring:message code="group.loan" /></h2></div><div class="erp-panel-body"><dl class="erp-detail-facts"><div><dt><spring:message code="group.loan" /></dt><dd><sec:authorize access="@access.has(principal,'LOAN_RECORDING_VIEW')" var="canViewLoan" /><c:choose><c:when test="${canViewLoan}"><a class="resource-table-id-link" href="<c:url value='/finance/loan-records/${workspace.loan.loanId}' />"><c:out value="${workspace.loan.number}" /></a></c:when><c:otherwise><c:out value="${workspace.loan.number}" /></c:otherwise></c:choose></dd></div><div><dt><spring:message code="group.principal" /></dt><dd>TZS <c:out value="${workspace.loan.principal}" /></dd></div><div><dt><spring:message code="group.monthlyPayment" /></dt><dd>TZS <c:out value="${workspace.loan.monthlyPayment}" /></dd></div><div><dt><spring:message code="group.representative" /></dt><dd><c:out value="${workspace.loan.representative}" /></dd></div><div><dt><spring:message code="group.status" /></dt><dd><spring:message code="recording.status.${workspace.loan.status}" /></dd></div></dl></div></section></c:if>

</c:otherwise></c:choose>
<c:if test="${cycle.state!='CANCELLED'}"><sec:authorize access="@access.has(principal,'GROUP_LENDING_SUBMIT')"><div class="accounting-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/cycles/${cycle.id}/withdraw' />"><spring:message code="group.withdraw" /></a></div></sec:authorize></c:if>
</div><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
