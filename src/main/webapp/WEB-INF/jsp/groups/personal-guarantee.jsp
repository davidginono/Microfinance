<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %><link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css'/>"/>
<c:set var="offer" value="${packet.offer}"/><c:set var="source" value="${packet.source}"/><c:set var="doc" value="${packet.document}"/><c:choose><c:when test="${personalGuaranteeStaff}"><c:url value="/finance/groups/cycles/${source.cycle}/personal-guarantees" var="guaranteesPath"/></c:when><c:otherwise><c:url value="/app/group-guarantees" var="guaranteesPath"/></c:otherwise></c:choose><nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb'/>"><a class="erp-page-path__link" href="${guaranteesPath}"><spring:message code="personalGuarantee.title"/></a><span aria-hidden="true">›</span><span aria-current="page"><c:out value="${offer.code}"/></span></nav><div class="erp-page-header"><h1 class="erp-page-title"><c:out value="${offer.code}"/></h1><c:if test="${offer.state=='ACCEPTED'}"><sec:authorize access="@access.has(principal,'LOAN_DOCUMENTS_VIEW') and @access.has(principal,'LOAN_DOCUMENTS_EXPORT')"><c:forEach items="${['pdf','print']}" var="format"><a class="app-btn btn-neutral" href="${guaranteesPath}/${offer.id}/evidence/${format}" ${format=='print'?'target="_blank" rel="noopener"':''}><spring:message code="management.${format}"/></a></c:forEach></sec:authorize></c:if></div><div class="accounting-workspace"><c:if test="${not empty consentError}"><div class="accounting-error-summary" role="alert"><spring:message code="${consentError}"/></div></c:if><c:if test="${consentCodeSent}"><p role="status"><spring:message code="group.otpSent"/></p></c:if><%@ include file="personal-guarantee-source.jspf" %>
<section class="erp-resource-section"><h2><spring:message code="personalGuarantee.guarantor"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.client"/></dt><dd><c:out value="${offer.number}"/> · <c:out value="${offer.name}"/></dd></div><div><dt><spring:message code="group.status"/></dt><dd><spring:message code="personalGuarantee.state.${offer.state}"/></dd></div><div><dt><spring:message code="personalGuarantee.validThrough"/></dt><dd><c:out value="${appTime:display(offer.validThrough)}"/></dd></div><c:if test="${not empty offer.decidedAt}"><div><dt><spring:message code="personalGuarantee.date"/></dt><dd><c:out value="${appTime:display(offer.decidedAt)}"/></dd></div></c:if><c:if test="${not empty offer.signature}"><div><dt><spring:message code="orgDocument.signature"/></dt><dd><c:out value="${offer.signature}"/></dd></div></c:if><c:if test="${not empty offer.reason}"><div><dt><spring:message code="group.reason"/></dt><dd><c:out value="${offer.reason}"/></dd></div></c:if><c:if test="${personalGuaranteeStaff}"><div><dt><spring:message code="personalGuarantee.capacity"/> (TZS)</dt><dd><fmt:formatNumber value="${offer.capacity}" minFractionDigits="2" maxFractionDigits="2"/></dd></div><div><dt><spring:message code="personalGuarantee.capacityEvidence"/></dt><dd><c:out value="${offer.capacityEvidence}"/></dd></div></c:if></dl><p><spring:message code="personalGuarantee.deadlineNote"/></p></section>
<section class="erp-resource-section"><h2><spring:message code="personalGuarantee.document"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="orgDocument.reference"/></dt><dd><c:out value="${offer.reference}"/></dd></div><div><dt><spring:message code="orgDocument.language"/></dt><dd><spring:message code="orgDocument.language.${offer.language}"/></dd></div><div><dt><spring:message code="orgDocument.address"/></dt><dd><c:out value="${doc.institutionAddress}"/></dd></div><div><dt><spring:message code="orgDocument.contact"/></dt><dd><c:out value="${doc.contactPhone}"/> <c:out value="${doc.contactEmail}"/></dd></div><div><dt><spring:message code="orgDocument.complaints"/></dt><dd><c:out value="${doc.complaintPhone}"/> <c:out value="${doc.complaintEmail}"/> <c:out value="${doc.complaintAddress}"/></dd></div></dl><sec:authorize access="@access.has(principal,'LOAN_DOCUMENTS_VIEW') and @access.has(principal,'LOAN_DOCUMENTS_EXPORT')"><c:choose><c:when test="${personalGuaranteeStaff}"><a class="app-btn btn-neutral" href="${guaranteesPath}/${offer.id}/document"><spring:message code="orgDocument.openTerms"/></a></c:when><c:otherwise><form method="post" action="${guaranteesPath}/${offer.id}/document" data-no-page-preloader="true"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><button class="app-btn btn-neutral" type="submit"><spring:message code="orgDocument.openTerms"/></button></form></c:otherwise></c:choose></sec:authorize></section>
<c:choose><c:when test="${personalGuaranteeStaff}"><c:if test="${source.status=='AWAITING_GUARANTORS' and (offer.state=='PENDING' or offer.state=='EXPIRED')}"><sec:authorize access="@access.has(principal,'GROUP_LENDING_UPDATE') and @access.has(principal,'LOAN_RECORDING_CREATE')"><form method="post" action="${guaranteesPath}/${offer.id}/cancel" class="accounting-create-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><section class="accounting-form accounting-create-card"><h2><spring:message code="personalGuarantee.cancel"/></h2><label class="erp-panel-body"><spring:message code="group.reason"/><input class="aws-control" name="reason" maxlength="500" required/></label></section><div class="accounting-actions"><button class="app-btn btn-neutral" type="submit"><spring:message code="personalGuarantee.cancel"/></button></div></form></sec:authorize></c:if></c:when><c:otherwise><c:if test="${packet.open}"><sec:authorize access="@access.has(principal,'GUARANTOR_REQUESTS_APPROVE')"><c:if test="${packet.otpRequired}"><form method="post" action="${guaranteesPath}/${offer.id}/code"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input type="hidden" name="packetHash" value="${offer.hash}"/><button class="app-btn btn-neutral" type="submit" ${packet.signatureReady?'':'disabled'}><spring:message code="group.requestCode"/></button></form></c:if><form method="post" action="${guaranteesPath}/${offer.id}/accept" class="accounting-create-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input type="hidden" name="packetHash" value="${offer.hash}"/><section class="accounting-form accounting-create-card"><h2><spring:message code="personalGuarantee.accept"/></h2><div class="erp-panel-body"><c:if test="${packet.otpRequired}"><label><spring:message code="group.otpCode"/><input class="aws-control" name="otpCode" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required/></label></c:if><label class="aws-settings-checkbox-row"><input class="aws-settings-checkbox" type="checkbox" name="accepted" value="true" required/><span class="aws-settings-checkbox-copy"><spring:message code="personalGuarantee.acceptance"/></span></label><c:if test="${not packet.signatureReady}"><p role="status"><spring:message code="group.error.signature"/></p></c:if></div></section><div class="accounting-actions"><button class="app-btn btn-launch" type="submit" ${packet.signatureReady?'':'disabled'}><spring:message code="personalGuarantee.accept"/></button></div></form></sec:authorize><sec:authorize access="@access.has(principal,'GUARANTOR_REQUESTS_REJECT')"><form method="post" action="${guaranteesPath}/${offer.id}/refuse" class="accounting-create-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input type="hidden" name="packetHash" value="${offer.hash}"/><section class="accounting-form accounting-create-card"><h2><spring:message code="personalGuarantee.refuse"/></h2><label class="erp-panel-body"><spring:message code="group.reason"/><input class="aws-control" name="reason" maxlength="500" required/></label></section><div class="accounting-actions"><button class="app-btn btn-neutral" type="submit"><spring:message code="personalGuarantee.refuse"/></button></div></form></sec:authorize></c:if></c:otherwise></c:choose></div><%@ include file="../fragments/footer.jspf" %>
