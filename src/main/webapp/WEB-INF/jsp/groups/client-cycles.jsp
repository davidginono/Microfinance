<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<div class="erp-page-header"><h1 class="erp-page-title" id="client-group-title"><spring:message code="group.clientLoans" /></h1></div>
<section class="erp-table-wrap" data-resource-table="client-group-loans" data-table-title-id="client-group-title"><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-order="group"><spring:message code="group.name" /></th><th data-table-order="date"><spring:message code="group.submittedAt" /></th><th data-table-order="state"><spring:message code="group.status" /></th><th data-table-order="accepted"><spring:message code="group.consent" /></th></tr></thead><tbody><c:forEach items="${packets.rows}" var="packet"><tr><td><a class="resource-table-id-link" href="<c:url value='/app/group-loans/${packet.id}${packet.payoutOnly?"/organization-payout":packet.model=="ORGANIZATION"?"/organization-agreement":""}' />"><c:out value="${packet.group}" /></a></td><td><c:out value="${appTime:display(packet.submittedAt)}" /></td><td><spring:message code="group.cycleState.${packet.state}" /></td><td><spring:message code="${packet.payoutOnly?(packet.accepted?'orgPayout.confirmed':'orgPayout.pending'):packet.accepted?(packet.model=='ORGANIZATION'?'orgAgreement.signed':'group.accepted'):packet.state=='CANCELLED'?'group.notSigned':'group.awaitingConsent'}" /></td></tr></c:forEach><c:if test="${empty packets.rows}"><tr><td colspan="4"><spring:message code="group.cycles.empty" /></td></tr></c:if></tbody></table></div><div data-table-pagination data-page="${packets.page}" data-table-for="client-group-loans"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?packets.page>0:packets.hasNext}"><c:url value="/app/group-loans" var="pageUrl"><c:param name="page" value="${packets.page+step}" /></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}' />"><spring:message code="${step==-1?'common.previous':'common.next'}" /></a></c:if></c:forEach></div></section><%@ include file="../fragments/footer.jspf" %>
