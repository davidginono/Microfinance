<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %><link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css'/>"/>
<c:set var="source" value="${workspace.source}"/><c:url value="/finance/groups/cycles/${source.cycle}/personal-guarantees" var="guaranteesPath"/>
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb'/>"><a class="erp-page-path__link" href="<c:url value='/finance/groups/cycles/${source.cycle}'/>"><spring:message code="group.cycle"/></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="personalGuarantee.title"/></span></nav><div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="personalGuarantee.title"/></h1><c:if test="${source.status=='AWAITING_GUARANTORS' and source.required>0}"><sec:authorize access="@access.has(principal,'GROUP_LENDING_UPDATE') and @access.has(principal,'LOAN_RECORDING_CREATE')"><a class="app-btn btn-launch" href="${guaranteesPath}/new"><spring:message code="personalGuarantee.create"/></a></sec:authorize></c:if></div>
<div class="accounting-workspace"><%@ include file="personal-guarantee-source.jspf" %><section class="erp-resource-section"><h2><spring:message code="personalGuarantee.required"/></h2><p><c:out value="${source.required}"/></p><c:if test="${source.status=='AWAITING_GUARANTORS'}"><sec:authorize access="@access.has(principal,'GROUP_LENDING_SUBMIT') and @access.has(principal,'GROUP_LENDING_UPDATE') and @access.has(principal,'LOAN_RECORDING_CREATE')"><form method="post" action="${guaranteesPath}/review"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><button class="app-btn btn-launch" type="submit" ${workspace.ready?'':'disabled'}><spring:message code="personalGuarantee.startReview"/></button></form></sec:authorize></c:if></section>
<section class="erp-table-wrap" data-resource-table="personal-guarantees"><h2><spring:message code="personalGuarantee.title"/></h2><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="server-guarantee-history"><thead><tr><th scope="col"><spring:message code="personalGuarantee.code"/></th><th scope="col"><spring:message code="personalGuarantee.guarantor"/></th><th scope="col"><spring:message code="personalGuarantee.cap"/> (TZS)</th><th scope="col"><spring:message code="group.status"/></th><th scope="col"><spring:message code="personalGuarantee.date"/></th></tr></thead><tbody><c:forEach items="${workspace.offers.rows}" var="row"><tr><td><a class="resource-table-id-link" href="${guaranteesPath}/${row.id}"><c:out value="${row.code}"/></a></td><td><c:out value="${row.number}"/> · <c:out value="${row.name}"/></td><td><fmt:formatNumber value="${row.cap}" minFractionDigits="2" maxFractionDigits="2"/></td><td><spring:message code="personalGuarantee.state.${row.state}"/></td><td><c:out value="${empty row.decidedAt?'—':appTime:display(row.decidedAt)}"/></td></tr></c:forEach><c:if test="${empty workspace.offers.rows}"><tr><td colspan="5"><spring:message code="personalGuarantee.empty"/></td></tr></c:if></tbody></table></div><div data-table-pagination data-table-for="personal-guarantees" data-page="${workspace.offers.page}"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?workspace.offers.page>0:workspace.offers.hasNext}"><c:url value="${guaranteesPath}" var="pageUrl"><c:param name="page" value="${workspace.offers.page+step}"/></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div></section></div><%@ include file="../fragments/footer.jspf" %>
