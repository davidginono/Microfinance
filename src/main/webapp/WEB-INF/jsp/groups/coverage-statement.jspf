<c:if test="${not empty statement.coverage}"><section class="erp-table-wrap" data-resource-table="statement-coverage"><h2><spring:message code="coverage.title"/></h2><p><spring:message code="coverage.statementNote"/></p><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="immutable-case-history"><thead><tr><c:forEach items="${['group.loan','coverage.person','coverage.kind','group.status','coverage.called','coverage.requested','coverage.received','coverage.unpaid']}" var="label"><th scope="col"><spring:message code="${label}"/></th></c:forEach></tr></thead><tbody><c:forEach items="${statement.coverage.rows}" var="row"><tr><td><a class="resource-table-id-link" href="<c:url value='${statement.coverage.own?"/app/group-coverage":"/finance/groups/coverage"}/${row.id}'/>"><c:out value="${row.loanNumber}"/> · <c:out value="${appTime:display(row.callDate)}"/></a></td><td><c:out value="${row.number}"/> · <c:out value="${row.name}"/></td><td><spring:message code="coverage.kind.${row.sourceKind}"/></td><td><spring:message code="coverage.state.${row.state}"/></td><td><c:out value="${appTime:display(row.callDate)}"/></td><c:forEach items="${['requested','received','unpaid']}" var="field"><td><c:choose><c:when test="${not empty row[field]}"><fmt:formatNumber value="${row[field]}" minFractionDigits="2" maxFractionDigits="2"/></c:when><c:otherwise>—</c:otherwise></c:choose></td></c:forEach></tr></c:forEach><c:if test="${empty statement.coverage.rows}"><tr><td colspan="8"><spring:message code="coverage.empty"/></td></tr></c:if></tbody></table></div><div data-table-pagination data-table-for="statement-coverage" data-page="${statement.coverage.page}"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?statement.coverage.page>0:statement.coverage.hasNext}"><c:url value="${statementPath}" var="pageUrl"><c:param name="from" value="${statement.from}"/><c:param name="through" value="${statement.through}"/><c:param name="coveragePage" value="${statement.coverage.page+step}"/><c:param name="page" value="${statement.page}"/><c:param name="loanPage" value="${statement.loanPage}"/><c:param name="contributionPage" value="${statement.contributionPage}"/><c:param name="allocationPage" value="${statement.allocationPage}"/></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div></section></c:if>
