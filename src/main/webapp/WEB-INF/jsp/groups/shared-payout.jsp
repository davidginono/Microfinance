<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<nav class="erp-page-path"><a href="<c:url value='/app/group-loans/${packet.row.cycle}' />"><spring:message code="group.sharedFacility" /></a><span>›</span><span aria-current="page"><spring:message code="sharedAgreement.title" /></span></nav><div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="sharedAgreement.title" /></h1></div>
<c:if test="${packet.row.state=='CANCELLED'}"><p role="status"><spring:message code="group.endedDisclosure" /></p></c:if>
<c:if test="${not empty consentError}"><p role="alert" class="coa-error"><spring:message code="${consentError}" /></p></c:if><c:if test="${consentCodeSent}"><p role="status"><spring:message code="group.otpSent" /></p></c:if>
<section class="erp-resource-section"><h2><spring:message code="group.sharedObligation" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.loan" /></dt><dd><c:out value="${packet.row.number}" /></dd></div><div><dt><spring:message code="group.sharedLiability" /></dt><dd><spring:message code="group.sharedLiability.${packet.row.obligation.liability}" /></dd></div><div><dt><spring:message code="group.sharedCap" /> (TZS)</dt><dd><c:out value="${packet.row.obligation.cap}" /></dd></div><div><dt><spring:message code="group.shared.net" /> (TZS)</dt><dd><c:out value="${packet.row.obligation.allocation.net}" /></dd></div><c:if test="${packet.row.destination.available}"><div><dt><spring:message code="voucher.moneyAccount" /></dt><dd><c:out value="${packet.row.destination.provider}" /> · <c:out value="${packet.row.destination.accountHolderName}" /> · <c:out value="${packet.row.destination.accountIdentifier}" /></dd></div></c:if></dl><p><spring:message code="group.sharedDisclosure.${packet.row.obligation.liability}" /></p><p><spring:message code="sharedAgreement.repaymentRule" /></p></section>
<c:choose><c:when test="${empty packet.row.document}"><p role="status"><spring:message code="group.error.documentRequired" /></p></c:when><c:when test="${not packet.row.destination.available}"><p role="alert"><spring:message code="group.error.sharedDestination" /></p><a class="app-btn btn-neutral" href="<c:url value='/app/settings?section=payment-details' />"><spring:message code="sharedAgreement.updateDestination" /></a></c:when><c:otherwise><section class="erp-resource-section"><h2><spring:message code="orgDocument.title" /></h2><a class="app-btn btn-neutral" href="<c:url value='/app/group-loans/${packet.row.cycle}/payout/pdf' />"><spring:message code="voucher.pdf" /></a><c:if test="${not packet.row.opened}"><p><spring:message code="group.error.sharedReadDocument" /></p></c:if></section></c:otherwise></c:choose>
<c:choose><c:when test="${not empty packet.row.confirmation}"><section class="erp-resource-section"><h2><spring:message code="sharedAgreement.signed" /></h2><p><c:out value="${appTime:display(packet.row.confirmation.at)}" /></p></section></c:when><c:when test="${packet.row.state=='SUBMITTED'}"><sec:authorize access="@access.has(principal,'MEMBER_LOANS_UPDATE')">
<c:if test="${packet.otpRequired and packet.canConfirm()}"><form method="post" action="<c:url value='/app/group-loans/${packet.row.cycle}/payout/code' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="packetHash" value="<c:out value='${packet.row.hash}' />" /><button class="app-btn btn-neutral"><spring:message code="group.requestCode" /></button></form></c:if>
<form method="post" action="<c:url value='/app/group-loans/${packet.row.cycle}/payout/confirm' />" class="accounting-create-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="packetHash" value="<c:out value='${packet.row.hash}' />" /><section class="accounting-form accounting-create-card"><h2><spring:message code="group.signatureTitle" /></h2><div class="erp-panel-body"><c:if test="${not packet.row.consented}"><p role="alert"><spring:message code="sharedAgreement.baseConsent" /></p></c:if><c:if test="${not packet.signatureReady}"><p role="alert"><spring:message code="group.error.signature" /></p></c:if><c:if test="${packet.otpRequired}"><label><spring:message code="group.otpCode" /><input name="otpCode" class="aws-control" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required /></label></c:if><label class="aws-settings-checkbox-row"><input name="accepted" type="checkbox" value="true" class="aws-settings-checkbox" required /><span class="aws-settings-checkbox-copy"><spring:message code="sharedAgreement.accept" /></span></label></div></section><div class="accounting-actions accounting-form-actions"><button class="app-btn btn-launch" ${packet.canConfirm()?'':'disabled'}><spring:message code="group.accept" /></button></div></form></sec:authorize></c:when></c:choose>
<%@ include file="../fragments/footer.jspf" %>
