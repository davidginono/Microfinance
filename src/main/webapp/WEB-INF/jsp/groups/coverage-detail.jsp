<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %><link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css'/>"/>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="coverage.case"/></h1></div><div class="accounting-workspace"><%@ include file="coverage-context.jspf" %><div class="accounting-actions"><c:if test="${coverageActions.contains('EXPORT')}"><a class="app-btn btn-neutral" href="${casePath}/notice"><spring:message code="coverage.noticePdf"/></a><a class="app-btn btn-neutral" href="${casePath}/pdf"><spring:message code="coverage.pdf"/></a><a class="app-btn btn-neutral" href="${casePath}/print" target="_blank" rel="noopener"><spring:message code="common.print"/></a></c:if><c:if test="${coverage.staff and coverageActions.contains('LINK')}"><a class="app-btn btn-neutral" href="${casePath}/payments"><spring:message code="coverage.link"/></a></c:if></div><section class="erp-table-wrap" data-resource-table="coverage-events"><h2><spring:message code="coverage.responses"/></h2><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="immutable-evidence-history"><thead><tr><th scope="col"><spring:message code="coverage.sequence"/></th><th scope="col"><spring:message code="group.status"/></th><th scope="col"><spring:message code="voucher.amount"/></th><th scope="col"><spring:message code="coverage.promiseDate"/></th><th scope="col"><spring:message code="group.reason"/></th><th scope="col"><spring:message code="voucher.date"/></th></tr></thead><tbody><c:forEach items="${coverage.events.rows}" var="row"><tr><td><c:out value="${row.sequence}"/></td><td><spring:message code="coverage.state.${row.kind}"/></td><td><fmt:formatNumber value="${row.amount}" minFractionDigits="2" maxFractionDigits="2"/></td><td><c:out value="${empty row.promiseOn?'—':appTime:display(row.promiseOn)}"/></td><td><c:out value="${row.reason}"/></td><td><c:out value="${appTime:display(row.at)}"/></td></tr></c:forEach><c:if test="${empty coverage.events.rows}"><tr><td colspan="6"><spring:message code="coverage.empty"/></td></tr></c:if></tbody></table></div><div data-table-pagination data-table-for="coverage-events" data-page="${coverage.events.page}"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?coverage.events.page>0:coverage.events.hasNext}"><c:url value="${casePath}" var="pageUrl"><c:param name="eventPage" value="${coverage.events.page+step}"/><c:param name="paymentPage" value="${coverage.payments.page}"/></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div></section>
<section class="erp-table-wrap" data-resource-table="coverage-payments"><h2><spring:message code="coverage.payments"/></h2><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="immutable-evidence-history"><thead><tr><th scope="col"><spring:message code="memberStatement.reference"/></th><th scope="col"><spring:message code="voucher.date"/></th><th scope="col"><spring:message code="group.payer"/></th><th scope="col"><spring:message code="voucher.amount"/></th><th scope="col"><spring:message code="recording.principal"/></th><th scope="col"><spring:message code="recording.interest"/></th><th scope="col"><spring:message code="charges.title"/></th><th scope="col"><spring:message code="coverage.net"/></th><th scope="col"><spring:message code="coverage.correction"/></th></tr></thead><tbody><c:forEach items="${coverage.payments.rows}" var="row"><tr><td><c:out value="${row.reference}"/></td><td><c:out value="${appTime:display(row.date)}"/></td><td><c:out value="${row.payer}"/></td><td><fmt:formatNumber value="${row.amount}" minFractionDigits="2" maxFractionDigits="2"/></td><td><fmt:formatNumber value="${row.principal}" minFractionDigits="2" maxFractionDigits="2"/></td><td><fmt:formatNumber value="${row.interest}" minFractionDigits="2" maxFractionDigits="2"/></td><td><fmt:formatNumber value="${row.charges}" minFractionDigits="2" maxFractionDigits="2"/></td><td><fmt:formatNumber value="${row.net}" minFractionDigits="2" maxFractionDigits="2"/></td><td><c:if test="${not empty row.reversedBy}"><spring:message code="coverage.receiptReversed"/> <c:out value="${row.reversedBy}"/></c:if><c:if test="${not empty row.correctedBy}"><spring:message code="coverage.linkCorrected"/> <c:out value="${row.correctedBy}"/></c:if></td></tr></c:forEach><c:if test="${empty coverage.payments.rows}"><tr><td colspan="9"><spring:message code="coverage.empty"/></td></tr></c:if></tbody></table></div><div data-table-pagination data-table-for="coverage-payments" data-page="${coverage.payments.page}"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?coverage.payments.page>0:coverage.payments.hasNext}"><c:url value="${casePath}" var="pageUrl"><c:param name="eventPage" value="${coverage.events.page}"/><c:param name="paymentPage" value="${coverage.payments.page+step}"/></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div></section>
<c:if test="${coverage.staff and coverageActions.contains('REVERSE') and not empty coverage.payments.rows}"><form method="post" action="${casePath}/correct" class="accounting-create-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input type="hidden" name="requestKey" value="${empty correctionKey?coverageResponse.requestKey:correctionKey}"/><section class="accounting-form accounting-create-card"><h2><spring:message code="coverage.correct"/></h2><div class="accounting-grid erp-panel-body"><label><spring:message code="coverage.payments"/><select class="aws-control" name="payment" required><option value=""><spring:message code="voucher.choose"/></option><c:forEach items="${coverage.payments.rows}" var="row"><c:if test="${empty row.correctedBy}"><option value="${row.id}" ${correctionPayment==row.id?'selected':''}><c:out value="${row.reference}"/> / <fmt:formatNumber value="${row.amount}" minFractionDigits="2" maxFractionDigits="2"/></option></c:if></c:forEach></select></label><label><spring:message code="group.reason"/><input name="reason" class="aws-control" maxlength="500" value="<c:out value='${correctionReason}'/>" required/></label><p><spring:message code="coverage.correctNote"/></p><c:if test="${not empty coverageError}"><p role="alert"><spring:message code="${coverageError}"/></p></c:if><button class="app-btn btn-neutral" type="submit"><spring:message code="coverage.correct"/></button></div></section>
</form></c:if><c:if test="${coverage.staff?coverageActions.contains('UPDATE'):coverageActions.contains('RESPOND')}"><c:if test="${caseRecord.state!='CANCELLED' and caseRecord.state!='CLOSED'}"><form:form modelAttribute="coverageResponse" action="${casePath}/${coverage.staff?'close':'respond'}" method="post" cssClass="accounting-create-form" data-preserve-submit-command="true"><form:hidden path="requestKey"/><form:hidden path="expectedSequence"/><section class="accounting-form accounting-create-card"><h2><spring:message code="coverage.respond"/></h2><div class="accounting-grid erp-panel-body"><label><spring:message code="group.status"/><form:select path="kind" cssClass="aws-control"><option value=""><spring:message code="voucher.choose"/></option><c:forEach items="${coverage.staff?['CLOSED','CANCELLED']:['ACKNOWLEDGED','PROMISED','DISPUTED']}" var="kind"><form:option value="${kind}"><spring:message code="coverage.state.${kind}"/></form:option></c:forEach></form:select></label><c:if test="${not coverage.staff}"><label><spring:message code="coverage.promiseAmount"/><form:input path="amount" type="number" cssClass="aws-control" min="0.01" step="0.01"/><form:errors path="amount" cssClass="coa-error"/></label><label><spring:message code="coverage.promiseDate"/><form:input path="promiseOn" type="date" cssClass="aws-control" /><form:errors path="promiseOn" cssClass="coa-error"/></label><p><spring:message code="coverage.promiseNote"/></p></c:if><label><spring:message code="group.reason"/><form:input path="reason" type="text" cssClass="aws-control" maxlength="500"/><form:errors path="reason" cssClass="coa-error"/></label><label class="aws-settings-checkbox-row"><form:checkbox path="confirmed" cssClass="aws-settings-checkbox" required="required"/><span><spring:message code="coverage.confirmResponse"/></span></label></div></section>
<div role="alert"><form:errors path="" element="p" cssClass="coa-error"/></div><div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" href="${casePath}"><spring:message code="common.cancel"/></a><button class="app-btn btn-launch" type="submit"><spring:message code="coverage.respond"/></button></div></form:form></c:if></c:if></div><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
