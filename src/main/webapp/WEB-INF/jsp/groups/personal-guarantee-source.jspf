<section class="erp-resource-section"><h2><spring:message code="group.summary"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.loan"/></dt><dd><c:out value="${source.number}"/></dd></div><div><dt><spring:message code="personalGuarantee.borrower"/></dt><dd><c:out value="${source.borrower}"/></dd></div><div><dt><spring:message code="group.model"/></dt><dd><spring:message code="group.model.${source.model}"/></dd></div><div><dt><spring:message code="group.status"/></dt><dd><spring:message code="recording.status.${source.status}"/></dd></div><c:forEach items="${['principal','interest','charges','cap','installment']}" var="field"><div><dt><spring:message code="personalGuarantee.${field}"/> (TZS)</dt><dd><fmt:formatNumber value="${source[field]}" minFractionDigits="2" maxFractionDigits="2"/></dd></div></c:forEach><div><dt><spring:message code="recording.rate"/></dt><dd><fmt:formatNumber value="${source.ratePercent()}" maxFractionDigits="6"/>% · <spring:message code="recording.basis.${source.basis}"/></dd></div><div><dt><spring:message code="recording.method"/></dt><dd><spring:message code="recording.method.${source.method}"/></dd></div><div><dt><spring:message code="recording.frequency"/></dt><dd><spring:message code="recording.frequency.${source.frequency}"/></dd></div><div><dt><spring:message code="personalGuarantee.firstDate"/></dt><dd><c:out value="${appTime:display(source.firstDue)}"/></dd></div></dl><p><spring:message code="personalGuarantee.capNote"/></p></section>