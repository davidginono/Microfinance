<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %><link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css'/>"/>
<div class="erp-page-header"><h1 class="erp-page-title" id="personal-guarantees-title"><spring:message code="personalGuarantee.menu"/></h1></div><section class="erp-table-wrap" data-resource-table="my-group-guarantees" data-table-title-id="personal-guarantees-title"><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="server-guarantee-history"><thead><tr><th scope="col"><spring:message code="personalGuarantee.code"/></th><th scope="col"><spring:message code="group.loan"/></th><th scope="col"><spring:message code="personalGuarantee.borrower"/></th><th scope="col"><spring:message code="personalGuarantee.cap"/> (TZS)</th><th scope="col"><spring:message code="group.status"/></th></tr></thead><tbody><c:forEach items="${guarantees.rows}" var="row"><tr><td><a class="resource-table-id-link" href="<c:url value='/app/group-guarantees/${row.id}'/>"><c:out value="${row.code}"/></a></td><td><c:out value="${row.loanNumber}"/></td><td><c:out value="${row.borrower}"/></td><td><fmt:formatNumber value="${row.cap}" minFractionDigits="2" maxFractionDigits="2"/></td><td><spring:message code="personalGuarantee.state.${row.state}"/></td></tr></c:forEach><c:if test="${empty guarantees.rows}"><tr><td colspan="5"><spring:message code="personalGuarantee.empty"/></td></tr></c:if></tbody></table></div><div data-table-pagination data-table-for="my-group-guarantees" data-page="${guarantees.page}"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?guarantees.page>0:guarantees.hasNext}"><c:url value="/app/group-guarantees" var="pageUrl"><c:param name="page" value="${guarantees.page+step}"/></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div></section><%@ include file="../fragments/footer.jspf" %>
