<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb' />"><a class="erp-page-path__link" href="<c:url value='/finance/groups/cycles/${groupCycle.id}' />"><spring:message code="group.cycle" /></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="group.receive" /></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="group.receive" /></h1></div>
<div class="accounting-workspace accounting-create-workspace"><c:url value="/finance/groups/cycles/${groupCycle.id}/receipts" var="saveUrl" /><c:url value="/finance/groups/cycles/${groupCycle.id}/receipts/choices/loans" var="loanChoices" /><c:url value="/finance/groups/cycles/${groupCycle.id}/receipts/choices/payers" var="payerChoices" /><c:url value="/finance/loan-recording/choices/money" var="moneyChoices" />
<form:form modelAttribute="collectionForm" action="${saveUrl}" method="post" cssClass="accounting-create-form" data-preserve-submit-command="true" data-unsaved-financial-form="${pageContext.request.method=='POST'}" data-group-collection="true"><form:hidden path="requestKey" /><form:hidden path="previewHash" />
<div class="accounting-error-summary" role="alert" tabindex="-1"><form:errors path="*" element="p" cssClass="coa-error" /></div>
<section class="accounting-form accounting-create-card"><h2><spring:message code="group.collection" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.name" /></dt><dd><c:out value="${groupCycle.groupName}" /></dd></div><c:if test="${not empty receiptNumber}"><div><dt><spring:message code="voucher.print.number" /></dt><dd><c:out value="${receiptNumber}" /></dd></div></c:if></dl><div class="accounting-grid">
<label><spring:message code="voucher.date" /><input type="date" name="effectiveDate" class="aws-control" value="<c:out value='${collectionForm.effectiveDate}' />" /></label>
<label><spring:message code="group.remitter" /><form:input path="remitter" maxlength="255" cssClass="aws-control" /></label><label><spring:message code="voucher.reference" /><form:input path="reference" maxlength="76" cssClass="aws-control" /></label>
<div data-loan-choice data-choice-url="${moneyChoices}"><label for="group-money"><spring:message code="voucher.moneyAccount" /></label><form:select path="moneyAccountId" id="group-money" cssClass="aws-control" data-choice-select="true" data-searchable="true"><option value=""><spring:message code="voucher.choose" /></option><c:if test="${not empty collectionForm.moneyAccountId}"><option value="${collectionForm.moneyAccountId}" selected><c:out value="${labels[collectionForm.moneyAccountId]}" /></option></c:if></form:select><%@ include file="../accounting/loans/choice-search.jspf" %></div>
<label><spring:message code="voucher.evidence" /><form:input path="evidence" maxlength="500" cssClass="aws-control" /></label></div></section>
<c:forEach items="${collectionForm.rows}" var="row" varStatus="s"><section class="accounting-form accounting-create-card"><h2><spring:message code="group.contribution" /> <c:out value="${s.count}" /></h2><div class="accounting-grid">
<div data-loan-choice data-choice-url="${payerChoices}"><label for="group-payer-${s.index}"><spring:message code="group.payer" /></label><form:select path="rows[${s.index}].payerId" id="group-payer-${s.index}" cssClass="aws-control" data-choice-select="true" data-searchable="true"><option value=""><spring:message code="voucher.choose" /></option><c:if test="${not empty row.payerId}"><option value="${row.payerId}" selected><c:out value="${labels[row.payerId]}" /></option></c:if></form:select><%@ include file="../accounting/loans/choice-search.jspf" %></div>
<div data-loan-choice data-choice-url="${loanChoices}"><label for="group-loan-${s.index}"><spring:message code="group.paidFor" /></label><form:select path="rows[${s.index}].loanId" id="group-loan-${s.index}" cssClass="aws-control" data-choice-select="true" data-searchable="true"><option value=""><spring:message code="voucher.choose" /></option><c:if test="${not empty row.loanId}"><option value="${row.loanId}" selected><c:out value="${labels[row.loanId]}" /></option></c:if></form:select><%@ include file="../accounting/loans/choice-search.jspf" %></div>
<label><spring:message code="group.chargeAmount" /><form:input path="rows[${s.index}].amount" type="number" min="0.01" step="0.01" cssClass="aws-control" /></label><label><spring:message code="voucher.description" /><form:input path="rows[${s.index}].description" maxlength="500" cssClass="aws-control" /></label>
<button type="submit" name="action" value="removeRow:${s.index}" class="app-btn btn-neutral" formnovalidate><spring:message code="group.remove" /></button></div></section></c:forEach>
<div class="accounting-actions"><button type="submit" name="action" value="addRow" class="app-btn btn-neutral" formnovalidate ${collectionForm.rows.size()>=50?'disabled':''}><spring:message code="group.addContribution" /></button></div>
<c:if test="${not empty preview}"><section class="erp-resource-section" data-collection-preview><h2><spring:message code="group.collectionPreview" /></h2><p><spring:message code="group.contributionOrder" /></p><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="group.payer" /></th><th><spring:message code="group.paidFor" /></th><th><spring:message code="group.loan" /></th><th><spring:message code="recording.principal" /> (TZS)</th><th><spring:message code="recording.interest" /> (TZS)</th><th><spring:message code="charges.title" /> (TZS)</th><th><spring:message code="voucher.amount" /> (TZS)</th></tr></thead><tbody><c:forEach items="${preview.contributions}" var="row"><tr><td><c:out value="${row.payerNumber}" /> · <c:out value="${row.payer}" /></td><td><c:out value="${row.beneficiaryNumber}" /> · <c:out value="${row.beneficiary}" /></td><td><a class="resource-table-id-link" href="<c:url value='/finance/loan-records/${row.loanId}' />"><c:out value="${row.loanNumber}" /></a></td><c:forEach items="${['principal','interest','charges','amount']}" var="field"><td><fmt:formatNumber value="${row[field]}" minFractionDigits="2" maxFractionDigits="2" /></td></c:forEach></tr></c:forEach></tbody></table></div><p><strong><spring:message code="voucher.total" /> (TZS): <fmt:formatNumber value="${preview.total}" minFractionDigits="2" maxFractionDigits="2" /></strong></p></section></c:if>
<div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/cycles/${groupCycle.id}' />"><spring:message code="common.cancel" /></a><button type="submit" name="action" value="preview" class="app-btn btn-neutral"><spring:message code="voucher.preview" /></button><c:if test="${not empty preview}"><button type="submit" name="action" value="post" class="app-btn btn-launch" data-collection-post><spring:message code="group.postReceipt" /></button></c:if></div>
</form:form></div><script src="<c:url value='/js/loan-recording.js' />" defer></script><script src="<c:url value='/js/group-collections.js' />" defer></script><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
