<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %><link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css'/>"/>
<c:set var="caseBase" value="${ownCoverage?'/app/group-coverage':'/finance/groups/coverage'}"/>
<div class="accounting-workspace">
<c:if test="${not ownCoverage}"><nav class="erp-page-path"><a href="<c:url value='/finance/groups/cycles/${cycle}'/>"><spring:message code="group.cycle"/></a><span aria-hidden="true">›</span><span><spring:message code="coverage.title"/></span></nav><c:if test="${coverageActions.contains('CONFIGURE')}"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/coverage/policy?cycle=${cycle}'/>"><spring:message code="coverage.policy"/></a></c:if><section class="erp-resource-section"><h2><spring:message code="coverage.policy"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="coverage.reference"/></dt><dd><c:out value="${policy.reference}"/></dd></div><div><dt><spring:message code="coverage.noticeDays"/></dt><dd><c:out value="${policy.noticeDays}"/></dd></div></dl><c:if test="${empty policy or not policy.enabled}"><p role="status"><spring:message code="coverage.error.policy"/></p></c:if></section>
<c:if test="${coverageActions.contains('CREATE') and not empty policy and policy.enabled}"><form method="get" action="<c:url value='/finance/groups/coverage/new'/>" class="accounting-create-form"><input type="hidden" name="cycle" value="${cycle}"/><section class="accounting-form accounting-create-card"><h2><spring:message code="coverage.create"/></h2><div class="accounting-grid erp-panel-body"><label><spring:message code="coverage.obligation"/><select class="aws-control" name="source" required><option value=""><spring:message code="voucher.choose"/></option><c:forEach items="${sources.rows}" var="row"><option value="${row.kind}/${row.id}"><c:out value="${row.number}"/> · <c:out value="${row.name}"/> / <c:out value="${row.loanNumber}"/> / <spring:message code="coverage.kind.${row.kind}"/></option></c:forEach></select></label><button class="app-btn btn-launch" type="submit"><spring:message code="coverage.create"/></button></div></section>
</form></c:if><section class="erp-table-wrap" data-resource-table="coverage-obligations" data-table-page-param="sourcePage"><h2><spring:message code="coverage.obligations"/></h2><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-order="loan" scope="col"><spring:message code="group.loan"/></th><th data-table-order="person" scope="col"><spring:message code="coverage.person"/></th><th data-table-order="kind" scope="col"><spring:message code="coverage.kind"/></th><th data-table-order="cap" scope="col"><spring:message code="coverage.cap"/></th><th data-table-order="arrears" scope="col"><spring:message code="coverage.arrears"/></th></tr></thead><tbody><c:forEach items="${sources.rows}" var="row"><tr><td><c:out value="${row.loanNumber}"/></td><td><c:out value="${row.number}"/> · <c:out value="${row.name}"/></td><td><spring:message code="coverage.kind.${row.kind}"/></td><td><fmt:formatNumber value="${row.cap}" minFractionDigits="2" maxFractionDigits="2"/></td><td><c:choose><c:when test="${row.known}"><fmt:formatNumber value="${row.arrears}" minFractionDigits="2" maxFractionDigits="2"/></c:when><c:otherwise><spring:message code="coverage.unavailable"/></c:otherwise></c:choose></td></tr></c:forEach><c:if test="${empty sources.rows}"><tr><td colspan="5"><spring:message code="coverage.empty"/></td></tr></c:if></tbody></table></div><div data-table-pagination data-table-for="coverage-obligations" data-page="${sources.page}"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?sources.page>0:sources.hasNext}"><c:url value="${caseBase}" var="pageUrl"><c:param name="cycle" value="${cycle}"/><c:param name="sourcePage" value="${sources.page+step}"/><c:param name="page" value="${cases.page}"/></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div></section>
</c:if><section class="erp-table-wrap" data-resource-table="coverage-cases"><h2><spring:message code="coverage.title"/></h2><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-order="loan" scope="col"><spring:message code="group.loan"/></th><th data-table-order="person" scope="col"><spring:message code="coverage.person"/></th><th data-table-order="kind" scope="col"><spring:message code="coverage.kind"/></th><th data-table-order="date" scope="col"><spring:message code="coverage.called"/></th><th data-table-order="amount" scope="col"><spring:message code="coverage.requested"/></th><th data-table-order="received" scope="col"><spring:message code="coverage.received"/></th><th data-table-order="state" scope="col"><spring:message code="group.status"/></th></tr></thead><tbody><c:forEach items="${cases.rows}" var="row"><tr><td><a class="resource-table-id-link" href="<c:url value='${caseBase}/${row.id}'/>"><c:out value="${row.loanNumber}"/> · <c:out value="${appTime:display(row.callDate)}"/></a></td><td><c:out value="${row.number}"/> · <c:out value="${row.name}"/></td><td><spring:message code="coverage.kind.${row.sourceKind}"/></td><td><c:out value="${appTime:display(row.callDate)}"/></td><td><fmt:formatNumber value="${row.requested}" minFractionDigits="2" maxFractionDigits="2"/></td><td><fmt:formatNumber value="${row.received}" minFractionDigits="2" maxFractionDigits="2"/></td><td><spring:message code="coverage.state.${row.state}"/></td></tr></c:forEach><c:if test="${empty cases.rows}"><tr><td colspan="7"><spring:message code="coverage.empty"/></td></tr></c:if></tbody></table></div><div data-table-pagination data-table-for="coverage-cases" data-page="${cases.page}"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?cases.page>0:cases.hasNext}"><c:url value="${caseBase}" var="pageUrl"><c:param name="cycle" value="${ownCoverage?null:cycle}"/><c:param name="page" value="${cases.page+step}"/><c:param name="sourcePage" value="${ownCoverage?null:sources.page}"/></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div></section>
</div><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
