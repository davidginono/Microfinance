<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb' />"><a class="erp-page-path__link" href="<c:url value='/finance/groups/${group.id}/cycles' />"><spring:message code="group.cycles" /></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="group.prepareCycle" /></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="group.prepareCycle" /></h1></div><div class="accounting-workspace accounting-create-workspace">
<c:choose><c:when test="${empty cycle}"><c:url value="/finance/groups/${group.id}/cycles" var="saveUrl" /></c:when><c:otherwise><c:url value="/finance/groups/cycles/${cycle.id}" var="saveUrl" /></c:otherwise></c:choose><c:url value="/finance/groups/cycle-policies" var="policiesUrl" /><c:url value="/finance/groups/${group.id}/member-choices" var="membersUrl" />
<form:form modelAttribute="cycleForm" action="${saveUrl}" method="post" cssClass="accounting-create-form" data-preserve-submit-command="true"><form:hidden path="requestKey" /><form:hidden path="expectedVersion" />
<div class="accounting-error-summary" role="alert" tabindex="-1"><form:errors path="*" element="p" cssClass="coa-error" /></div>
<section class="accounting-form accounting-create-card"><h2><spring:message code="group.cycle" /></h2><div class="accounting-grid">
<div data-loan-choice data-choice-url="${policiesUrl}"><label for="cycle-policy"><spring:message code="group.productRules" /></label><form:select id="cycle-policy" path="policyId" cssClass="aws-control" data-choice-select="true" data-searchable="true" disabled="${not empty cycle}"><option value=""><spring:message code="voucher.choose" /></option><c:if test="${not empty selectedPolicy}"><option value="${selectedPolicy.id}" selected><c:out value="${selectedPolicy.product}" /> · <spring:message code="group.model.${selectedPolicy.model}" /></option></c:if></form:select><c:if test="${not empty cycle}"><form:hidden path="policyId" /></c:if><%@ include file="../accounting/loans/choice-search.jspf" %></div>
<label><spring:message code="group.applicationDate" /><input type="date" name="applicationDate" class="aws-control" value="<c:out value='${cycleForm.applicationDate}' />" /></label>
<label><spring:message code="group.firstPaymentDate" /><input type="date" name="firstPaymentDate" class="aws-control" value="<c:out value='${cycleForm.firstPaymentDate}' />" /></label>
<label><spring:message code="group.tenureUnit" /><form:select path="tenureUnit" cssClass="aws-control"><c:forEach items="${['DAYS','MONTHS','YEARS']}" var="unit"><form:option value="${unit}"><spring:message code="group.unit.${unit}" /></form:option></c:forEach></form:select></label>
<label><spring:message code="group.tenure" /><form:input path="tenureValue" type="number" min="1" cssClass="aws-control" /></label><label><spring:message code="group.purpose" /><form:input path="purpose" maxlength="500" cssClass="aws-control" /></label>
</div></section>
<c:if test="${not empty cycle}"><c:forEach items="${cycleForm.participants}" var="row" varStatus="s"><section class="accounting-form accounting-create-card"><h2><spring:message code="group.participant" /> <c:out value="${s.count}" /></h2><div class="accounting-grid">
<div data-loan-choice data-choice-url="${membersUrl}"><label for="participant-${s.index}"><spring:message code="group.client" /></label><form:select id="participant-${s.index}" path="participants[${s.index}].clientId" cssClass="aws-control" data-choice-select="true" data-searchable="true"><option value=""><spring:message code="voucher.choose" /></option><c:if test="${not empty memberLabels[row.clientId]}"><option value="${row.clientId}" selected><c:out value="${memberLabels[row.clientId]}" /></option></c:if></form:select><%@ include file="../accounting/loans/choice-search.jspf" %></div>
<c:forEach items="${cycle.model=='SHARED'?['principal','income','expenses','otherDebt']:['principal','income','expenses','otherDebt','guaranteeCapacity']}" var="field"><label><spring:message code="group.${field}" /><form:input path="participants[${s.index}].${field}" type="number" min="0" step="0.01" cssClass="aws-control" /></label></c:forEach>
<c:forEach items="${cycle.model=='SHARED'?['assessmentEvidence','collateral']:['assessmentEvidence','capacityEvidence','collateral']}" var="field"><label><spring:message code="group.${field}" /><form:input path="participants[${s.index}].${field}" maxlength="500" cssClass="aws-control" /></label></c:forEach>
<label><spring:message code="group.collateralValue" /><form:input path="participants[${s.index}].collateralValue" type="number" min="0" step="0.01" cssClass="aws-control" /></label>
<label><spring:message code="group.insurancePremium" /><form:input path="participants[${s.index}].insurancePremium" type="number" min="0" step="0.01" cssClass="aws-control" /></label><label><spring:message code="group.insuranceEvidence" /><form:input path="participants[${s.index}].insuranceEvidence" maxlength="500" cssClass="aws-control" /></label>
<button class="app-btn btn-neutral" type="submit" name="action" value="removeRow:${s.index}" formnovalidate><spring:message code="group.remove" /></button></div></section></c:forEach>
<div class="accounting-actions"><button class="app-btn btn-neutral" type="submit" name="action" value="addRow" formnovalidate ${cycleForm.participants.size()>=50?'disabled':''}><spring:message code="group.addParticipant" /></button></div></c:if>
<c:if test="${not empty sharedQuote}"><section class="accounting-form accounting-create-card"><h2><spring:message code="group.sharedQuote" /></h2><p><spring:message code="group.sharedEstimate" /></p><dl class="accounting-grid"><c:forEach items="${['principal','interest','charges','deductions','net','totalPayable']}" var="field"><div><dt><spring:message code="group.shared.${field}" /> (TZS)</dt><dd><fmt:formatNumber value="${sharedQuote[field]}" minFractionDigits="2" maxFractionDigits="2" /></dd></div></c:forEach></dl><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="editor"><thead><tr><th><spring:message code="group.client" /></th><c:forEach items="${['principal','interest','charges','deductions','net','monthlyPayment']}" var="field"><th><spring:message code="group.shared.${field}" /> (TZS)</th></c:forEach></tr></thead><tbody><c:forEach items="${sharedQuote.shares}" var="share"><tr><td><c:out value="${memberLabels[share.clientId]}" /></td><c:forEach items="${['principal','interest','charges','deductions','net','monthlyPayment']}" var="field"><td><fmt:formatNumber value="${share[field]}" minFractionDigits="2" maxFractionDigits="2" /></td></c:forEach></tr></c:forEach></tbody></table></div></section></c:if>
<div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/${group.id}/cycles' />"><spring:message code="common.cancel" /></a><button class="app-btn btn-neutral" type="submit" name="action" value="save"><spring:message code="group.saveDraft" /></button><c:if test="${cycle.model=='SHARED'}"><sec:authorize access="@access.has(principal,'GROUP_LENDING_UPDATE') and @access.has(principal,'LOAN_RECORDING_CREATE')"><button class="app-btn btn-neutral" type="submit" name="action" value="previewShared"><spring:message code="group.sharedQuote" /></button></sec:authorize></c:if><c:if test="${not empty cycle and cycle.model!='SHARED'}"><sec:authorize access="@access.has(principal,'GROUP_LENDING_SUBMIT')"><button class="app-btn btn-launch" type="submit" name="action" value="submit"><spring:message code="group.send" /></button></sec:authorize></c:if></div>
</form:form><c:if test="${not empty cycle}"><sec:authorize access="@access.has(principal,'GROUP_LENDING_SUBMIT')"><div class="accounting-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/cycles/${cycle.id}/withdraw' />"><spring:message code="group.withdraw" /></a></div></sec:authorize></c:if></div><script src="<c:url value='/js/loan-recording.js' />" defer></script><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
