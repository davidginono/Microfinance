<section class="erp-resource-section" data-detail-summary><h2><spring:message code="group.summary"/></h2><dl class="erp-detail-facts">
<div><dt><spring:message code="group.loan"/></dt><dd><c:choose><c:when test="${coverageStaff}"><a class="resource-table-id-link" href="<c:url value='/finance/loan-records/${caseHeader.loan}'/>"><c:out value="${caseHeader.loanNumber}"/></a></c:when><c:otherwise><c:out value="${caseHeader.loanNumber}"/></c:otherwise></c:choose></dd></div>
<c:forEach items="${['borrower','name','sourceKind','state','callDate','expiresOn','requested','received','unpaid','cap','terms']}" var="field"><div><dt><spring:message code="coverage.${field}"/><c:if test="${field=='requested'||field=='received'||field=='unpaid'||field=='cap'}"> (TZS)</c:if></dt><dd><c:choose><c:when test="${field=='sourceKind'||field=='state'}"><spring:message code="coverage.${field}.${caseHeader[field]}"/></c:when><c:when test="${field=='requested'||field=='received'||field=='unpaid'||field=='cap'}"><c:choose><c:when test="${empty caseHeader[field]}"><spring:message code="coverage.unavailable"/></c:when><c:otherwise><fmt:formatNumber value="${caseHeader[field]}" minFractionDigits="2" maxFractionDigits="2"/></c:otherwise></c:choose></c:when><c:when test="${field=='callDate'||field=='expiresOn'}"><c:out value="${appTime:display(caseHeader[field])}"/></c:when><c:otherwise><c:out value="${caseHeader[field]}"/></c:otherwise></c:choose></dd></div></c:forEach>
</dl><p><spring:message code="coverage.noDebtChange"/> <spring:message code="coverage.liabilityNote"/></p><c:if test="${caseHeader.sourceKind=='VOLUNTARY'}"><p><spring:message code="coverage.voluntaryNote"/></p></c:if></section>
