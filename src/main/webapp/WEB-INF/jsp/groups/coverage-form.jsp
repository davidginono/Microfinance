<%@ page pageEncoding="UTF-8" %>
<%@ include file="coverage-head.jspf" %>
<c:choose><c:when test="${mode=='policy'}"><c:set var="coverageFormName" value="coveragePolicyForm"/><c:set var="formTitle" value="coverage.policy"/><c:set var="formAction" value="${coverageUrl}/policy"/></c:when><c:when test="${mode=='call'}"><c:set var="coverageFormName" value="coverageCallForm"/><c:set var="formTitle" value="coverage.record"/><c:set var="formAction" value="${coverageUrl}"/></c:when><c:when test="${mode=='response'||mode=='close'}"><c:set var="coverageFormName" value="coverageResponseForm"/><c:set var="formTitle" value="${mode=='response'?'coverage.respond':'coverage.close'}"/><c:set var="formAction" value="${coverageUrl}/${caseHeader.id}/${mode=='response'?'respond':'close'}"/></c:when><c:when test="${mode=='link'}"><c:set var="coverageFormName" value="coverageLinkForm"/><c:set var="formTitle" value="coverage.link"/><c:set var="formAction" value="${coverageUrl}/${caseHeader.id}/link"/></c:when><c:otherwise><c:set var="coverageFormName" value="coverageCorrectionForm"/><c:set var="formTitle" value="coverage.correct"/><c:set var="formAction" value="${coverageUrl}/${caseHeader.id}/links/${paymentId}/correct"/></c:otherwise></c:choose>
<c:set var="returnUrl" value="${coverageUrl}"/><c:if test="${not empty caseHeader}"><c:set var="returnUrl" value="${coverageUrl}/${caseHeader.id}"/></c:if>
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb'/>"><a class="erp-page-path__link" href="${coverageUrl}"><spring:message code="coverage.title"/></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="${formTitle}"/></span></nav><div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="${formTitle}"/></h1></div>
<div class="accounting-create-workspace"><c:if test="${not empty caseHeader}"><%@ include file="coverage-summary.jspf" %></c:if>
<form:form method="post" action="${formAction}" modelAttribute="${coverageFormName}" cssClass="accounting-create-form" enctype="${mode=='call'?'multipart/form-data':'application/x-www-form-urlencoded'}" data-coverage-form="true" data-unsaved-financial-form="${not empty noticeFileError?'true':'false'}"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><form:hidden path="requestKey"/>
<c:if test="${mode=='policy'}"><form:hidden path="expectedPreviousId"/><section class="erp-resource-section"><h2><spring:message code="group.product"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.name"/></dt><dd><c:out value="${cycleContext.group}"/></dd></div><div><dt><spring:message code="group.product"/></dt><dd><c:out value="${cycleContext.product}"/></dd></div></dl></section><section class="accounting-form accounting-create-card"><h2><spring:message code="coverage.limits"/></h2><div class="accounting-grid erp-panel-body">
<spring:bind path="${coverageFormName}.reference"><label for="coverage-reference"><spring:message code="coverage.reference"/><form:input id="coverage-reference" path="reference" type="text" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-reference-error" maxlength="500" required="required"/><form:errors path="reference" id="coverage-reference-error" cssClass="coa-error"/></label></spring:bind>
<spring:bind path="${coverageFormName}.noticeDays"><label for="coverage-noticeDays"><spring:message code="coverage.noticeDays"/><form:input id="coverage-noticeDays" path="noticeDays" type="number" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-noticeDays-error" min="14" max="365" required="required"/><form:errors path="noticeDays" id="coverage-noticeDays-error" cssClass="coa-error"/></label></spring:bind>
<spring:bind path="${coverageFormName}.caseDays"><label for="coverage-caseDays"><spring:message code="coverage.caseDays"/><form:input id="coverage-caseDays" path="caseDays" type="number" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-caseDays-error" min="1" max="365" required="required"/><form:errors path="caseDays" id="coverage-caseDays-error" cssClass="coa-error"/></label></spring:bind>
<spring:bind path="${coverageFormName}.promiseDays"><label for="coverage-promiseDays"><spring:message code="coverage.promiseDays"/><form:input id="coverage-promiseDays" path="promiseDays" type="number" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-promiseDays-error" min="1" max="365" required="required"/><form:errors path="promiseDays" id="coverage-promiseDays-error" cssClass="coa-error"/></label></spring:bind>
<label class="aws-settings-checkbox-row"><form:checkbox path="enabled" cssClass="aws-settings-checkbox"/><span class="aws-settings-checkbox-copy"><spring:message code="coverage.enabled"/></span></label>
<label class="aws-settings-checkbox-row"><form:checkbox path="verified" cssClass="aws-settings-checkbox" required="required"/><span class="aws-settings-checkbox-copy"><spring:message code="coverage.policyVerified"/></span></label><form:errors path="verified" cssClass="coa-error"/>
</div></section></c:if>
<c:if test="${mode=='call'}"><form:hidden path="sourceId"/><form:hidden path="sourceKind"/><form:hidden path="policyId"/><c:set var="source" value="${preparation.source}"/><section class="erp-resource-section"><h2><spring:message code="coverage.obligation"/></h2><dl class="erp-detail-facts"><c:forEach items="${['loanNumber','name','borrower','kind','cap','arrears','terms']}" var="field"><div><dt><spring:message code="coverage.source.${field}"/><c:if test="${field=='cap'||field=='arrears'}"> (TZS)</c:if></dt><dd><c:choose><c:when test="${field=='kind'}"><spring:message code="coverage.sourceKind.${source.kind}"/></c:when><c:when test="${field=='cap'||field=='arrears'}"><c:choose><c:when test="${empty source[field]}"><spring:message code="coverage.unavailable"/></c:when><c:otherwise><fmt:formatNumber value="${source[field]}" minFractionDigits="2" maxFractionDigits="2"/></c:otherwise></c:choose></c:when><c:otherwise><c:out value="${source[field]}"/></c:otherwise></c:choose></dd></div></c:forEach><div><dt><spring:message code="coverage.maximum"/> (TZS)</dt><dd><c:choose><c:when test="${empty preparation.maximum}"><spring:message code="coverage.unavailable"/></c:when><c:otherwise><fmt:formatNumber value="${preparation.maximum}" minFractionDigits="2" maxFractionDigits="2"/></c:otherwise></c:choose></dd></div></dl><c:if test="${source.kind=='VOLUNTARY'}"><p><spring:message code="coverage.voluntaryNote"/></p></c:if></section>
<c:choose><c:when test="${empty preparation.policy or not preparation.policy.enabled}"><div class="accounting-error-summary" role="alert"><spring:message code="coverage.error.policy"/></div><sec:authorize access="@access.has(principal,'GROUP_COVERAGE_CONFIGURE')"><a class="app-btn btn-neutral" href="${coverageUrl}/policy"><spring:message code="coverage.policy"/></a></sec:authorize></c:when><c:otherwise><section class="erp-resource-section"><h2><spring:message code="coverage.policy"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="coverage.reference"/></dt><dd><c:out value="${preparation.policy.reference}"/></dd></div><div><dt><spring:message code="coverage.noticeDays"/></dt><dd><c:out value="${preparation.policy.noticeDays}"/></dd></div><div><dt><spring:message code="coverage.caseDays"/></dt><dd><c:out value="${preparation.policy.caseDays}"/></dd></div></dl></section></c:otherwise></c:choose>
<section class="accounting-form accounting-create-card"><h2><spring:message code="coverage.requested"/></h2><div class="accounting-grid erp-panel-body"><spring:bind path="${coverageFormName}.amount"><label for="coverage-amount"><spring:message code="coverage.amountTzs"/><form:input id="coverage-amount" path="amount" type="number" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-amount-error" min="0.01" step="0.01" max="${preparation.maximum}" required="required"/><form:errors path="amount" id="coverage-amount-error" cssClass="coa-error"/></label></spring:bind></div></section>
<section class="accounting-form accounting-create-card"><h2><spring:message code="coverage.notices"/></h2><div class="accounting-grid erp-panel-body">
<spring:bind path="${coverageFormName}.borrowerNoticeDate"><label for="coverage-borrowerNoticeDate"><spring:message code="coverage.borrowerNoticeDate"/><form:input id="coverage-borrowerNoticeDate" path="borrowerNoticeDate" type="date" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-borrowerNoticeDate-error" required="required"/><form:errors path="borrowerNoticeDate" id="coverage-borrowerNoticeDate-error" cssClass="coa-error"/></label></spring:bind>
<spring:bind path="${coverageFormName}.personNoticeDate"><label for="coverage-personNoticeDate"><spring:message code="coverage.personNoticeDate"/><form:input id="coverage-personNoticeDate" path="personNoticeDate" type="date" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-personNoticeDate-error" required="required"/><form:errors path="personNoticeDate" id="coverage-personNoticeDate-error" cssClass="coa-error"/></label></spring:bind>
<spring:bind path="${coverageFormName}.borrowerNoticeEvidence"><label for="coverage-borrowerNoticeEvidence"><spring:message code="coverage.borrowerNoticeEvidence"/><form:input id="coverage-borrowerNoticeEvidence" path="borrowerNoticeEvidence" type="text" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-borrowerNoticeEvidence-error" maxlength="500" required="required"/><form:errors path="borrowerNoticeEvidence" id="coverage-borrowerNoticeEvidence-error" cssClass="coa-error"/></label></spring:bind>
<spring:bind path="${coverageFormName}.personNoticeEvidence"><label for="coverage-personNoticeEvidence"><spring:message code="coverage.personNoticeEvidence"/><form:input id="coverage-personNoticeEvidence" path="personNoticeEvidence" type="text" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-personNoticeEvidence-error" maxlength="500" required="required"/><form:errors path="personNoticeEvidence" id="coverage-personNoticeEvidence-error" cssClass="coa-error"/></label></spring:bind>
<label for="coverage-noticeLanguage"><spring:message code="orgDocument.language"/><form:select path="noticeLanguage" id="coverage-noticeLanguage" cssClass="aws-control" required="required"><option value=""><spring:message code="voucher.choose"/></option><c:forEach items="${['SW','BOTH']}" var="language"><form:option value="${language}"><spring:message code="orgDocument.language.${language}"/></form:option></c:forEach></form:select><form:errors path="noticeLanguage" cssClass="coa-error"/></label>
<label for="coverage-noticePdf"><spring:message code="orgDocument.file"/><input id="coverage-noticePdf" class="aws-control" type="file" name="noticePdf" accept="application/pdf,.pdf" required aria-invalid="${not empty noticeFileError}" aria-describedby="coverage-noticePdf-error"/><c:if test="${not empty noticeFileError}"><span id="coverage-noticePdf-error" class="coa-error"><spring:message code="${noticeFileError}"/></span></c:if></label>
<label class="aws-settings-checkbox-row"><form:checkbox path="noticesVerified" cssClass="aws-settings-checkbox" required="required"/><span class="aws-settings-checkbox-copy"><spring:message code="coverage.noticesVerified"/></span></label><form:errors path="noticesVerified" cssClass="coa-error"/>
</div></section></c:if>
<c:if test="${mode=='response'||mode=='close'}"><form:hidden path="expectedSequence"/><section class="accounting-form accounting-create-card"><h2><spring:message code="${formTitle}"/></h2><div class="accounting-grid erp-panel-body"><label for="coverage-kind"><spring:message code="coverage.response"/><form:select path="kind" id="coverage-kind" cssClass="aws-control" data-coverage-kind="true" required="required"><option value=""><spring:message code="voucher.choose"/></option><c:set var="kinds" value="${mode=='response'?['ACKNOWLEDGED','PROMISED','DISPUTED']:['CLOSED','CANCELLED']}"/><c:forEach items="${kinds}" var="kind"><form:option value="${kind}"><spring:message code="coverage.event.${kind}"/></form:option></c:forEach></form:select><form:errors path="kind" cssClass="coa-error"/></label>
<spring:bind path="${coverageFormName}.reason"><label for="coverage-reason"><spring:message code="group.reason"/><form:input id="coverage-reason" path="reason" type="text" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-reason-error" maxlength="500" data-coverage-reason="true"/><form:errors path="reason" id="coverage-reason-error" cssClass="coa-error"/></label></spring:bind>
<c:if test="${mode=='response'}"><fieldset data-coverage-promise><legend><spring:message code="coverage.event.PROMISED"/></legend><spring:bind path="${coverageFormName}.amount"><label for="coverage-amount"><spring:message code="coverage.amountTzs"/><form:input id="coverage-amount" path="amount" type="number" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-amount-error" min="0.01" step="0.01" max="${caseHeader.unpaid}" required="required"/><form:errors path="amount" id="coverage-amount-error" cssClass="coa-error"/></label></spring:bind><spring:bind path="${coverageFormName}.promiseOn"><label for="coverage-promiseOn"><spring:message code="coverage.promiseOn"/><form:input id="coverage-promiseOn" path="promiseOn" type="date" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-promiseOn-error" min="${caseContext.today}" max="${promiseDeadline}" required="required"/><form:errors path="promiseOn" id="coverage-promiseOn-error" cssClass="coa-error"/></label></spring:bind></fieldset></c:if>
<label class="aws-settings-checkbox-row"><form:checkbox path="confirmed" cssClass="aws-settings-checkbox" required="required"/><span class="aws-settings-checkbox-copy"><spring:message code="${mode=='response'?'coverage.confirmResponse':'coverage.confirmClose'}"/></span></label><form:errors path="confirmed" cssClass="coa-error"/>
</div></section></c:if>
<c:if test="${mode=='link'||mode=='correction'}"><c:if test="${mode=='link'}"><form:hidden path="postingId"/><form:hidden path="contributionId"/></c:if><section class="erp-resource-section"><h2><spring:message code="coverage.receipt"/></h2><c:choose><c:when test="${empty paymentSource}"><p class="coa-error" role="alert"><spring:message code="coverage.error.payment"/></p></c:when><c:otherwise><dl class="erp-detail-facts"><c:forEach items="${['reference','date','payer','principal','interest','charges','amount']}" var="field"><div><dt><spring:message code="coverage.payment.${field}"/><c:if test="${field=='principal'||field=='interest'||field=='charges'||field=='amount'}"> (TZS)</c:if></dt><dd><c:choose><c:when test="${field=='date'}"><c:out value="${appTime:display(paymentSource.date)}"/></c:when><c:when test="${field=='principal'||field=='interest'||field=='charges'||field=='amount'}"><fmt:formatNumber value="${paymentSource[field]}" minFractionDigits="2" maxFractionDigits="2"/></c:when><c:otherwise><c:out value="${paymentSource[field]}"/></c:otherwise></c:choose></dd></div></c:forEach></dl></c:otherwise></c:choose><c:if test="${mode=='link'}"><p><a class="resource-table-id-link" href="${coverageUrl}/${caseHeader.id}/link"><spring:message code="coverage.chooseReceipt"/></a></p></c:if></section><section class="accounting-form accounting-create-card"><h2><spring:message code="coverage.verification"/></h2><div class="accounting-grid erp-panel-body"><c:choose><c:when test="${mode=='link'}"><spring:bind path="${coverageFormName}.payerEvidence"><label for="coverage-payerEvidence"><spring:message code="coverage.payerEvidence"/><form:input id="coverage-payerEvidence" path="payerEvidence" type="text" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-payerEvidence-error" maxlength="500" required="required"/><form:errors path="payerEvidence" id="coverage-payerEvidence-error" cssClass="coa-error"/></label></spring:bind><label class="aws-settings-checkbox-row"><form:checkbox path="payerVerified" cssClass="aws-settings-checkbox" required="required"/><span class="aws-settings-checkbox-copy"><spring:message code="coverage.payerVerified"/></span></label><form:errors path="payerVerified" cssClass="coa-error"/></c:when><c:otherwise><spring:bind path="${coverageFormName}.reason"><label for="coverage-reason"><spring:message code="group.reason"/><form:input id="coverage-reason" path="reason" type="text" cssClass="aws-control" aria-invalid="${status.error}" aria-describedby="coverage-reason-error" maxlength="500" required="required"/><form:errors path="reason" id="coverage-reason-error" cssClass="coa-error"/></label></spring:bind><label class="aws-settings-checkbox-row"><form:checkbox path="confirmed" cssClass="aws-settings-checkbox" required="required"/><span class="aws-settings-checkbox-copy"><spring:message code="coverage.confirmCorrection"/></span></label><form:errors path="confirmed" cssClass="coa-error"/></c:otherwise></c:choose></div></section></c:if>
<spring:hasBindErrors name="${coverageFormName}"><c:if test="${errors.globalErrorCount>0}"><div class="accounting-error-summary" role="alert" tabindex="-1"><form:errors path="" cssClass="coa-error"/></div></c:if></spring:hasBindErrors>
<div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" href="${returnUrl}"><spring:message code="common.cancel"/></a><button class="app-btn btn-launch" type="submit" ${(mode=='call' and (empty preparation.policy or not preparation.policy.enabled or empty preparation.maximum or preparation.maximum<=0 or not preparation.source.known)) or (mode=='link' and empty paymentSource)?'disabled':''}><spring:message code="${mode=='policy'?'common.save':formTitle}"/></button></div>
</form:form></div><script src="<c:url value='/js/group-coverage.js'/>" defer></script><script src="<c:url value='/js/loan-recording.js'/>" defer></script><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
