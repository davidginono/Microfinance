<%@ page pageEncoding="UTF-8" %>
<section class="erp-resource-section group-form-context">
    <h2><spring:message code="group.details" /></h2>
    <dl class="erp-detail-facts">
        <div>
            <dt><spring:message code="group.name" /></dt>
            <dd><c:out value="${group.name}" /></dd>
        </div>
        <div>
            <dt><spring:message code="group.code" /></dt>
            <dd><c:out value="${group.code}" /></dd>
        </div>
    </dl>
    <c:if test="${not empty groupFormNotice}">
        <p><spring:message code="${groupFormNotice}" /></p>
    </c:if>
</section>
