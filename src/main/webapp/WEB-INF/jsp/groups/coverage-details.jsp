<%@ page pageEncoding="UTF-8" %>
<%@ include file="coverage-head.jspf" %>
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb'/>"><a class="erp-page-path__link" href="${coverageUrl}"><spring:message code="coverage.title"/></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="coverage.case"/></span></nav><div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="coverage.case"/></h1><div class="accounting-actions"><sec:authorize access="(principal.staffSession and @access.has(principal,'GROUP_COVERAGE_EXPORT')) or (!principal.staffSession and @access.has(principal,'GROUP_COVERAGE_OWN_EXPORT'))"><c:forEach items="${['pdf','print']}" var="format"><a class="app-btn btn-neutral" href="${coverageUrl}/${caseHeader.id}/${format}" ${format=='print'?'target="_blank" rel="noopener"':''}><spring:message code="${format=='pdf'?'coverage.pdf':'common.print'}"/></a></c:forEach></sec:authorize><c:choose><c:when test="${coverageStaff}"><sec:authorize access="@access.has(principal,'GROUP_COVERAGE_LINK')"><a class="app-btn btn-neutral" href="${coverageUrl}/${caseHeader.id}/link"><spring:message code="coverage.link"/></a></sec:authorize><c:if test="${closeOpen}"><sec:authorize access="@access.has(principal,'GROUP_COVERAGE_UPDATE')"><a class="app-btn btn-neutral" href="${coverageUrl}/${caseHeader.id}/close"><spring:message code="coverage.close"/></a></sec:authorize></c:if></c:when><c:otherwise><c:if test="${responseOpen}"><sec:authorize access="@access.has(principal,'GROUP_COVERAGE_OWN_RESPOND')"><a class="app-btn btn-neutral" href="${coverageUrl}/${caseHeader.id}/respond"><spring:message code="coverage.respond"/></a></sec:authorize></c:if></c:otherwise></c:choose></div></div>
<div class="accounting-workspace" data-resource-details-page><%@ include file="coverage-summary.jspf" %>
<section class="erp-resource-section" id="coverage-notices"><h2><spring:message code="coverage.notices"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="coverage.borrowerNoticeDate"/></dt><dd><c:out value="${appTime:display(detail.notice.borrowerDate)}"/></dd></div><div><dt><spring:message code="coverage.personNoticeDate"/></dt><dd><c:out value="${appTime:display(detail.notice.personDate)}"/></dd></div><div><dt><spring:message code="orgDocument.language"/></dt><dd><spring:message code="orgDocument.language.${caseHeader.noticeLanguage}"/></dd></div><c:if test="${coverageStaff}"><div><dt><spring:message code="coverage.borrowerNoticeEvidence"/></dt><dd><c:out value="${detail.notice.borrowerEvidence}"/></dd></div><div><dt><spring:message code="coverage.personNoticeEvidence"/></dt><dd><c:out value="${detail.notice.personEvidence}"/></dd></div></c:if></dl>
<sec:authorize access="(principal.staffSession and @access.has(principal,'GROUP_COVERAGE_EXPORT')) or (!principal.staffSession and @access.has(principal,'GROUP_COVERAGE_OWN_EXPORT'))"><div class="accounting-actions"><c:forEach items="${['pdf','print']}" var="format"><a class="app-btn btn-neutral" href="${coverageUrl}/${caseHeader.id}/notice/${format}" ${format=='print'?'target="_blank" rel="noopener"':''}><spring:message code="management.${format}"/></a></c:forEach></div></sec:authorize></section>
<section class="erp-table-wrap" id="coverage-responses" data-resource-table="coverage-events" data-table-page-param="eventPage"><h2><spring:message code="coverage.responses"/></h2>
<form method="get" action="${coverageUrl}/${caseHeader.id}" data-table-filter-for="coverage-events" data-table-sort-param="eventSort"><input type="hidden" name="eventSort" value="<c:out value='${eventSort}'/>"/><input type="hidden" name="paymentPage" value="${detail.payments.page}"/><input type="hidden" name="paymentSort" value="<c:out value='${paymentSort}'/>"/><input type="hidden" name="detailTab" value="coverage-responses"/></form>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><c:forEach items="${['date','kind','amount','promise','reason']}" var="column"><th scope="col" data-table-sort-asc="${column}_asc" data-table-sort-desc="${column}_desc"><spring:message code="coverage.eventColumn.${column}"/><c:if test="${column=='amount'}"> (TZS)</c:if></th></c:forEach></tr></thead><tbody>
<c:forEach items="${detail.events.rows}" var="row"><tr><td><c:out value="${appTime:display(row.at)}"/></td><td><spring:message code="coverage.event.${row.kind}"/></td><td><c:choose><c:when test="${not empty row.amount}"><fmt:formatNumber value="${row.amount}" minFractionDigits="2" maxFractionDigits="2"/></c:when><c:otherwise>—</c:otherwise></c:choose></td><td><c:out value="${empty row.promiseOn?'—':appTime:display(row.promiseOn)}"/></td><td><c:out value="${row.reason}"/></td></tr></c:forEach><c:if test="${empty detail.events.rows}"><tr><td colspan="5"><spring:message code="coverage.noResponses"/></td></tr></c:if>
</tbody></table></div><div data-table-pagination data-table-for="coverage-events" data-page="${detail.events.page}"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?detail.events.page>0:detail.events.hasNext}"><c:url value="${coveragePath}/${caseHeader.id}" var="pageUrl"><c:param name="eventPage" value="${detail.events.page+step}"/><c:param name="eventSort" value="${eventSort}"/><c:param name="paymentPage" value="${detail.payments.page}"/><c:param name="paymentSort" value="${paymentSort}"/><c:param name="detailTab" value="coverage-responses"/></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div></section>
<sec:authorize access="@access.has(principal,'GROUP_COVERAGE_REVERSE')" var="reverseClaim"/><c:set var="allowCorrection" value="${coverageStaff and reverseClaim}"/>
<section class="erp-table-wrap" id="coverage-payments" data-resource-table="coverage-payments" data-table-page-param="paymentPage" ${allowCorrection?'data-group-register data-table-selection="single"':''}><h2><spring:message code="coverage.receipts"/></h2><c:if test="${allowCorrection}"><div class="accounting-actions" data-table-toolbar-for="coverage-payments"><button class="app-btn btn-neutral" type="button" data-table-command data-group-command="view" disabled><spring:message code="coverage.correct"/></button><span class="sr-only" data-group-selection-status aria-live="polite"></span></div></c:if>
<form method="get" action="${coverageUrl}/${caseHeader.id}" data-table-filter-for="coverage-payments" data-table-sort-param="paymentSort"><input type="hidden" name="paymentSort" value="<c:out value='${paymentSort}'/>"/><input type="hidden" name="eventPage" value="${detail.events.page}"/><input type="hidden" name="eventSort" value="<c:out value='${eventSort}'/>"/><input type="hidden" name="detailTab" value="coverage-payments"/></form>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><c:if test="${allowCorrection}"><th scope="col"><span class="sr-only"><spring:message code="voucher.select"/></span></th></c:if><c:forEach items="${['reference','date','payer','principal','interest','charges','amount','net','status','linked']}" var="column"><th scope="col" data-table-sort-asc="${column}_asc" data-table-sort-desc="${column}_desc"><spring:message code="coverage.payment.${column}"/><c:if test="${column=='principal'||column=='interest'||column=='charges'||column=='amount'||column=='net'}"> (TZS)</c:if></th></c:forEach></tr></thead><tbody>
<c:forEach items="${detail.payments.rows}" var="row"><c:set var="eligibleCorrection" value="${allowCorrection and empty row.correctedBy and row.recordedBy!=actorId}"/><tr <c:if test="${eligibleCorrection}">data-group-row="${row.id}" data-target="${coverageUrl}/${caseHeader.id}/links/${row.id}/correct"</c:if>><c:if test="${allowCorrection}"><td><input type="checkbox" aria-label="<spring:message code='voucher.select'/> <c:out value='${row.reference}'/>" ${eligibleCorrection?'':'disabled'}/></td></c:if><td data-group-identity><sec:authorize access="@access.has(principal,'ACCOUNTING_BUSINESS_VIEW')" var="receiptView"/><c:choose><c:when test="${coverageStaff and receiptView}"><a class="resource-table-id-link" href="<c:url value='/finance/loan-postings/${row.posting}'/>"><c:out value="${row.reference}"/></a></c:when><c:otherwise><c:out value="${row.reference}"/></c:otherwise></c:choose></td><td><c:out value="${appTime:display(row.date)}"/></td><td><c:out value="${row.payer}"/><c:if test="${coverageStaff and not empty row.evidence}"><div><c:out value="${row.evidence}"/></div></c:if></td><c:forEach items="${['principal','interest','charges','amount','net']}" var="field"><td><fmt:formatNumber value="${row[field]}" minFractionDigits="2" maxFractionDigits="2"/></td></c:forEach><td><c:choose><c:when test="${empty row.correctedBy and empty row.reversedBy}"><spring:message code="coverage.payment.LINKED"/></c:when><c:otherwise><c:if test="${not empty row.correctedBy}"><div><spring:message code="coverage.payment.CORRECTED"/> · <c:out value="${appTime:display(row.correctedAt)}"/></div><c:if test="${coverageStaff}"><div><c:out value="${row.correctionReason}"/></div></c:if></c:if><c:if test="${not empty row.reversedBy}"><div><spring:message code="coverage.payment.REVERSED"/></div></c:if></c:otherwise></c:choose></td><td><c:out value="${appTime:display(row.linkedAt)}"/></td></tr></c:forEach><c:if test="${empty detail.payments.rows}"><tr><td colspan="${allowCorrection?11:10}"><spring:message code="coverage.noReceipts"/></td></tr></c:if>
</tbody></table></div><div data-table-pagination data-table-for="coverage-payments" data-page="${detail.payments.page}"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?detail.payments.page>0:detail.payments.hasNext}"><c:url value="${coveragePath}/${caseHeader.id}" var="pageUrl"><c:param name="paymentPage" value="${detail.payments.page+step}"/><c:param name="paymentSort" value="${paymentSort}"/><c:param name="eventPage" value="${detail.events.page}"/><c:param name="eventSort" value="${eventSort}"/><c:param name="detailTab" value="coverage-payments"/></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div></section></div><script src="<c:url value='/js/group-lending.js'/>" defer></script><%@ include file="../fragments/footer.jspf" %>
