<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb' />"><a class="erp-page-path__link" href="<c:url value='/finance/groups/${cycle.groupId}/cycles' />"><spring:message code="group.cycles" /></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="group.cycle" /></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="group.cycle" /></h1><c:if test="${hasFundedLoans}"><sec:authorize access="@access.has(principal,'GROUP_LENDING_POST') and @access.has(principal,'LOAN_RECORDING_POST') and @access.has(principal,'ACCOUNTING_BUSINESS_CREATE')"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/cycles/${cycle.id}/receipts/new' />"><spring:message code="group.receive" /></a></sec:authorize></c:if></div>
<c:if test="${not empty termination}"><section class="erp-resource-section"><h2><spring:message code="group.termination" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.status" /></dt><dd><spring:message code="group.termination.${termination.kind}" /></dd></div><div><dt><spring:message code="group.actor" /></dt><dd><c:out value="${termination.actor}" /></dd></div><div><dt><spring:message code="group.reason" /></dt><dd><c:out value="${termination.reason}" /></dd></div></dl></section></c:if>
<c:if test="${canWithdraw}"><sec:authorize access="@access.has(principal,'GROUP_LENDING_SUBMIT')"><div class="accounting-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/cycles/${cycle.id}/withdraw' />"><spring:message code="group.withdraw" /></a></div></sec:authorize></c:if>
<section class="erp-resource-section"><h2><spring:message code="group.summary" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.name" /></dt><dd><c:out value="${cycle.groupName}" /></dd></div><div><dt><spring:message code="group.model" /></dt><dd><spring:message code="group.model.${cycle.model}" /></dd></div><div><dt><spring:message code="group.product" /></dt><dd><c:out value="${policy.product}" /></dd></div><div><dt><spring:message code="group.agreement" /></dt><dd><c:out value="${policy.agreementReference}" /></dd></div><div><dt><spring:message code="group.status" /></dt><dd><spring:message code="group.cycleState.${cycle.state}" /></dd></div></dl></section>
<section class="erp-table-wrap" data-resource-table="group-cycle-participants"><h2><spring:message code="group.participants" /></h2><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-order="client"><spring:message code="group.client" /></th><th data-table-order="principal"><spring:message code="group.principal" /></th><th data-table-order="monthly"><spring:message code="group.monthlyPayment" /></th><th data-table-order="loan"><spring:message code="group.loan" /></th><th data-table-order="consent"><spring:message code="group.consent" /></th><th data-table-order="status"><spring:message code="group.status" /></th></tr></thead><tbody>
<c:forEach items="${participants}" var="row"><tr><td><c:out value="${row.clientNumber}" /> · <c:out value="${row.name}" /></td><td><c:out value="${row.principal}" /></td><td><c:out value="${row.monthlyPayment}" /></td><td><sec:authorize access="@access.has(principal,'LOAN_RECORDING_VIEW')" var="canViewLoan" /><c:choose><c:when test="${canViewLoan and not empty row.loanId}"><a class="resource-table-id-link" href="<c:url value='/finance/loan-records/${row.loanId}' />"><c:out value="${row.loanNumber}" /></a></c:when><c:otherwise><c:out value="${row.loanNumber}" /></c:otherwise></c:choose></td><td><spring:message code="${row.consented?'group.accepted':cycle.state=='CANCELLED'?'group.notSigned':'group.awaitingConsent'}" /></td><td><spring:message code="recording.status.${row.loanStatus}" /></td></tr></c:forEach></tbody></table></div></section>

<c:if test="${not empty sharedFacility}"><section class="erp-resource-section"><h2><spring:message code="group.sharedFacility" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.loan" /></dt><dd><sec:authorize access="@access.has(principal,'LOAN_RECORDING_VIEW')" var="canViewSharedLoan" /><c:choose><c:when test="${canViewSharedLoan}"><a class="resource-table-id-link" href="<c:url value='/finance/loan-records/${sharedFacility.loanId}' />"><c:out value="${sharedFacility.number}" /></a></c:when><c:otherwise><c:out value="${sharedFacility.number}" /></c:otherwise></c:choose></dd></div><div><dt><spring:message code="group.sharedLiability" /></dt><dd><spring:message code="group.sharedLiability.${sharedFacility.liability}" /></dd></div><c:forEach items="${['principal','interest','charges','deductions','net','totalPayable']}" var="field"><div><dt><spring:message code="group.shared.${field}" /> (TZS)</dt><dd><c:out value="${sharedFacility.quote[field]}" /></dd></div></c:forEach></dl></section></c:if>
<c:if test="${cycle.model=='SHARED'}"><div class="accounting-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/cycles/${cycle.id}/agreement' />"><spring:message code="sharedAgreement.title" /></a></div></c:if>
<%@ include file="../fragments/footer.jspf" %>
