<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %><template data-resource-details-page></template>
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb' />"><a class="erp-page-path__link" href="<c:url value='/finance/groups/${authority.groupId}/authority' />"><spring:message code="authority.title" /></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="authority.details" /></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="authority.details" /></h1><sec:authorize access="@access.has(principal,'GROUP_AUTHORITY_UPDATE')"><c:if test="${empty authority.revokedAt}"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/${authority.groupId}/authority/${authority.id}/revoke' />"><spring:message code="authority.revoke" /></a></c:if></sec:authorize></div>
<section class="erp-resource-section"><h2><spring:message code="authority.title" /></h2><dl class="erp-detail-facts"><c:forEach items="${['groupName','groupCode','revision','maxPrincipal','validFrom','validThrough','recordedByName','recordedAt']}" var="field"><div><dt><spring:message code="authority.${field}" /></dt><dd><c:choose><c:when test="${field=='maxPrincipal'}">TZS <c:out value="${authority[field]}" /></c:when><c:when test="${field=='validFrom' or field=='validThrough' or field=='recordedAt'}"><c:out value="${appTime:display(authority[field])}" /></c:when><c:otherwise><c:out value="${authority[field]}" /></c:otherwise></c:choose></dd></div></c:forEach><div><dt><spring:message code="authority.state" /></dt><dd><span data-resource-status="${authority.state=='CURRENT'?'ACTIVE':authority.state=='NOT_YET_VALID'?'PENDING':'INACTIVE'}"><spring:message code="authority.state.${authority.state}" /></span></dd></div></dl><p><spring:message code="authority.notLoanApproval" /></p></section>
<section class="erp-resource-section"><h2><spring:message code="authority.documents" /></h2><dl class="erp-detail-facts"><c:forEach items="${['capacityEvidence','resolutionEvidence','signatureEvidence']}" var="field"><div><dt><spring:message code="authority.${field}" /></dt><dd><c:out value="${authority[field]}" /></dd></div></c:forEach></dl></section>
<section class="erp-resource-section"><h2><spring:message code="authority.signers" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="authority.requiredSignatures" /></dt><dd><c:out value="${authority.requiredSignatures}" /></dd></div><c:forEach items="${authority.signers}" var="person"><div><dt><c:out value="${person.number}" /> · <c:out value="${person.name}" /></dt><dd><c:forEach items="${['mayApply','maySign','mayReceive']}" var="power"><c:if test="${person[power]}"><span><spring:message code="authority.${power}" /></span><br /></c:if></c:forEach></dd></div></c:forEach></dl></section>
<section class="erp-resource-section"><h2><spring:message code="authority.payout" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="common.type" /></dt><dd><spring:message code="authority.payoutType.${authority.payoutType}" /></dd></div><c:forEach items="${['payoutProvider','payoutHolder','payoutIdentifier','payoutEvidence']}" var="field"><div><dt><spring:message code="authority.${field}" /></dt><dd><c:out value="${authority[field]}" /></dd></div></c:forEach></dl></section>
<c:if test="${not empty authority.revokedAt}"><section class="erp-resource-section"><h2><spring:message code="authority.revoke" /></h2><dl class="erp-detail-facts"><c:forEach items="${['revocationReason','revokedByName','revokedAt']}" var="field"><div><dt><spring:message code="authority.${field}" /></dt><dd><c:choose><c:when test="${field=='revokedAt'}"><c:out value="${appTime:display(authority.revokedAt)}" /></c:when><c:otherwise><c:out value="${authority[field]}" /></c:otherwise></c:choose></dd></div></c:forEach></dl></section></c:if>
<%@ include file="../fragments/footer.jspf" %>
