<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %><link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css'/>"/>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="coverage.link"/></h1></div><div class="accounting-workspace accounting-create-workspace"><%@ include file="coverage-context.jspf" %><section class="erp-resource-section"><h2><spring:message code="coverage.selectReceipt"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="memberStatement.reference"/></dt><dd><c:out value="${selectedPayment.reference}"/></dd></div><div><dt><spring:message code="group.payer"/></dt><dd><c:out value="${selectedPayment.payer}"/></dd></div><div><dt><spring:message code="voucher.date"/></dt><dd><c:out value="${appTime:display(selectedPayment.date)}"/></dd></div><div><dt><spring:message code="voucher.amount"/></dt><dd><fmt:formatNumber value="${selectedPayment.amount}" minFractionDigits="2" maxFractionDigits="2"/> TZS</dd></div><div><dt><spring:message code="recording.principal"/></dt><dd><fmt:formatNumber value="${selectedPayment.principal}" minFractionDigits="2" maxFractionDigits="2"/></dd></div><div><dt><spring:message code="recording.interest"/></dt><dd><fmt:formatNumber value="${selectedPayment.interest}" minFractionDigits="2" maxFractionDigits="2"/></dd></div><div><dt><spring:message code="charges.title"/></dt><dd><fmt:formatNumber value="${selectedPayment.charges}" minFractionDigits="2" maxFractionDigits="2"/></dd></div></dl></section>
<c:if test="${selectionUnavailable}"><p role="alert"><spring:message code="coverage.error.payment"/></p></c:if><form:form modelAttribute="coverageLink" action="${casePath}/link" method="post" cssClass="accounting-create-form" data-preserve-submit-command="true"><form:hidden path="requestKey"/><form:hidden path="postingId"/><form:hidden path="contributionId"/><section class="accounting-form accounting-create-card"><h2><spring:message code="coverage.verifyPayer"/></h2><div class="accounting-grid erp-panel-body"><label><spring:message code="coverage.payerEvidence"/><form:input path="payerEvidence" type="text" cssClass="aws-control" maxlength="500" required="required"/><form:errors path="payerEvidence" cssClass="coa-error"/></label><label class="aws-settings-checkbox-row"><form:checkbox path="payerVerified" cssClass="aws-settings-checkbox" required="required"/><span><spring:message code="coverage.payerVerified"/></span></label><p><spring:message code="coverage.linkNote"/></p></div></section>
<div role="alert"><form:errors path="" element="p" cssClass="coa-error"/></div><div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" href="${casePath}/payments"><spring:message code="common.cancel"/></a><button class="app-btn btn-launch" type="submit" ${selectionUnavailable?'disabled':''}><spring:message code="coverage.link"/></button></div></form:form></div><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
