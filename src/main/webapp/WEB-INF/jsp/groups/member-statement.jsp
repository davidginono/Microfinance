<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<c:set var="source" value="${statement.source}" /><c:set var="member" value="${source.member}" />
<c:if test="${statement.staff}"><nav class="erp-page-path"><a href="<c:url value='/finance/groups/cycles/${source.cycle}/allocations' />"><spring:message code="sharedStatement.title" /></a><span aria-hidden="true">›</span><span aria-current="page"><c:out value="${member.number}" /></span></nav></c:if>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="memberStatement.title" /></h1></div>
<section class="erp-resource-section"><dl class="erp-detail-facts">
<div><dt><spring:message code="memberStatement.institution" /></dt><dd><c:out value="${source.institution}" /></dd></div><div><dt><spring:message code="voucher.print.branch" /></dt><dd><c:out value="${source.branch}" /></dd></div><div><dt><spring:message code="group.group" /></dt><dd><c:out value="${source.groupCode} - ${source.groupName}" /></dd></div><div><dt><spring:message code="group.client" /></dt><dd><c:out value="${member.number} - ${member.name}" /></dd></div><div><dt><spring:message code="group.loan" /></dt><dd><c:out value="${source.loanNumber}" /></dd></div><div><dt><spring:message code="group.status" /></dt><dd><spring:message code="recording.status.${source.status}" /></dd></div><div><dt><spring:message code="memberStatement.asOf" /></dt><dd><c:out value="${appTime:display(statement.asOf)}" /></dd></div><div><dt><spring:message code="group.sharedLiability" /></dt><dd><spring:message code="memberStatement.liability.${source.liability}" /></dd></div>
</dl></section>
<section class="erp-resource-section"><h2><spring:message code="memberStatement.balance" /></h2><dl class="erp-detail-facts">
<div><dt><spring:message code="memberStatement.cap" /></dt><dd><fmt:formatNumber value="${source.cap}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="memberStatement.originalPrincipal" /></dt><dd><fmt:formatNumber value="${member.principal}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="memberStatement.originalInterest" /></dt><dd><fmt:formatNumber value="${member.interest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="memberStatement.totalFees" /></dt><dd><fmt:formatNumber value="${member.charges+source.deductions}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="group.deductions" /></dt><dd><fmt:formatNumber value="${source.deductions}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="group.shared.net" /></dt><dd><fmt:formatNumber value="${source.net}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><c:if test="${source.funded and source.known}"><div><dt><spring:message code="sharedStatement.principal" /></dt><dd><fmt:formatNumber value="${member.remainingPrincipal()}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="memberStatement.remainingInterest" /></dt><dd><fmt:formatNumber value="${member.remainingInterest()}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="sharedStatement.charges" /></dt><dd><fmt:formatNumber value="${member.remainingCharges()}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="sharedStatement.excluded" /></dt><dd><fmt:formatNumber value="${member.excludedInterest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="memberStatement.waived" /></dt><dd><fmt:formatNumber value="${member.waivedInterest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="memberStatement.writtenOff" /></dt><dd><fmt:formatNumber value="${member.writtenOff}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="memberStatement.maximum" /></dt><dd><fmt:formatNumber value="${source.maximumLiability}" minFractionDigits="2" maxFractionDigits="2" /></dd></div></c:if><c:if test="${source.funded and source.duePrincipal!=null}"><div><dt><spring:message code="memberStatement.wholeDuePrincipal" /></dt><dd><fmt:formatNumber value="${source.duePrincipal}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="memberStatement.wholeDueInterest" /></dt><dd><fmt:formatNumber value="${source.dueInterest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="memberStatement.wholeCharges" /></dt><dd><fmt:formatNumber value="${source.loanCharges}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="memberStatement.wholeArrears" /></dt><dd><fmt:formatNumber value="${source.arrears}" minFractionDigits="2" maxFractionDigits="2" /></dd></div></c:if>
</dl><c:if test="${not source.funded or not source.known}"><p role="status"><spring:message code="${source.funded?'memberStatement.unknown':'sharedStatement.unfunded'}" /></p></c:if><p><spring:message code="memberStatement.note" /></p></section>
<section class="erp-resource-section"><h2><spring:message code="memberStatement.history" /></h2>
<c:url value="${statementPath}" var="filterUrl" /><form action="${filterUrl}" method="get" class="coa-filters erp-table-toolbar"><label><spring:message code="memberStatement.from" /><input class="aws-control" type="date" name="from" value="<c:out value='${statement.from}' />" max="${statement.asOf}" /></label><label><spring:message code="memberStatement.through" /><input class="aws-control" type="date" name="through" value="${statement.through}" max="${statement.asOf}" /></label><button class="app-btn btn-neutral" type="submit"><spring:message code="memberStatement.filter" /></button></form>
<p><spring:message code="memberStatement.filterNote" /></p>
<sec:authorize access="@access.has(principal,'GROUP_LENDING_EXPORT') and @access.has(principal,'LOAN_RECORDING_EXPORT') and @access.has(principal,'FINANCIAL_REPORTS_EXPORT')" var="canExportStaff" /><c:if test="${not statement.staff or canExportStaff}"><div class="accounting-actions"><c:forEach items="${['pdf','print']}" var="format"><c:url value="${statementPath}/${format}" var="exportUrl"><c:param name="from" value="${statement.from}" /><c:param name="through" value="${statement.through}" /></c:url><a class="app-btn btn-neutral" href="${exportUrl}" target="_blank" rel="noopener"><spring:message code="memberStatement.${format}" /></a></c:forEach></div></c:if>
<div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="financial-statement"><thead><tr><th><spring:message code="voucher.date" /></th><th><spring:message code="memberStatement.reference" /></th><th><spring:message code="group.status" /></th><th><spring:message code="group.payer" /></th><th><spring:message code="recording.principal" /> (TZS)</th><th><spring:message code="recording.interest" /> (TZS)</th><th><spring:message code="charges.title" /> (TZS)</th><th><spring:message code="memberStatement.nonCash" /> (TZS)</th><th><spring:message code="memberStatement.waived" /></th><th><spring:message code="memberStatement.writtenOff" /></th></tr></thead><tbody><c:forEach items="${statement.credits}" var="credit"><tr><td><c:out value="${appTime:display(credit.date)}" /></td><td><c:choose><c:when test="${statement.receiptLinks and not empty credit.receipt}"><a class="resource-table-id-link" href="<c:url value='/finance/vouchers/receipts/${credit.receipt}' />"><c:out value="${credit.number}" /></a></c:when><c:otherwise><c:out value="${credit.number}" /></c:otherwise></c:choose></td><td><spring:message code="memberStatement.kind.${credit.kind}" /><c:if test="${not empty credit.reverses}"><div><spring:message code="memberStatement.reverses" />: <c:out value="${credit.reverses}" /></div></c:if><c:if test="${not empty credit.reversedBy}"><div><spring:message code="memberStatement.reversedBy" />: <c:out value="${credit.reversedBy}" /></div></c:if></td><td><c:out value="${credit.payer}" /></td><c:forEach items="${['principal','interest','charges','excludedInterest','waivedInterest','writtenOff']}" var="field"><td><fmt:formatNumber value="${credit[field]}" minFractionDigits="2" maxFractionDigits="2" /></td></c:forEach></tr></c:forEach><c:if test="${empty statement.credits}"><tr><td colspan="10"><spring:message code="memberStatement.empty" /></td></tr></c:if></tbody></table></div>
<nav class="accounting-actions" aria-label="<spring:message code='memberStatement.history' />"><c:if test="${statement.page>0}"><c:url value="${statementPath}" var="previousUrl"><c:param name="from" value="${statement.from}" /><c:param name="through" value="${statement.through}" /><c:param name="schedulePage" value="${statement.schedulePage}" /><c:param name="page" value="${statement.page-1}" /></c:url><a class="app-btn btn-neutral" href="${previousUrl}"><spring:message code="memberStatement.previous" /></a></c:if><span><spring:message code="memberStatement.page" /> <c:out value="${statement.page+1}" /></span><c:if test="${statement.hasNext}"><c:url value="${statementPath}" var="nextUrl"><c:param name="from" value="${statement.from}" /><c:param name="through" value="${statement.through}" /><c:param name="schedulePage" value="${statement.schedulePage}" /><c:param name="page" value="${statement.page+1}" /></c:url><a class="app-btn btn-neutral" href="${nextUrl}"><spring:message code="memberStatement.next" /></a></c:if></nav>
</section>
<section class="erp-resource-section"><h2><spring:message code="memberStatement.schedule" /></h2><p><spring:message code="memberStatement.scheduleNote" /></p><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="financial-statement"><thead><tr><th>#</th><th><spring:message code="memberStatement.dueDate" /></th><th><spring:message code="recording.principal" /> (TZS)</th><th><spring:message code="recording.interest" /> (TZS)</th><th><spring:message code="voucher.amount" /> (TZS)</th></tr></thead><tbody><c:forEach items="${statement.schedule}" var="due"><tr><td><c:out value="${due.number}" /></td><td><c:out value="${appTime:display(due.date)}" /></td><td><fmt:formatNumber value="${due.principal}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${due.interest}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${due.amount()}" minFractionDigits="2" maxFractionDigits="2" /></td></tr></c:forEach><c:if test="${empty statement.schedule}"><tr><td colspan="5"><spring:message code="memberStatement.empty" /></td></tr></c:if></tbody></table></div>
<nav class="accounting-actions" aria-label="<spring:message code='memberStatement.schedule' />"><c:if test="${statement.schedulePage>0}"><c:url value="${statementPath}" var="previousUrl"><c:param name="from" value="${statement.from}" /><c:param name="through" value="${statement.through}" /><c:param name="page" value="${statement.page}" /><c:param name="schedulePage" value="${statement.schedulePage-1}" /></c:url><a class="app-btn btn-neutral" href="${previousUrl}"><spring:message code="memberStatement.previous" /></a></c:if><span><spring:message code="memberStatement.page" /> <c:out value="${statement.schedulePage+1}" /></span><c:if test="${statement.scheduleNext}"><c:url value="${statementPath}" var="nextUrl"><c:param name="from" value="${statement.from}" /><c:param name="through" value="${statement.through}" /><c:param name="page" value="${statement.page}" /><c:param name="schedulePage" value="${statement.schedulePage+1}" /></c:url><a class="app-btn btn-neutral" href="${nextUrl}"><spring:message code="memberStatement.next" /></a></c:if></nav>
</section>
<c:set var="coverageMemberStatement" value="${true}"/><%@ include file="coverage-statement.jspf" %><%@ include file="../fragments/footer.jspf" %>
