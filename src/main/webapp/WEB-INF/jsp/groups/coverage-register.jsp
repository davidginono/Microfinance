<%@ page pageEncoding="UTF-8" %>
<%@ include file="coverage-head.jspf" %>
<c:if test="${coverageStaff}"><nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb'/>"><a class="erp-page-path__link" href="<c:url value='/finance/groups/cycles/${cycleContext.cycle}'/>"><spring:message code="group.cycle"/></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="coverage.title"/></span></nav><section class="erp-resource-section"><h2><spring:message code="group.cycle"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.name"/></dt><dd><c:out value="${cycleContext.group}"/></dd></div><div><dt><spring:message code="group.product"/></dt><dd><c:out value="${cycleContext.product}"/></dd></div></dl></section></c:if>
<section class="erp-table-wrap" data-resource-table="coverage-cases" data-group-register data-table-selection="single"><h2><spring:message code="coverage.title"/></h2><div class="accounting-actions" data-table-toolbar-for="coverage-cases"><button class="app-btn btn-neutral" type="button" data-table-command data-group-command="view" disabled><spring:message code="group.open"/></button><span class="sr-only" data-group-selection-status aria-live="polite"></span><c:if test="${coverageStaff}"><sec:authorize access="@access.has(principal,'GROUP_COVERAGE_CONFIGURE')"><a class="app-btn btn-neutral" href="${coverageUrl}/policy"><spring:message code="coverage.policy"/></a></sec:authorize><sec:authorize access="@access.has(principal,'GROUP_COVERAGE_CREATE')"><a class="app-btn btn-launch" href="${coverageUrl}/new"><spring:message code="coverage.record"/></a></sec:authorize></c:if></div>
<form method="get" action="${coverageUrl}" data-table-filter-for="coverage-cases"><input type="hidden" name="sort" value="<c:out value='${sort}'/>"/></form>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th scope="col"><span class="sr-only"><spring:message code="voucher.select"/></span></th><c:forEach items="${['date','loan','person','kind','amount','received','state','expires']}" var="column"><th scope="col" data-table-sort-asc="${column}_asc" data-table-sort-desc="${column}_desc"><spring:message code="coverage.column.${column}"/><c:if test="${column=='amount'||column=='received'}"> (TZS)</c:if></th></c:forEach></tr></thead><tbody>
<c:forEach items="${records.rows}" var="row"><tr data-group-row="${row.id}" data-target="${coverageUrl}/${row.id}"><td><input type="checkbox" aria-label="<spring:message code='voucher.select'/> <c:out value='${row.loanNumber}'/> <c:out value='${appTime:display(row.callDate)}'/>"/></td><td data-group-identity><c:out value="${appTime:display(row.callDate)}"/></td><td><c:choose><c:when test="${coverageStaff}"><a class="resource-table-id-link" href="<c:url value='/finance/loan-records/${row.loan}'/>"><c:out value="${row.loanNumber}"/></a></c:when><c:otherwise><c:out value="${row.loanNumber}"/></c:otherwise></c:choose></td><td><c:out value="${row.name}"/></td><td><spring:message code="coverage.sourceKind.${row.sourceKind}"/></td><td><fmt:formatNumber value="${row.requested}" minFractionDigits="2" maxFractionDigits="2"/></td><td><fmt:formatNumber value="${row.received}" minFractionDigits="2" maxFractionDigits="2"/></td><td><spring:message code="coverage.state.${row.state}"/></td><td><c:out value="${appTime:display(row.expiresOn)}"/></td></tr></c:forEach><c:if test="${empty records.rows}"><tr><td colspan="9"><spring:message code="coverage.empty"/></td></tr></c:if>
</tbody></table></div><div data-table-pagination data-table-for="coverage-cases" data-page="${records.page}"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?records.page>0:records.hasNext}"><c:url value="${coveragePath}" var="pageUrl"><c:param name="page" value="${records.page+step}"/><c:param name="sort" value="${sort}"/></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div></section><script src="<c:url value='/js/group-lending.js'/>" defer></script><%@ include file="../fragments/footer.jspf" %>
