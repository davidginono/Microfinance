<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb' />"><a class="erp-page-path__link" href="<c:url value='/finance/groups/${group.id}' />"><spring:message code="group.details" /></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="group.cycles" /></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title" id="group-cycles-title"><spring:message code="group.cycles" /></h1></div>
<section class="erp-table-wrap" data-resource-table="group-cycles" data-table-title-id="group-cycles-title"><div class="accounting-actions" data-table-toolbar-for="group-cycles"><sec:authorize access="@access.has(principal,'GROUP_LENDING_CREATE')"><a class="app-btn btn-launch" href="<c:url value='/finance/groups/${group.id}/cycles/new' />"><spring:message code="group.startCycle" /></a></sec:authorize></div>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-order="cycle"><spring:message code="group.cycle" /></th><th data-table-order="model"><spring:message code="group.model" /></th><th data-table-order="status"><spring:message code="group.status" /></th><th data-table-order="submitted"><spring:message code="group.submittedAt" /></th></tr></thead><tbody>
<c:forEach items="${cycles.rows}" var="row"><tr><td><a class="resource-table-id-link" href="<c:url value='/finance/groups/cycles/${row.id}' />"><c:if test="${empty row.date and empty row.purpose}"><spring:message code="group.cycleState.DRAFT" /></c:if><c:out value="${appTime:display(row.date)}" /><c:if test="${not empty row.date and not empty row.purpose}"> · </c:if><c:out value="${row.purpose}" /></a></td><td><spring:message code="group.model.${row.model}" /></td><td><spring:message code="group.cycleState.${row.state}" /></td><td><c:out value="${appTime:display(row.submittedAt)}" /></td></tr></c:forEach><c:if test="${empty cycles.rows}"><tr><td colspan="4"><spring:message code="group.cycles.empty" /></td></tr></c:if></tbody></table></div>
<div data-table-pagination data-page="${cycles.page}" data-table-for="group-cycles"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?cycles.page>0:cycles.hasNext}"><c:url value="/finance/groups/${group.id}/cycles" var="pageUrl"><c:param name="page" value="${cycles.page+step}" /></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}' />"><spring:message code="${step==-1?'common.previous':'common.next'}" /></a></c:if></c:forEach></div></section>
<%@ include file="../fragments/footer.jspf" %>
