<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %><link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css'/>"/>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="coverage.link"/></h1></div><div class="accounting-workspace"><%@ include file="coverage-context.jspf" %><form method="get" action="${casePath}/link" class="accounting-create-form"><section class="accounting-form accounting-create-card"><h2><spring:message code="coverage.selectReceipt"/></h2><div class="accounting-grid erp-panel-body"><label><spring:message code="coverage.payments"/><select name="selection" class="aws-control" required><option value=""><spring:message code="voucher.choose"/></option><c:forEach items="${choices.rows}" var="row"><option value="${row.posting}/${row.contribution}"><c:out value="${row.reference}"/> / <c:out value="${row.payer}"/> / <c:out value="${appTime:display(row.date)}"/> / <fmt:formatNumber value="${row.amount}" minFractionDigits="2" maxFractionDigits="2"/> TZS</option></c:forEach></select></label><button class="app-btn btn-neutral" type="submit"><spring:message code="coverage.selectReceipt"/></button></div></section>
</form><c:if test="${empty choices.rows}"><p><spring:message code="coverage.emptyPayments"/></p></c:if><nav><c:if test="${choices.page>0}"><a class="app-btn btn-neutral" href="${casePath}/payments?page=${choices.page-1}"><spring:message code="common.previous"/></a></c:if><c:if test="${choices.hasNext}"><a class="app-btn btn-neutral" href="${casePath}/payments?page=${choices.page+1}"><spring:message code="common.next"/></a></c:if></nav></div><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
