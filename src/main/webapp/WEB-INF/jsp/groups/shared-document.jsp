<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<nav class="erp-page-path"><a href="<c:url value='/finance/groups/cycles/${cycle.id}' />"><spring:message code="group.cycle" /></a><span>›</span><span aria-current="page"><spring:message code="sharedAgreement.title" /></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="sharedAgreement.title" /></h1></div>
<div class="accounting-workspace accounting-create-workspace"><c:choose><c:when test="${not empty document}"><section class="erp-resource-section"><h2><spring:message code="orgDocument.title" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="orgDocument.reference" /></dt><dd><c:out value="${document.reference}" /></dd></div><div><dt><spring:message code="orgDocument.language" /></dt><dd><spring:message code="orgDocument.language.${document.language}" /></dd></div><div><dt><spring:message code="orgDocument.fileHash" /></dt><dd><c:out value="${document.sha256}" /></dd></div></dl><sec:authorize access="@access.has(principal,'LOAN_DOCUMENTS_VIEW') and @access.has(principal,'LOAN_DOCUMENTS_EXPORT')"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/cycles/${cycle.id}/agreement/${document.id}/pdf' />"><spring:message code="voucher.pdf" /></a></sec:authorize></section></c:when><c:otherwise>
<sec:authorize access="@access.has(principal,'GROUP_LENDING_UPDATE') and @access.has(principal,'LOAN_RECORDING_CREATE')"><c:if test="${cycle.state=='SUBMITTED'}"><c:url value="/finance/groups/cycles/${cycle.id}/agreement" var="saveUrl" />
<form:form modelAttribute="documentForm" action="${saveUrl}" method="post" enctype="multipart/form-data" cssClass="accounting-create-form"><form:hidden path="documentRequestKey" /><div class="accounting-error-summary" role="alert"><form:errors path="*" element="p" cssClass="coa-error" /></div>
<section class="accounting-form accounting-create-card"><h2><spring:message code="orgDocument.title" /></h2><div class="accounting-grid erp-panel-body"><label><spring:message code="orgDocument.reference" /><form:input path="documentReference" maxlength="500" cssClass="aws-control" required="required" /></label><label><spring:message code="orgDocument.language" /><form:select path="documentLanguage" cssClass="aws-control"><option value=""><spring:message code="voucher.choose" /></option><c:forEach items="${['SW','EN','BOTH']}" var="language"><form:option value="${language}"><spring:message code="orgDocument.language.${language}" /></form:option></c:forEach></form:select></label>
<label><spring:message code="orgDocument.file" /><input type="file" name="agreementPdf" accept="application/pdf,.pdf" class="aws-control" required /></label><c:forEach items="${['institutionAddress','contactPhone','contactEmail','complaintPhone','complaintEmail','complaintAddress']}" var="field"><label><spring:message code="orgDocument.${field}" /><form:input path="${field}" maxlength="${field=='institutionAddress' or field=='complaintAddress'?500:field=='contactEmail' or field=='complaintEmail'?160:80}" cssClass="aws-control" /></label></c:forEach></div></section>
<section class="accounting-form accounting-create-card"><h2><spring:message code="sharedAgreement.repaymentTitle" /></h2><div class="erp-panel-body"><p><spring:message code="sharedAgreement.repaymentRule" /></p><label class="aws-settings-checkbox-row"><form:checkbox path="documentChecked" cssClass="aws-settings-checkbox" /><span class="aws-settings-checkbox-copy"><spring:message code="sharedAgreement.documentChecked" /></span></label></div></section>
<div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/cycles/${cycle.id}' />"><spring:message code="common.cancel" /></a><button class="app-btn btn-launch"><spring:message code="orgDocument.record" /></button></div></form:form></c:if></sec:authorize></c:otherwise></c:choose></div>
<%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
