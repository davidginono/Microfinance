<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<div class="erp-page-header"><h1 class="erp-page-title" id="group-rules-title"><spring:message code="group.productRules" /></h1></div>
<section class="erp-table-wrap" data-resource-table="group-product-rules" data-table-title-id="group-rules-title">
<div class="accounting-actions" data-table-toolbar-for="group-product-rules"><sec:authorize access="@access.has(principal,'GROUP_LENDING_CONFIGURE')"><a class="app-btn btn-launch" href="<c:url value='/finance/groups/product-rules/new' />"><spring:message code="group.addRules" /></a></sec:authorize></div>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-order="product"><spring:message code="group.product" /></th><th data-table-order="model"><spring:message code="group.model" /></th><th data-table-order="members"><spring:message code="group.members" /></th><th data-table-order="principal"><spring:message code="group.maxPrincipal" /></th><th data-table-order="guarantee"><spring:message code="group.maxGuarantee" /></th><th data-table-order="agreement"><spring:message code="group.agreement" /></th><th data-table-order="enabled"><spring:message code="group.enabled" /></th></tr></thead><tbody>
<c:forEach items="${policies.rows}" var="p"><tr><td><c:out value="${p.product}" /></td><td><spring:message code="group.model.${p.model}" /></td><td><c:out value="${p.minMembers}" />–<c:out value="${p.maxMembers}" /></td><td><c:out value="${p.maxPrincipal}" /></td><td><c:out value="${p.maxGuarantee}" /></td><td><c:out value="${p.agreementReference}" /></td><td><spring:message code="${p.enabled?'group.yes':'group.no'}" /></td></tr></c:forEach>
<c:if test="${empty policies.rows}"><tr><td colspan="7"><spring:message code="group.rules.empty" /></td></tr></c:if></tbody></table></div>
<div data-table-pagination data-page="${policies.page}" data-table-for="group-product-rules"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?policies.page>0:policies.hasNext}"><c:url value="/finance/groups/product-rules" var="pageUrl"><c:param name="page" value="${policies.page+step}" /></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}' />"><spring:message code="${step==-1?'common.previous':'common.next'}" /></a></c:if></c:forEach></div>
</section><%@ include file="../fragments/footer.jspf" %>
