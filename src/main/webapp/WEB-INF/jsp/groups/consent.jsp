<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="group.consentTitle" /></h1></div>
<section class="erp-resource-section"><h2><spring:message code="group.ownLoan" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.name" /></dt><dd><c:out value="${packet.group}" /></dd></div><div><dt><spring:message code="group.loan" /></dt><dd><c:out value="${packet.borrower.loanNumber}" /></dd></div><div><dt><spring:message code="group.principal" /></dt><dd><c:out value="${packet.terms.principal}" /></dd></div><div><dt><spring:message code="group.annualRate" /></dt><dd><fmt:formatNumber value="${packet.terms.annualRate*100}" maxFractionDigits="4" />%</dd></div><div><dt><spring:message code="group.contractualInterest" /></dt><dd><c:out value="${packet.terms.contractualInterest}" /></dd></div><div><dt><spring:message code="group.instalment" /></dt><dd><c:out value="${packet.terms.instalment}" /> · <spring:message code="group.frequency.${packet.terms.frequency}" /></dd></div><div><dt><spring:message code="group.tenure" /></dt><dd><c:out value="${packet.terms.tenureValue}" /> <spring:message code="group.unit.${packet.terms.tenureUnit}" /></dd></div><div><dt><spring:message code="group.firstPaymentDate" /></dt><dd><c:out value="${appTime:display(packet.terms.firstPaymentDate)}" /></dd></div><div><dt><spring:message code="group.agreement" /></dt><dd><c:out value="${packet.policy.agreementReference}" /></dd></div></dl></section>
<section class="erp-resource-section"><h2><spring:message code="group.costs" /></h2><dl class="erp-detail-facts">
<c:forEach items="${['maximumInstalment','chargeTotal','deductions','netCash','totalPayable']}" var="field"><div><dt><spring:message code="group.${field}" /></dt><dd><c:out value="${packet.terms[field]}" /></dd></div></c:forEach>
</dl><c:choose><c:when test="${empty packet.terms.charges.terms}"><p><spring:message code="group.noCharges" /></p></c:when><c:otherwise><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="charges.kind" /></th><th><spring:message code="group.chargeAmount" /></th><th><spring:message code="group.chargeTiming" /></th><th><spring:message code="group.provider" /></th></tr></thead><tbody>
<c:forEach items="${packet.terms.charges.terms}" var="charge"><tr><td><spring:message code="charges.kind.${charge.kind}" /></td><td><c:out value="${charge.amount}" /></td><td><spring:message code="charges.timing.${charge.timing}" /></td><td><c:out value="${charge.provider}" /></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section>
<section class="erp-table-wrap" data-resource-table="group-personal-guarantees"><h2><spring:message code="group.guaranteesTitle" /></h2><p><spring:message code="group.guaranteeDisclosure" /></p><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-order="borrower"><spring:message code="group.borrower" /></th><th data-table-order="loan"><spring:message code="group.loan" /></th><th data-table-order="cap"><spring:message code="group.cap" /></th><th data-table-order="agreement"><spring:message code="group.agreement" /></th></tr></thead><tbody><c:forEach items="${packet.guarantees}" var="g"><tr><td><c:out value="${g.borrower}" /></td><td><c:out value="${g.loanNumber}" /></td><td><c:out value="${g.cap}" /></td><td><c:out value="${g.agreementReference}" /></td></tr></c:forEach></tbody></table></div></section>
<c:choose><c:when test="${packet.accepted}"><p role="status"><spring:message code="group.accepted" /></p></c:when><c:otherwise><c:url value="/app/group-loans/${packet.id}/accept" var="acceptUrl" /><form action="${acceptUrl}" method="post" class="accounting-create-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><section class="accounting-form"><label><input type="checkbox" name="accepted" value="true" required /><spring:message code="group.personalAcceptance" /></label></section><div class="accounting-actions accounting-form-actions"><button type="submit" class="app-btn btn-launch"><spring:message code="group.accept" /></button></div></form></c:otherwise></c:choose>
<%@ include file="../fragments/footer.jspf" %>
