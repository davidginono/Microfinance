<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb' />"><a class="erp-page-path__item erp-page-path__link" href="<c:url value='/finance/groups' />"><spring:message code="group.title" /></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="group.details" /></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="group.details" /></h1><a class="app-btn btn-neutral" href="<c:url value='/finance/groups/${group.id}/cycles' />"><spring:message code="group.cycles" /></a></div>
<c:if test="${not empty groupError}"><div role="alert" class="accounting-error-summary"><spring:message code="${groupError}" /></div></c:if>
<section class="erp-resource-section"><h2><spring:message code="group.summary" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.code" /></dt><dd><c:out value="${group.code}" /></dd></div><div><dt><spring:message code="group.name" /></dt><dd><c:out value="${group.name}" /></dd></div><div><dt><spring:message code="group.legalForm" /></dt><dd><spring:message code="group.legalForm.${group.legalForm}" /></dd></div><div><dt><spring:message code="group.evidence" /></dt><dd><c:out value="${group.evidence}" /></dd></div><div><dt><spring:message code="group.status" /></dt><dd><spring:message code="group.status.${group.status}" /></dd></div></dl>
<sec:authorize access="@access.has(principal,'GROUP_LENDING_UPDATE')"><c:url value="/finance/groups/${group.id}/status" var="statusUrl" /><form action="${statusUrl}" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="version" value="${group.version}" /><input type="hidden" name="active" value="${group.status!='ACTIVE'}" /><button class="app-btn btn-neutral" type="submit"><spring:message code="${group.status=='ACTIVE'?'group.deactivate':'group.reactivate'}" /></button></form></sec:authorize></section>
<section class="erp-table-wrap" data-resource-table="group-members" data-group-register data-table-selection="single"><h2><spring:message code="group.members" /></h2><div class="accounting-actions" data-table-toolbar-for="group-members"><sec:authorize access="@access.has(principal,'GROUP_LENDING_UPDATE')"><button class="app-btn btn-neutral" type="button" data-table-command data-group-command="end" disabled><spring:message code="group.endMembership" /></button></sec:authorize><span class="sr-only" data-group-selection-status aria-live="polite"></span></div><c:url value="/finance/groups/${group.id}" var="memberListUrl" /><form method="get" action="${memberListUrl}" data-table-filter-for="group-members"><input type="hidden" name="sort" value="<c:out value='${sort}' />" /></form><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th scope="col"><span class="sr-only"><spring:message code="voucher.select" /></span></th><c:forEach items="${['client','office','startsOn','endsOn','evidence']}" var="column"><th scope="col" data-table-sort-asc="${column}" data-table-sort-desc="${column}_desc"><spring:message code="group.${column}" /></th></c:forEach></tr></thead><tbody>
<c:forEach items="${members.rows}" var="row"><tr data-group-row="${row.id}" data-active="${empty row.endsOn}" data-target="<c:url value='/finance/groups/${group.id}/members/${row.id}' />"><td><input type="checkbox" aria-label="<spring:message code='voucher.select' /> <c:out value='${row.clientNumber}' />" /></td><td data-group-identity><c:out value="${row.clientNumber}" /> · <c:out value="${row.name}" /></td><td><spring:message code="group.office.${row.office}" /></td><td><c:out value="${appTime:display(row.startsOn)}" /></td><td><c:out value="${appTime:display(row.endsOn)}" /></td><td><c:out value="${row.evidence}" /></td></tr></c:forEach><c:if test="${empty members.rows}"><tr><td colspan="6"><spring:message code="group.members.empty" /></td></tr></c:if>
</tbody></table></div><div data-table-pagination data-page="${members.page}" data-table-for="group-members"><c:forEach items="${[-1,1]}" var="step"><c:url value="/finance/groups/${group.id}" var="pageUrl"><c:param name="page" value="${members.page+step}" /><c:param name="sort" value="${sort}" /></c:url><c:if test="${step==-1?members.page>0:members.hasNext}"><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}' />"><spring:message code="${step==-1?'common.previous':'common.next'}" /></a></c:if></c:forEach></div></section>
<sec:authorize access="@access.has(principal,'GROUP_LENDING_UPDATE')"><c:if test="${group.status=='ACTIVE'}"><div class="accounting-workspace accounting-create-workspace"><c:url value="/finance/groups/${group.id}/members" var="memberUrl" /><c:url value="/finance/groups/clients" var="clientsUrl" />
<form:form modelAttribute="memberForm" method="post" action="${memberUrl}" cssClass="accounting-create-form"><form:hidden path="requestKey" /><div class="accounting-error-summary" role="alert" tabindex="-1"><form:errors path="*" element="p" cssClass="coa-error" /></div><section class="accounting-form accounting-create-card"><h2><spring:message code="group.addMember" /></h2><div class="accounting-grid">
<div data-loan-choice data-choice-url="${clientsUrl}"><label for="group-client"><spring:message code="group.client" /></label><form:select id="group-client" path="clientId" cssClass="aws-control" data-choice-select="true" data-searchable="true"><option value=""><spring:message code="voucher.choose" /></option><c:if test="${not empty selectedClient}"><option value="${selectedClient.id}" selected><c:out value="${selectedClient.label}" /></option></c:if></form:select><%@ include file="../accounting/loans/choice-search.jspf" %></div>
<label><spring:message code="group.office" /><form:select path="office" cssClass="aws-control"><c:forEach items="${['MEMBER','CHAIRPERSON','SECRETARY','TREASURER']}" var="office"><form:option value="${office}"><spring:message code="group.office.${office}" /></form:option></c:forEach></form:select></label>
<label><spring:message code="group.startsOn" /><input class="aws-control" type="date" name="startsOn" value="<c:out value='${memberForm.startsOn}' />" required /></label><label><spring:message code="group.evidence" /><form:input path="evidence" cssClass="aws-control" maxlength="500" required="required" /></label>
</div></section><div class="accounting-actions accounting-form-actions"><button class="app-btn btn-launch" type="submit"><spring:message code="group.addMember" /></button></div></form:form></div></c:if></sec:authorize>
<script src="<c:url value='/js/loan-recording.js' />" defer></script><script src="<c:url value='/js/group-lending.js' />" defer></script><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
