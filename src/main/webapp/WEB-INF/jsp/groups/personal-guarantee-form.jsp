<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %><link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css'/>"/>
<c:set var="source" value="${workspace.source}"/><c:url value="/finance/groups/cycles/${source.cycle}/personal-guarantees" var="guaranteesPath"/><c:url value="/finance/groups/cycles/${source.cycle}/personal-guarantees/clients" var="clientsUrl"/>
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb'/>"><a class="erp-page-path__link" href="${guaranteesPath}"><spring:message code="personalGuarantee.title"/></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="personalGuarantee.create"/></span></nav><div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="personalGuarantee.create"/></h1></div><div class="accounting-workspace accounting-create-workspace"><%@ include file="personal-guarantee-source.jspf" %>
<form:form modelAttribute="personalGuaranteeForm" action="${guaranteesPath}" method="post" enctype="multipart/form-data" cssClass="accounting-create-form" data-preserve-submit-command="true"><form:hidden path="requestKey"/><form:hidden path="document.documentRequestKey"/><div class="accounting-error-summary" role="alert" tabindex="-1"><form:errors path="*" element="p" cssClass="coa-error"/></div>
<section class="accounting-form accounting-create-card"><h2><spring:message code="personalGuarantee.guarantor"/></h2><div class="accounting-grid erp-panel-body"><div data-loan-choice data-choice-url="${clientsUrl}"><label for="personal-guarantor"><spring:message code="personalGuarantee.guarantor"/></label><form:select path="clientId" id="personal-guarantor" cssClass="aws-control" data-choice-select="true" data-searchable="true"><option value=""><spring:message code="voucher.choose"/></option><c:if test="${not empty workspace.selected}"><option value="${workspace.selected.id}" selected><c:out value="${workspace.selected.number}"/> · <c:out value="${workspace.selected.name}"/></option></c:if></form:select><form:errors path="clientId" cssClass="coa-error"/><%@ include file="../accounting/loans/choice-search.jspf" %></div><label><spring:message code="personalGuarantee.capacity"/> (TZS)<form:input path="capacity" cssClass="aws-control" type="number" min="0.01" step="0.01" required="required"/><form:errors path="capacity" cssClass="coa-error"/></label><label><spring:message code="personalGuarantee.capacityEvidence"/><form:input path="capacityEvidence" cssClass="aws-control" maxlength="500" required="required"/><form:errors path="capacityEvidence" cssClass="coa-error"/></label><label><spring:message code="personalGuarantee.validThrough"/><form:input path="validThrough" cssClass="aws-control" type="date" required="required"/><form:errors path="validThrough" cssClass="coa-error"/></label></div><p class="erp-panel-body"><spring:message code="personalGuarantee.deadlineNote"/></p></section>
<section class="accounting-form accounting-create-card"><h2><spring:message code="personalGuarantee.document"/></h2><div class="accounting-grid erp-panel-body"><label><spring:message code="orgDocument.file"/><input class="aws-control" type="file" name="termsPdf" accept="application/pdf,.pdf" required/></label><label><spring:message code="orgDocument.reference"/><form:input path="document.documentReference" cssClass="aws-control" maxlength="500" required="required"/></label><label><spring:message code="orgDocument.language"/><form:select path="document.documentLanguage" cssClass="aws-control"><option value=""><spring:message code="voucher.choose"/></option><c:forEach items="${['EN','SW','BOTH']}" var="language"><form:option value="${language}"><spring:message code="orgDocument.language.${language}"/></form:option></c:forEach></form:select></label><c:forEach items="${['institutionAddress','contactPhone','contactEmail','complaintPhone','complaintEmail','complaintAddress']}" var="field"><label><spring:message code="orgDocument.${field}"/><form:input path="document.${field}" cssClass="aws-control" maxlength="${field=='institutionAddress'||field=='complaintAddress'?500:field=='contactEmail'||field=='complaintEmail'?160:80}"/></label></c:forEach></div><div class="erp-panel-body"><label class="aws-settings-checkbox-row"><form:checkbox path="document.documentChecked" cssClass="aws-settings-checkbox" required="required"/><span class="aws-settings-checkbox-copy"><spring:message code="personalGuarantee.checked"/></span></label></div></section><div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" href="${guaranteesPath}"><spring:message code="common.cancel"/></a><button class="app-btn btn-launch" type="submit"><spring:message code="personalGuarantee.create"/></button></div></form:form></div><script src="<c:url value='/js/loan-recording.js'/>" defer></script><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
