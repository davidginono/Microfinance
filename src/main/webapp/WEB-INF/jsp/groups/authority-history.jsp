<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb' />"><a class="erp-page-path__link" href="<c:url value='/finance/groups/${group.id}' />"><spring:message code="group.details" /></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="authority.title" /></span></nav>
<div class="erp-page-header"><h1 id="authority-title" class="erp-page-title"><spring:message code="authority.title" /></h1></div>
<section class="erp-resource-section"><h2><spring:message code="group.details" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.code" /></dt><dd><c:out value="${group.code}" /></dd></div><div><dt><spring:message code="group.name" /></dt><dd><c:out value="${group.name}" /></dd></div></dl></section>
<section class="erp-table-wrap" data-resource-table="group-authority" data-group-register data-table-selection="single" data-table-title-id="authority-title">
<form method="get" data-table-filter-for="group-authority"><input type="hidden" name="sort" value="<c:out value='${sort}' />" /></form>
<div class="accounting-actions" data-table-toolbar-for="group-authority"><button class="app-btn btn-neutral" data-table-command data-group-command="view" type="button" disabled><spring:message code="group.open" /></button><sec:authorize access="@access.has(principal,'GROUP_AUTHORITY_CREATE')"><a class="app-btn btn-launch" href="<c:url value='/finance/groups/${group.id}/authority/new' />"><spring:message code="authority.record" /></a></sec:authorize></div>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th scope="col"><span class="sr-only"><spring:message code="voucher.select" /></span></th><c:forEach items="${['revision','from','through','principal','state']}" var="column"><th scope="col" data-table-sort-asc="${column}" data-table-sort-desc="${column}_desc"><spring:message code="authority.${column}" /></th></c:forEach></tr></thead><tbody>
<c:forEach items="${history.rows}" var="row"><tr data-group-row="${row.id}" data-target="<c:url value='/finance/groups/${group.id}/authority/${row.id}' />"><td><input type="checkbox" aria-label="<spring:message code='voucher.select' /> <c:out value='${row.revision}' />" /></td><td data-group-identity><a class="resource-table-id-link" href="<c:url value='/finance/groups/${group.id}/authority/${row.id}' />"><c:out value="${row.revision}" /></a></td><td><c:out value="${appTime:display(row.validFrom)}" /></td><td><c:out value="${appTime:display(row.validThrough)}" /></td><td>TZS <c:out value="${row.maxPrincipal}" /></td><td><span data-resource-status="${row.state=='CURRENT'?'ACTIVE':row.state=='NOT_YET_VALID'?'PENDING':'INACTIVE'}"><spring:message code="authority.state.${row.state}" /></span></td></tr></c:forEach>
<c:if test="${empty history.rows}"><tr><td colspan="6"><spring:message code="authority.empty" /></td></tr></c:if>
</tbody></table></div><div data-table-pagination data-page="${history.page}" data-table-for="group-authority"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?history.page>0:history.hasNext}"><c:url value="/finance/groups/${group.id}/authority" var="pageUrl"><c:param name="page" value="${history.page+step}" /><c:param name="sort" value="${sort}" /></c:url><a data-page-direction="${step==-1?'previous':'next'}" href="<c:out value='${pageUrl}' />"><spring:message code="${step==-1?'common.previous':'common.next'}" /></a></c:if></c:forEach></div>
</section><script src="<c:url value='/js/group-lending.js' />" defer></script><%@ include file="../fragments/footer.jspf" %>
