<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %><link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css'/>"/>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="coverage.create"/></h1></div><div class="accounting-workspace accounting-create-workspace"><section class="erp-resource-section"><h2><spring:message code="coverage.obligation"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.loan"/></dt><dd><c:out value="${source.loanNumber}"/></dd></div><div><dt><spring:message code="coverage.borrower"/></dt><dd><c:out value="${source.borrower}"/></dd></div><div><dt><spring:message code="coverage.person"/></dt><dd><c:out value="${source.name}"/></dd></div><div><dt><spring:message code="coverage.kind"/></dt><dd><spring:message code="coverage.kind.${source.kind}"/></dd></div><div><dt><spring:message code="coverage.cap"/></dt><dd><fmt:formatNumber value="${source.cap}" minFractionDigits="2" maxFractionDigits="2"/> TZS</dd></div><div><dt><spring:message code="coverage.arrears"/></dt><dd><fmt:formatNumber value="${source.arrears}" minFractionDigits="2" maxFractionDigits="2"/> TZS</dd></div><div><dt><spring:message code="coverage.noticeDays"/></dt><dd><c:out value="${policy.noticeDays}"/></dd></div></dl></section>
<c:url value="/finance/groups/coverage?cycle=${cycle}" var="submitPath"/><form:form modelAttribute="coverageCall" action="${submitPath}" method="post" enctype="multipart/form-data" cssClass="accounting-create-form" data-preserve-submit-command="true"><form:hidden path="requestKey"/><form:hidden path="sourceId"/><form:hidden path="sourceKind"/><form:hidden path="policyId"/><section class="accounting-form accounting-create-card"><h2><spring:message code="coverage.notices"/></h2><div class="accounting-grid erp-panel-body"><label><spring:message code="coverage.requested"/><form:input path="amount" type="number" cssClass="aws-control" min="0.01" step="0.01" required="required"/><form:errors path="amount" cssClass="coa-error"/></label><label><spring:message code="coverage.borrowerNoticeDate"/><form:input path="borrowerNoticeDate" type="date" cssClass="aws-control" required="required"/><form:errors path="borrowerNoticeDate" cssClass="coa-error"/></label><label><spring:message code="coverage.personNoticeDate"/><form:input path="personNoticeDate" type="date" cssClass="aws-control" required="required"/><form:errors path="personNoticeDate" cssClass="coa-error"/></label><label><spring:message code="coverage.borrowerNoticeEvidence"/><form:input path="borrowerNoticeEvidence" type="text" cssClass="aws-control" maxlength="500" required="required"/><form:errors path="borrowerNoticeEvidence" cssClass="coa-error"/></label><label><spring:message code="coverage.personNoticeEvidence"/><form:input path="personNoticeEvidence" type="text" cssClass="aws-control" maxlength="500" required="required"/><form:errors path="personNoticeEvidence" cssClass="coa-error"/></label><label><spring:message code="orgDocument.language"/><form:select path="noticeLanguage" cssClass="aws-control"><option value=""><spring:message code="voucher.choose"/></option><form:option value="SW"><spring:message code="orgDocument.language.SW"/></form:option><form:option value="BOTH"><spring:message code="orgDocument.language.BOTH"/></form:option></form:select></label><label><spring:message code="coverage.noticePdf"/><input type="file" class="aws-control" name="noticePdf" accept="application/pdf,.pdf" required/></label><label class="aws-settings-checkbox-row"><form:checkbox path="noticesVerified" cssClass="aws-settings-checkbox" required="required"/><span><spring:message code="coverage.noticesVerified"/></span></label></div></section>
<p><spring:message code="coverage.uploadAgain"/></p><div role="alert"><form:errors path="" element="p" cssClass="coa-error"/></div><div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" href="/finance/groups/coverage?cycle=${cycle}"><spring:message code="common.cancel"/></a><button class="app-btn btn-launch" type="submit"><spring:message code="coverage.create"/></button></div></form:form></div><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
