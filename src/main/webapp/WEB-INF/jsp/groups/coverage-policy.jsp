<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %><link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css'/>"/>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="coverage.policy"/></h1></div><div class="accounting-workspace accounting-create-workspace"><c:url value="/finance/groups/coverage/policy?cycle=${cycle}" var="submitPath"/><form:form modelAttribute="coveragePolicy" action="${submitPath}" method="post" cssClass="accounting-create-form" data-preserve-submit-command="true"><form:hidden path="requestKey"/><form:hidden path="expectedPreviousId"/><section class="accounting-form accounting-create-card"><h2><spring:message code="coverage.policy"/></h2><div class="accounting-grid erp-panel-body"><label><spring:message code="coverage.reference"/><form:input path="reference" type="text" cssClass="aws-control" maxlength="500" required="required"/><form:errors path="reference" cssClass="coa-error"/></label><label><spring:message code="coverage.noticeDays"/><form:input path="noticeDays" type="number" cssClass="aws-control" min="14" max="365" required="required"/><form:errors path="noticeDays" cssClass="coa-error"/></label><label><spring:message code="coverage.caseDays"/><form:input path="caseDays" type="number" cssClass="aws-control" min="1" max="365" required="required"/><form:errors path="caseDays" cssClass="coa-error"/></label><label><spring:message code="coverage.promiseDays"/><form:input path="promiseDays" type="number" cssClass="aws-control" min="1" max="365" required="required"/><form:errors path="promiseDays" cssClass="coa-error"/></label><label><spring:message code="coverage.enabled"/><form:checkbox path="enabled"/></label><label class="aws-settings-checkbox-row"><form:checkbox path="verified" cssClass="aws-settings-checkbox" required="required"/><span><spring:message code="coverage.policyVerified"/></span></label></div></section>
<div role="alert"><form:errors path="" element="p" cssClass="coa-error"/></div><div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" href="/finance/groups/coverage?cycle=${cycle}"><spring:message code="common.cancel"/></a><button class="app-btn btn-launch" type="submit"><spring:message code="coverage.recordPolicy"/></button></div></form:form></div><%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="../fragments/footer.jspf" %>
