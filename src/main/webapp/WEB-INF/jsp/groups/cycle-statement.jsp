<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ include file="../fragments/header.jspf" %><%@ include file="../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css'/>"/>
<c:if test="${empty statementPath}"><c:set var="statementPath" value="/finance/groups/cycles/${statement.context.cycle}/statement"/></c:if>
<div class="accounting-workspace" data-group-cycle-statement data-generated-at="${statement.generatedAt}">
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb'/>"><a class="erp-page-path__link" href="<c:url value='${organizationAccount?"/app/group-loans":"/finance/groups/cycles/".concat(statement.context.cycle)}'/>"><spring:message code="${organizationAccount?'group.clientLoans':'group.cycle'}"/></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="cycleStatement.title"/></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="cycleStatement.title"/></h1><div class="accounting-actions"><c:if test="${canExport}"><c:forEach items="${['pdf','print']}" var="format"><c:url value="${statementPath}/${format}" var="exportUrl"><c:param name="coveragePage" value="${statement.coverage.page}"/><c:param name="from" value="${statement.from}"/><c:param name="through" value="${statement.through}"/></c:url><a class="app-btn btn-neutral" href="<c:out value='${exportUrl}'/>" ${format=='print'?'target="_blank" rel="noopener"':''}><spring:message code="management.${format}"/></a></c:forEach></c:if></div></div>
<section class="erp-resource-section"><h2><spring:message code="group.summary"/></h2><dl class="erp-detail-facts"><c:forEach items="${['institution','branch','code','name','model','state']}" var="field"><div><dt><spring:message code="cycleStatement.context.${field}"/></dt><dd><c:choose><c:when test="${field=='model'}"><spring:message code="group.model.${statement.context.model}"/></c:when><c:when test="${field=='state'}"><spring:message code="group.cycleState.${statement.context.state}"/></c:when><c:otherwise><c:out value="${statement.context[field]}"/></c:otherwise></c:choose></dd></div></c:forEach><div><dt><spring:message code="memberStatement.asOf"/></dt><dd><c:out value="${appTime:display(statement.asOf)}"/></dd></div><div><dt><spring:message code="cycleStatement.agreed"/></dt><dd><fmt:formatNumber value="${statement.totals.agreed}" minFractionDigits="2" maxFractionDigits="2"/> TZS</dd></div><div><dt><spring:message code="cycleStatement.loanCount"/></dt><dd><c:out value="${statement.totals.loans}"/></dd></div></dl>
<c:choose><c:when test="${statement.totals.funded==0}"><p><spring:message code="sharedStatement.unfunded"/></p></c:when><c:when test="${not statement.totals.known()}"><p role="status"><spring:message code="cycleStatement.unknown"/></p></c:when><c:otherwise><dl class="erp-detail-facts"><c:forEach items="${['fundedPrincipal','principal','dueInterest','futureInterest','charges','arrears']}" var="field"><div><dt><spring:message code="cycleStatement.balance.${field}"/></dt><dd><fmt:formatNumber value="${statement.totals[field]}" minFractionDigits="2" maxFractionDigits="2"/> TZS</dd></div></c:forEach><div><dt><spring:message code="cycleStatement.outstanding"/></dt><dd><fmt:formatNumber value="${statement.totals.outstanding()}" minFractionDigits="2" maxFractionDigits="2"/> TZS</dd></div><div><dt><spring:message code="cycleStatement.nextDue"/></dt><dd><c:out value="${empty statement.totals.nextDue?'—':appTime:display(statement.totals.nextDue)}"/></dd></div></dl></c:otherwise></c:choose></section>
<form method="get" action="<c:url value='${statementPath}'/>" class="resource-table-filters"><label><spring:message code="management.from"/><input class="aws-control" type="date" name="from" value="${statement.from}" max="${statement.asOf}"/></label><label><spring:message code="management.through"/><input class="aws-control" type="date" name="through" value="${statement.through}" max="${statement.asOf}" required/></label><button class="app-btn btn-neutral"><spring:message code="management.run"/></button></form>
<p><spring:message code="memberStatement.filterNote"/></p>
<section class="erp-table-wrap" data-resource-table="cycle-statement-loans"><h2><spring:message code="cycleStatement.loans"/></h2><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="server-statement"><thead><tr><th scope="col"><spring:message code="group.loan"/></th><th scope="col"><spring:message code="group.client"/></th><th scope="col"><spring:message code="group.status"/></th><th scope="col"><spring:message code="group.principal"/></th><th scope="col"><spring:message code="sharedStatement.principal"/></th><th scope="col"><spring:message code="memberStatement.wholeDueInterest"/></th><th scope="col"><spring:message code="cycleStatement.future"/></th><th scope="col"><spring:message code="sharedStatement.charges"/></th><th scope="col"><spring:message code="memberStatement.wholeArrears"/></th><th scope="col"><spring:message code="cycleStatement.outstanding"/></th><th scope="col"><spring:message code="cycleStatement.nextDue"/></th></tr></thead><tbody><c:forEach items="${statement.loans}" var="row"><tr><td><c:choose><c:when test="${statement.loanLinks}"><a class="resource-table-id-link" href="<c:url value='/finance/loan-records/${row.id}'/>"><c:out value="${row.number}"/></a></c:when><c:otherwise><c:out value="${row.number}"/></c:otherwise></c:choose></td><td><c:out value="${row.borrowerNumber}"/> · <c:out value="${row.borrower}"/></td><td><spring:message code="recording.status.${row.status}"/></td><td><fmt:formatNumber value="${row.original}" minFractionDigits="2" maxFractionDigits="2"/></td><c:forEach items="${['principal','dueInterest','futureInterest','charges','arrears']}" var="field"><td><c:choose><c:when test="${row.funded and row.known}"><fmt:formatNumber value="${row[field]}" minFractionDigits="2" maxFractionDigits="2"/></c:when><c:otherwise>—</c:otherwise></c:choose></td></c:forEach><td><c:choose><c:when test="${row.funded and row.known}"><fmt:formatNumber value="${row.outstanding()}" minFractionDigits="2" maxFractionDigits="2"/></c:when><c:otherwise>—</c:otherwise></c:choose></td><td><c:out value="${row.funded and row.known and not empty row.nextDue?appTime:display(row.nextDue):'—'}"/></td></tr></c:forEach></tbody></table></div><div data-table-pagination data-table-for="cycle-statement-loans" data-page="${statement.loanPage}"><c:forEach items="${['previous','next']}" var="move"><c:if test="${move=='previous'?statement.loanPage>0:statement.moreLoans}"><c:url value="${statementPath}" var="pageUrl"><c:param name="coveragePage" value="${statement.coverage.page}"/><c:param name="from" value="${statement.from}"/><c:param name="through" value="${statement.through}"/><c:param name="loanPage" value="${statement.loanPage+(move=='previous'?-1:1)}"/><c:param name="page" value="${statement.page}"/><c:param name="contributionPage" value="${statement.contributionPage}"/><c:param name="allocationPage" value="${statement.allocationPage}"/></c:url><a data-page-direction="${move}" href="<c:out value='${pageUrl}'/>"><spring:message code="common.${move}"/></a></c:if></c:forEach></div></section><c:if test="${statement.context.model=='SHARED'}"><section class="erp-table-wrap" data-resource-table="cycle-statement-allocations"><h2><spring:message code="cycleStatement.allocations"/></h2><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="server-statement"><thead><tr><th scope="col"><spring:message code="group.client"/></th><th scope="col"><spring:message code="group.principal"/></th><th scope="col"><spring:message code="sharedStatement.principal"/></th><th scope="col"><spring:message code="sharedStatement.interest"/></th><th scope="col"><spring:message code="sharedStatement.charges"/></th><th scope="col"><spring:message code="sharedStatement.excluded"/></th><th scope="col"><spring:message code="memberStatement.waived"/></th><th scope="col"><spring:message code="memberStatement.writtenOff"/></th></tr></thead><tbody><c:forEach items="${statement.allocations}" var="row"><tr><td><c:choose><c:when test="${statement.loanLinks}"><a class="resource-table-id-link" href="<c:url value='/finance/groups/cycles/${statement.context.cycle}/allocations/${row.client}/statement'/>"><c:out value="${row.number}"/></a></c:when><c:otherwise><c:out value="${row.number}"/></c:otherwise></c:choose> · <c:out value="${row.name}"/></td><td><fmt:formatNumber value="${row.principal}" minFractionDigits="2" maxFractionDigits="2"/></td><c:forEach items="${[row.remainingPrincipal(),row.remainingInterest(),row.remainingCharges(),row.excludedInterest,row.waivedInterest,row.writtenOff]}" var="amount"><td><c:choose><c:when test="${row.known}"><fmt:formatNumber value="${amount}" minFractionDigits="2" maxFractionDigits="2"/></c:when><c:otherwise>—</c:otherwise></c:choose></td></c:forEach></tr></c:forEach></tbody></table></div><div data-table-pagination data-table-for="cycle-statement-allocations" data-page="${statement.allocationPage}"><c:forEach items="${['previous','next']}" var="move"><c:if test="${move=='previous'?statement.allocationPage>0:statement.moreAllocations}"><c:url value="${statementPath}" var="pageUrl"><c:param name="coveragePage" value="${statement.coverage.page}"/><c:param name="from" value="${statement.from}"/><c:param name="through" value="${statement.through}"/><c:param name="loanPage" value="${statement.loanPage}"/><c:param name="page" value="${statement.page}"/><c:param name="contributionPage" value="${statement.contributionPage}"/><c:param name="allocationPage" value="${statement.allocationPage+(move=='previous'?-1:1)}"/></c:url><a data-page-direction="${move}" href="<c:out value='${pageUrl}'/>"><spring:message code="common.${move}"/></a></c:if></c:forEach></div><p><spring:message code="cycleStatement.allocationNote"/></p></section></c:if><section class="erp-table-wrap" data-resource-table="cycle-statement-activity"><h2><spring:message code="cycleStatement.activity"/></h2><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="server-statement"><thead><tr><th scope="col"><spring:message code="voucher.date"/></th><th scope="col"><spring:message code="group.loan"/></th><th scope="col"><spring:message code="memberStatement.reference"/></th><th scope="col"><spring:message code="group.status"/></th><th scope="col"><spring:message code="group.payer"/></th><th scope="col"><spring:message code="cycleStatement.cash"/></th><th scope="col"><spring:message code="recording.principal"/></th><th scope="col"><spring:message code="recording.interest"/></th><th scope="col"><spring:message code="charges.title"/></th><th scope="col"><spring:message code="memberStatement.nonCash"/></th><th scope="col"><spring:message code="cycleStatement.nonCash"/></th></tr></thead><tbody><c:forEach items="${statement.movements}" var="row"><tr><td><c:out value="${appTime:display(row.date)}"/></td><td><c:out value="${row.loanNumber}"/></td><td><c:choose><c:when test="${statement.receiptLinks and not empty row.receiptId}"><a class="resource-table-id-link" href="<c:url value='/finance/vouchers/receipts/${row.receiptId}'/>"><c:out value="${row.reference}"/></a></c:when><c:otherwise><c:out value="${row.reference}"/></c:otherwise></c:choose><c:if test="${not empty row.reverses}"><br/><spring:message code="memberStatement.reverses"/>: <c:out value="${row.reverses}"/></c:if></td><td><spring:message code="cycleStatement.kind.${row.kind}"/></td><td><c:out value="${row.payer}"/></td><c:forEach items="${['cash','principal','interest','charges','excluded','nonCash']}" var="field"><td><fmt:formatNumber value="${row[field]}" minFractionDigits="2" maxFractionDigits="2"/></td></c:forEach></tr></c:forEach></tbody></table></div><div data-table-pagination data-table-for="cycle-statement-activity" data-page="${statement.page}"><c:forEach items="${['previous','next']}" var="move"><c:if test="${move=='previous'?statement.page>0:statement.moreMovements}"><c:url value="${statementPath}" var="pageUrl"><c:param name="coveragePage" value="${statement.coverage.page}"/><c:param name="from" value="${statement.from}"/><c:param name="through" value="${statement.through}"/><c:param name="loanPage" value="${statement.loanPage}"/><c:param name="page" value="${statement.page+(move=='previous'?-1:1)}"/><c:param name="contributionPage" value="${statement.contributionPage}"/><c:param name="allocationPage" value="${statement.allocationPage}"/></c:url><a data-page-direction="${move}" href="<c:out value='${pageUrl}'/>"><spring:message code="common.${move}"/></a></c:if></c:forEach></div></section><c:if test="${not organizationAccount}"><section class="erp-table-wrap" data-resource-table="cycle-statement-contributions"><h2><spring:message code="cycleStatement.contributions"/></h2><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="server-statement"><thead><tr><th scope="col"><spring:message code="voucher.date"/></th><th scope="col"><spring:message code="memberStatement.reference"/></th><th scope="col"><spring:message code="group.loan"/></th><th scope="col"><spring:message code="group.payer"/></th><th scope="col"><spring:message code="cycleStatement.beneficiary"/></th><th scope="col"><spring:message code="group.status"/></th><th scope="col"><spring:message code="voucher.amount"/></th><th scope="col"><spring:message code="recording.principal"/></th><th scope="col"><spring:message code="recording.interest"/></th><th scope="col"><spring:message code="charges.title"/></th></tr></thead><tbody><c:forEach items="${statement.contributions}" var="row"><tr><td><c:out value="${appTime:display(row.date)}"/></td><td><c:choose><c:when test="${statement.receiptLinks}"><a class="resource-table-id-link" href="<c:url value='/finance/vouchers/receipts/${row.receiptId}'/>"><c:out value="${row.receipt}"/></a></c:when><c:otherwise><c:out value="${row.receipt}"/></c:otherwise></c:choose></td><td><c:out value="${row.loan}"/></td><td><c:out value="${row.payer}"/></td><td><c:out value="${row.beneficiary}"/></td><td><spring:message code="memberStatement.kind.${row.reversal?'REVERSAL':'PAYMENT'}"/></td><c:forEach items="${['amount','principal','interest','charges']}" var="field"><td><fmt:formatNumber value="${row[field]}" minFractionDigits="2" maxFractionDigits="2"/></td></c:forEach></tr></c:forEach></tbody></table></div><div data-table-pagination data-table-for="cycle-statement-contributions" data-page="${statement.contributionPage}"><c:forEach items="${['previous','next']}" var="move"><c:if test="${move=='previous'?statement.contributionPage>0:statement.moreContributions}"><c:url value="${statementPath}" var="pageUrl"><c:param name="coveragePage" value="${statement.coverage.page}"/><c:param name="from" value="${statement.from}"/><c:param name="through" value="${statement.through}"/><c:param name="loanPage" value="${statement.loanPage}"/><c:param name="page" value="${statement.page}"/><c:param name="contributionPage" value="${statement.contributionPage+(move=='previous'?-1:1)}"/><c:param name="allocationPage" value="${statement.allocationPage}"/></c:url><a data-page-direction="${move}" href="<c:out value='${pageUrl}'/>"><spring:message code="common.${move}"/></a></c:if></c:forEach></div></section></c:if><%@ include file="coverage-statement.jspf" %><p><spring:message code="cycleStatement.note"/></p></div><script src="<c:url value='/js/group-cycle-statement.js'/>" defer></script><%@ include file="../fragments/footer.jspf" %>
