<%@ page pageEncoding="UTF-8" %>
<%@ include file="coverage-head.jspf" %>
<c:set var="pickerTitle" value="${picker=='source'?'coverage.choosePerson':'coverage.chooseReceipt'}"/><c:choose><c:when test="${picker=='source'}"><c:set var="pickerPath" value="${coverageUrl}/new"/></c:when><c:otherwise><c:set var="pickerPath" value="${coverageUrl}/${caseHeader.id}/link"/></c:otherwise></c:choose>
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb'/>"><a class="erp-page-path__link" href="${coverageUrl}"><spring:message code="coverage.title"/></a><span aria-hidden="true">›</span><span aria-current="page"><spring:message code="${pickerTitle}"/></span></nav><div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="${pickerTitle}"/></h1></div>
<div class="accounting-create-workspace"><c:if test="${picker=='payment'}"><%@ include file="coverage-summary.jspf" %></c:if><section class="erp-resource-section"><h2><spring:message code="common.search"/></h2><form method="get" action="${pickerPath}" class="erp-panel-body erp-table-toolbar"><label><spring:message code="common.search"/><input class="aws-control" name="search" maxlength="100" value="<c:out value='${search}'/>"/></label><button class="app-btn btn-neutral" type="submit"><spring:message code="common.search"/></button><a class="app-btn btn-neutral" href="${pickerPath}"><spring:message code="common.clear"/></a></form></section>
<form method="get" action="${pickerPath}" class="accounting-create-form"><section class="erp-resource-section"><h2><spring:message code="${pickerTitle}"/></h2><div class="erp-panel-body"><c:choose><c:when test="${empty choices.rows}"><p role="status"><spring:message code="coverage.noChoices"/></p></c:when><c:otherwise><label><spring:message code="${pickerTitle}"/><select class="aws-control" name="choice" required><option value=""><spring:message code="voucher.choose"/></option><c:forEach items="${choices.rows}" var="row"><c:choose><c:when test="${picker=='source'}"><option value="${row.kind}:${row.id}"><c:out value="${row.loanNumber}"/> · <c:out value="${row.number}"/> · <c:out value="${row.name}"/> · <spring:message code="coverage.sourceKind.${row.kind}"/></option></c:when><c:otherwise><option value="${row.posting}<c:if test='${not empty row.contribution}'>:${row.contribution}</c:if>"><c:out value="${row.reference}"/> · <c:out value="${appTime:display(row.date)}"/> · <c:out value="${row.payer}"/> · TZS <fmt:formatNumber value="${row.amount}" minFractionDigits="2" maxFractionDigits="2"/></option></c:otherwise></c:choose></c:forEach></select></label></c:otherwise></c:choose>
<div class="accounting-actions"><c:forEach items="${[-1,1]}" var="step"><c:if test="${step==-1?choices.page>0:choices.hasNext}"><c:url value="${pickerPath}" var="pageUrl"><c:param name="page" value="${choices.page+step}"/><c:param name="search" value="${search}"/></c:url><a class="app-btn btn-neutral" href="<c:out value='${pageUrl}'/>"><spring:message code="${step==-1?'common.previous':'common.next'}"/></a></c:if></c:forEach></div></div></section><div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" href="${coverageUrl}"><spring:message code="common.cancel"/></a><button class="app-btn btn-launch" type="submit" ${empty choices.rows?'disabled':''}><spring:message code="common.continue"/></button></div></form></div><%@ include file="../fragments/footer.jspf" %>
