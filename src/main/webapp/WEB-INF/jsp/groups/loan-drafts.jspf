<c:if test="${not empty groupDrafts.rows}"><section class="erp-table-wrap" data-resource-table="group-loan-drafts" data-table-page-param="draftPage"><h2><spring:message code="simpleGroup.drafts" /></h2><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="simpleGroup.draft" /></th><th data-table-order="actor"><spring:message code="simpleGroup.savedBy" /></th><th data-table-order="updated"><spring:message code="simpleGroup.savedOn" /></th><th data-table-order="amount"><spring:message code="recording.principal" /> (TZS)</th></tr></thead><tbody>
<c:forEach items="${groupDrafts.rows}" var="draft"><tr><td><a class="resource-table-id-link" href="<c:url value='/finance/loan-records/new?groupDraftId=${draft.id}' />"><spring:message code="simpleGroup.draft" /></a></td><td><c:out value="${draft.actor}" /></td><td><c:out value="${appTime:display(draft.updated)}" /></td><td><c:out value="${draft.amount}" /></td></tr></c:forEach>
</tbody></table></div><div data-table-pagination data-page="${groupDrafts.page}" data-table-for="group-loan-drafts"><c:if test="${groupDrafts.page>0}"><a data-page-direction="previous" href="<c:url value='/finance/groups/${group.id}'><c:param name='draftPage' value='${groupDrafts.page-1}' /><c:param name='tableSort[group-loan-drafts]' value="${param['tableSort[group-loan-drafts]']}" /><c:param name='tableDirection[group-loan-drafts]' value="${param['tableDirection[group-loan-drafts]']}" /></c:url>"><spring:message code="common.previous" /></a></c:if><c:if test="${groupDrafts.hasNext}"><a data-page-direction="next" href="<c:url value='/finance/groups/${group.id}'><c:param name='draftPage' value='${groupDrafts.page+1}' /><c:param name='tableSort[group-loan-drafts]' value="${param['tableSort[group-loan-drafts]']}" /><c:param name='tableDirection[group-loan-drafts]' value="${param['tableDirection[group-loan-drafts]']}" /></c:url>"><spring:message code="common.next" /></a></c:if></div></section></c:if>
