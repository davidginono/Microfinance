<c:set var="caseRecord" value="${coverage.header}"/><c:set var="caseBase" value="${coverage.staff?'/finance/groups/coverage':'/app/group-coverage'}"/><c:url value="${caseBase}/${caseRecord.id}" var="casePath"/>
<section class="erp-resource-section"><h2><spring:message code="coverage.case"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="group.loan"/></dt><dd><c:out value="${caseRecord.loanNumber}"/></dd></div><div><dt><spring:message code="coverage.borrower"/></dt><dd><c:out value="${caseRecord.borrower}"/></dd></div><div><dt><spring:message code="coverage.person"/></dt><dd><c:out value="${caseRecord.number}"/> · <c:out value="${caseRecord.name}"/></dd></div><div><dt><spring:message code="coverage.kind"/></dt><dd><spring:message code="coverage.kind.${caseRecord.sourceKind}"/></dd></div><div><dt><spring:message code="group.status"/></dt><dd><spring:message code="coverage.state.${caseRecord.state}"/></dd></div><div><dt><spring:message code="coverage.requested"/></dt><dd><fmt:formatNumber value="${caseRecord.requested}" minFractionDigits="2" maxFractionDigits="2"/> TZS</dd></div><div><dt><spring:message code="coverage.received"/></dt><dd><fmt:formatNumber value="${caseRecord.received}" minFractionDigits="2" maxFractionDigits="2"/> TZS</dd></div><div><dt><spring:message code="coverage.unpaid"/></dt><dd><c:choose><c:when test="${not empty caseRecord.unpaid}"><fmt:formatNumber value="${caseRecord.unpaid}" minFractionDigits="2" maxFractionDigits="2"/> TZS</c:when><c:otherwise><spring:message code="coverage.unavailable"/></c:otherwise></c:choose></dd></div><div><dt><spring:message code="coverage.expires"/></dt><dd><c:out value="${appTime:display(caseRecord.expiresOn)}"/></dd></div><div><dt><spring:message code="coverage.terms"/></dt><dd><c:out value="${caseRecord.terms}"/></dd></div></dl><p><spring:message code="coverage.noDebtChange"/></p></section>
