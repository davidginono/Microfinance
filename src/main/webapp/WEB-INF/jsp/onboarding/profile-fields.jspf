<%@ page pageEncoding="UTF-8" %>
<spring:message code="kyc.field.hasBusiness" var="profileBusinessLabel" htmlEscape="true"/>
<spring:message code="kyc.field.maritalStatus" var="profileMaritalLabel" htmlEscape="true"/>
<section class="erp-resource-section" data-profile-section="personal"><h2><spring:message code="kyc.section.bio"/></h2>
<div class="kyc-profile-grid">
<label class="kyc-field"><span><spring:message code="kyc.field.firstName"/> *</span><form:input path="profile.firstName" type="text" cssClass="aws-control" readonly="${identityReadOnly}" maxlength="80" required="true"/><form:errors path="profile.firstName" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.middleName"/></span><form:input path="profile.middleName" type="text" cssClass="aws-control" readonly="${identityReadOnly}" maxlength="80"/><form:errors path="profile.middleName" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.lastName"/> *</span><form:input path="profile.lastName" type="text" cssClass="aws-control" readonly="${identityReadOnly}" maxlength="80" required="true"/><form:errors path="profile.lastName" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.gender"/></span><form:select path="profile.gender" cssClass="aws-control"><form:option value=""><spring:message code="kyc.choose"/></form:option><form:option value="MALE"><spring:message code="kyc.gender.MALE"/></form:option><form:option value="FEMALE"><spring:message code="kyc.gender.FEMALE"/></form:option><form:option value="OTHER"><spring:message code="kyc.gender.OTHER"/></form:option><form:option value="NOT_DISCLOSED"><spring:message code="kyc.gender.NOT_DISCLOSED"/></form:option></form:select><form:errors path="profile.gender" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.maritalStatus"/></span><form:select path="profile.maritalStatus" cssClass="aws-control" data-profile-marital-status="true" aria-label="${profileMaritalLabel}" aria-controls="profile-spouse-details"><form:option value=""><spring:message code="kyc.choose"/></form:option><form:option value="SINGLE"><spring:message code="kyc.maritalStatus.SINGLE"/></form:option><form:option value="MARRIED"><spring:message code="kyc.maritalStatus.MARRIED"/></form:option><form:option value="DIVORCED"><spring:message code="kyc.maritalStatus.DIVORCED"/></form:option><form:option value="SEPARATED"><spring:message code="kyc.maritalStatus.SEPARATED"/></form:option><form:option value="WIDOWED"><spring:message code="kyc.maritalStatus.WIDOWED"/></form:option><form:option value="NOT_DISCLOSED"><spring:message code="kyc.maritalStatus.NOT_DISCLOSED"/></form:option></form:select><form:errors path="profile.maritalStatus" cssClass="field-error"/></label>
<c:choose><c:when test="${publicProfileRegistration}"><label class="kyc-field"><span><spring:message code="kyc.field.groupId"/></span><select class="aws-control" disabled><option><spring:message code="portal.afterVerification"/></option></select></label></c:when><c:otherwise>
<div class="kyc-field" data-loan-choice data-choice-url="<c:url value='${groupLookup}'/>">
<label for="profile.groupId"><spring:message code="kyc.field.groupId"/></label>
<form:select path="profile.groupId" cssClass="aws-control" data-choice-select="true"><form:option value=""><spring:message code="kyc.noGroup"/></form:option><c:if test="${not empty profileValues.groupId}"><form:option value="${profileValues.groupId}" label="${profileValues.groupName}"/></c:if></form:select><%@ include file="../accounting/loans/choice-search.jspf" %><form:errors path="profile.groupId" cssClass="field-error"/></div>
</c:otherwise></c:choose>
<label class="kyc-field"><span><spring:message code="kyc.field.dependants"/></span><form:input path="profile.dependants" type="number" cssClass="aws-control"  min="0" max="100" step="1"/><form:errors path="profile.dependants" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.familiarName"/></span><form:input path="profile.familiarName" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.familiarName" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.identityType"/></span><form:select path="profile.identityType" data-profile-required="${formKind eq 'self'}" cssClass="aws-control"><form:option value=""><spring:message code="kyc.choose"/></form:option><c:forEach items="${['NATIONAL_ID','PASSPORT','VOTER_ID','DRIVING_LICENCE','OTHER']}" var="type"><form:option value="${type}"><spring:message code="kyc.identity.${type}"/></form:option></c:forEach></form:select><form:errors path="profile.identityType" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.identityNumber"/></span><form:input path="profile.identityNumber" data-profile-required="${formKind eq 'self'}" type="text" cssClass="aws-control"  maxlength="64"/><form:errors path="profile.identityNumber" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.issuingCountry"/></span><form:input path="profile.issuingCountry" data-profile-required="${formKind eq 'self'}" type="text" cssClass="aws-control"  maxlength="2"/><form:errors path="profile.issuingCountry" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.birthDate"/></span><form:input path="profile.birthDate" data-profile-required="${formKind eq 'self'}" type="date" cssClass="aws-control"  /><form:errors path="profile.birthDate" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.identityExpiresOn"/></span><form:input path="profile.identityExpiresOn" type="date" cssClass="aws-control"  /><form:errors path="profile.identityExpiresOn" cssClass="field-error"/></label>
<label class="kyc-checkbox"><form:checkbox path="profile.identityNoExpiry"/><span><spring:message code="kyc.field.identityNoExpiry"/></span></label>
</div></section>

<section class="erp-resource-section" data-profile-section="personal"><h2><spring:message code="kyc.section.contact"/></h2>
<div class="kyc-profile-grid" data-contact-fields
    data-contact-phone-error="<spring:message code='kyc.error.phone'/>" data-contact-email-error="<spring:message code='kyc.error.email'/>"
    data-contact-exists="<spring:message code='kyc.contact.exists'/>" data-contact-available="<spring:message code='kyc.contact.available'/>"
    data-contact-checking="<spring:message code='kyc.contact.checking'/>" data-contact-unavailable="<spring:message code='kyc.contact.unavailable'/>" data-contact-retry="<spring:message code='kyc.contact.retry'/>">
<label class="kyc-field" data-contact-field="phone"><span><spring:message code="kyc.field.phone"/> *</span><form:input path="profile.phone" aria-describedby="profile-phone-example profile-phone-status" type="tel" cssClass="aws-control" readonly="${identityReadOnly}" maxlength="16" required="true"/><form:errors path="profile.phone" cssClass="field-error"/><small class="kyc-field-hint" id="profile-phone-example"><spring:message code="kyc.example.phone"/></small><span class="kyc-contact-result" id="profile-phone-status" data-contact-result role="status" aria-live="polite" hidden></span></label>
<label class="kyc-field" data-contact-field="email"><span><spring:message code="kyc.field.email"/></span><form:input path="profile.email" aria-describedby="profile-email-example profile-email-status" type="email" cssClass="aws-control" readonly="${identityReadOnly}" maxlength="255"/><form:errors path="profile.email" cssClass="field-error"/><small class="kyc-field-hint" id="profile-email-example"><spring:message code="kyc.example.email"/></small><span class="kyc-contact-result" id="profile-email-status" data-contact-result role="status" aria-live="polite" hidden></span></label>
<label class="kyc-field"><span><spring:message code="kyc.field.postalAddress"/></span><form:input path="profile.postalAddress" aria-describedby="profile-postalAddress-example" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.postalAddress" cssClass="field-error"/><small class="kyc-field-hint" id="profile-postalAddress-example"><spring:message code="kyc.example.postalAddress"/></small></label>
<label class="kyc-field"><span><spring:message code="kyc.field.city"/></span><form:input path="profile.city" aria-describedby="profile-city-example" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.city" cssClass="field-error"/><small class="kyc-field-hint" id="profile-city-example"><spring:message code="kyc.example.city"/></small></label>
<label class="kyc-field"><span><spring:message code="kyc.field.ward"/></span><form:input path="profile.ward" aria-describedby="profile-ward-example" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.ward" cssClass="field-error"/><small class="kyc-field-hint" id="profile-ward-example"><spring:message code="kyc.example.ward"/></small></label>
<label class="kyc-field"><span><spring:message code="kyc.field.villageStreet"/></span><form:input path="profile.villageStreet" aria-describedby="profile-villageStreet-example" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.villageStreet" cssClass="field-error"/><small class="kyc-field-hint" id="profile-villageStreet-example"><spring:message code="kyc.example.villageStreet"/></small></label>
<label class="kyc-field"><span><spring:message code="kyc.field.nearbyPlace"/></span><form:input path="profile.nearbyPlace" aria-describedby="profile-nearbyPlace-example" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.nearbyPlace" cssClass="field-error"/><small class="kyc-field-hint" id="profile-nearbyPlace-example"><spring:message code="kyc.example.nearbyPlace"/></small></label>
<label class="kyc-field"><span><spring:message code="kyc.field.address"/></span><form:input path="profile.address" aria-describedby="profile-address-example" data-profile-required="${formKind eq 'self'}" type="text" cssClass="aws-control"  maxlength="1000"/><form:errors path="profile.address" cssClass="field-error"/><small class="kyc-field-hint" id="profile-address-example"><spring:message code="kyc.example.address"/></small></label>
</div></section>

<section class="erp-resource-section" data-profile-section="finances"><h2 id="profile-business-heading"><spring:message code="kyc.section.business"/></h2>
<div class="kyc-profile-grid"><label class="kyc-field"><span><spring:message code="kyc.field.hasBusiness"/></span><form:select path="profile.hasBusiness" cssClass="aws-control" data-profile-business-choice="true" aria-label="${profileBusinessLabel}" aria-controls="profile-business-details"><form:option value=""><spring:message code="kyc.choose"/></form:option><form:option value="true"><spring:message code="kyc.yes"/></form:option><form:option value="false"><spring:message code="kyc.no"/></form:option></form:select><form:errors path="profile.hasBusiness" cssClass="field-error"/></label></div>
<fieldset id="profile-business-details" class="kyc-profile-fields" aria-labelledby="profile-business-heading" data-profile-business-fields ${profileValues.hasBusiness==true?'':'hidden'}><div class="kyc-profile-grid">
<label class="kyc-field"><span><spring:message code="kyc.field.businessName"/></span><form:input path="profile.businessName" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.businessName" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.businessType"/></span><form:input path="profile.businessType" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.businessType" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.businessTin"/></span><form:input path="profile.businessTin" type="text" cssClass="aws-control"  maxlength="50"/><form:errors path="profile.businessTin" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.businessLicence"/></span><form:input path="profile.businessLicence" type="text" cssClass="aws-control"  maxlength="100"/><form:errors path="profile.businessLicence" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.businessLocation"/></span><form:input path="profile.businessLocation" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.businessLocation" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.businessWard"/></span><form:input path="profile.businessWard" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.businessWard" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.businessCity"/></span><form:input path="profile.businessCity" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.businessCity" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.dailySales"/></span><form:input path="profile.dailySales" type="number" cssClass="aws-control"  min="0" step="0.01" max="9999999999999999.99"/><form:errors path="profile.dailySales" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.dailyExpenditure"/></span><form:input path="profile.dailyExpenditure" type="number" cssClass="aws-control"  min="0" step="0.01" max="9999999999999999.99"/><form:errors path="profile.dailyExpenditure" cssClass="field-error"/></label>
<p class="kyc-profile-note"><spring:message code="kyc.dailyDeclared"/></p></div></fieldset></section>

<section id="profile-spouse-details" class="erp-resource-section" data-profile-section="personal" data-profile-spouse-section ${profileValues.maritalStatus=='SINGLE' or profileValues.maritalStatus=='DIVORCED' or profileValues.maritalStatus=='WIDOWED'?'hidden':''}><h2 id="profile-spouse-heading"><spring:message code="kyc.section.spouse"/></h2>
<fieldset class="kyc-profile-fields" aria-labelledby="profile-spouse-heading" data-profile-spouse-fields><div class="kyc-profile-grid">
<label class="kyc-field"><span><spring:message code="kyc.field.spouseName"/></span><form:input path="profile.spouseName" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.spouseName" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.spouseRelationship"/></span><form:input path="profile.spouseRelationship" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.spouseRelationship" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.spousePhone"/></span><form:input path="profile.spousePhone" type="text" cssClass="aws-control"  maxlength="32"/><form:errors path="profile.spousePhone" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.spouseWork"/></span><form:input path="profile.spouseWork" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.spouseWork" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.spouseWorkLocation"/></span><form:input path="profile.spouseWorkLocation" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.spouseWorkLocation" cssClass="field-error"/></label>
</div></fieldset></section>

<section class="erp-resource-section" data-profile-section="finances"><h2><spring:message code="kyc.section.bank"/></h2>
<div class="kyc-profile-grid">
<label class="kyc-field"><span><spring:message code="payroll.employeeNumber.optional"/></span><form:input path="profile.employeeNumber" type="text" cssClass="aws-control" maxlength="50"/><form:errors path="profile.employeeNumber" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.bankName"/></span><form:input path="profile.bankName" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.bankName" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.bankAccountName"/></span><form:input path="profile.bankAccountName" type="text" cssClass="aws-control"  maxlength="255"/><form:errors path="profile.bankAccountName" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.bankAccountNumber"/></span><form:input path="profile.bankAccountNumber" type="text" cssClass="aws-control"  maxlength="80"/><form:errors path="profile.bankAccountNumber" cssClass="field-error"/></label>
<p class="kyc-profile-note"><spring:message code="kyc.bankDeclared"/></p></div></section>

<section class="erp-resource-section" data-profile-section="finances"><h2><spring:message code="kyc.section.activity"/></h2>
<div class="kyc-profile-grid">
<fieldset class="kyc-income-choices">
    <legend><spring:message code="kyc.field.activity"/></legend>
    <div class="kyc-income-options">
        <c:forEach items="${['BUSINESS','EMPLOYMENT','OTHER']}" var="incomeActivity"><label class="kyc-checkbox"><form:checkbox path="profile.incomeActivities" value="${incomeActivity}"/><span><spring:message code="kyc.income.${incomeActivity}"/></span></label></c:forEach>
        <c:forEach items="${profileValues.incomeActivities}" var="legacyIncomeActivity"><c:if test="${not ['BUSINESS','EMPLOYMENT','OTHER'].contains(legacyIncomeActivity)}"><label class="kyc-checkbox"><form:checkbox path="profile.incomeActivities" value="${legacyIncomeActivity}"/><span><c:out value="${legacyIncomeActivity}"/></span></label></c:if></c:forEach>
    </div>
    <form:errors path="profile.activity" cssClass="field-error"/>
    <form:errors path="profile.incomeActivities" cssClass="field-error"/>
</fieldset>
<label class="kyc-field"><span><spring:message code="kyc.field.otherIncomeSources"/></span><form:input path="profile.otherIncomeSources" type="text" cssClass="aws-control"  maxlength="1000"/><form:errors path="profile.otherIncomeSources" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.activityAddress"/></span><form:input path="profile.activityAddress" data-profile-required="${formKind eq 'self'}" type="text" cssClass="aws-control"  maxlength="1000"/><form:errors path="profile.activityAddress" cssClass="field-error"/></label>
<label class="kyc-field"><span><spring:message code="kyc.field.sourceOfFunds"/></span><form:input path="profile.sourceOfFunds" data-profile-required="${formKind eq 'self'}" type="text" cssClass="aws-control"  maxlength="1000"/><form:errors path="profile.sourceOfFunds" cssClass="field-error"/></label>
</div></section>
