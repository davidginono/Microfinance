    <section class="erp-resource-section"><h2><spring:message code="kyc.profile"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="kyc.version"/></dt><dd><c:out value="${revision.sequence}"/></dd></div>
        <c:forEach items="${['fullName','phone','email','clientNumber','identityType','issuingCountry','birthDate','identityExpiresOn','address','activity','activityAddress','sourceOfFunds','noticeVersion','lawfulBasis','consentReference','consentOn','retentionReference','retentionReviewOn','legalHoldReference']}" var="field"><div><dt><spring:message code="kyc.field.${field}"/></dt><dd><c:choose><c:when test="${field=='identityType' and not empty revision.profile.identityType}"><spring:message code="kyc.identity.${revision.profile.identityType}"/></c:when><c:when test="${field=='lawfulBasis' and not empty revision.profile.lawfulBasis}"><spring:message code="kyc.basis.${revision.profile.lawfulBasis}"/></c:when><c:otherwise><c:out value="${revision.profile[field]}"/></c:otherwise></c:choose></dd></div></c:forEach>
        <div><dt><spring:message code="kyc.field.identityNumber"/></dt><dd>••••<c:out value="${revision.profile.identityNumber.length()>4?revision.profile.identityNumber.substring(revision.profile.identityNumber.length()-4):''}"/></dd></div>
        <div><dt><spring:message code="kyc.field.identityNoExpiry"/></dt><dd><spring:message code="${revision.profile.identityNoExpiry?'kyc.yes':'kyc.no'}"/></dd></div>
        <div><dt><spring:message code="kyc.recordedBy"/></dt><dd><c:out value="${revision.makerName}"/> · <c:out value="${appTime:display(revision.recordedAt)}"/></dd></div>
    </dl></section>
