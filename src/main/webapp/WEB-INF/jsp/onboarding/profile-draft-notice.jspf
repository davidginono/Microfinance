<%@ page pageEncoding="UTF-8" %>
<c:if test="${profileDraftSaved}"><div class="workspace-flashbar" data-workspace-flashbar><div class="console-message" data-message-type="success" data-app-toast role="status"><p><spring:message code="kyc.sessionDraftSaved"/></p><button type="button" data-feedback-dismiss class="app-toast-close" aria-label="<spring:message code='form.notification.dismiss'/>"><svg class="app-toast-close-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="2"/></svg></button></div></div></c:if>
