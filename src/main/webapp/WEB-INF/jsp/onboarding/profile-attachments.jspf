<%@ page pageEncoding="UTF-8" %>
<div id="profile-documents" data-detail-panel><h2 class="sr-only"><spring:message code="kyc.attachmentsAndDocuments"/></h2><section class="erp-resource-section" data-profile-section="documents"><h2><spring:message code="kyc.attachmentsAndDocuments"/></h2><div class="kyc-section-body">
<div data-profile-document-list data-revision-id="${client.revisionId}" class="kyc-profile-document-list">
<c:if test="${formKind=='self' and not profileReadOnly}">
    <div data-profile-evidence>
        <h4 tabindex="-1"><spring:message code="kyc.evidence.heading"/></h4>
        <ul class="kyc-evidence-list">
            <c:forEach items="${workspace.evidenceRequirements}" var="evidence">
                <li data-evidence-status="${evidence.status}">
                    <spring:message code="kyc.category.${evidence.category}"/>:
                    <strong><spring:message code="kyc.evidence.${evidence.status}"/></strong>
                </li>
            </c:forEach>
        </ul>
        <p data-evidence-error role="alert" hidden><spring:message code="kyc.evidence.fix"/></p>
    </div>
</c:if>
<%@ include file="profile-document-tokens.jspf" %>
<c:if test="${empty profileDocuments and formKind!='create'}"><p><spring:message code="kyc.noDocuments"/></p></c:if>
<c:if test="${not empty profileDocuments and profileDocuments.size()>=100}"><p class="kyc-field-hint"><spring:message code="kyc.recentDocuments"/></p></c:if>
</div><c:choose><c:when test="${formKind=='create'}">
    <div class="kyc-creation-uploads">
        <p class="kyc-field-hint"><spring:message code="kyc.creationDocumentsOptional"/></p>
        <button type="button" class="app-btn btn-neutral" data-profile-add-documents hidden><spring:message code="kyc.addDocument"/></button>
        <%@ include file="creation-document.jspf" %>
    </div>
</c:when><c:when test="${client.state=='DRAFT' or (formKind=='profile' and client.state=='RECORDED')}"><a class="app-btn btn-neutral" ${formKind=='self'?'data-profile-add-documents':''} href="<c:url value='${uploadPath}'/>"><spring:message code="kyc.addDocument"/></a></c:when><c:otherwise><c:if test="${not empty client and client.state!='SUBMITTED'}"><p><spring:message code="${formKind=='profile'?'kyc.saveChangesBeforeUpload':'kyc.saveBeforeUpload'}"/></p></c:if></c:otherwise></c:choose>
<c:if test="${formKind=='self' and not profileReadOnly}">
    <div class="kyc-acknowledgement" data-profile-declaration>
        <label class="kyc-checkbox"><form:checkbox path="declarationAccepted" required="true"/><span><spring:message code="kyc.acceptDeclaration"/></span></label>
        <form:errors path="declarationAccepted" cssClass="coa-error"/>
    </div>
</c:if>
</div></section></div>
