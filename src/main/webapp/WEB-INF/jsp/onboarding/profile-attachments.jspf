<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<div id="profile-documents" data-detail-panel><h2 class="sr-only"><spring:message code="kyc.attachmentsAndDocuments"/></h2><section class="erp-resource-section" data-profile-section="documents"><h3><spring:message code="kyc.attachmentsAndDocuments"/></h3><div class="kyc-section-body">
<div data-profile-document-list data-revision-id="${client.revisionId}" class="kyc-profile-document-list">
<c:if test="${not empty profileDocuments}">
    <ul class="kyc-upload-queue" aria-label="<spring:message code='kyc.uploadedFiles'/>">
        <c:forEach items="${profileDocuments}" var="doc">
            <li class="kyc-upload-row" data-profile-document>
                <div class="kyc-upload-token">
                    <c:url var="fileUrl" value="${documentRoot}/${doc.id}"/>
                    <c:if test="${formKind=='self' and canReadProfileDocuments and (doc.contentType=='image/jpeg' or doc.contentType=='image/png')}">
                        <img class="kyc-upload-thumbnail" src="${fileUrl}?preview=true" alt="" loading="lazy" decoding="async"/>
                    </c:if>
                    <div class="kyc-upload-details">
                        <p class="kyc-upload-name" data-profile-file-name><c:choose>
                            <c:when test="${canReadProfileDocuments}"><a class="console-resource-link" href="${fileUrl}" download><c:out value="${doc.name}"/></a></c:when>
                            <c:otherwise><c:out value="${doc.name}"/></c:otherwise>
                        </c:choose></p>
                        <dl class="kyc-upload-metadata">
                            <c:if test="${formKind!='self' or doc.category!='PROFILE_PHOTO'}"><div><dt><spring:message code="kyc.field.category"/></dt><dd><spring:message code="kyc.category.${doc.category}"/></dd></div></c:if>
                            <div><dt><spring:message code="kyc.fileSize"/></dt><dd><c:choose>
                                <c:when test="${doc.sizeBytes ge 1048576}"><fmt:formatNumber value="${doc.sizeBytes / 1048576}" maxFractionDigits="1"/> MB</c:when>
                                <c:when test="${doc.sizeBytes ge 1024}"><fmt:formatNumber value="${doc.sizeBytes / 1024}" maxFractionDigits="1"/> KB</c:when>
                                <c:otherwise><fmt:formatNumber value="${doc.sizeBytes}"/> B</c:otherwise>
                            </c:choose></dd></div>
                            <div><dt><spring:message code="kyc.uploaded"/></dt><dd><c:out value="${appTime:display(doc.recordedAt)}"/></dd></div>
                        </dl>
                    </div>
                    <c:if test="${formKind=='self' and not profileReadOnly and client.state=='DRAFT'}">
                        <button type="button" class="erp-icon-btn kyc-upload-remove" data-profile-remove="<c:url value='${documentRoot}/${doc.id}/remove'/>"
                                aria-label="<spring:message code='kyc.removeFile'/>: <c:out value='${doc.name}'/>" hidden>
                            <svg class="console-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 3l10 10M13 3L3 13"/></svg>
                        </button>
                    </c:if>
                </div>
            </li>
        </c:forEach>
    </ul>
</c:if>
<c:if test="${empty profileDocuments}"><p><spring:message code="kyc.noDocuments"/></p></c:if>
<c:if test="${not empty profileDocuments and profileDocuments.size()>=100}"><p class="kyc-field-hint"><spring:message code="kyc.recentDocuments"/></p></c:if>
</div><c:choose><c:when test="${not empty client and client.state=='DRAFT'}"><a class="app-btn btn-neutral" ${formKind=='self'?'data-profile-add-documents':''} href="<c:url value='${uploadPath}'/>"><spring:message code="kyc.addDocument"/></a></c:when><c:otherwise><c:if test="${client.state!='SUBMITTED'}"><p><spring:message code="kyc.saveBeforeUpload"/></p></c:if></c:otherwise></c:choose>
<c:if test="${formKind=='self' and not profileReadOnly}">
    <p class="kyc-field-hint"><spring:message code="kyc.beforeSubmit"/></p>
    <div class="kyc-acknowledgement" data-profile-declaration>
        <label class="kyc-checkbox"><form:checkbox path="declarationAccepted" required="true"/><span><spring:message code="kyc.acceptDeclaration"/></span></label>
        <form:errors path="declarationAccepted" cssClass="coa-error"/>
    </div>
</c:if>
</div></section></div>
