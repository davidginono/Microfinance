<%@ page pageEncoding="UTF-8" %>
<div id="profile-photo" data-detail-panel><h2 class="sr-only"><spring:message code="kyc.section.photos"/></h2><section class="erp-resource-section"><h3><spring:message code="kyc.section.photos"/></h3><div class="kyc-section-body">
<c:forEach items="${profileDocuments}" var="doc"><c:if test="${doc.category=='PROFILE_PHOTO' or doc.category=='SPOUSE_PHOTO'}"><div class="kyc-photo"><h4><spring:message code="kyc.category.${doc.category}"/></h4><c:if test="${canReadProfileDocuments}"><img src="<c:url value='${photoRoot}/${doc.id}'/>" alt="<spring:message code='kyc.category.${doc.category}'/>" loading="lazy"/></c:if><c:out value="${doc.name}"/></div></c:if></c:forEach>
<c:choose><c:when test="${not empty client and client.state=='DRAFT'}"><a class="app-btn btn-neutral" href="<c:url value='${uploadPath}?category=PROFILE_PHOTO'/>"><spring:message code="kyc.addPhoto"/></a></c:when><c:otherwise><c:if test="${client.state!='SUBMITTED'}"><p><spring:message code="kyc.saveBeforeUpload"/></p></c:if></c:otherwise></c:choose>
</div></section></div>
<div id="profile-documents" data-detail-panel><h2 class="sr-only"><spring:message code="kyc.documents"/></h2><section class="erp-resource-section"><h3><spring:message code="kyc.documents"/></h3><div class="kyc-section-body">
<c:forEach items="${profileDocuments}" var="doc"><c:if test="${doc.category!='PROFILE_PHOTO' and doc.category!='SPOUSE_PHOTO'}"><p><spring:message code="kyc.category.${doc.category}"/>: <c:choose><c:when test="${canReadProfileDocuments}"><a class="resource-table-id-link" href="<c:url value='${documentRoot}/${doc.id}'/>"><c:out value="${doc.name}"/></a></c:when><c:otherwise><c:out value="${doc.name}"/></c:otherwise></c:choose></p></c:if></c:forEach>
<c:if test="${empty profileDocuments}"><p><spring:message code="kyc.noDocuments"/></p></c:if>
<c:choose><c:when test="${not empty client and client.state=='DRAFT'}"><a class="app-btn btn-neutral" href="<c:url value='${uploadPath}'/>"><spring:message code="kyc.addDocument"/></a></c:when><c:otherwise><c:if test="${client.state!='SUBMITTED'}"><p><spring:message code="kyc.saveBeforeUpload"/></p></c:if></c:otherwise></c:choose>
</div></section></div>