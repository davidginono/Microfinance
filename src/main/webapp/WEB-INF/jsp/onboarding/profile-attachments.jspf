<%@ page pageEncoding="UTF-8" %>
<div id="profile-documents" data-detail-panel><h2 class="sr-only"><spring:message code="kyc.attachmentsAndDocuments"/></h2><section class="erp-resource-section"><h3><spring:message code="kyc.attachmentsAndDocuments"/></h3><div class="kyc-section-body">
<c:forEach items="${profileDocuments}" var="doc"><p><spring:message code="kyc.category.${doc.category}"/>: <c:choose><c:when test="${canReadProfileDocuments}"><a class="resource-table-id-link" href="<c:url value='${documentRoot}/${doc.id}'/>"><c:out value="${doc.name}"/></a></c:when><c:otherwise><c:out value="${doc.name}"/></c:otherwise></c:choose></p></c:forEach>
<c:if test="${empty profileDocuments}"><p><spring:message code="kyc.noDocuments"/></p></c:if>
<c:choose><c:when test="${not empty client and client.state=='DRAFT'}"><a class="app-btn btn-neutral" href="<c:url value='${uploadPath}'/>"><spring:message code="kyc.addDocument"/></a></c:when><c:otherwise><c:if test="${client.state!='SUBMITTED'}"><p><spring:message code="${publicProfileRegistration?'portal.verifyBeforeUpload':'kyc.saveBeforeUpload'}"/></p></c:if></c:otherwise></c:choose>
</div></section></div>
