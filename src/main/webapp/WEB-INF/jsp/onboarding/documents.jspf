<%@ page pageEncoding="UTF-8" %>
<section class="erp-resource-section"><h2><spring:message code="kyc.documents"/></h2><div class="kyc-section-body">
    <c:set var="profileDocuments" value="${documents}"/>
    <c:set var="documentRoot" value="/finance/clients/onboarding/${client.id}/documents"/>
    <c:set var="staffDocumentDetails" value="${true}"/>
    <sec:authorize access="@access.has(principal,'CLIENT_ONBOARDING_DOCUMENTS')" var="canReadProfileDocuments"/>
    <%@ include file="profile-document-tokens.jspf" %>
    <c:if test="${empty documents}"><p><spring:message code="kyc.noDocuments"/></p></c:if>
</div></section>
