<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../../fragments/header.jspf" %>
<%@ include file="../../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<div class="accounting-workspace"><div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="management.budgets" /></h1></div>
<section class="erp-table-wrap" data-resource-table="account-budgets" data-table-selection="single" data-budget-register>
<div class="app-table-titlebar"><h2><spring:message code="management.budget.latest" /></h2><div class="accounting-actions"><button class="app-btn btn-neutral" data-budget-view disabled type="button" data-url="<c:url value='/finance/budgets/' />"><spring:message code="common.view" /></button><sec:authorize access="@access.has(principal,'ACCOUNTING_ACCOUNTS_CREATE')"><a class="app-btn btn-launch" href="<c:url value='/finance/budgets/new' />"><spring:message code="management.budget.create" /></a></sec:authorize></div></div>
<form method="get" action="<c:url value='/finance/budgets' />" class="erp-table-toolbar"><label class="erp-table-toolbar__control"><spring:message code="management.year" /><input class="aws-control" type="number" min="1900" max="2200" name="year" value="${year}" required /></label><input type="hidden" name="sort" value="<c:out value='${sort}' />" /><input type="hidden" name="direction" value="<c:out value='${direction}' />" /><button class="app-btn btn-neutral"><spring:message code="coa.filter" /></button></form>
<span class="sr-only" role="status" data-budget-status data-empty="<spring:message code='coa.selectHint' />" data-selected="<spring:message code='coa.selected' />"></span>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><span class="sr-only"><spring:message code="coa.select" /></span></th><c:forEach items="${['code','account','date','year','revision','total','recordedBy']}" var="key"><th data-table-sort-key="${key}" data-table-sort-asc="asc" data-table-sort-desc="desc"><spring:message code="management.${key}" /></th></c:forEach></tr></thead><tbody>
<c:forEach items="${budgets.rows}" var="b"><tr data-budget-id="${b.id}"><td><input type="checkbox" aria-label="<c:out value='${b.account}' />" /></td><td><c:out value="${b.code}" /></td><td><c:out value="${b.account}" /></td><td><c:out value="${b.date}" /></td><td><c:out value="${b.year}" /></td><td><c:out value="${b.revision}" /></td><td><fmt:formatNumber value="${b.total}" minFractionDigits="2" maxFractionDigits="2" /></td><td><c:out value="${b.recordedBy}" /></td></tr></c:forEach><c:if test="${empty budgets.rows}"><tr><td colspan="8"><spring:message code="management.empty" /></td></tr></c:if>
</tbody></table></div>
<div data-table-pagination data-page="${budgets.page}" data-table-for="account-budgets" class="accounting-actions"><c:forEach items="${['previous','next']}" var="move"><c:if test="${move=='previous'?budgets.page>0:budgets.hasNext}"><c:url value="/finance/budgets" var="pageUrl"><c:param name="year" value="${year}" /><c:param name="page" value="${budgets.page+(move=='previous'?-1:1)}" /><c:param name="sort" value="${sort}" /><c:param name="direction" value="${direction}" /></c:url><a class="app-btn btn-neutral" data-page-direction="${move}" href="<c:out value='${pageUrl}' />"><spring:message code="common.${move}" /></a></c:if></c:forEach></div>
</section></div><script src="<c:url value='/js/management-reports.js' />" defer></script><%@ include file="../../fragments/footer.jspf" %>
