<%@ page pageEncoding="UTF-8" %>
<article class="reference-document reference-${report.kind}">
  <header><h2><spring:message code="management.title.${report.kind}" /></h2><p><c:out value="${report.institution}" /> — <c:out value="${report.branch}" /></p>
  <p><spring:message code="${report.kind=='PORTFOLIO_RISK' or report.kind=='PORTFOLIO_ANALYSIS'?'management.asAt':'management.period'}" />: <c:if test="${report.kind!='PORTFOLIO_RISK' and report.kind!='PORTFOLIO_ANALYSIS'}"><c:out value="${report.parameters.from}" /> — </c:if><c:out value="${report.parameters.through}" /> · TZS</p>
  <p class="reference-stamp"><spring:message code="management.cutoff" />: <c:out value="${report.parameters.cutoff}" /></p></header>
  <c:if test="${report.kind=='CASHBOOK' or report.kind=='DAILY_COLLECTIONS'}"><p><spring:message code="management.accounts" />: <c:choose><c:when test="${empty report.parameters.startAccount and empty report.parameters.endAccount}"><spring:message code="management.allAccounts" /></c:when><c:otherwise><c:out value="${report.accountRange}" /></c:otherwise></c:choose></p></c:if>
  <c:if test="${not empty report.parameters.client}"><p><spring:message code="management.clientSearch" />: <c:out value="${report.parameters.client}" /></p></c:if>
  <c:if test="${not empty report.parameters.product}"><p><spring:message code="management.productSearch" />: <c:out value="${report.parameters.product}" /></p></c:if>
  <p class="reference-basis"><spring:message code="management.excluded" />: <c:out value="${report.excluded}" /></p>
  <table class="reference-table"><thead><tr><c:forEach items="${report.columns}" var="column"><th scope="col"><spring:message code="management.field.${column.key}" /></th></c:forEach></tr></thead>
  <c:forEach items="${report.getDisplayedGroups()}" var="group" varStatus="groupStatus"><tbody>
    <tr class="reference-group"><th colspan="${report.columns.size()}" scope="rowgroup"><c:choose><c:when test="${fn:substringAfter(group.name,' | ')=='@loan' or fn:substringAfter(group.name,' | ')=='@general'}"><c:out value="${fn:substringBefore(group.name,' | ')}" /> | <spring:message code="${fn:substringAfter(group.name,' | ')=='@loan'?'management.loanRepayments':'management.generalReceipts'}" /></c:when><c:otherwise><c:out value="${group.name}" /></c:otherwise></c:choose></th></tr>
    <c:forEach items="${report.rows}" var="row"><c:if test="${row.groupName==group.name}"><tr><c:forEach items="${report.columns}" var="column"><td class="${column.money?'reference-money':''}"><c:choose><c:when test="${row[column.key]==null}">—</c:when><c:when test="${column.money}"><fmt:formatNumber value="${row[column.key]}" minFractionDigits="2" maxFractionDigits="2" /></c:when><c:when test="${column.key=='transaction' and (row.component=='PRINCIPAL' or row.component=='INTEREST')}"><spring:message code="management.component.${row.component}" /> — <c:out value="${row[column.key]}" /></c:when><c:otherwise><c:out value="${row[column.key]}" /></c:otherwise></c:choose></td></c:forEach></tr></c:if></c:forEach>
    <tr class="reference-total"><c:forEach items="${report.columns}" var="column" varStatus="cell"><td class="${column.money?'reference-money':''}"><c:choose><c:when test="${cell.first}"><spring:message code="management.groupTotal" /></c:when><c:when test="${column.money and group.totals[column.key]!=null}"><fmt:formatNumber value="${group.totals[column.key]}" minFractionDigits="2" maxFractionDigits="2" /></c:when></c:choose></td></c:forEach></tr>
    <c:if test="${report.kind=='DAILY_COLLECTIONS' and (groupStatus.last or group.name.substring(0,10)!=report.getDisplayedGroups()[groupStatus.index+1].name.substring(0,10))}"><tr class="reference-total reference-day-total"><c:forEach items="${report.columns}" var="column" varStatus="cell"><td class="${column.money?'reference-money':''}"><c:choose><c:when test="${cell.first}"><spring:message code="management.dayTotal" /></c:when><c:when test="${column.money}"><fmt:formatNumber value="${report.getDailyTotals()[group.name.substring(0,10)][column.key]}" minFractionDigits="2" maxFractionDigits="2" /></c:when></c:choose></td></c:forEach></tr></c:if>
  </tbody></c:forEach>
  <c:if test="${empty report.rows}"><tbody><tr><td colspan="${report.columns.size()}"><spring:message code="management.empty" /></td></tr></tbody></c:if>
  <tfoot><tr class="reference-total"><c:forEach items="${report.columns}" var="column" varStatus="cell"><td class="${column.money?'reference-money':''}"><c:choose><c:when test="${cell.first}"><spring:message code="management.total" /></c:when><c:when test="${column.money and report.totals[column.key]!=null}"><fmt:formatNumber value="${report.totals[column.key]}" minFractionDigits="2" maxFractionDigits="2" /></c:when></c:choose></td></c:forEach></tr></tfoot>
  </table><footer class="reference-basis"><strong><spring:message code="management.basis" /></strong><p><spring:message code="management.coverage.${report.kind}" /></p>
  <c:if test="${report.kind=='PORTFOLIO_RISK'}"><p><spring:message code="management.riskBasis" /></p></c:if>
  <c:if test="${report.kind=='LOAN_PORTFOLIO' or report.kind=='PORTFOLIO_ANALYSIS'}"><p><spring:message code="management.interestBasis" /></p></c:if>
  <c:if test="${report.excluded>0}"><p><c:if test="${report.kind!='DAILY_COLLECTIONS' and report.kind!='CASHBOOK'}"><spring:message code="management.exclusionBasis" /> </c:if><spring:message code="management.missingNext" /></p></c:if>
  <p><spring:message code="management.fullTotals" /></p></footer>
</article>
