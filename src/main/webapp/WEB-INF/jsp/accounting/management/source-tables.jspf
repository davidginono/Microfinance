<%@ page pageEncoding="UTF-8" %>
<c:set var="displayedGroups" value="${report.getDisplayedGroups()}" />
<c:set var="emptySource" value="${empty displayedGroups}" />
<c:set var="auditSource" value="${report.kind=='DISBURSED_LOANS_AUDIT'}" />
<c:set var="recordNumber" value="${report.parameters.page*25}" />
<c:forEach items="${emptySource ? [0] : displayedGroups}" var="group" varStatus="groupStatus">
  <c:set var="facts" value="${emptySource ? report.emptyGroupFacts : groupFacts[group.name]}" />
  <section class="reference-source-group">
    <c:choose>
      <c:when test="${report.kind=='LOAN_REPAYMENT_TRANSACTIONS'}">
        <dl class="reference-client-facts">
          <div><dt><spring:message code="management.field.clientNumber" /></dt><dd><c:out value="${facts.clientNumber}" default="—" /></dd></div>
          <div><dt><spring:message code="management.field.name" /></dt><dd><c:out value="${facts.name}" default="—" /></dd></div>
          <div><dt><spring:message code="management.startDate" /></dt><dd><c:out value="${empty facts.startDate ? '—' : appTime:referenceDate(facts.startDate,referenceLocale)}" /></dd></div>
        </dl>
        <dl class="reference-loan-facts">
          <div><dt><spring:message code="management.field.loanId" /></dt><dd><c:out value="${facts.loanId}" default="—" /></dd></div>
          <div><dt><spring:message code="management.pdf.loanType" /></dt><dd><c:out value="${facts.product}" default="—" /></dd></div>
          <div><dt><spring:message code="management.pdf.disbursedLoanAmount" /></dt><dd><c:choose><c:when test="${facts.disbursed!=null}"><fmt:formatNumber value="${facts.disbursed}" minFractionDigits="0" maxFractionDigits="2" /></c:when><c:otherwise>—</c:otherwise></c:choose></dd></div>
          <div><dt><spring:message code="management.pdf.loanBalance" /></dt><dd><c:choose><c:when test="${facts.principalBalance!=null}"><fmt:formatNumber value="${facts.principalBalance}" minFractionDigits="0" maxFractionDigits="2" /></c:when><c:otherwise>—</c:otherwise></c:choose></dd></div>
        </dl>
      </c:when>
      <c:when test="${auditSource}">
        <div class="reference-audit-facts reference-audit-month">
          <p><strong><spring:message code="management.month" /></strong> <em><c:out value="${facts.month}" default="—" /></em></p>
          <p><strong><spring:message code="management.productSearch" /></strong> <c:out value="${facts.product}" default="—" /></p>
        </div>
        <div class="reference-audit-facts reference-audit-institution">
          <p><strong><spring:message code="management.pdf.institutionName" /></strong> <c:out value="${report.institution}" /></p>
        </div>
        <div class="reference-audit-facts reference-audit-branch">
          <p><strong><spring:message code="management.pdf.branchName" /></strong> <c:out value="${report.branch}" /></p>
          <p><strong><spring:message code="management.field.disbursementAccount" /></strong> <c:out value="${facts.disbursementAccount}" default="—" /></p>
        </div>
      </c:when>
      <c:otherwise>
        <dl class="reference-product-facts">
          <dt><spring:message code="management.pdf.loanTypeName" /></dt><dd><c:out value="${emptySource ? facts.product : group.name}" default="—" /></dd>
        </dl>
      </c:otherwise>
    </c:choose>
    <table data-table-sort-mode="none" data-table-sort-reason="document" class="reference-table">
      <colgroup><c:forEach items="${referenceWidths}" var="width"><col style="width:${width}pt" /></c:forEach></colgroup>
      <thead><tr>
        <c:if test="${auditSource}"><th scope="col"><spring:message code="management.pdf.recordNumber" /></th></c:if>
        <c:forEach items="${report.getDocumentColumns()}" var="column"><th scope="col" class="${column.money?'reference-money':''}"><c:out value="${referenceHeadings[column.key]}" /></th></c:forEach>
      </tr></thead>
      <tbody>
        <c:if test="${emptySource}"><tr><td colspan="${referenceWidths.size()}"><spring:message code="management.${report.getEmptyKey()}" /></td></tr></c:if>
        <c:forEach items="${report.rows}" var="row"><c:if test="${row.groupName==group.name}">
          <tr>
            <c:if test="${auditSource}"><c:set var="recordNumber" value="${recordNumber+1}" /><td><c:out value="${recordNumber}" /></td></c:if>
            <c:forEach items="${report.getDocumentColumns()}" var="column">
              <td class="${column.money?'reference-money':''}">
                <c:choose>
                  <c:when test="${row[column.key]==null}">—</c:when>
                  <c:when test="${column.money}"><fmt:formatNumber value="${row[column.key]}" minFractionDigits="0" maxFractionDigits="2" /></c:when>
                  <c:when test="${column.key=='frequency' and (row[column.key]=='MONTHLY' or row[column.key]=='WEEKLY')}"><spring:message code="recording.frequency.${row[column.key]}" /></c:when>
                  <c:otherwise><c:out value="${appTime:referenceDate(row[column.key],referenceLocale)}" /></c:otherwise>
                </c:choose>
                <c:if test="${report.kind=='LOAN_REPAYMENT_TRANSACTIONS' and column.key=='date' and not empty row.entryKind}">
                  <span class="reference-entry"><spring:message code="management.entry.${row.entryKind}" /> <c:out value="${row.reference}" /></span>
                  <c:if test="${not empty row.reversesReference}"><span class="reference-entry"><spring:message code="management.field.reversesReference" />: <c:out value="${row.reversesReference}" /></span></c:if>
                </c:if>
              </td>
            </c:forEach>
          </tr>
        </c:if></c:forEach>
      </tbody>
      <c:if test="${!emptySource}"><tfoot>
        <c:if test="${reportSubtotals.groups.contains(group.name)}"><c:set var="sourceTotals" value="${group.totals}" /><c:set var="sourceTotalLabel" value="management.groupTotal" /><%@ include file="source-total.jspf" %></c:if>
        <c:if test="${auditSource and reportSubtotals.periods.contains(group.name.substring(0,7)) and (groupStatus.last or group.name.substring(0,7)!=displayedGroups[groupStatus.index+1].name.substring(0,7))}"><c:set var="sourceTotals" value="${report.getMonthlyTotals()[group.name.substring(0,7)]}" /><c:set var="sourceTotalLabel" value="management.monthTotal" /><%@ include file="source-total.jspf" %></c:if>
        <c:if test="${groupStatus.last}"><c:set var="sourceTotals" value="${report.totals}" /><c:set var="sourceTotalLabel" value="management.total" /><%@ include file="source-total.jspf" %></c:if>
      </tfoot></c:if>
    </table>
  </section>
</c:forEach>
