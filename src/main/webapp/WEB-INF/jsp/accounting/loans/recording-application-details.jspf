<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty supportingDetails}">
<section class="accounting-section erp-detail-card"><h2><spring:message code="applications.information"/></h2><dl class="erp-detail-facts">
<c:if test="${not empty supportingDetails.loanOfficerLabel}"><div><dt><spring:message code="applications.officer"/></dt><dd><c:out value="${supportingDetails.loanOfficerLabel}"/></dd></div></c:if>
<div><dt><spring:message code="applications.useOfFunds"/></dt><dd><c:out value="${supportingDetails.useOfFunds}"/></dd></div>
<c:forEach items="${supportingDetails.fields}" var="field"><div><dt><spring:message code="${supportingDetails.fieldLabels[field.key]}" text="${field.key}"/></dt><dd><c:out value="${field.value}"/></dd></div></c:forEach>
</dl></section>
<section class="accounting-section erp-detail-card"><h2><spring:message code="applications.guarantors"/></h2>
<c:forEach items="${supportingDetails.guarantors}" var="row"><dl class="erp-detail-facts">
<c:forEach items="${['fullName','relationship','business','location','phone']}" var="key"><div><dt><c:choose><c:when test="${key=='fullName'}"><spring:message code="recording.guarantorName"/></c:when><c:otherwise><spring:message code="applications.${key}"/></c:otherwise></c:choose></dt><dd><c:choose><c:when test="${key=='fullName' and empty row.fullName}"><c:out value="${evidenceGuarantorLabels[row.clientId]}"/></c:when><c:otherwise><c:out value="${row[key]}"/></c:otherwise></c:choose></dd></div></c:forEach>
</dl></c:forEach></section>
<section class="accounting-section erp-detail-card"><h2><spring:message code="applications.collateral"/></h2>
<c:forEach items="${supportingDetails.collateral}" var="row"><dl class="erp-detail-facts">
<c:forEach items="${['itemName','itemNumber','itemType','description','owner','phone','location','estimatedValue']}" var="key"><div><dt><spring:message code="applications.${key}"/></dt><dd><c:out value="${row[key]}"/></dd></div></c:forEach>
</dl></c:forEach></section>
</c:if>
