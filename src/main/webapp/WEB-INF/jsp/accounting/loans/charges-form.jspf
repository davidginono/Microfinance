<%@ page pageEncoding="UTF-8" %>
<section class="accounting-section loan-repayment-terms" data-charge-preview data-empty-label="<spring:message code='charges.noCharges' />" aria-live="polite">
<h2><spring:message code="charges.title" /></h2><p data-manual-charge-help hidden><spring:message code="charges.manualHelp" /></p><p><spring:message code="charges.managementHelp" /></p>
<sec:authorize access="@access.has(principal,'LOAN_CHARGES_CUSTOM')"><details data-management-charge-inputs><summary><spring:message code="charges.custom" /></summary><div class="loan-form-grid"><label><spring:message code="charges.kind.APPLICATION" /> (TZS)<form:input path="customApplicationCharge" data-recorded-fee="application" type="number" min="0" step="0.01" cssClass="aws-control" /></label><label><spring:message code="charges.kind.PROCESSING" /> (TZS)<form:input path="customProcessingCharge" data-recorded-fee="processing" type="number" min="0" step="0.01" cssClass="aws-control" /></label></div><p data-configured-charge-help><spring:message code="charges.customHelp" /></p></details></sec:authorize><sec:authorize access="!@access.has(principal,'LOAN_CHARGES_CUSTOM')"><p data-manual-charge-permission hidden class="aws-inline-notice aws-inline-notice--warning" role="status"><spring:message code="charges.manualPermission" /></p></sec:authorize>
<div class="loan-form-grid" data-insurance-fields hidden><label><spring:message code="charges.insurancePremium" /> (TZS)<form:input path="insurancePremium" data-recorded-fee="insurance" type="number" min="0" step="0.01" cssClass="aws-control" /></label><label><spring:message code="charges.insuranceEvidence" /><form:input path="insuranceEvidence" maxlength="500" cssClass="aws-control" /></label></div>
<div class="erp-table-scroll erp-table-scroll-sm"><table class="erp-table"><thead><tr><th scope="col"><spring:message code="charges.kind" /></th><th scope="col"><spring:message code="charges.basis" /></th><th scope="col"><spring:message code="voucher.amount" /> (TZS)</th><th scope="col"><spring:message code="charges.timing" /></th></tr></thead><tbody data-charge-rows><tr><td colspan="4"><spring:message code="charges.chooseTerms" /></td></tr></tbody></table></div>
<dl class="loan-topup-facts"><div><dt><spring:message code="charges.managementTotal" /> (TZS)</dt><dd data-charge-management>—</dd></div><div><dt><spring:message code="charges.total" /> (TZS)</dt><dd data-charge-total>—</dd></div><div data-configured-charge-summary><dt><spring:message code="charges.deductions" /> (TZS)</dt><dd data-charge-deductions>—</dd></div><div data-configured-charge-summary><dt><spring:message code="charges.separate" /> (TZS)</dt><dd data-charge-separate>—</dd></div><div data-configured-charge-summary><dt><spring:message code="recording.topUp.cash" /> (TZS)</dt><dd data-charge-net>—</dd></div></dl>
<p data-charge-error role="alert"></p><p><spring:message code="charges.notPaid" /></p>
<c:if test="${empty recordForm.topUpSourceLoanId}"><label><spring:message code="charges.signedEvidence" /><form:input path="evidence" maxlength="500" cssClass="aws-control" /></label></c:if>
<sec:authorize access="@access.has(principal,'LOAN_PRODUCTS_CONFIGURE') and @access.has(principal,'ACCOUNTING_ACCOUNTS_UPDATE')"><a class="app-btn btn-neutral" data-charge-policy-link hidden href="#"><spring:message code="charges.policy" /></a></sec:authorize>
<p><spring:message code="charges.financedBlocked" /></p>
</section>
