<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<div class="accounting-workspace"><div class="erp-page-header" data-aws-page-header><h1 class="erp-page-title"><spring:message code="recording.clientLedgers" /></h1></div><section class="erp-table-wrap" data-aws-table-region><form class="voucher-filters"><label><spring:message code="voucher.search" /><input class="aws-control" name="search" maxlength="100" value="<c:out value='${search}' />" /></label><button class="app-btn btn-neutral"><spring:message code="voucher.search" /></button></form><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="recording.client" /></th></tr></thead><tbody><c:forEach items="${clients}" var="client" end="24"><tr><td><a href="<c:url value='/finance/client-ledgers/${client.id}' />"><c:out value="${client.label}" /></a></td></tr></c:forEach><c:if test="${empty clients}"><tr><td><spring:message code="voucher.noMatches" /></td></tr></c:if></tbody></table></div><div class="voucher-pagination"><spring:message code="voucher.page" /> ${page+1}<div class="accounting-actions"><c:if test="${page>0}"><c:url value="/finance/client-ledgers" var="prev"><c:param name="page" value="${page-1}" /><c:param name="search" value="${search}" /></c:url><a class="app-btn btn-neutral" href="<c:out value='${prev}' />"><spring:message code="common.previous" /></a></c:if><c:if test="${clients.size()>25}"><c:url value="/finance/client-ledgers" var="next"><c:param name="page" value="${page+1}" /><c:param name="search" value="${search}" /></c:url><a class="app-btn btn-neutral" href="<c:out value='${next}' />"><spring:message code="common.next" /></a></c:if></div></div></section></div><%@ include file="../../fragments/footer.jspf" %>
