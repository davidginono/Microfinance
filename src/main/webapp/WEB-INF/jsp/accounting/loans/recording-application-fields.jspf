<%@ page pageEncoding="UTF-8" %>
<c:url value="/finance/loan-recording/evidence/choices/guarantors" var="guarantorChoiceUrl" />
<div class="recording-application-evidence" data-recording-evidence data-root="<c:url value='/finance/loan-recording/evidence'/>" data-error="<spring:message code='applications.error.details'/>" data-select-placeholder="<c:out value='${chooseLabel}' />">
<div class="loan-form-grid">
    <div data-loan-choice data-lazy-choice data-choice-url="<c:url value='/finance/loan-recording/evidence/choices/officers'/>">
        <label for="recordingLoanOfficer"><spring:message code="applications.officer"/></label>
        <form:select path="applicationDetails.loanOfficerId" id="recordingLoanOfficer" cssClass="aws-control" data-choice-select="true">
            <form:option value="" data-empty-option="true"><spring:message code="common.optional"/></form:option>
            <c:if test="${not empty recordForm.applicationDetails.loanOfficerId}"><form:option value="${recordForm.applicationDetails.loanOfficerId}"><c:choose><c:when test="${not empty selectedOfficerLabel}"><c:out value="${selectedOfficerLabel}"/></c:when><c:otherwise><spring:message code="recording.unavailable"/></c:otherwise></c:choose></form:option></c:if>
        </form:select>
        <%@ include file="choice-search.jspf" %>
    </div>
    <label for="recordingUseOfFunds"><spring:message code="applications.useOfFunds"/><form:textarea path="applicationDetails.useOfFunds" id="recordingUseOfFunds" cssClass="aws-control" maxlength="2000" rows="2"/></label>
</div>
<div class="loan-form-grid" data-evidence-fields>
<c:forEach items="${evidenceProduct.fields}" var="field" varStatus="index">
<div><label for="recording-field-${index.index}"><spring:message code="${field.labelKey}" text="${field.name}"/> ${field.required?'*':''}</label>
<c:choose><c:when test="${not empty field.enumOptions or field.type=='boolean'}"><select class="aws-control" id="recording-field-${index.index}" name="applicationDetails.fields[<c:out value='${field.name}'/>]"><option value=""><spring:message code="applications.select"/></option><c:choose><c:when test="${field.type=='boolean'}"><option value="true" ${recordForm.applicationDetails.fields[field.name]=='true'?'selected':''}><spring:message code="common.yes"/></option><option value="false" ${recordForm.applicationDetails.fields[field.name]=='false'?'selected':''}><spring:message code="common.no"/></option></c:when><c:otherwise><c:forEach items="${field.enumOptions}" var="option"><option value="<c:out value='${option}'/>" ${recordForm.applicationDetails.fields[field.name]==option?'selected':''}><c:out value="${option}"/></option></c:forEach></c:otherwise></c:choose></select></c:when>
<c:when test="${field.type=='textarea'}"><textarea class="aws-control" id="recording-field-${index.index}" name="applicationDetails.fields[<c:out value='${field.name}'/>]" rows="2" maxlength="1000"><c:out value="${recordForm.applicationDetails.fields[field.name]}"/></textarea></c:when>
<c:otherwise><input class="aws-control" id="recording-field-${index.index}" name="applicationDetails.fields[<c:out value='${field.name}'/>]" type="${field.type=='number' or field.type=='integer'?'number':field.type=='date'?'date':'text'}" step="${field.type=='integer'?'1':'0.01'}" maxlength="1000" value="<c:out value='${recordForm.applicationDetails.fields[field.name]}'/>"/></c:otherwise></c:choose></div>
</c:forEach>
</div>
<h3><spring:message code="applications.guarantors"/></h3><div data-repeat-list="guarantors"><c:forEach items="${recordForm.applicationDetails.guarantors}" var="row" varStatus="i"><div class="recording-evidence-row" data-repeat-row><div class="loan-form-grid"><div data-loan-choice data-lazy-choice data-choice-url="<c:out value='${guarantorChoiceUrl}' />"><label for="recording-guarantor-${i.index}-client"><spring:message code="applications.client"/></label><form:select path="applicationDetails.guarantors[${i.index}].clientId" id="recording-guarantor-${i.index}-client" cssClass="aws-control" data-choice-select="true"><form:option value=""><spring:message code="recording.choose"/></form:option><c:if test="${not empty row.clientId}"><form:option value="${row.clientId}"><c:choose><c:when test="${not empty evidenceGuarantorLabels[row.clientId]}"><c:out value="${evidenceGuarantorLabels[row.clientId]}"/></c:when><c:otherwise><spring:message code="recording.unavailable"/></c:otherwise></c:choose></form:option></c:if></form:select><%@ include file="choice-search.jspf" %></div><c:forEach items="${['relationship','business','location','phone']}" var="key"><div><label><spring:message code="applications.${key}"/></label><form:input path="applicationDetails.guarantors[${i.index}].${key}" cssClass="aws-control" maxlength="255"/></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-remove-row><spring:message code="applications.remove"/></button></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-add-row="guarantors"><spring:message code="applications.add"/></button>
<h3><spring:message code="applications.collateral"/></h3><div data-repeat-list="collateral"><c:forEach items="${recordForm.applicationDetails.collateral}" var="row" varStatus="i"><div class="recording-evidence-row" data-repeat-row><div class="loan-form-grid"><c:forEach items="${['itemName','itemNumber','itemType','description','owner','phone','location','estimatedValue']}" var="key"><div><label><spring:message code="applications.${key}"/></label><form:input path="applicationDetails.collateral[${i.index}].${key}" cssClass="aws-control" maxlength="500"/></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-remove-row><spring:message code="applications.remove"/></button></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-add-row="collateral"><spring:message code="applications.add"/></button>
<template data-row-template="guarantors"><div class="recording-evidence-row" data-repeat-row><div class="loan-form-grid"><div data-loan-choice data-lazy-choice data-choice-url="<c:out value='${guarantorChoiceUrl}' />"><label><spring:message code="applications.client"/></label><select class="aws-control" data-field="clientId" data-choice-select="true"><option value=""><spring:message code="recording.choose"/></option></select><%@ include file="choice-search.jspf" %></div><c:forEach items="${['relationship','business','location','phone']}" var="key"><div><label><spring:message code="applications.${key}"/></label><input class="aws-control" data-field="${key}" maxlength="255"/></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-remove-row><spring:message code="applications.remove"/></button></div></template>
<template data-row-template="collateral"><div class="recording-evidence-row" data-repeat-row><div class="loan-form-grid"><c:forEach items="${['itemName','itemNumber','itemType','description','owner','phone','location','estimatedValue']}" var="key"><div><label><spring:message code="applications.${key}"/></label><input class="aws-control" data-field="${key}" maxlength="500" <c:if test="${key=='estimatedValue'}">type="number" min="0" step="0.01"</c:if>/></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-remove-row><spring:message code="applications.remove"/></button></div></template>
<c:if test="${not empty savedApplicationDocuments}"><h3><spring:message code="applications.savedDocuments"/></h3><ul class="recording-saved-files">
<c:forEach items="${savedApplicationDocuments}" var="file" varStatus="index"><li>
<a class="resource-table-id-link" href="<c:url value='/finance/loan-records/applications/${recordForm.applicationId}/documents/${file.id}'/>" data-download-action="true"><c:out value="${empty file.documentTitle?file.originalName:file.documentTitle}"/></a>
<button type="submit" form="recording-remove-${index.index}" formnovalidate class="app-btn btn-neutral"><spring:message code="applications.remove"/></button>
</li></c:forEach></ul></c:if>
<h3><spring:message code="applications.documents"/></h3>
<p data-evidence-requirements></p>
<div data-evidence-documents></div>
<template data-evidence-document-template><div class="loan-form-grid recording-evidence-row">
<label><spring:message code="applications.file"/><span data-evidence-filename></span></label>
<label><spring:message code="applications.documentName"/><input class="aws-control" data-document-field="documentNames" maxlength="120"/></label>
<label><spring:message code="applications.documentType"/><select class="aws-control" data-document-field="documentTypes"><c:forEach items="${documentTypes}" var="type"><option value="${type}"><spring:message code="applications.document.${type}"/></option></c:forEach></select></label>
<label><spring:message code="applications.requirement"/><select class="aws-control" data-document-field="requiredAttachmentIds"><option value=""><spring:message code="applications.optional"/></option></select></label>
</div></template>
<label class="recording-declaration"><form:checkbox path="applicationDetails.declarationAccepted"/><span><spring:message code="applications.declaration"/></span></label>
<p role="alert" data-evidence-error class="coa-error" hidden></p>
<span hidden data-evidence-yes><spring:message code="common.yes"/></span><span hidden data-evidence-no><spring:message code="common.no"/></span>
</div>
