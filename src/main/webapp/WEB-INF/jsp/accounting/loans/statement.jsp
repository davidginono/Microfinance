<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/statement-reference.css' />" />
<link rel="stylesheet" href="<c:url value='/css/client-loan-statement.css' />" />
<div class="accounting-workspace client-statement-workspace"><div class="erp-page-header erp-detail-header" data-aws-page-header><h1 class="erp-page-title"><spring:message code="recording.statement" /></h1><sec:authorize access="@access.has(principal,'LOAN_RECORDING_EXPORT')"><div class="accounting-actions" data-aws-action-pin="true"><a class="app-btn btn-neutral" href="<c:url value='/finance/client-ledgers/${clientId}/pdf' />"><spring:message code="voucher.pdf" /></a><a class="app-btn btn-neutral" data-print-action="true" href="<c:url value='/finance/client-ledgers/${clientId}/print' />"><spring:message code="voucher.print" /></a></div></sec:authorize></div><section class="reference-report client-loan-statement"><h2 class="reference-title"><spring:message code="recording.statement" /></h2><p><c:out value="${statement.client}" /></p><dl class="erp-detail-facts"><div><dt><spring:message code="recording.outstandingPrincipal" /> (TZS)</dt><dd><fmt:formatNumber value="${statement.principal}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.dueInterest" /> (TZS)</dt><dd><fmt:formatNumber value="${statement.interest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.arrears" /> (TZS)</dt><dd><fmt:formatNumber value="${statement.arrears}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.futureInterest" /> (TZS)</dt><dd><fmt:formatNumber value="${statement.futureInterest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div></dl></section>
<section class="reference-report reference-account"><div class="reference-scroll"><table class="reference-table"><thead><tr><th><spring:message code="recording.loan" /></th><th><spring:message code="recording.product" /></th><th><spring:message code="voucher.status" /></th><th><spring:message code="recording.outstandingPrincipal" /></th><th><spring:message code="recording.dueInterest" /></th><th><spring:message code="recording.arrears" /></th></tr></thead><tbody><c:forEach items="${statement.page.rows}" var="l"><tr><td><a href="<c:url value='/finance/client-ledgers/${clientId}/loans/${l.id}/statement' />"><c:out value="${l.number}" /></a></td><td><c:out value="${l.product}" /></td><td><spring:message code="recording.status.${l.status}" /></td><td><fmt:formatNumber value="${l.outstandingPrincipal}" pattern="#,##0.00;(#,##0.00)" /></td><td><fmt:formatNumber value="${l.dueInterest}" pattern="#,##0.00;(#,##0.00)" /></td><td><fmt:formatNumber value="${l.arrears}" pattern="#,##0.00;(#,##0.00)" /></td></tr></c:forEach></tbody></table></div><div class="reference-pagination"><spring:message code="voucher.page" /> ${statement.page.page+1}<div class="accounting-actions"><c:if test="${statement.page.page>0}"><a data-page-direction="previous" class="app-btn btn-neutral" href="?page=${statement.page.page-1}&amp;movementPage=${movements.page}"><spring:message code="common.previous" /></a></c:if><c:if test="${statement.page.hasNext}"><a data-page-direction="next" class="app-btn btn-neutral" href="?page=${statement.page.page+1}&amp;movementPage=${movements.page}"><spring:message code="common.next" /></a></c:if></div></div></section><section class="reference-report reference-account client-loan-statement"><div class="app-table-titlebar"><h2><spring:message code="recording.history" /></h2></div><div class="reference-scroll"><table class="reference-table"><thead><tr><th><spring:message code="voucher.date" /></th><th><spring:message code="recording.loan" /></th><th><spring:message code="recording.product" /></th><th><spring:message code="voucher.reference" /></th><th><spring:message code="voucher.type" /></th><th><spring:message code="voucher.amount" /> (TZS)</th><th><spring:message code="recording.principal" /></th><th><spring:message code="recording.interest" /></th><th><spring:message code="recording.balanceAfter" /></th></tr></thead><tbody><c:forEach items="${movements.rows}" var="p"><tr><td>${p.date}</td><td><c:out value="${p.loanNumber}" /></td><td><c:out value="${p.product}" /></td><td><a href="<c:url value='/finance/loan-postings/${p.id}' />"><c:out value="${p.reference}" /></a></td><td><spring:message code="recording.document.${p.kind}" /></td><td><fmt:formatNumber value="${p.kind=='REVERSAL'?-p.amount:p.amount}" pattern="#,##0.00;(#,##0.00)" /></td><td><fmt:formatNumber value="${p.principal}" pattern="#,##0.00;(#,##0.00)" /></td><td><fmt:formatNumber value="${p.interest}" pattern="#,##0.00;(#,##0.00)" /></td><td><fmt:formatNumber value="${p.principalBalance}" pattern="#,##0.00;(#,##0.00)" /></td></tr></c:forEach></tbody></table></div><div class="reference-pagination"><spring:message code="voucher.page" /> ${movements.page+1}<div class="accounting-actions"><c:if test="${movements.page>0}"><a data-page-direction="previous" class="app-btn btn-neutral" href="?movementPage=${movements.page-1}&amp;page=${statement.page.page}"><spring:message code="common.previous" /></a></c:if><c:if test="${movements.hasNext}"><a data-page-direction="next" class="app-btn btn-neutral" href="?movementPage=${movements.page+1}&amp;page=${statement.page.page}"><spring:message code="common.next" /></a></c:if></div></div></section></div><%@ include file="../../fragments/footer.jspf" %>
