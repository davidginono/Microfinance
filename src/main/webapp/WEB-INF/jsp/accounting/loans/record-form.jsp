<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<nav class="erp-page-path"><a href="<c:url value='/finance/loan-records' />"><spring:message code="recording.register.LOAN" /></a><span aria-hidden="true">&#8250;</span><span aria-current="page"><spring:message code="${empty recordForm.topUpSourceLoanId ? 'recording.create.LOAN' : 'recording.topUp.create'}" /></span></nav>
<div class="erp-page-header" data-aws-page-header><h1 class="erp-page-title"><spring:message code="${empty recordForm.topUpSourceLoanId ? 'recording.create.LOAN' : 'recording.topUp.create'}" /></h1></div>
<div class="accounting-workspace accounting-create-workspace"><c:url value="/finance/loan-records" var="saveUrl" />
<form:form modelAttribute="recordForm" action="${saveUrl}" method="post" enctype="multipart/form-data" data-loan-form="true" cssClass="accounting-create-form"><form:hidden path="requestKey" /><c:if test="${not empty recordForm.topUpSourceLoanId}"><form:hidden path="topUpSourceLoanId" /><form:hidden path="clientId" /></c:if>
<form:errors path="*" cssClass="loan-error-summary" element="div" role="alert" tabindex="-1" />
<c:if test="${not empty recordForm.topUpSourceLoanId}"><%@ include file="topup-quote.jspf" %></c:if>
<section class="accounting-section" aria-labelledby="loan-basic-information"><h2 id="loan-basic-information"><spring:message code="recording.loanDetails" /></h2><div class="loan-form-grid">
<div data-loan-choice data-category="clients"><label for="clientId"><spring:message code="recording.client" /><form:select path="clientId" id="clientId" disabled="${not empty recordForm.topUpSourceLoanId}" cssClass="aws-control" data-choice-select="true"><form:option value="" label="${chooseLabel}" /><c:if test="${not empty recordForm.clientId}"><form:option value="${recordForm.clientId}" label="${empty topUpQuote ? recordForm.clientId : topUpQuote.client}" /></c:if></form:select></label><%@ include file="choice-search.jspf" %></div>
<label for="loanMode"><spring:message code="recording.loanMode" /><form:select path="loanMode" id="loanMode" cssClass="aws-control"><form:option value="CONFIGURED"><spring:message code="recording.mode.CONFIGURED" /></form:option><form:option value="CUSTOM"><spring:message code="recording.mode.CUSTOM" /></form:option></form:select></label>
<div data-configured-product ${recordForm.loanMode eq 'CUSTOM' ? 'hidden' : ''} data-loan-choice data-category="products"><label for="productId"><spring:message code="recording.product" /><form:select path="productId" id="productId" cssClass="aws-control" data-choice-select="true"><form:option value="" label="${chooseLabel}" /><c:if test="${not empty recordForm.productId}"><form:option value="${recordForm.productId}" label="${empty selectedProduct ? recordForm.productId : selectedProduct.label}" data-tenure-unit="${selectedProduct.tenureUnit}" data-minimum-amount="${selectedProduct.minimumAmount}" data-maximum-amount="${selectedProduct.maximumAmount}" data-minimum-tenure="${selectedProduct.minimumTenure}" data-maximum-tenure="${selectedProduct.maximumTenure}" /></c:if></form:select></label><%@ include file="choice-search.jspf" %></div>
<label for="applicationDate"><spring:message code="recording.applicationDate" /><form:input path="applicationDate" id="applicationDate" type="date" cssClass="aws-control" required="required" /></label>
<label for="purpose"><spring:message code="recording.purpose" /><form:input path="purpose" id="purpose" maxlength="500" cssClass="aws-control" required="required" /></label>
</div></section>
<section class="accounting-section loan-repayment-terms"><h2><spring:message code="recording.terms" /></h2><div class="loan-form-grid">
<label for="tenureUnit" data-tenure-type ${recordForm.loanMode ne 'CUSTOM' ? 'hidden' : ''}><spring:message code="recording.tenureUnit" /><form:select path="tenureUnit" id="tenureUnit" cssClass="aws-control" required="required"><form:option value="" label="${chooseLabel}" /><c:forEach items="${['DAYS','MONTHS','YEARS']}" var="u"><form:option value="${u}"><spring:message code="recording.tenure.${u}" /></form:option></c:forEach></form:select></label>
<label for="tenureValue" data-tenure-number ${empty recordForm.tenureUnit ? 'hidden' : ''}><span data-tenure-label data-empty="<spring:message code='recording.tenureValue' />" data-days="<spring:message code='recording.tenureValue.DAYS' />" data-months="<spring:message code='recording.tenureValue.MONTHS' />" data-years="<spring:message code='recording.tenureValue.YEARS' />"><spring:message code="recording.tenureValue${recordForm.tenureUnit eq 'DAYS' ? '.DAYS' : recordForm.tenureUnit eq 'MONTHS' ? '.MONTHS' : recordForm.tenureUnit eq 'YEARS' ? '.YEARS' : ''}" /></span><form:input path="tenureValue" id="tenureValue" aria-describedby="loan-tenure-limits" type="number" min="1" step="1" cssClass="aws-control" required="required" /><small id="loan-tenure-limits" class="loan-field-hint" data-product-tenure-limits hidden aria-live="polite"><spring:message code="newloan.allowedTenureRange" /> <span data-limit-min></span> <spring:message code="common.to" /> <span data-limit-max></span> <span data-limit-unit></span></small></label>
<div data-custom-terms class="loan-custom-terms" ${recordForm.loanMode ne 'CUSTOM' ? 'hidden' : ''}><label for="customMethod"><spring:message code="recording.method" /><form:select path="customMethod" id="customMethod" cssClass="aws-control"><form:option value="FLAT_RATE"><spring:message code="recording.method.FLAT_RATE" /></form:option><form:option value="REDUCING_BALANCE"><spring:message code="recording.method.REDUCING_BALANCE" /></form:option></form:select></label>
<label for="interestEntry"><spring:message code="recording.interestEntry" /><form:select path="interestEntry" id="interestEntry" cssClass="aws-control"><form:option value="PERCENTAGE"><spring:message code="recording.entry.PERCENTAGE" /></form:option><form:option value="AMOUNT"><spring:message code="recording.entry.AMOUNT" /></form:option></form:select></label>
<label data-custom-percentage for="interestPercent"><spring:message code="recording.interestPercent" /><form:input path="interestPercent" id="interestPercent" type="number" min="0" max="10000" step="0.0001" cssClass="aws-control" /></label>
<label data-custom-percentage for="interestBasis"><spring:message code="recording.interestBasis" /><form:select path="interestBasis" id="interestBasis" cssClass="aws-control" aria-describedby="reducingTermsNote"><form:option value="WHOLE_LOAN"><spring:message code="recording.basis.WHOLE_LOAN" /></form:option><form:option value="ANNUAL"><spring:message code="recording.basis.ANNUAL" /></form:option></form:select><small id="reducingTermsNote" class="loan-field-hint" data-reducing-terms-note ${recordForm.customMethod ne 'REDUCING_BALANCE' or recordForm.interestBasis ne 'WHOLE_LOAN' ? 'hidden' : ''}><spring:message code="recording.reducingTerms" /></small></label>
<label data-custom-amount for="interestAmount"><spring:message code="recording.interest" /> (TZS)<form:input path="interestAmount" id="interestAmount" type="number" data-amount-input="true" min="0" step="0.01" cssClass="aws-control" /></label>
<label for="customFrequency"><spring:message code="recording.frequency" /><form:select path="customFrequency" id="customFrequency" cssClass="aws-control"><form:option value="MONTHLY"><spring:message code="recording.frequency.MONTHLY" /></form:option><form:option value="WEEKLY"><spring:message code="recording.frequency.WEEKLY" /></form:option></form:select></label></div>
</div><p data-configured-terms-note ${recordForm.loanMode eq 'CUSTOM' ? 'hidden' : ''}><spring:message code="recording.productTerms" /></p><div class="loan-form-grid loan-amount-row"><label for="principal"><spring:message code="${empty recordForm.topUpSourceLoanId ? 'recording.loanAmount' : 'recording.topUp.newPrincipal'}" /> (TZS)<form:input path="principal" id="principal" aria-describedby="loan-amount-limits" type="number" data-amount-input="true" min="0.01" step="0.01" cssClass="aws-control" required="required" /><small id="loan-amount-limits" class="loan-field-hint" data-product-amount-limits data-unavailable="<spring:message code='recording.unavailable' />" hidden aria-live="polite"><spring:message code="newloan.allowedRange" /> TZS <span data-limit-min></span> <spring:message code="common.to" /> <span data-limit-max></span></small></label>
<div data-interest-preview aria-live="polite" data-error="<spring:message code='recording.quoteError' />" data-days="<spring:message code='recording.tenure.DAYS' />" data-months="<spring:message code='recording.tenure.MONTHS' />" data-years="<spring:message code='recording.tenure.YEARS' />"><span class="loan-interest-label"><spring:message code="recording.contractInterest" /> (TZS) <span class="loan-interest-spinner" hidden aria-hidden="true"></span></span><output data-interest-value>&#8212;</output><p data-interest-description></p><p data-approved-rate hidden data-label="<spring:message code='recording.rate' />" data-basis="<spring:message code='recording.basis.ANNUAL' />"></p></div>
</div></section>
<%@ include file="charges-form.jspf" %>
<section class="loan-schedule-preview accounting-section" data-schedule-preview hidden aria-labelledby="loan-schedule-heading"><h2 id="loan-schedule-heading"><spring:message code="repayment.estimatedSchedule" /></h2><p><span data-schedule-summary data-monthly="<spring:message code='recording.frequency.MONTHLY' />" data-weekly="<spring:message code='recording.frequency.WEEKLY' />" data-weekly-period="<spring:message code='repayment.period.WEEKLY' />" data-monthly-period="<spring:message code='repayment.period.MONTHLY' />"></span> · <spring:message code="recording.beforeDisbursement" /></p><div class="erp-table-scroll erp-table-scroll-sm" role="region" tabindex="0" aria-labelledby="loan-schedule-heading"><table class="erp-table" data-table-sort-mode="local"><thead><tr><th scope="col">#</th><th scope="col"><spring:message code="recording.dueDate" /></th><th scope="col"><spring:message code="repayment.beginningBalance" /> (TZS)</th><th scope="col"><spring:message code="repayment.scheduledPayment" /> (TZS)</th><th scope="col"><spring:message code="recording.principal" /> (TZS)</th><th scope="col"><spring:message code="recording.interest" /> (TZS)</th><th scope="col"><spring:message code="repayment.endingBalance" /> (TZS)</th></tr></thead><tbody data-schedule-rows></tbody></table></div></section>
<c:if test="${not empty recordForm.topUpSourceLoanId}"><section class="accounting-section"><h2><spring:message code="recording.topUp.agreement" /></h2><label for="topUpEvidence"><spring:message code="recording.topUp.agreement" /><form:input path="evidence" id="topUpEvidence" cssClass="aws-control" required="required" maxlength="500" /></label></section></c:if>
<details class="accounting-section"><summary><spring:message code="recording.supporting" /></summary><div class="loan-form-grid">
<label><spring:message code="recording.business" /><form:textarea path="business" cssClass="aws-control" maxlength="1000" rows="3" /></label>
<label><spring:message code="recording.information" /><form:select path="informationSource" cssClass="aws-control"><c:forEach items="${['DECLARED','DOCUMENTED','UNAVAILABLE']}" var="s"><form:option value="${s}"><spring:message code="recording.source.${s}" /></form:option></c:forEach></form:select></label>
<label><spring:message code="recording.income" /> (TZS)<form:input path="income" type="number" data-amount-input="true" min="0" step="0.01" cssClass="aws-control" /></label>
<label><spring:message code="recording.expenses" /> (TZS)<form:input path="expenses" type="number" data-amount-input="true" min="0" step="0.01" cssClass="aws-control" /></label>
<label><spring:message code="recording.otherDebt" /> (TZS)<form:input path="otherDebt" type="number" data-amount-input="true" min="0" step="0.01" cssClass="aws-control" /></label>
<label><spring:message code="recording.guarantors" /><form:textarea path="guarantors" cssClass="aws-control" maxlength="1000" rows="3" /></label>
<label><spring:message code="recording.collateral" /><form:textarea path="collateral" cssClass="aws-control" maxlength="1000" rows="3" /></label>
<%@ include file="attachments.jspf" %>
<label><spring:message code="voucher.description" /><form:textarea path="notes" cssClass="aws-control" maxlength="500" rows="3" /></label>
</div></details>
<div class="accounting-actions loan-form-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/loan-records' />"><spring:message code="common.cancel" /></a><button class="app-btn btn-launch" name="action" value="save"><spring:message code="recording.save" /></button></div>
</form:form></div><%@ include file="../../fragments/attachment-dropzone.jspf" %><%@ include file="../accounting-form-support.jspf" %><script src="<c:url value='/js/loan-recording.js' />" defer></script><script src="<c:url value='/js/loan-charges.js' />" defer></script><script src="<c:url value='/js/loan-topup.js' />" defer></script><%@ include file="../../fragments/footer.jspf" %>
