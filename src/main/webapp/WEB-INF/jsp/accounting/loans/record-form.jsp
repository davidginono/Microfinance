<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<nav class="erp-page-path"><a href="<c:url value='/finance/loan-records' />"><spring:message code="recording.register.LOAN" /></a><span aria-hidden="true">&#8250;</span><span aria-current="page"><spring:message code="recording.create.LOAN" /></span></nav>
<div class="erp-page-header" data-aws-page-header><h1 class="erp-page-title"><spring:message code="recording.create.LOAN" /></h1></div>
<div class="accounting-workspace accounting-create-workspace"><c:url value="/finance/loan-records" var="saveUrl" />
<form:form modelAttribute="recordForm" action="${saveUrl}" method="post" enctype="multipart/form-data" data-loan-form="true" cssClass="accounting-create-form"><form:hidden path="requestKey" />
<form:errors path="*" cssClass="loan-error-summary" element="div" role="alert" tabindex="-1" />
<section class="accounting-section"><div class="loan-form-grid">
<div data-loan-choice data-category="clients"><label for="clientId"><spring:message code="recording.client" /><form:select path="clientId" id="clientId" cssClass="aws-control" data-choice-select="true"><form:option value="" label="${chooseLabel}" /><c:if test="${not empty recordForm.clientId}"><form:option value="${recordForm.clientId}" label="${recordForm.clientId}" /></c:if></form:select></label><%@ include file="choice-search.jspf" %></div>
<label for="loanMode"><spring:message code="recording.loanMode" /><form:select path="loanMode" id="loanMode" cssClass="aws-control"><form:option value="CONFIGURED"><spring:message code="recording.mode.CONFIGURED" /></form:option><form:option value="CUSTOM"><spring:message code="recording.mode.CUSTOM" /></form:option></form:select></label>
<div data-configured-product ${recordForm.loanMode eq 'CUSTOM' ? 'hidden' : ''} data-loan-choice data-category="products"><label for="productId"><spring:message code="recording.product" /><form:select path="productId" id="productId" cssClass="aws-control" data-choice-select="true"><form:option value="" label="${chooseLabel}" /><c:if test="${not empty recordForm.productId}"><form:option value="${recordForm.productId}" label="${recordForm.productId}" /></c:if></form:select></label><%@ include file="choice-search.jspf" %></div>
<label for="applicationDate"><spring:message code="recording.applicationDate" /><form:input path="applicationDate" id="applicationDate" type="date" cssClass="aws-control" required="required" /></label>
<label for="purpose"><spring:message code="recording.purpose" /><form:input path="purpose" id="purpose" maxlength="500" cssClass="aws-control" required="required" /></label>
</div></section>
<section class="accounting-section loan-repayment-terms"><h2><spring:message code="recording.terms" /></h2><div class="loan-form-grid">
<label for="tenureUnit"><spring:message code="recording.tenureUnit" /><form:select path="tenureUnit" id="tenureUnit" cssClass="aws-control" required="required"><form:option value="" label="${chooseLabel}" /><c:forEach items="${['DAYS','MONTHS','YEARS']}" var="u"><form:option value="${u}"><spring:message code="recording.tenure.${u}" /></form:option></c:forEach></form:select></label>
<label for="tenureValue" data-tenure-number ${empty recordForm.tenureUnit ? 'hidden' : ''}><spring:message code="recording.tenureValue" /><form:input path="tenureValue" id="tenureValue" type="number" min="1" step="1" cssClass="aws-control" required="required" /></label>
<div data-custom-terms class="loan-custom-terms" ${recordForm.loanMode ne 'CUSTOM' ? 'hidden' : ''}><label for="interestEntry"><spring:message code="recording.interestEntry" /><form:select path="interestEntry" id="interestEntry" cssClass="aws-control"><form:option value="PERCENTAGE"><spring:message code="recording.entry.PERCENTAGE" /></form:option><form:option value="AMOUNT"><spring:message code="recording.entry.AMOUNT" /></form:option></form:select></label>
<label data-custom-percentage for="interestPercent"><spring:message code="recording.interestPercent" /><form:input path="interestPercent" id="interestPercent" type="number" min="0" max="10000" step="0.0001" cssClass="aws-control" /></label>
<label data-custom-percentage for="interestBasis"><spring:message code="recording.interestBasis" /><form:select path="interestBasis" id="interestBasis" cssClass="aws-control"><form:option value="WHOLE_LOAN"><spring:message code="recording.basis.WHOLE_LOAN" /></form:option><form:option value="ANNUAL"><spring:message code="recording.basis.ANNUAL" /></form:option></form:select></label>
<label data-custom-amount for="interestAmount"><spring:message code="recording.interest" /> (TZS)<form:input path="interestAmount" id="interestAmount" type="number" min="0" step="0.01" cssClass="aws-control" /></label>
<label for="customFrequency"><spring:message code="recording.frequency" /><form:select path="customFrequency" id="customFrequency" cssClass="aws-control"><form:option value="MONTHLY"><spring:message code="recording.frequency.MONTHLY" /></form:option><form:option value="WEEKLY"><spring:message code="recording.frequency.WEEKLY" /></form:option></form:select></label></div>
</div><p data-configured-terms-note ${recordForm.loanMode eq 'CUSTOM' ? 'hidden' : ''}><spring:message code="recording.productTerms" /></p><div class="loan-form-grid loan-amount-row"><label for="principal"><spring:message code="recording.loanAmount" /> (TZS)<form:input path="principal" id="principal" type="number" min="0.01" step="0.01" cssClass="aws-control" required="required" /></label>
<div data-interest-preview aria-live="polite" data-error="<spring:message code='recording.quoteError' />" data-days="<spring:message code='recording.tenure.DAYS' />" data-months="<spring:message code='recording.tenure.MONTHS' />" data-years="<spring:message code='recording.tenure.YEARS' />"><span class="loan-interest-label"><spring:message code="recording.contractInterest" /> (TZS) <span class="loan-interest-spinner" hidden aria-hidden="true"></span></span><output data-interest-value>&#8212;</output><p data-interest-description></p></div>
</div></section>
<section class="loan-schedule-preview" data-schedule-preview hidden aria-labelledby="loan-schedule-heading"><h2 id="loan-schedule-heading"><spring:message code="repayment.estimatedSchedule" /></h2><p><span data-schedule-summary data-monthly="<spring:message code='recording.frequency.MONTHLY' />" data-weekly="<spring:message code='recording.frequency.WEEKLY' />"></span> · <spring:message code="recording.beforeDisbursement" /></p><div class="erp-table-scroll erp-table-scroll-sm" role="region" tabindex="0" aria-labelledby="loan-schedule-heading"><table class="erp-table"><thead><tr><th scope="col">#</th><th scope="col"><spring:message code="recording.dueDate" /></th><th scope="col"><spring:message code="recording.principal" /> (TZS)</th><th scope="col"><spring:message code="recording.interest" /> (TZS)</th><th scope="col"><spring:message code="voucher.amount" /> (TZS)</th></tr></thead><tbody data-schedule-rows></tbody></table></div></section>
<details class="accounting-section"><summary><spring:message code="recording.supporting" /></summary><div class="loan-form-grid">
<label><spring:message code="recording.business" /><form:textarea path="business" cssClass="aws-control" maxlength="1000" rows="3" /></label>
<label><spring:message code="recording.information" /><form:select path="informationSource" cssClass="aws-control"><c:forEach items="${['DECLARED','DOCUMENTED','UNAVAILABLE']}" var="s"><form:option value="${s}"><spring:message code="recording.source.${s}" /></form:option></c:forEach></form:select></label>
<label><spring:message code="recording.income" /> (TZS)<form:input path="income" type="number" min="0" step="0.01" cssClass="aws-control" /></label>
<label><spring:message code="recording.expenses" /> (TZS)<form:input path="expenses" type="number" min="0" step="0.01" cssClass="aws-control" /></label>
<label><spring:message code="recording.otherDebt" /> (TZS)<form:input path="otherDebt" type="number" min="0" step="0.01" cssClass="aws-control" /></label>
<label><spring:message code="recording.guarantors" /><form:textarea path="guarantors" cssClass="aws-control" maxlength="1000" rows="3" /></label>
<label><spring:message code="recording.collateral" /><form:textarea path="collateral" cssClass="aws-control" maxlength="1000" rows="3" /></label>
<%@ include file="attachments.jspf" %>
<label><spring:message code="voucher.description" /><form:textarea path="notes" cssClass="aws-control" maxlength="500" rows="3" /></label>
</div></details>
<div class="accounting-actions loan-form-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/loan-records' />"><spring:message code="common.cancel" /></a><button class="app-btn btn-primary" name="action" value="save"><spring:message code="recording.save" /></button></div>
</form:form></div><%@ include file="../../fragments/attachment-dropzone.jspf" %><%@ include file="../accounting-form-support.jspf" %><script src="<c:url value='/js/loan-recording.js' />" defer></script><%@ include file="../../fragments/footer.jspf" %>
