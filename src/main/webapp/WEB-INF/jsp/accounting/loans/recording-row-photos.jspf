<%@ page pageEncoding="UTF-8" %>
<div class="recording-row-photos">
<label class="attachment-dropzone"><input type="file" multiple accept=".png,.jpg,.jpeg" class="attachment-dropzone-input" data-row-photos/><span class="attachment-dropzone-main"><span class="attachment-dropzone-title"><spring:message code="kyc.addPhoto"/></span><span class="attachment-dropzone-action"><spring:message code="attachments.dropzone.choose"/></span><span class="attachment-dropzone-help"><spring:message code="recording.photos.help"/></span></span></label>
</div>
