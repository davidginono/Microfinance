<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty topUpQuote or not empty topUpError}"><%@ include file="topup-quote.jspf" %></c:if>
<c:if test="${not empty sourceTopUp}"><section class="accounting-section erp-detail-card"><h2><spring:message code="recording.topUp.settled" /></h2><p><spring:message code="recording.topUp.replacement" />: <a href="<c:url value='/finance/loan-records/${sourceTopUp.loanId}' />"><c:out value="${sourceTopUp.loanNumber}" /></a></p><p><spring:message code="recording.topUp.internal" /></p><p><spring:message code="recording.topUp.excluded" />: TZS <fmt:formatNumber value="${sourceTopUp.excludedInterest}" minFractionDigits="2" maxFractionDigits="2" /></p></section></c:if>
<c:if test="${not empty topUpPosting}">
<section class="accounting-section erp-detail-card loan-topup-summary"><h2><spring:message code="recording.topUp.breakdown" /></h2>
    <p><spring:message code="recording.topUp.source" />: <a href="<c:url value='/finance/loan-records/${topUpPosting.sourceId}' />"><c:out value="${topUpPosting.sourceNumber}" /></a> · <c:out value="${topUpPosting.date}" /></p>
    <dl class="loan-topup-facts"><div><dt><spring:message code="recording.topUp.newPrincipal" /> (TZS)</dt><dd><fmt:formatNumber value="${detail.loan.principal}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.outstandingPrincipal" /> (TZS)</dt><dd><fmt:formatNumber value="${topUpPosting.principal}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.topUp.settlement" /> (TZS)</dt><dd><fmt:formatNumber value="${topUpPosting.principal+topUpPosting.interest+topUpPosting.sourceCharges}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="charges.sourceSettlement" /> (TZS)</dt><dd><fmt:formatNumber value="${topUpPosting.sourceCharges}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="charges.deductions" /> (TZS)</dt><dd><fmt:formatNumber value="${topUpPosting.newDeductions}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.topUp.cash" /> (TZS)</dt><dd><fmt:formatNumber value="${topUpPosting.cash}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.dueInterest" /> (TZS)</dt><dd><fmt:formatNumber value="${topUpPosting.interest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.topUp.excluded" /> (TZS)</dt><dd><fmt:formatNumber value="${topUpPosting.excludedInterest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div></dl>
    <p><spring:message code="recording.topUp.internal" /></p><p><spring:message code="recording.topUp.agreement" />: <c:out value="${topUpPosting.evidence}" /></p>
    <c:choose><c:when test="${not empty topUpPosting.reversedBy}"><p role="status"><spring:message code="recording.topUp.reversed" /></p></c:when><c:otherwise>
    <sec:authorize access="@access.has(principal,'LOAN_RECORDING_REVERSE')"><c:if test="${topUpPosting.actorId ne principal.memberId}"><details ${not empty topUpCorrectionError ? 'open' : ''}><summary><spring:message code="recording.topUp.reverse" /></summary>
    <form method="post" action="<c:url value='/finance/loan-records/${detail.loan.id}/reverse-top-up' />" data-loan-form data-confirm-message="<spring:message code='recording.topUp.reverseConfirm' /> ${fn:escapeXml(topUpPosting.sourceNumber)} → ${fn:escapeXml(topUpPosting.loanNumber)} · TZS ${topUpPosting.cash}"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="requestKey" value="${topUpReverseKey}" />
    <c:if test="${not empty topUpCorrectionError}"><p class="loan-error-summary" tabindex="-1" role="alert"><spring:message code="${topUpCorrectionError}" /></p></c:if>
    <div class="loan-form-grid"><label><spring:message code="voucher.date" /><input class="aws-control" type="date" name="date" value="${empty topUpCorrectionDate ? today : topUpCorrectionDate}" min="${topUpPosting.date}" max="${today}" required /></label><label><spring:message code="recording.topUp.correctionEvidence" /><input class="aws-control" name="evidence" maxlength="500" value="${fn:escapeXml(topUpEvidence)}" required /></label><label><spring:message code="repayment.reason" /><textarea class="aws-control" name="reason" maxlength="500" required><c:out value="${topUpReason}" /></textarea></label></div><p><spring:message code="recording.topUp.dependencies" /></p><div class="accounting-actions"><button class="app-btn btn-neutral"><spring:message code="recording.topUp.reverse" /></button></div></form></details></c:if></sec:authorize>
    </c:otherwise></c:choose>
</section></c:if>

<script src="<c:url value='/js/loan-recording.js' />" defer></script>
