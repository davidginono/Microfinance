<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<div class="accounting-workspace"><nav class="erp-page-path"><a href="<c:url value='/finance/loan-records' />"><spring:message code="recording.register.LOAN" /></a><span>›</span><span aria-current="page"><c:out value="${detail.loan.number}" /></span></nav><div class="erp-page-header" data-aws-page-header><h1 class="erp-page-title"><spring:message code="recording.loanDetails" /> <c:out value="${detail.loan.number}" /></h1></div><c:if test="${recordingSaved}"><div class="loan-success" role="status"><spring:message code="recording.saved" /></div></c:if>
<div class="accounting-actions"><sec:authorize access="@access.has(principal,'LOAN_RECORDING_EXPORT')"><a class="app-btn btn-neutral" href="<c:url value='/finance/loan-records/${detail.loan.id}/pdf' />"><spring:message code="voucher.pdf" /></a><a class="app-btn btn-neutral" href="<c:url value='/finance/loan-records/${detail.loan.id}/print' />"><spring:message code="voucher.print" /></a></sec:authorize><c:if test="${detail.loan.status=='RECORDED'}"><sec:authorize access="@access.has(principal,'LOAN_RECORDING_DISBURSE')"><a class="app-btn btn-primary" href="<c:url value='/finance/loan-disbursements/new?loanId=${detail.loan.id}' />"><spring:message code="recording.create.DISBURSEMENT" /></a></sec:authorize></c:if><c:if test="${detail.loan.status=='DISBURSED' or detail.loan.status=='PAR' or detail.loan.status=='DEFAULTED'}"><sec:authorize access="@access.has(principal,'LOAN_RECORDING_POST')"><a class="app-btn btn-primary" href="<c:url value='/finance/loan-repayments/new?loanId=${detail.loan.id}' />"><spring:message code="recording.create.PAYMENT" /></a></sec:authorize></c:if><a class="app-btn btn-neutral" href="<c:url value='/finance/client-ledgers/${detail.loan.clientId}' />"><spring:message code="recording.statement" /></a></div>
<section class="accounting-section"><h2><c:out value="${detail.loan.client}" /> · <c:out value="${detail.loan.clientNumber}" /></h2><p><spring:message code="recording.status.${detail.loan.status}" /></p><dl class="loan-facts">
<div><dt><spring:message code="recording.product" /></dt><dd><c:out value="${detail.loan.product}" /></dd></div><div><dt><spring:message code="recording.applicationDate" /></dt><dd>${detail.loan.applicationDate}</dd></div><div><dt><spring:message code="recording.requestedPrincipal" /> (TZS)</dt><dd>${detail.loan.requestedPrincipal}</dd></div><div><dt><spring:message code="recording.principal" /> (TZS)</dt><dd>${detail.loan.principal}</dd></div><div><dt><spring:message code="recording.firstPaymentDate" /></dt><dd>${detail.firstPaymentDate}</dd></div><div><dt><spring:message code="recording.months" /></dt><dd>${detail.months}</dd></div><div><dt><spring:message code="recording.installment" /> (TZS)</dt><dd>${detail.installment}</dd></div><div><dt><spring:message code="recording.contractInterest" /> (TZS)</dt><dd>${detail.contractualInterest}</dd></div><div><dt><spring:message code="recording.purpose" /></dt><dd><c:out value="${detail.purpose}" /></dd></div></dl><p><fmt:formatNumber value="${detail.rate*100}" />% <spring:message code="recording.annual" /> · <spring:message code="recording.method.${detail.method}" /> · <spring:message code="recording.frequency.${detail.frequency}" /></p></section>
<section class="accounting-section"><h2><spring:message code="recording.balances" /> (TZS)</h2><dl class="loan-facts"><div><dt><spring:message code="recording.outstandingPrincipal" /></dt><dd>${detail.loan.outstandingPrincipal}</dd></div><div><dt><spring:message code="recording.dueInterest" /></dt><dd>${detail.loan.dueInterest}</dd></div><div><dt><spring:message code="recording.arrears" /></dt><dd>${detail.loan.arrears}</dd></div><div><dt><spring:message code="recording.futureInterest" /></dt><dd>${detail.loan.futureInterest}</dd></div><div><dt><spring:message code="recording.principalPaid" /></dt><dd>${detail.loan.principalPaid}</dd></div><div><dt><spring:message code="recording.interestPaid" /></dt><dd>${detail.loan.interestPaid}</dd></div></dl><p><spring:message code="recording.balanceHelp" /></p></section>
<details class="accounting-section"><summary><spring:message code="recording.supporting" /></summary><dl class="loan-facts"><div><dt><spring:message code="recording.business" /></dt><dd><c:out value="${detail.business}" /></dd></div><div><dt><spring:message code="recording.income" /></dt><dd><c:out value="${detail.income}" default="—" /></dd></div><div><dt><spring:message code="recording.expenses" /></dt><dd><c:out value="${detail.expenses}" default="—" /></dd></div><div><dt><spring:message code="recording.otherDebt" /></dt><dd><c:out value="${detail.otherDebt}" default="—" /></dd></div><div><dt><spring:message code="recording.guarantors" /></dt><dd><c:out value="${detail.guarantors}" /></dd></div><div><dt><spring:message code="recording.collateral" /></dt><dd><c:out value="${detail.collateral}" /></dd></div><div><dt><spring:message code="voucher.evidence" /></dt><dd><c:out value="${detail.evidence}" /></dd></div><div><dt><spring:message code="voucher.description" /></dt><dd><c:out value="${detail.notes}" /></dd></div></dl><p><spring:message code="recording.source.${detail.informationSource}" /></p></details>
<section class="erp-table-wrap" data-aws-table-region><div class="app-table-titlebar"><h2><spring:message code="recording.history" /></h2></div><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="voucher.date" /></th><th><spring:message code="voucher.reference" /></th><th><spring:message code="voucher.type" /></th><th><spring:message code="voucher.amount" /> (TZS)</th><th><spring:message code="recording.principal" /></th><th><spring:message code="recording.interest" /></th><th><spring:message code="recording.balanceAfter" /></th></tr></thead><tbody><c:forEach items="${history.rows}" var="p"><tr><td>${p.date}</td><td><a href="<c:url value='/finance/loan-postings/${p.id}' />"><c:out value="${p.reference}" /></a></td><td><spring:message code="recording.document.${p.kind}" /><c:if test="${not empty p.reversedBy}"> · <spring:message code="voucher.status.REVERSED" /></c:if></td><td>${p.amount}</td><td>${p.principal}</td><td>${p.interest}</td><td>${p.principalBalance}</td></tr></c:forEach></tbody></table></div><div class="voucher-pagination"><spring:message code="voucher.page" /> ${history.page+1}<div class="accounting-actions"><c:if test="${history.page>0}"><a class="app-btn btn-neutral" href="?historyPage=${history.page-1}&amp;schedulePage=${schedulePage}"><spring:message code="common.previous" /></a></c:if><c:if test="${history.hasNext}"><a class="app-btn btn-neutral" href="?historyPage=${history.page+1}&amp;schedulePage=${schedulePage}"><spring:message code="common.next" /></a></c:if></div></div></section>
<section class="erp-table-wrap" data-aws-table-region><div class="app-table-titlebar"><h2><spring:message code="recording.schedule" /></h2></div><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th>#</th><th><spring:message code="recording.dueDate" /></th><th><spring:message code="recording.principal" /></th><th><spring:message code="recording.interest" /></th><th><spring:message code="voucher.amount" /> (TZS)</th></tr></thead><tbody><c:forEach items="${scheduleRows}" var="s"><tr><td>${s.number}</td><td>${s.date}</td><td>${s.principal}</td><td>${s.interest}</td><td>${s.amount}</td></tr></c:forEach></tbody></table></div><div class="voucher-pagination"><spring:message code="voucher.page" /> ${schedulePage+1}<div class="accounting-actions"><c:if test="${schedulePage>0}"><a class="app-btn btn-neutral" href="?schedulePage=${schedulePage-1}&amp;historyPage=${history.page}"><spring:message code="common.previous" /></a></c:if><c:if test="${scheduleHasNext}"><a class="app-btn btn-neutral" href="?schedulePage=${schedulePage+1}&amp;historyPage=${history.page}"><spring:message code="common.next" /></a></c:if></div></div></section>
<section class="accounting-section"><p><spring:message code="recording.recordedBy" />: <c:out value="${detail.recordedBy}" /> · <c:out value="${detail.recordedAt}" /></p></section></div><%@ include file="../../fragments/footer.jspf" %>
