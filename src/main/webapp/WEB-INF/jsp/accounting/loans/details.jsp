<%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<template data-resource-details-page></template>
<div class="accounting-workspace"><nav class="erp-page-path"><a href="<c:url value='/finance/loan-records' />"><spring:message code="recording.register.LOAN" /></a><span>›</span><span aria-current="page"><spring:message code="recording.loanDetails" /></span></nav><div class="erp-page-header erp-detail-header" data-aws-page-header><h1 class="erp-page-title"><spring:message code="recording.loanDetails" /></h1><div class="accounting-actions" data-aws-action-pin="true"><c:if test="${detail.loan.topUpEligible}"><sec:authorize access="@access.has(principal,'LOAN_RECORDING_CREATE')"><a class="app-btn btn-neutral" href="<c:url value='/finance/loan-records/new?topUpLoanId=${detail.loan.id}' />"><spring:message code="recording.topUp.create" /></a></sec:authorize></c:if><c:if test="${empty topUpPosting and (detail.loan.status=='DISBURSED' or detail.loan.status=='PAR' or detail.loan.status=='DEFAULTED' or detail.loan.status=='WRITTEN_OFF')}"><sec:authorize access="@access.has(principal,'LOAN_ADJUSTMENTS_CREATE')"><a class="app-btn btn-neutral" href="<c:url value='/finance/loan-adjustments/new?loanId=${detail.loan.id}&amp;kind=${detail.loan.status=="WRITTEN_OFF"?"WRITE_BACK":"PROVISION"}' />"><spring:message code="adjustment.create" /></a></sec:authorize></c:if><sec:authorize access="@access.has(principal,'LOAN_RECORDING_EXPORT')"><a class="app-btn btn-neutral" href="<c:url value='/finance/loan-records/${detail.loan.id}/pdf' />"><spring:message code="voucher.pdf" /></a><a class="app-btn btn-neutral" data-print-action="true" href="<c:url value='/finance/loan-records/${detail.loan.id}/print' />"><spring:message code="voucher.print" /></a></sec:authorize><c:if test="${detail.loan.status=='RECORDED'}"><sec:authorize access="@access.has(principal,'LOAN_RECORDING_CREATE')"><form method="post" action="<c:url value='/finance/loan-records/${detail.loan.id}/submit-for-review' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><button class="app-btn btn-neutral"><spring:message code="recording.submitReview" /></button></form></sec:authorize></c:if><c:if test="${detail.loan.status=='READY_FOR_DISBURSEMENT'}"><sec:authorize access="@access.has(principal,'DISBURSEMENT_QUEUE_DISBURSE')"><a class="app-btn btn-neutral" href="<c:url value='/disbursement/loan-applications/${detail.loan.id}' />"><spring:message code="recording.reviewDisbursement" /></a></sec:authorize></c:if><c:if test="${detail.loan.status=='DISBURSED' or detail.loan.status=='PAR' or detail.loan.status=='DEFAULTED'}"><sec:authorize access="@access.has(principal,'LOAN_RECORDING_POST')"><a class="app-btn btn-primary" href="<c:url value='/finance/loan-repayments/new?loanId=${detail.loan.id}' />"><spring:message code="recording.create.PAYMENT" /></a></sec:authorize></c:if><a class="app-btn btn-neutral" href="<c:url value='/finance/client-ledgers/${detail.loan.clientId}' />"><spring:message code="recording.statement" /></a></div></div><c:if test="${recordingSaved}"><div class="loan-success" role="status"><spring:message code="recording.saved" /></div></c:if>

<%@ include file="topup-details.jspf" %><%@ include file="charges-details.jspf" %>
<c:if test="${not productAccountsLinked and (detail.loan.status=='DISBURSED' or detail.loan.status=='PAR' or detail.loan.status=='DEFAULTED')}">
<section class="console-prerequisite" data-detail-persistent role="region" aria-labelledby="product-accounts-prerequisite">
<svg class="console-icon" viewBox="0 0 16 16" aria-hidden="true"><path class="stroke-linejoin-round" d="M8 5V9" />
<path class="stroke-linejoin-round" d="M8 10L8 12" />
<path class="stroke-linejoin-round" d="M6.52 1.88L1.19 11.64C1.06 11.87 1 12.14 1 12.4C1 13.28 1.71 13.99 2.59 13.99H13.4C14.28 13.99 14.99 13.28 14.99 12.4C14.99 12.13 14.92 11.87 14.8 11.64L9.48 1.88C9.18 1.34 8.62 1 8 1C7.38 1 6.82 1.34 6.52 1.88Z" /></svg>
<div class="console-prerequisite-body"><h2 id="product-accounts-prerequisite"><spring:message code="productAccounts.title" /></h2>
<p><spring:message code="productAccounts.existingHelp" /></p>
<c:if test="${not empty productAccountsError}"><p class="coa-error" role="alert"><spring:message code="${productAccountsError}" /></p></c:if>
</div><sec:authorize access="@access.has(principal,'LOAN_RECORDING_POST')"><form method="post" action="<c:url value='/finance/loan-records/${detail.loan.id}/link-product-accounts' />">
<input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><button class="app-btn btn-neutral"><spring:message code="productAccounts.link" /></button></form></sec:authorize></section></c:if>
<section class="accounting-section erp-detail-card"><h2><spring:message code="resource.details.summary" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="recording.client" /></dt><dd><c:out value="${detail.loan.client}" /></dd></div>
<div><dt><spring:message code="loan.loanId" /></dt><dd><c:out value="${detail.loan.number}" /></dd></div>
<div><dt><spring:message code="voucher.print.clientNumber" /></dt><dd><c:out value="${detail.loan.clientNumber}" /></dd></div>
<div><dt><spring:message code="voucher.status" /></dt><dd><span class="voucher-status"><span data-resource-status="${detail.loan.status}"><spring:message code="recording.status.${detail.loan.status}" /></span></span></dd></div>
<div><dt><spring:message code="recording.product" /></dt><dd><c:out value="${detail.loan.product}" /></dd></div><div><dt><spring:message code="recording.applicationDate" /></dt><dd>${appTime:display(detail.loan.applicationDate)}</dd></div><div><dt><spring:message code="recording.principal" /> (TZS)</dt><dd><fmt:formatNumber value="${detail.loan.principal}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.firstPaymentDate" /></dt><dd><c:choose><c:when test="${empty detail.firstPaymentDate}"><spring:message code="recording.beforeDisbursement" /></c:when><c:otherwise>${appTime:display(detail.firstPaymentDate)}</c:otherwise></c:choose></dd></div><div><dt><spring:message code="recording.tenureUnit" /></dt><dd>${detail.tenureValue} <spring:message code="recording.tenure.${detail.tenureUnit}" /></dd></div><div><dt><spring:message code="recording.installment" /> (TZS)</dt><dd><fmt:formatNumber value="${detail.installment}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.contractInterest" /> (TZS)</dt><dd><fmt:formatNumber value="${detail.contractualInterest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.purpose" /></dt><dd><c:out value="${detail.purpose}" /></dd></div></dl><p><c:if test="${detail.interestEntry ne 'AMOUNT'}"><fmt:formatNumber value="${detail.rate*100}" />% <c:choose><c:when test="${detail.loanMode eq 'CUSTOM'}"><spring:message code="recording.basis.${detail.interestBasis}" /></c:when><c:otherwise><spring:message code="recording.annual" /></c:otherwise></c:choose> &#183; </c:if><spring:message code="recording.method.${detail.method}" /> · <spring:message code="recording.frequency.${detail.frequency}" /></p></section>
<section class="accounting-section erp-detail-card"><h2><spring:message code="recording.balances" /> (TZS)</h2><dl class="erp-detail-facts"><div><dt><spring:message code="recording.outstandingPrincipal" /></dt><dd><fmt:formatNumber value="${detail.loan.outstandingPrincipal}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.dueInterest" /></dt><dd><fmt:formatNumber value="${detail.loan.dueInterest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.arrears" /></dt><dd><fmt:formatNumber value="${detail.loan.arrears}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.futureInterest" /></dt><dd><fmt:formatNumber value="${detail.loan.futureInterest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.principalPaid" /></dt><dd><fmt:formatNumber value="${detail.loan.principalPaid}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.interestPaid" /></dt><dd><fmt:formatNumber value="${detail.loan.interestPaid}" minFractionDigits="2" maxFractionDigits="2" /></dd></div></dl><p><spring:message code="recording.balanceHelp" /></p></section>
<details class="accounting-section erp-detail-card"><summary><spring:message code="recording.supporting" /></summary><dl class="erp-detail-facts"><div><dt><spring:message code="recording.business" /></dt><dd><c:out value="${detail.business}" /></dd></div><div><dt><spring:message code="recording.income" /></dt><dd><c:out value="${detail.income}" default="—" /></dd></div><div><dt><spring:message code="recording.expenses" /></dt><dd><c:out value="${detail.expenses}" default="—" /></dd></div><div><dt><spring:message code="recording.otherDebt" /></dt><dd><c:out value="${detail.otherDebt}" default="—" /></dd></div><div><dt><spring:message code="recording.guarantors" /></dt><dd><c:out value="${detail.guarantors}" /></dd></div><div><dt><spring:message code="recording.collateral" /></dt><dd><c:out value="${detail.collateral}" /></dd></div><div><dt><spring:message code="voucher.evidence" /></dt><dd><c:out value="${detail.evidence}" /></dd></div><div><dt><spring:message code="voucher.description" /></dt><dd><c:out value="${detail.notes}" /></dd></div></dl><p><spring:message code="recording.source.${detail.informationSource}" /></p></details>
<section data-resource-table="accounting-loans-details-1" data-table-page-param="historyPage" class="erp-table-wrap" data-aws-table-region><div class="app-table-titlebar"><h2><spring:message code="recording.history" /></h2></div><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-order="date"><spring:message code="voucher.date" /></th><th data-table-order="reference"><spring:message code="voucher.reference" /></th><th data-table-order="kind"><spring:message code="voucher.type" /></th><th data-table-order="amount"><spring:message code="voucher.amount" /> (TZS)</th><th data-table-order="principal"><spring:message code="recording.principal" /></th><th data-table-order="interest"><spring:message code="recording.interest" /></th><th data-table-order="balance"><spring:message code="recording.balanceAfter" /></th></tr></thead><tbody><c:forEach items="${history.rows}" var="p"><tr><td>${appTime:display(p.date)}</td><td><a class="resource-table-id-link" href="<c:url value='/finance/loan-postings/${p.id}' />"><c:out value="${p.reference}" /></a></td><td><spring:message code="recording.document.${p.kind}" /><c:if test="${not empty p.reversedBy}"> · <span data-resource-status="REVERSED"><spring:message code="voucher.status.REVERSED" /></span></c:if></td><td>${p.amount}</td><td>${p.principal}</td><td>${p.interest}</td><td>${p.principalBalance}</td></tr></c:forEach><c:if test="${empty history.rows}"><tr><td colspan="7"><spring:message code="recording.statement.empty" /></td></tr></c:if></tbody></table></div><div data-table-pagination data-page="${history.page}" data-table-for="accounting-loans-details-1" class="voucher-pagination"><spring:message code="voucher.page" /> ${history.page+1}<div class="accounting-actions"><c:if test="${history.page>0}"><a data-page-direction="previous" class="app-btn btn-neutral" href="?historyPage=${history.page-1}&amp;schedulePage=${schedulePage}"><spring:message code="common.previous" /></a></c:if><c:if test="${history.hasNext}"><a data-page-direction="next" class="app-btn btn-neutral" href="?historyPage=${history.page+1}&amp;schedulePage=${schedulePage}"><spring:message code="common.next" /></a></c:if></div></div></section>
<section data-resource-table="accounting-loans-details-2" data-table-page-param="schedulePage" class="erp-table-wrap" data-aws-table-region><div class="app-table-titlebar"><h2><c:choose><c:when test="${empty detail.firstPaymentDate}"><spring:message code="repayment.estimatedSchedule" /></c:when><c:otherwise><spring:message code="recording.schedule" /></c:otherwise></c:choose></h2></div><c:if test="${empty detail.firstPaymentDate}"><p class="voucher-help px-4"><spring:message code="recording.beforeDisbursement" /></p></c:if><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-order="number">#</th><th data-table-order="due"><spring:message code="recording.dueDate" /></th><th data-table-order="beginning"><spring:message code="repayment.beginningBalance" /> (TZS)</th><th data-table-order="payment"><spring:message code="repayment.scheduledPayment" /> (TZS)</th><th data-table-order="principal"><spring:message code="recording.principal" /> (TZS)</th><th data-table-order="interest"><spring:message code="recording.interest" /> (TZS)</th><th data-table-order="ending"><spring:message code="repayment.endingBalance" /> (TZS)</th></tr></thead><tbody><c:forEach items="${scheduleRows}" var="s"><tr><td>${s.number}</td><td><c:choose><c:when test="${empty s.date}"><spring:message code="repayment.period.${detail.frequency}" arguments="${s.number}" /></c:when><c:otherwise><c:out value="${appTime:display(s.date)}" /></c:otherwise></c:choose></td><td><fmt:formatNumber value="${s.beginningBalance}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${s.amount}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${s.principal}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${s.interest}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${s.endingBalance}" minFractionDigits="2" maxFractionDigits="2" /></td></tr></c:forEach></tbody></table></div><div data-table-pagination data-page="${schedulePage}" data-table-for="accounting-loans-details-2" class="voucher-pagination"><spring:message code="voucher.page" /> ${schedulePage+1}<div class="accounting-actions"><c:if test="${schedulePage>0}"><a data-page-direction="previous" class="app-btn btn-neutral" href="?schedulePage=${schedulePage-1}&amp;historyPage=${history.page}"><spring:message code="common.previous" /></a></c:if><c:if test="${scheduleHasNext}"><a data-page-direction="next" class="app-btn btn-neutral" href="?schedulePage=${schedulePage+1}&amp;historyPage=${history.page}"><spring:message code="common.next" /></a></c:if></div></div></section>
<section class="accounting-section erp-detail-card"><p><spring:message code="recording.recordedBy" />: <c:out value="${detail.recordedBy}" /> · <c:out value="${appTime:display(detail.recordedAt)}" /></p></section></div><section class="accounting-section"><h2><spring:message code="recording.attachments" /></h2><c:forEach items="${attachments}" var="file"><p><a class="resource-table-id-link" href="<c:url value='/finance/loan-records/${detail.loan.id}/attachments/${file.id}' />"><c:out value="${file.originalName}" /></a></p></c:forEach><c:if test="${empty attachments}"><p><spring:message code="loan.attachments.empty" /></p></c:if></section><%@ include file="../../repayments/interest-waivers.jspf" %><%@ include file="../../fragments/footer.jspf" %>
