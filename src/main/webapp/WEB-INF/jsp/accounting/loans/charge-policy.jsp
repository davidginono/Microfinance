<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<nav class="erp-page-path"><a href="<c:url value='/finance/loan-records' />"><spring:message code="recording.register.LOAN" /></a><span aria-current="page"><spring:message code="charges.policy" /></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="charges.policy" /></h1></div><div class="accounting-workspace accounting-create-workspace">
<c:if test="${recordingSaved}"><p role="status"><spring:message code="charges.policySaved" /></p></c:if>
<c:if test="${not empty currentChargePolicy}"><p><spring:message code="charges.policyReference" />: <c:out value="${currentChargePolicy.policyReference}" /> · <c:out value="${currentChargePolicy.effectiveFrom}" /></p></c:if>
<c:url value="/finance/loan-recording/charge-policy" var="policyUrl" /><form:form method="post" action="${policyUrl}" modelAttribute="chargePolicy" cssClass="accounting-create-form" data-loan-form="true"><form:hidden path="requestKey" /><form:hidden path="expectedVersion" /><form:hidden path="productId" />
<c:if test="${not empty chargeError}"><p class="loan-error-summary" tabindex="-1" role="alert"><spring:message code="${chargeError}" /></p></c:if>
<section class="accounting-section"><h2><spring:message code="charges.policy" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="recording.product" /></dt><dd><c:out value="${selectedChargeProduct.label}" /></dd></div></dl><p><spring:message code="charges.policyHelp" /></p><div class="loan-form-grid">
<label><spring:message code="charges.effectiveFrom" /><form:input path="effectiveFrom" type="date" cssClass="aws-control" required="required" /></label><label><spring:message code="charges.policyReference" /><form:input path="policyReference" maxlength="500" cssClass="aws-control" /></label><label><spring:message code="charges.agreementReference" /><form:input path="agreementReference" maxlength="500" cssClass="aws-control" /></label>
<label><spring:message code="charges.managementTiming" /><form:select path="managementTiming" cssClass="aws-control"><c:forEach items="${['SEPARATE','DEDUCT']}" var="timing"><form:option value="${timing}"><spring:message code="charges.timing.${timing}" /></form:option></c:forEach><form:option value="FINANCED" disabled="true"><spring:message code="charges.timing.FINANCED" /></form:option></form:select></label>
<label><spring:message code="charges.insuranceTiming" /><form:select path="insuranceTiming" cssClass="aws-control"><c:forEach items="${['SEPARATE','DEDUCT']}" var="timing"><form:option value="${timing}"><spring:message code="charges.timing.${timing}" /></form:option></c:forEach><form:option value="FINANCED" disabled="true"><spring:message code="charges.timing.FINANCED" /></form:option></form:select></label>
<c:forEach items="${['RECEIVABLE','MANAGEMENT','INSURANCE']}" var="category"><c:set var="accountPath" value="${category=='RECEIVABLE'?'receivableAccountId':category=='MANAGEMENT'?'managementAccountId':'insuranceAccountId'}" /><div data-loan-choice data-category="${category}" data-choice-url="${pageContext.request.contextPath}/finance/loan-recording/charge-accounts/${category}"><label><spring:message code="charges.account.${category}" /><form:select path="${accountPath}" cssClass="aws-control" data-choice-select="true"><form:option value="" label="${chooseLabel}" /><c:forEach items="${chargeAccounts[category]}" var="account"><form:option value="${account.id}" label="${account.label}" /></c:forEach></form:select></label><%@ include file="choice-search.jspf" %></div></c:forEach>
<label><spring:message code="charges.insurer" /><form:input path="insurer" maxlength="500" cssClass="aws-control" /></label><label><spring:message code="charges.insurerVerification" /><form:input path="insurerVerification" maxlength="500" cssClass="aws-control" /></label><label><spring:message code="charges.customLimit" /> (TZS)<form:input path="customManagementLimit" type="number" min="0" step="0.01" cssClass="aws-control" /></label>
</div><label><form:checkbox path="allowCustom" /> <spring:message code="charges.allowCustom" /></label><label><form:checkbox path="enabled" /> <spring:message code="charges.enable" /></label><p><spring:message code="charges.recognitionHelp" /></p><p><spring:message code="charges.financedBlocked" /></p></section>
<div class="accounting-actions loan-form-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/loan-records' />"><spring:message code="common.cancel" /></a><button class="app-btn btn-launch"><spring:message code="charges.savePolicy" /></button></div>
</form:form></div><%@ include file="../accounting-form-support.jspf" %><script src="<c:url value='/js/loan-recording.js' />" defer></script><%@ include file="../../fragments/footer.jspf" %>
