<%@ include file="application-head.jspf" %>
<c:url value="${applicationRoot}" var="root"/>
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb'/>"><a class="erp-page-path__link" href="${portalWorkspace ? root : pageContext.request.contextPath.concat('/finance/loan-records')}"><spring:message code="${portalWorkspace ? 'apps.title' : 'recording.register.LOAN'}"/></a><span aria-hidden="true">&#8250;</span><span aria-current="page"><c:out value="${detail.number}"/></span></nav>
<h1 class="erp-page-title"><spring:message code="applications.number"/> <c:out value="${detail.number}"/></h1>
<c:if test="${detail.status=='DRAFT'}"><div class="accounting-actions"><a class="app-btn btn-neutral" href="${root}/${detail.id}/edit"><spring:message code="kyc.edit"/></a></div></c:if>
<section class="erp-resource-section"><h2><spring:message code="applications.information"/></h2><dl class="erp-detail-facts"><div><dt><spring:message code="applications.client"/></dt><dd><c:out value="${detail.name}"/></dd></div><div><dt><spring:message code="applications.status"/></dt><dd><spring:message code="loan.status.${detail.status}" text="${detail.status}"/></dd></div><c:forEach items="${['applicationDate','amount','tenureValue','tenureUnit','purpose','business','useOfFunds','income','expenses','otherDebt']}" var="key"><div><dt><spring:message code="applications.${key}"/></dt><dd><c:out value="${recordedForm[key]}"/></dd></div></c:forEach></dl><p><spring:message code="applications.declared"/></p></section>
<c:set var="loanGuarantors" value="${recordedForm.guarantors}" /><c:set var="loanGuarantorLabels" value="${guarantorLabels}" />
<%@ include file="guarantor-details.jspf" %>
<section class="erp-resource-section"><h2><spring:message code="applications.collateral"/></h2><c:forEach items="${recordedForm.collateral}" var="row"><dl class="erp-detail-facts"><c:forEach items="${['itemName','itemNumber','itemType','description','owner','phone','location','estimatedValue']}" var="key"><div><dt><spring:message code="applications.${key}"/></dt><dd><c:out value="${row[key]}"/></dd></div></c:forEach></dl></c:forEach></section>
<section class="erp-resource-section"><h2><spring:message code="applications.documents"/></h2><c:forEach items="${documents}" var="doc"><p><a class="resource-table-id-link" href="${root}/${detail.id}/documents/<c:out value='${doc.id}'/>"><c:out value="${empty doc.documentTitle?doc.originalName:doc.documentTitle}"/></a><c:if test="${not empty doc.documentPurpose}"> &#183; <spring:message code="applications.document.${doc.documentPurpose}"/></c:if></p></c:forEach></section>
<%@ include file="application-foot.jspf" %>
