<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<nav class="erp-page-path"><a href="<c:url value='/finance/loan-records/${historyLoan.id}' />"><spring:message code="recording.loanDetails" /></a><span>›</span><span aria-current="page"><spring:message code="simpleGroup.history" /></span></nav>
<section class="erp-table-wrap"><h1 class="erp-page-title"><spring:message code="simpleGroup.history" /></h1><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="simpleGroup.agreement" /></th><th><spring:message code="simpleGroup.savedOn" /></th><th><spring:message code="simpleGroup.agreementReference" /></th></tr></thead><tbody>
<c:forEach items="${groupHistory.rows}" var="file"><tr><td><sec:authorize access="@access.has(principal,'LOAN_DOCUMENTS_EXPORT')"><a href="<c:url value='/finance/loan-records/${historyLoan.id}/group-history/${file.kind}/${file.id}' />"><c:out value="${file.filename}" /></a></sec:authorize><sec:authorize access="!@access.has(principal,'LOAN_DOCUMENTS_EXPORT')"><c:out value="${file.filename}" /></sec:authorize></td><td><c:out value="${appTime:display(file.recorded)}" /></td><td><c:out value="${file.reference}" /></td></tr></c:forEach><c:if test="${empty groupHistory.rows}"><tr><td colspan="3"><spring:message code="simpleGroup.historyEmpty" /></td></tr></c:if>
</tbody></table></div><div data-table-pagination data-page="${groupHistory.page}"><c:if test="${groupHistory.page>0}"><a data-page-direction="previous" href="<c:url value='/finance/loan-records/${historyLoan.id}/group-history?page=${groupHistory.page-1}' />"><spring:message code="common.previous" /></a></c:if><c:if test="${groupHistory.hasNext}"><a data-page-direction="next" href="<c:url value='/finance/loan-records/${historyLoan.id}/group-history?page=${groupHistory.page+1}' />"><spring:message code="common.next" /></a></c:if></div></section>
<%@ include file="../accounting-form-support.jspf" %><%@ include file="../../fragments/footer.jspf" %>
