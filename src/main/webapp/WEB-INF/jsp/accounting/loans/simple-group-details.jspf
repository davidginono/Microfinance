<c:if test="${not empty simpleGroup}">
<spring:message code="kyc.profile" var="groupProfileLabel" />
<section class="erp-resource-section"><h2><spring:message code="simpleGroup.groupLoan" /></h2><dl class="erp-detail-facts">
<div><dt><spring:message code="simpleGroup.group" /></dt><dd><c:out value="${simpleGroup.name}" /></dd></div><div><dt><spring:message code="simpleGroup.leader" /></dt><dd><c:out value="${simpleGroup.leader}" /></dd></div>
<div><dt><spring:message code="simpleGroup.groupAccount" /></dt><dd><c:out value="${simpleGroup.destination}" /></dd></div><div><dt><spring:message code="simpleGroup.agreementReference" /></dt><dd><c:out value="${simpleGroup.reference}" /></dd></div>
</dl><p><spring:message code="simpleGroup.liability" /></p><sec:authorize access="@access.has(principal,'LOAN_DOCUMENTS_VIEW') and @access.has(principal,'LOAN_DOCUMENTS_EXPORT')"><a href="<c:url value='${empty groupAgreementBase?"/finance/loan-records":groupAgreementBase}/${simpleGroup.loanId}/group-agreement' />"><spring:message code="simpleGroup.agreement" /></a></sec:authorize></section>
<section class="erp-table-wrap"><h2><spring:message code="group.members" /></h2><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="group.client" /></th><th><spring:message code="simpleGroup.signedOn" /></th><th><spring:message code="simpleGroup.income" /> (TZS)</th><th><spring:message code="simpleGroup.expenses" /> (TZS)</th><th><spring:message code="simpleGroup.debt" /> (TZS)</th><th><spring:message code="simpleGroup.budgetSource" /></th></tr></thead><tbody>
<c:forEach items="${simpleGroup.borrowers}" var="person"><tr><td><c:out value="${person.number}" /> &middot; <c:out value="${person.name}" /></td><td><c:out value="${person.signedOn}" /></td><td><c:out value="${person.income}" /></td><td><c:out value="${person.expenses}" /></td><td><c:out value="${person.debt}" /></td><td><c:out value="${person.evidence.startsWith('CLIENT_PROFILE:')?groupProfileLabel:person.evidence}" /></td></tr></c:forEach>
</tbody></table></div></section>
</c:if>
