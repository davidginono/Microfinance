<div class="loan-choice-search"><input type="search" class="aws-control" maxlength="100" data-choice-search aria-label="<spring:message code='voucher.search' />" /><button type="button" class="app-btn btn-neutral" data-choice-load><spring:message code="voucher.search" /></button><button type="button" class="app-btn btn-neutral" data-choice-next disabled><spring:message code="common.next" /></button></div><span data-choice-error role="status" data-error="<spring:message code='recording.lookupError' />"></span>
