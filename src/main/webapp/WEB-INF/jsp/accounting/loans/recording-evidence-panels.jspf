<%@ page pageEncoding="UTF-8" %>
<section class="accounting-section recording-evidence-panel" data-validation-step id="recording-panel-guarantors" aria-labelledby="recording-heading-guarantors">
<h2 id="recording-heading-guarantors" tabindex="-1" data-recording-step-heading><spring:message code="applications.guarantors" /></h2>
<div data-repeat-list="guarantors"><c:forEach items="${recordForm.applicationDetails.guarantors}" var="row" varStatus="i"><div class="recording-evidence-row" data-repeat-row><div class="loan-form-grid"><div data-group-guarantee hidden><label><spring:message code="simpleGroup.clientNumber" /><form:input path="applicationDetails.guarantors[${i.index}].clientNumber" cssClass="aws-control" maxlength="255" /></label></div><div data-group-guarantee hidden><label><spring:message code="simpleGroup.guaranteeBudget" /><form:input path="applicationDetails.guarantors[${i.index}].guaranteeBudget" cssClass="aws-control" type="number" min="0.01" step="0.01" /></label></div><div data-group-guarantee hidden><label><spring:message code="simpleGroup.budgetEvidence" /><form:input path="applicationDetails.guarantors[${i.index}].guaranteeEvidence" cssClass="aws-control" maxlength="500" /></label></div><div data-group-guarantee hidden><label><spring:message code="simpleGroup.signedOn" /><form:input path="applicationDetails.guarantors[${i.index}].signedOn" cssClass="aws-control" type="date" /></label></div><div><label for="recording-guarantor-${i.index}-name"><spring:message code="recording.guarantorName"/></label><form:input path="applicationDetails.guarantors[${i.index}].fullName" id="recording-guarantor-${i.index}-name" cssClass="aws-control" required="required" maxlength="255"/></div><c:forEach items="${['relationship','business','location']}" var="key"><div><label><spring:message code="applications.${key}"/></label><form:input path="applicationDetails.guarantors[${i.index}].${key}" cssClass="aws-control" maxlength="255"/></div></c:forEach></div><div class="recording-item-footer"><div class="recording-phone"><label><spring:message code="applications.phone"/></label><form:input path="applicationDetails.guarantors[${i.index}].phone" cssClass="aws-control" maxlength="255"/></div><%@ include file="recording-row-photos.jspf" %><div class="recording-item-actions"><button type="button" class="app-btn btn-neutral erp-icon-btn erp-form-row-action" data-remove-row aria-label="<spring:message code='applications.remove' />" title="<spring:message code='applications.remove' />"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12" /></svg></button></div></div><div data-row-photo-list class="recording-photo-list" aria-live="polite"></div></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-add-row="guarantors"><spring:message code="recording.addGuarantor" text="${recordingAddLabel}"/></button>
<c:set var="recordingPhotoPurpose" value="GUARANTOR_PHOTO"/><%@ include file="recording-saved-files.jspf" %>

</section>
<section class="accounting-section recording-evidence-panel" data-validation-step id="recording-panel-collateral" aria-labelledby="recording-heading-collateral">
<h2 id="recording-heading-collateral" tabindex="-1" data-recording-step-heading><spring:message code="applications.collateral" /></h2>
<div data-repeat-list="collateral"><c:forEach items="${recordForm.applicationDetails.collateral}" var="row" varStatus="i"><div class="recording-evidence-row" data-repeat-row><div class="loan-form-grid"><c:forEach items="${['itemName','itemNumber','itemType','description']}" var="key"><div><label><spring:message code="applications.${key}"/></label><form:input path="applicationDetails.collateral[${i.index}].${key}" cssClass="aws-control" maxlength="${key=='description'?500:key=='itemName'?255:100}" required="${key=='itemName'?'required':null}"/></div></c:forEach></div><div class="recording-item-footer"><div class="recording-phone"><label><spring:message code="applications.phone"/></label><form:input path="applicationDetails.collateral[${i.index}].phone" cssClass="aws-control" maxlength="32"/></div><%@ include file="recording-row-photos.jspf" %><div class="recording-item-actions"><button type="button" class="app-btn btn-neutral erp-icon-btn erp-form-row-action" data-remove-row aria-label="<spring:message code='applications.remove' />" title="<spring:message code='applications.remove' />"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12" /></svg></button></div></div><div data-row-photo-list class="recording-photo-list" aria-live="polite"></div></div></c:forEach></div><button type="button" class="app-btn btn-neutral" data-add-row="collateral"><spring:message code="recording.addCollateral" text="${recordingAddLabel}"/></button>
<c:set var="recordingPhotoPurpose" value="COLLATERAL_PHOTO"/><%@ include file="recording-saved-files.jspf" %>
<div data-group-confirmation ${recordForm.loanFor!='GROUP'?'hidden':''}>
<p><spring:message code="simpleGroup.liability" /></p>
<label class="aws-settings-checkbox-row"><form:checkbox path="groupApplication.checked" cssClass="aws-settings-checkbox" required="required" disabled="${recordForm.loanFor!='GROUP'}" /><span><spring:message code="simpleGroup.checked" /></span></label>
</div>

</section>
<section class="accounting-section recording-evidence-panel" data-validation-step id="recording-panel-attachments" aria-labelledby="recording-heading-attachments">
<h2 id="recording-heading-attachments" tabindex="-1" data-recording-step-heading><c:out value="${recordingAttachmentsLabel}" /></h2>
<%@ include file="attachments.jspf" %>
<c:set var="recordingPhotoPurpose" value="OTHER"/><%@ include file="recording-saved-files.jspf" %>

<p data-evidence-requirements></p>
<div data-evidence-documents></div>
<template data-evidence-document-template><div class="recording-evidence-row"><div class="loan-form-grid">
<label><spring:message code="applications.file"/><span data-evidence-filename></span></label>
<label><spring:message code="applications.documentName"/><input class="aws-control" data-document-field="documentNames" required maxlength="120"/></label>
<label><spring:message code="applications.documentType"/><select class="aws-control" data-document-field="documentTypes"><c:forEach items="${documentTypes}" var="type"><option value="${type}"><spring:message code="applications.document.${type}"/></option></c:forEach></select></label>
<label><spring:message code="applications.requirement"/><select class="aws-control" data-document-field="requiredAttachmentIds"><option value=""><spring:message code="applications.optional"/></option></select></label>
</div><button type="button" class="erp-icon-btn recording-file-remove" data-remove-upload data-remove-label="<spring:message code='applications.remove' htmlEscape='true'/>"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div></template>
<c:if test="${not empty recordForm.applicationId}">
    <label class="recording-declaration"><form:checkbox path="applicationDetails.declarationAccepted" required="required"/><span><spring:message code="applications.declaration"/></span></label>
</c:if>
</section>
<template data-row-template="guarantors"><div class="recording-evidence-row" data-repeat-row><div class="loan-form-grid"><div data-group-guarantee hidden><label><spring:message code="simpleGroup.clientNumber" /><input class="aws-control" data-field="clientNumber" type="text" maxlength="500" /></label></div><div data-group-guarantee hidden><label><spring:message code="simpleGroup.guaranteeBudget" /><input class="aws-control" data-field="guaranteeBudget" type="number" min="0.01" step="0.01" /></label></div><div data-group-guarantee hidden><label><spring:message code="simpleGroup.budgetEvidence" /><input class="aws-control" data-field="guaranteeEvidence" type="text" maxlength="500" /></label></div><div data-group-guarantee hidden><label><spring:message code="simpleGroup.signedOn" /><input class="aws-control" data-field="signedOn" type="date" maxlength="500" /></label></div><div><label><spring:message code="recording.guarantorName"/></label><input class="aws-control" data-field="fullName" required maxlength="255"/></div><c:forEach items="${['relationship','business','location']}" var="key"><div><label><spring:message code="applications.${key}"/></label><input class="aws-control" data-field="${key}" maxlength="255"/></div></c:forEach></div><div class="recording-item-footer"><div class="recording-phone"><label><spring:message code="applications.phone"/></label><input class="aws-control" data-field="phone" maxlength="255"/></div><%@ include file="recording-row-photos.jspf" %><div class="recording-item-actions"><button type="button" class="app-btn btn-neutral erp-icon-btn erp-form-row-action" data-remove-row aria-label="<spring:message code='applications.remove' />" title="<spring:message code='applications.remove' />"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12" /></svg></button></div></div><div data-row-photo-list class="recording-photo-list" aria-live="polite"></div></div></template>
<template data-row-template="collateral"><div class="recording-evidence-row" data-repeat-row><div class="loan-form-grid"><c:forEach items="${['itemName','itemNumber','itemType','description']}" var="key"><div><label><spring:message code="applications.${key}"/></label><input class="aws-control" data-field="${key}" maxlength="${key=='description'?500:key=='itemName'?255:100}" ${key=='itemName'?'required':''}/></div></c:forEach></div><div class="recording-item-footer"><div class="recording-phone"><label><spring:message code="applications.phone"/></label><input class="aws-control" data-field="phone" maxlength="32"/></div><%@ include file="recording-row-photos.jspf" %><div class="recording-item-actions"><button type="button" class="app-btn btn-neutral erp-icon-btn erp-form-row-action" data-remove-row aria-label="<spring:message code='applications.remove' />" title="<spring:message code='applications.remove' />"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12" /></svg></button></div></div><div data-row-photo-list class="recording-photo-list" aria-live="polite"></div></div></template>
<p role="alert" data-evidence-error class="coa-error" hidden></p>
<span hidden data-evidence-yes><spring:message code="common.yes"/></span><span hidden data-evidence-no><spring:message code="common.no"/></span>
