<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<div class="accounting-workspace" data-voucher-register data-base="<c:url value='${base}' />"><div class="erp-page-header" data-aws-page-header><h1 class="erp-page-title"><spring:message code="recording.register.${kind}" /></h1></div>
<section data-resource-table="accounting-loans-register-1" data-table-selection="single" class="erp-table-wrap" data-aws-table-region><div class="app-table-titlebar voucher-toolbar"><h2 class="erp-panel-title"><spring:message code="voucher.records" /></h2><div class="accounting-actions">
<c:if test="${kind=='LOAN'}"><sec:authorize access="@access.has(principal,'LOAN_RECORDING_CREATE')"><button class="app-btn btn-neutral" data-table-command data-selection-action="topup" disabled><spring:message code="recording.topUp.create" /></button></sec:authorize></c:if>
<button class="app-btn btn-neutral" data-selection-action="details" disabled><spring:message code="common.view" /></button>
<sec:authorize access="@access.has(principal,'LOAN_RECORDING_EXPORT')"><button class="app-btn btn-neutral" data-selection-action="pdf" disabled><spring:message code="voucher.pdf" /></button><button class="app-btn btn-neutral" data-selection-action="print" disabled><spring:message code="voucher.print" /></button></sec:authorize>
<c:if test="${kind!='DISBURSEMENT'}"><sec:authorize access="@access.has(principal,'${createClaim}')"><a class="app-btn btn-launch" href="<c:url value='${base}/new' />"><spring:message code="recording.create.${kind}" /></a></sec:authorize></c:if>
</div></div>
<form class="voucher-filters"><label><spring:message code="voucher.search" /><input class="aws-control" name="search" value="<c:out value='${filter.search}' />" maxlength="100" /></label><label><spring:message code="voucher.from" /><input class="aws-control" type="date" name="from" value="${filter.from}" /></label><label><spring:message code="voucher.through" /><input class="aws-control" type="date" name="through" value="${filter.through}" /></label><label data-loan-choice data-category="filter-products"><spring:message code="recording.product" /><select class="aws-control" name="productId" data-choice-select><option value=""><spring:message code="voucher.all" /></option><c:if test="${not empty selectedProduct}"><option value="${selectedProduct.id}" selected><c:out value="${selectedProduct.label}" /></option></c:if></select><%@ include file="choice-search.jspf" %></label><c:if test="${not empty filter.status}"><input type="hidden" name="state" value="<c:out value='${filter.status}' />" /></c:if><label><spring:message code="voucher.sort" /><select class="aws-control" name="sort"><c:forEach items="${['newest','oldest','amount']}" var="s"><option value="${s}" ${filter.sort==s?'selected':''}><spring:message code="voucher.sort.${s}" /></option></c:forEach><c:forEach items="${['number','product','client','amount','status',kind=='LOAN'?'balance':'reference']}" var="column"><c:forEach items="${['asc','desc']}" var="order"><c:set var="sortValue" value="${column}_${order}" /><option value="${sortValue}" ${filter.sort==sortValue?'selected':''}><spring:message code="table.sort.${sortValue}" /></option></c:forEach></c:forEach></select></label><button class="app-btn btn-neutral"><spring:message code="voucher.filter" /></button><a class="app-btn btn-neutral" href="<c:url value='${base}' />"><spring:message code="voucher.clear" /></a></form>
<p class="sr-only" role="status" aria-live="polite" data-selection-status data-empty="<spring:message code='voucher.selectHelp' />" data-selected="<spring:message code='voucher.selected' />"></p>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="voucher.select" /></th><th data-table-sort-asc="number_asc" data-table-sort-desc="number_desc"><spring:message code="recording.loan" /></th><th data-table-sort-asc="product_asc" data-table-sort-desc="product_desc"><spring:message code="recording.product" /></th><th data-table-sort-asc="client_asc" data-table-sort-desc="client_desc"><spring:message code="recording.client" /></th><th data-table-sort-asc="oldest" data-table-sort-desc="newest"><spring:message code="voucher.date" /></th><th data-table-sort-asc="amount_asc" data-table-sort-desc="amount"><spring:message code="voucher.amount" /> (TZS)</th><th data-table-sort-asc="${kind=='LOAN'?'balance_asc':'reference_asc'}" data-table-sort-desc="${kind=='LOAN'?'balance_desc':'reference_desc'}"><spring:message code="${kind=='LOAN'?'recording.outstandingPrincipal':'voucher.reference'}" /></th><th data-table-sort-asc="status_asc" data-table-sort-desc="status_desc"><spring:message code="voucher.status" /></th></tr></thead><tbody>
<c:forEach items="${records.rows}" var="r"><tr data-voucher-id="${r.id}" data-topup-eligible="${kind=='LOAN' and r.topUpEligible}"><td><input type="checkbox" class="voucher-select" aria-label="<spring:message code='voucher.select' /> <c:out value='${kind=="LOAN"?r.number:r.loanNumber}' />" /></td><td><a href="<c:url value='${base}/${r.id}' />"><c:out value="${kind=='LOAN'?r.number:r.loanNumber}" /></a></td><td><c:out value="${r.product}" /></td><td><c:out value="${r.client}" /></td><td><c:out value="${kind=='LOAN'?r.applicationDate:r.date}" /></td><td class="voucher-numeric"><fmt:formatNumber value="${kind=='LOAN'?r.principal:(r.kind=='REVERSAL' or r.kind=='FUNDING_UNDO')?-r.amount:r.amount}" minFractionDigits="2" maxFractionDigits="2" /></td><td><c:out value="${kind=='LOAN'?r.outstandingPrincipal:r.reference}" /></td><td><spring:message code="${kind=='LOAN'?'recording':'voucher'}.status.${kind=='LOAN'?r.status:(r.kind=='REVERSAL' or r.kind=='FUNDING_UNDO')?'REVERSAL':empty r.reversedBy?'POSTED':'REVERSED'}" /></td></tr></c:forEach>
<c:if test="${empty records.rows}"><tr><td colspan="8"><spring:message code="voucher.noMatches" /></td></tr></c:if></tbody></table></div>
<div data-table-pagination data-page="${records.page}" data-table-for="accounting-loans-register-1" class="voucher-pagination"><spring:message code="voucher.page" /> ${records.page+1}<div class="accounting-actions"><c:forEach items="${[-1,1]}" var="step"><c:url value="${base}" var="pageUrl"><c:param name="page" value="${records.page+step}" /><c:param name="search" value="${filter.search}" /><c:param name="from" value="${filter.from}" /><c:param name="through" value="${filter.through}" /><c:param name="state" value="${filter.status}" /><c:param name="productId" value="${filter.productId}" /><c:param name="sort" value="${filter.sort}" /></c:url><c:choose><c:when test="${step==-1?records.page>0:records.hasNext}"><a data-page-direction="${step==-1?'previous':'next'}" class="app-btn btn-neutral" href="<c:out value='${pageUrl}' />"><spring:message code="${step==-1?'common.previous':'common.next'}" /></a></c:when><c:otherwise><button data-page-direction="${step==-1?'previous':'next'}" class="app-btn btn-neutral" disabled><spring:message code="${step==-1?'common.previous':'common.next'}" /></button></c:otherwise></c:choose></c:forEach></div></div></section></div>
<script src="<c:url value='/js/accounting-vouchers.js' />" defer></script><script src="<c:url value='/js/loan-recording.js' />" defer></script><%@ include file="../../fragments/footer.jspf" %>
