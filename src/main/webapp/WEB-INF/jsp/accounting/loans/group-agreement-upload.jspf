<%@ page pageEncoding="UTF-8" %>
<div data-group-agreement-upload ${recordForm.loanFor!='GROUP'?'hidden':''}>
<form:hidden path="groupApplication.removeAgreement" data-group-agreement-remove="true" />
<label class="attachment-dropzone"><input type="file" id="group-agreement-file" name="groupAgreement" aria-describedby="group-agreement-help group-agreement-error" accept="application/pdf,.pdf" class="attachment-dropzone-input" data-group-agreement-input data-error="<spring:message code='simpleGroup.error.document' htmlEscape='true'/>" /><span class="attachment-dropzone-main"><span class="attachment-dropzone-copy"><span class="attachment-dropzone-title"><spring:message code="simpleGroup.agreement" /></span><span class="attachment-dropzone-help" id="group-agreement-help"><spring:message code="simpleGroup.agreementHelp" /></span></span><span class="attachment-dropzone-action"><spring:message code="attachments.dropzone.choose" /></span></span></label>
<p class="coa-error" id="group-agreement-error" data-group-agreement-error role="alert" hidden></p>
<div class="recording-photo-list" data-group-agreement-selected aria-live="polite"></div>
<sec:authorize access="@access.has(principal,'LOAN_DOCUMENTS_VIEW') and @access.has(principal,'LOAN_DOCUMENTS_EXPORT')">
<c:forEach items="${groupDraftDocuments}" var="file"><c:choose><c:when test="${file.agreement}">
<div class="recording-evidence-row recording-photo-token" data-group-agreement-saved ${recordForm.groupApplication.removeAgreement?'hidden':''}><div class="loan-form-grid"><a class="resource-table-id-link" href="<c:url value='/finance/group-loan-drafts/${recordForm.applicationId}/files/${file.id}' />"><c:out value="${file.displayName}" /></a></div><button type="button" class="erp-icon-btn recording-file-remove" data-remove-group-agreement aria-label="<spring:message code='applications.remove' htmlEscape='true'/> <c:out value='${file.displayName}'/>" title="<spring:message code='applications.remove' htmlEscape='true'/>"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
</c:when><c:otherwise><p><a href="<c:url value='/finance/group-loan-drafts/${recordForm.applicationId}/files/${file.id}' />"><c:out value="${file.displayName}" /></a></p></c:otherwise></c:choose></c:forEach>
</sec:authorize>
<template data-group-agreement-template><div class="recording-evidence-row recording-photo-token"><div class="loan-form-grid"><div><span data-group-agreement-name></span><span class="recording-photo-size" data-group-agreement-size></span></div></div><button type="button" class="erp-icon-btn recording-file-remove" data-remove-group-agreement data-remove-label="<spring:message code='applications.remove' htmlEscape='true'/>" title="<spring:message code='applications.remove' htmlEscape='true'/>"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div></template>
</div>
