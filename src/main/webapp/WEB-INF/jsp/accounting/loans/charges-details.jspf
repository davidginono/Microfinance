<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty chargeSummary and not empty chargeSummary.plan.terms}">
<section class="accounting-section erp-detail-card"><h2><spring:message code="charges.title" /></h2>
<div class="erp-table-scroll" role="region" tabindex="0" aria-label="<spring:message code='charges.title' />"><table class="erp-table" data-table-sort-mode="local"><thead><tr><th scope="col"><spring:message code="charges.kind" /></th><th scope="col"><spring:message code="charges.basis" /></th><th scope="col"><spring:message code="voucher.amount" /> (TZS)</th><th scope="col"><spring:message code="charges.timing" /></th><th scope="col"><spring:message code="charges.supportingEvidence" /></th></tr></thead><tbody><c:forEach items="${chargeSummary.plan.terms}" var="charge"><tr><td><spring:message code="charges.kind.${charge.kind}" /></td><td><spring:message code="charges.basis.${charge.basis}" /> · <c:choose><c:when test="${charge.percentageRate}"><fmt:formatNumber value="${charge.basisValue*100}" maxFractionDigits="4" />%</c:when><c:otherwise>TZS <fmt:formatNumber value="${charge.basisValue}" minFractionDigits="2" maxFractionDigits="2" /></c:otherwise></c:choose></td><td><fmt:formatNumber value="${charge.amount}" minFractionDigits="2" maxFractionDigits="2" /></td><td><spring:message code="charges.timing.${charge.timing}" /></td><td><c:out value="${charge.evidence}" /><c:if test="${not empty charge.provider}"><p><spring:message code="charges.provider" />: <c:out value="${charge.provider}" /> · <c:out value="${charge.verification}" /></p></c:if></td></tr></c:forEach></tbody></table></div>
<c:if test="${not empty detail and detail.loan.status=='READY_FOR_DISBURSEMENT' and chargeSummary.plan.supported and chargeSummary.balance.assessed==0}"><sec:authorize access="@access.has(principal,'LOAN_RECORDING_POST')"><details ${not empty assessmentForm ? 'open' : ''}><summary><spring:message code="charges.assess" /></summary><form method="post" action="<c:url value='/finance/loan-records/${detail.loan.id}/charges/assess' />" data-loan-form data-confirm-message="<spring:message code='charges.assessConfirm' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="requestKey" value="${empty assessmentForm ? chargeRequestKey : assessmentForm.requestKey}" /><div class="loan-form-grid"><label><spring:message code="voucher.date" /><input class="aws-control" name="date" type="date" value="${empty assessmentForm ? today : assessmentForm.date}" max="${today}" required /></label><label><spring:message code="charges.signedEvidence" /><input class="aws-control" name="evidence" maxlength="500" value="${fn:escapeXml(assessmentForm.evidence)}" required /></label></div><button class="app-btn btn-neutral"><spring:message code="charges.assess" /></button></form></details></sec:authorize></c:if>
<c:if test="${not empty chargeError}"><p role="alert" class="loan-error-summary"><spring:message code="${chargeError}" /></p></c:if>
<c:if test="${not empty detail and detail.loan.status=='READY_FOR_DISBURSEMENT' and chargeSummary.balance.assessed>0 and chargeSummary.balance.collected==0 and chargeSummary.assessmentActor ne principal.memberId}"><sec:authorize access="@access.has(principal,'LOAN_RECORDING_REVERSE')"><details ${not empty chargeReverseForm ? 'open' : ''}><summary><spring:message code="charges.reverse" /></summary><form method="post" action="<c:url value='/finance/loan-records/${detail.loan.id}/charges/reverse' />" data-loan-form data-confirm-message="<spring:message code='charges.reverseConfirm' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="requestKey" value="${empty chargeReverseForm ? chargeRequestKey : chargeReverseForm.requestKey}" /><input type="hidden" name="journalId" value="${chargeSummary.assessmentJournal}" /><div class="loan-form-grid"><label><spring:message code="voucher.date" /><input class="aws-control" name="date" type="date" value="${empty chargeReverseForm ? today : chargeReverseForm.date}" max="${today}" required /></label><label><spring:message code="charges.supportingEvidence" /><input class="aws-control" name="evidence" maxlength="500" value="${fn:escapeXml(chargeReverseForm.evidence)}" required /></label><label><spring:message code="repayment.reason" /><input class="aws-control" name="reason" maxlength="500" value="${fn:escapeXml(chargeReverseForm.reason)}" required /></label></div><button class="app-btn btn-neutral"><spring:message code="charges.reverse" /></button></form></details></sec:authorize></c:if>
</section></c:if>
