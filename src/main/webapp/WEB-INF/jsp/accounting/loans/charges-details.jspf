<%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty chargeSummary and not empty chargeSummary.plan.terms}">
<section class="accounting-section erp-detail-card"><h2><spring:message code="charges.title" /></h2>
<p><spring:message code="charges.managementHelp" /></p><p><spring:message code="charges.policyReference" />: <c:out value="${chargeSummary.plan.policyReference}" /> · <spring:message code="charges.agreementReference" />: <c:out value="${chargeSummary.plan.agreementReference}" /></p>
<dl class="loan-topup-facts"><div><dt><spring:message code="charges.managementTotal" /> (TZS)</dt><dd><fmt:formatNumber value="${chargeSummary.plan.managementTotal}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="charges.total" /> (TZS)</dt><dd><fmt:formatNumber value="${chargeSummary.plan.total}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="charges.assessed" /> (TZS)</dt><dd><fmt:formatNumber value="${chargeSummary.balance.assessed}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="charges.collected" /> (TZS)</dt><dd><fmt:formatNumber value="${chargeSummary.balance.collected}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="charges.outstanding" /> (TZS)</dt><dd><fmt:formatNumber value="${chargeSummary.balance.outstanding}" minFractionDigits="2" maxFractionDigits="2" /></dd></div></dl>
<div class="erp-table-scroll" role="region" tabindex="0" aria-label="<spring:message code='charges.title' />"><table class="erp-table"><thead><tr><th scope="col"><spring:message code="charges.kind" /></th><th scope="col"><spring:message code="charges.basis" /></th><th scope="col"><spring:message code="voucher.amount" /> (TZS)</th><th scope="col"><spring:message code="charges.timing" /></th><th scope="col"><spring:message code="charges.supportingEvidence" /></th></tr></thead><tbody><c:forEach items="${chargeSummary.plan.terms}" var="charge"><tr><td><spring:message code="charges.kind.${charge.kind}" /></td><td><spring:message code="charges.basis.${charge.basis}" /> · <c:choose><c:when test="${charge.basis=='PRINCIPAL_RATE'}"><fmt:formatNumber value="${charge.basisValue*100}" maxFractionDigits="4" />%</c:when><c:otherwise>TZS <fmt:formatNumber value="${charge.basisValue}" minFractionDigits="2" maxFractionDigits="2" /></c:otherwise></c:choose></td><td><fmt:formatNumber value="${charge.amount}" minFractionDigits="2" maxFractionDigits="2" /></td><td><spring:message code="charges.timing.${charge.timing}" /></td><td><c:out value="${charge.evidence}" /><c:if test="${not empty charge.provider}"><p><spring:message code="charges.provider" />: <c:out value="${charge.provider}" /> · <c:out value="${charge.verification}" /></p></c:if></td></tr></c:forEach></tbody></table></div>
<div class="erp-table-wrap" data-resource-table="loan-charge-history" data-aws-table-region><div class="app-table-titlebar"><h3><spring:message code="charges.history" /></h3></div><div class="erp-table-scroll" role="region" tabindex="0" aria-label="<spring:message code='charges.history' />"><table class="erp-table"><thead><tr><th scope="col"><spring:message code="voucher.date" /></th><th scope="col"><spring:message code="charges.kind" /></th><th scope="col"><spring:message code="voucher.type" /></th><th scope="col"><spring:message code="voucher.amount" /> (TZS)</th><th scope="col"><spring:message code="charges.supportingEvidence" /></th></tr></thead><tbody><c:forEach items="${chargeSummary.history}" var="movement"><tr><td><c:out value="${appTime:display(movement.date)}" /></td><td><spring:message code="charges.kind.${movement.chargeKind}" /></td><td><spring:message code="charges.event.${movement.kind}" /></td><td><fmt:formatNumber value="${movement.amount}" minFractionDigits="2" maxFractionDigits="2" /></td><td><c:out value="${movement.evidence}" /></td></tr></c:forEach><c:if test="${empty chargeSummary.history}"><tr><td colspan="5"><spring:message code="charges.notAssessed" /></td></tr></c:if></tbody></table></div>
<div data-table-pagination data-page="${chargeSummary.page}" data-table-for="loan-charge-history" class="voucher-pagination"><spring:message code="voucher.page" /> ${chargeSummary.page+1}<div class="accounting-actions"><c:forEach items="${[-1,1]}" var="step"><c:choose><c:when test="${step==-1?chargeSummary.page>0:chargeSummary.hasNext}"><a data-page-direction="${step==-1?'previous':'next'}" class="app-btn btn-neutral" href="?chargePage=${chargeSummary.page+step}"><spring:message code="${step==-1?'common.previous':'common.next'}" /></a></c:when><c:otherwise><button type="button" data-page-direction="${step==-1?'previous':'next'}" class="app-btn btn-neutral" disabled><spring:message code="${step==-1?'common.previous':'common.next'}" /></button></c:otherwise></c:choose></c:forEach></div></div></div>
<c:if test="${not empty detail and detail.loan.status=='READY_FOR_DISBURSEMENT' and chargeSummary.balance.assessed==0}"><sec:authorize access="@access.has(principal,'LOAN_RECORDING_POST')"><details ${not empty assessmentForm ? 'open' : ''}><summary><spring:message code="charges.assess" /></summary><form method="post" action="<c:url value='/finance/loan-records/${detail.loan.id}/charges/assess' />" data-loan-form data-confirm-message="<spring:message code='charges.assessConfirm' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="requestKey" value="${empty assessmentForm ? chargeRequestKey : assessmentForm.requestKey}" /><div class="loan-form-grid"><label><spring:message code="voucher.date" /><input class="aws-control" name="date" type="date" value="${empty assessmentForm ? today : assessmentForm.date}" max="${today}" required /></label><label><spring:message code="charges.signedEvidence" /><input class="aws-control" name="evidence" maxlength="500" value="${fn:escapeXml(assessmentForm.evidence)}" required /></label></div><button class="app-btn btn-neutral"><spring:message code="charges.assess" /></button></form></details></sec:authorize></c:if>
<c:if test="${not empty chargeError}"><p role="alert" class="loan-error-summary"><spring:message code="${chargeError}" /></p></c:if>
<c:if test="${not empty detail and detail.loan.status=='READY_FOR_DISBURSEMENT' and chargeSummary.balance.assessed>0 and chargeSummary.balance.collected==0 and chargeSummary.assessmentActor ne principal.memberId}"><sec:authorize access="@access.has(principal,'LOAN_RECORDING_REVERSE')"><details ${not empty chargeReverseForm ? 'open' : ''}><summary><spring:message code="charges.reverse" /></summary><form method="post" action="<c:url value='/finance/loan-records/${detail.loan.id}/charges/reverse' />" data-loan-form data-confirm-message="<spring:message code='charges.reverseConfirm' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="requestKey" value="${empty chargeReverseForm ? chargeRequestKey : chargeReverseForm.requestKey}" /><input type="hidden" name="journalId" value="${chargeSummary.assessmentJournal}" /><div class="loan-form-grid"><label><spring:message code="voucher.date" /><input class="aws-control" name="date" type="date" value="${empty chargeReverseForm ? today : chargeReverseForm.date}" max="${today}" required /></label><label><spring:message code="charges.supportingEvidence" /><input class="aws-control" name="evidence" maxlength="500" value="${fn:escapeXml(chargeReverseForm.evidence)}" required /></label><label><spring:message code="repayment.reason" /><input class="aws-control" name="reason" maxlength="500" value="${fn:escapeXml(chargeReverseForm.reason)}" required /></label></div><button class="app-btn btn-neutral"><spring:message code="charges.reverse" /></button></form></details></sec:authorize></c:if>
<p><spring:message code="charges.recognitionHelp" /></p>
</section></c:if>
