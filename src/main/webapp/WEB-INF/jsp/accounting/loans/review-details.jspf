<%@ page pageEncoding="UTF-8" %>
<div id="loan-review" class="accounting-workspace">
<c:if test="${not empty groupReview.request}">
<c:if test="${not empty groupReview.steps}">
<section class="erp-table-wrap" data-aws-table-region><div class="app-table-titlebar"><h2><spring:message code="loanGroups.steps" /></h2></div><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="evidence-history"><thead><tr><th>#</th><th><spring:message code="loanGroups.group" /></th><th><spring:message code="loanGroups.count" /></th></tr></thead><tbody>
<c:forEach items="${groupReview.steps}" var="s" varStatus="i"><tr ${i.index==groupReview.step?'aria-current="step"':''}><td>${i.count}</td><td><spring:message code="userGroup.${s.group}" /></td><td>${s.approvals}</td></tr></c:forEach>
</tbody></table></div></section>
</c:if>
<section class="erp-table-wrap" data-aws-table-region><div class="app-table-titlebar"><h2><spring:message code="recording.history" /></h2></div><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="evidence-history"><thead><tr><th><spring:message code="voucher.date" /></th><th><spring:message code="recording.recordedBy" /></th><th><spring:message code="loanGroups.decision" /></th><th><spring:message code="loanGroups.reason" /></th><th><spring:message code="voucher.evidence" /></th></tr></thead><tbody>
<c:forEach items="${groupReview.decisions}" var="d"><tr><td>${appTime:display(d.at)}</td><td><c:out value="${d.name}" /></td><td><spring:message code="loanGroups.${d.decision}" /></td><td><c:out value="${d.reason}" /></td><td><c:out value="${d.evidence}" /></td></tr></c:forEach>
<c:if test="${empty groupReview.decisions}"><tr><td colspan="5"><spring:message code="recording.statement.empty" /></td></tr></c:if>
</tbody></table></div></section>
</c:if>
<c:if test="${not empty groupError}"><div class="loan-error-summary" role="alert" tabindex="-1"><spring:message code="${groupError}" /></div></c:if>
<c:if test="${groupReview.canSubmit}"><form method="post" action="<c:url value='/finance/loan-records/${detail.loan.id}/submit-for-review' />" class="accounting-actions loan-form-actions" data-workspace-submit="recover">
<input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="requestKey" value="${reviewRequestKey}" /><button class="app-btn btn-launch"><spring:message code="recording.submitReview" /></button></form></c:if>
<c:if test="${groupReview.canApprove or groupReview.canReject}">
<c:if test="${not retiredGroupApplication}"><form method="post" action="<c:url value='/finance/loan-records/${detail.loan.id}/review' />" data-workspace-submit="recover">
<input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="requestKey" value="${reviewRequestKey}" /><input type="hidden" name="approvalRequest" value="${groupReview.request.id}" />
<section class="accounting-section"><h2><spring:message code="loanGroups.review" /></h2><div class="loan-form-grid"><label><spring:message code="loanGroups.reason" /><input class="aws-control" name="reason" maxlength="500" required value="<c:out value='${reviewReason}' />" /></label><label><spring:message code="voucher.evidence" /><input class="aws-control" name="evidence" maxlength="500" required value="<c:out value='${reviewEvidence}' />" /></label></div></section>
<div class="accounting-actions loan-form-actions"><c:if test="${groupReview.canReject}"><button class="app-btn btn-neutral" name="decision" value="REJECT"><spring:message code="loanGroups.reject" /></button></c:if><c:if test="${groupReview.canApprove}"><button class="app-btn btn-launch" name="decision" value="APPROVE"><spring:message code="loanGroups.approve" /></button></c:if></div>
</form></c:if>
</c:if>
</div>
