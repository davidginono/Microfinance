<%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<div class="accounting-workspace"><nav class="erp-page-path"><a href="<c:url value='/finance/loan-records/${posting.loanId}' />"><c:out value="${posting.loanNumber}" /></a><span>›</span><span aria-current="page"><c:out value="${posting.reference}" /></span></nav><div class="erp-page-header erp-detail-header" data-aws-page-header><h1 class="erp-page-title"><spring:message code="recording.document.${posting.kind}" /></h1><sec:authorize access="@access.has(principal,'LOAN_RECORDING_EXPORT')"><div class="accounting-actions" data-aws-action-pin="true"><a class="app-btn btn-neutral" href="<c:url value='/finance/loan-postings/${posting.id}/pdf' />"><spring:message code="voucher.pdf" /></a><a class="app-btn btn-neutral" data-print-action="true" href="<c:url value='/finance/loan-postings/${posting.id}/print' />"><spring:message code="voucher.print" /></a></div></sec:authorize></div><c:if test="${recordingSaved}"><div class="loan-success" role="status"><spring:message code="recording.saved" /></div></c:if>

<section class="accounting-section erp-detail-card"><h2><c:out value="${posting.client}" /></h2><p><spring:message code="voucher.status.${not empty posting.reversedBy or not empty disbursementCorrection?'REVERSED':posting.kind=='REVERSAL'?'REVERSAL':'POSTED'}" /></p><dl class="erp-detail-facts">
<div><dt><spring:message code="recording.loan" /></dt><dd><c:out value="${posting.loanNumber}" /></dd></div><div><dt><spring:message code="recording.product" /></dt><dd><c:out value="${posting.product}" /></dd></div><div><dt><spring:message code="voucher.date" /></dt><dd>${appTime:display(posting.date)}</dd></div><div><dt><spring:message code="voucher.reference" /></dt><dd><c:out value="${posting.reference}" /></dd></div><div><dt><spring:message code="voucher.amount" /> (TZS)</dt><dd><fmt:formatNumber value="${posting.amount}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.principal" /> (TZS)</dt><dd><fmt:formatNumber value="${posting.principal}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.interest" /> (TZS)</dt><dd><fmt:formatNumber value="${posting.interest}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.moneyAccount" /></dt><dd><c:out value="${posting.moneyAccount}" /></dd></div><div><dt><spring:message code="recording.principalAccount" /></dt><dd><c:out value="${posting.principalAccount}" /></dd></div><div><dt><spring:message code="recording.interestAccount" /></dt><dd><c:out value="${posting.interestAccount}" /></dd></div><div><dt><spring:message code="recording.balanceAfter" /> (TZS)</dt><dd><fmt:formatNumber value="${posting.principalBalance}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="voucher.evidence" /></dt><dd><c:out value="${posting.evidence}" /></dd></div><div><dt><spring:message code="voucher.description" /></dt><dd><c:out value="${posting.notes}" /></dd></div><div><dt><spring:message code="voucher.postedBy" /></dt><dd><c:out value="${posting.actor}" /></dd></div><div><dt><spring:message code="voucher.postedAt" /></dt><dd>${appTime:display(posting.recordedAt)}</dd></div></dl>
<c:if test="${not empty disbursementCorrection}"><a href="<c:url value='/finance/loan-adjustments/${disbursementCorrection}' />"><spring:message code="voucher.reversal" /></a></c:if><c:if test="${not empty posting.reversedBy}"><a href="<c:url value='/finance/loan-postings/${posting.reversedBy}' />"><spring:message code="voucher.reversal" /></a></c:if><c:if test="${not empty posting.reversesId}"><a href="<c:url value='/finance/loan-postings/${posting.reversesId}' />"><spring:message code="recording.original" /></a></c:if></section>
<c:if test="${posting.kind=='DISBURSEMENT'}">
<section class="erp-table-wrap" data-resource-table="loan-disbursement-schedule" data-aws-table-region>
    <div class="app-table-titlebar"><h2><spring:message code="recording.schedule" /></h2></div>
    <c:choose><c:when test="${empty actualSchedule}"><p class="voucher-help px-4" role="status"><spring:message code="recording.scheduleUnavailable" text="The stored repayment schedule is unavailable for this loan." /></p></c:when><c:otherwise>
    <p class="voucher-help px-4"><spring:message code="recording.actualScheduleHelp" text="Due dates and instalment amounts fixed at disbursement." /></p>
    <div class="erp-table-scroll" data-view-position-key="loan-disbursement-schedule"><table class="erp-table" data-table-sort-mode="local">
        <thead><tr><th>#</th><th><spring:message code="recording.dueDate" /></th><th><spring:message code="repayment.beginningBalance" /> (TZS)</th><th><spring:message code="repayment.scheduledPayment" /> (TZS)</th><th><spring:message code="recording.principal" /> (TZS)</th><th><spring:message code="recording.interest" /> (TZS)</th><th><spring:message code="repayment.endingBalance" /> (TZS)</th></tr></thead>
        <tbody><c:forEach items="${actualSchedule.rows}" var="instalment"><tr><td><c:out value="${instalment.number}" /></td><td><c:out value="${appTime:display(instalment.date)}" /></td><td><fmt:formatNumber value="${instalment.beginningBalance}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${instalment.amount}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${instalment.principal}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${instalment.interest}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${instalment.endingBalance}" minFractionDigits="2" maxFractionDigits="2" /></td></tr></c:forEach><c:if test="${empty actualSchedule.rows}"><tr><td colspan="7" class="erp-table-empty"><spring:message code="recording.scheduleEmptyPage" text="No instalments on this page." /></td></tr></c:if></tbody>
    </table></div>
    <div data-table-pagination data-page="${actualSchedule.page}" data-table-for="loan-disbursement-schedule" class="voucher-pagination"><spring:message code="voucher.page" /> <c:out value="${actualSchedule.page+1}" /><div class="accounting-actions"><c:if test="${actualSchedule.page>0}"><a class="app-btn btn-neutral" data-page-direction="previous" href="<c:url value='/finance/loan-postings/${posting.id}?schedulePage=${actualSchedule.page-1}' />"><spring:message code="common.previous" /></a></c:if><c:if test="${actualSchedule.hasNext}"><a class="app-btn btn-neutral" data-page-direction="next" href="<c:url value='/finance/loan-postings/${posting.id}?schedulePage=${actualSchedule.page+1}' />"><spring:message code="common.next" /></a></c:if></div></div>
    </c:otherwise></c:choose>
</section>
</c:if>
<c:if test="${posting.kind=='PAYMENT' and empty posting.reversedBy}"><sec:authorize access="@access.has(principal,'LOAN_RECORDING_REVERSE')"><section class="accounting-section erp-detail-card"><h2><spring:message code="recording.reverse" /></h2><c:if test="${not empty reverseError}"><div class="loan-error-summary" role="alert"><spring:message code="${reverseError}" /></div></c:if>
<form method="post" action="<c:url value='/finance/loan-postings/${posting.id}/reverse' />" data-loan-form><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="requestKey" value="${reverseKey}" /><div class="loan-form-grid"><label><spring:message code="voucher.date" /><input class="aws-control" type="date" name="effectiveDate" value="${today}" required /></label><label><spring:message code="recording.reason" /><input class="aws-control" name="reason" value="<c:out value='${reason}' />" maxlength="500" required /></label></div><p><spring:message code="recording.reverseHelp" /></p><div class="accounting-actions loan-form-actions"><button class="app-btn btn-primary" aria-disabled="${not canReverse}" <c:if test="${not canReverse}">disabled</c:if>><spring:message code="recording.reverse" /></button></div></form></section></sec:authorize></c:if></div>
<%@ include file="charges-details.jspf" %>
<script src="<c:url value='/js/loan-recording.js' />" defer></script><%@ include file="../../fragments/footer.jspf" %>
