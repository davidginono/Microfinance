<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ include file="../../fragments/header.jspf" %><%@ include file="../../fragments/sidebar.jspf" %><link rel="stylesheet" href="<c:url value='/css/reconciliation.css' />" /><main class="reconciliation-workspace"><div class="erp-page-header" data-aws-page-header><h1 class="erp-page-title"><spring:message code="reconciliation.actionFailed" /></h1></div><p role="alert"><spring:message code="${reconciliationError}" /></p><p><spring:message code="reconciliation.retryHelp" /></p><c:if test="${not empty content}"><section class="reconciliation-form"><form method="post" action="<c:url value='/finance/reconciliation/import' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><c:forEach items="${['requestKey','account','format']}" var="field"><input type="hidden" name="${field}" value="<c:out value='${requestScope[field]}' />" /></c:forEach><div class="reconciliation-grid"><c:forEach items="${['from','through','opening','closing','filename','evidence']}" var="field"><label><spring:message code="reconciliation.${field=='opening'?'openingTZS':field=='closing'?'closingTZS':field}" /><input name="${field}" class="aws-control" value="<c:out value='${requestScope[field]}' />" required /></label></c:forEach></div><label><spring:message code="reconciliation.csv" /><textarea name="content" class="aws-control" maxlength="1000000" required><c:out value="${content}" /></textarea></label><div class="reconciliation-actions"><button name="action" value="preview" class="app-btn btn-neutral"><spring:message code="reconciliation.preview" /></button><button name="action" value="import" class="app-btn btn-primary"><spring:message code="reconciliation.import" /></button></div></form></section></c:if></main><%@ include file="../../fragments/footer.jspf" %>
