<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../../fragments/header.jspf" %><%@ include file="../../fragments/sidebar.jspf" %><link rel="stylesheet" href="<c:url value='/css/reconciliation.css' />" /><main class="reconciliation-workspace"><h1><spring:message code="reconciliation.closing" /></h1><p><spring:message code="reconciliation.closeHelp" /></p>
<section class="erp-table-wrap"><div class="erp-table-scroll" data-view-position-key="accounting-periods"><table class="erp-table"><thead><tr><th><spring:message code="reconciliation.period" /></th><th><spring:message code="reconciliation.state" /></th><th><spring:message code="common.actions" /></th></tr></thead><tbody><c:forEach items="${periods.rows}" var="p"><tr><td><c:out value="${p.from} – ${p.through}" /></td><td><spring:message code="reconciliation.state.${p.state}" /></td><td><a class="app-btn btn-neutral" href="?period=${p.id}"><spring:message code="reconciliation.checks" /></a>
<c:if test="${p.state=='OPEN'}"><sec:authorize access="@access.has(principal,'ACCOUNTING_CLOSING_CREATE')"><form method="post" action="<c:url value='/finance/closing/reviews' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="period" value="${p.id}" /><label><spring:message code="reconciliation.evidence" /><input name="evidence" maxlength="500" class="aws-control" required /></label><button class="app-btn btn-neutral"><spring:message code="reconciliation.proposeClose" /></button></form></sec:authorize></c:if>
<c:if test="${p.state=='CLOSED'}"><sec:authorize access="@access.has(principal,'ACCOUNTING_CLOSING_REOPEN')"><form method="post" action="<c:url value='/finance/closing/reviews' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="period" value="${p.id}" /><input type="hidden" name="reopen" value="true" /><label><spring:message code="reconciliation.reason" /><input name="evidence" maxlength="500" class="aws-control" required /></label><button class="app-btn btn-neutral"><spring:message code="reconciliation.proposeReopen" /></button></form></sec:authorize></c:if></td></tr></c:forEach><c:if test="${empty periods.rows}"><tr><td colspan="3"><spring:message code="reconciliation.empty" /></td></tr></c:if></tbody></table></div></section>
<c:if test="${not empty checks}"><section class="reconciliation-form"><h2><spring:message code="reconciliation.checks" /></h2><c:forEach items="${checks}" var="check"><p><spring:message code="reconciliation.check.${check.key}" />: <c:out value="${check.blockers}" /></p></c:forEach></section></c:if>
<sec:authorize access="@access.has(principal,'ACCOUNTING_CLOSING_INSTITUTION')"><c:if test="${not empty selectedPeriod}"><section class="reconciliation-form"><h2><spring:message code="reconciliation.completeInstitution" /></h2><form method="post" action="<c:url value='/finance/closing/complete' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="period" value="${selectedPeriod}" /><label><spring:message code="reconciliation.reviewEvidence" /><input name="evidence" maxlength="500" class="aws-control" required /></label><label><input type="checkbox" name="confirmed" value="true" required /><spring:message code="reconciliation.confirmClose" /></label><button class="app-btn btn-primary"><spring:message code="reconciliation.completeInstitution" /></button></form></section></c:if></sec:authorize>
<section class="erp-table-wrap"><h2><spring:message code="reconciliation.closeHistory" /></h2><div class="erp-table-scroll" data-view-position-key="accounting-close-history"><table class="erp-table"><thead><tr><th><spring:message code="reconciliation.version" /></th><th><spring:message code="reconciliation.state" /></th><th><spring:message code="reconciliation.evidence" /></th><th><spring:message code="common.actions" /></th></tr></thead><tbody><c:forEach items="${reviews.rows}" var="r"><tr><td><c:out value="${r.version}" /></td><td><spring:message code="reconciliation.state.${r.state}" /></td><td><c:out value="${r.evidence}" /></td><td><a class="app-btn btn-neutral" href="<c:url value='/finance/closing/reviews/${r.id}' />"><spring:message code="reconciliation.review" /></a></td></tr></c:forEach><c:if test="${empty reviews.rows}"><tr><td colspan="4"><spring:message code="reconciliation.empty" /></td></tr></c:if></tbody></table></div></section><div class="reconciliation-actions"><c:if test="${page>0}"><a class="app-btn btn-neutral" href="?page=${page-1}"><spring:message code="common.previous" /></a></c:if><c:if test="${periods.hasNext or reviews.hasNext}"><a class="app-btn btn-neutral" href="?page=${page+1}"><spring:message code="common.next" /></a></c:if></div></main><%@ include file="../../fragments/footer.jspf" %>
