<%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ page pageEncoding="UTF-8" %>
<div class="reconciliation-heading">
  <h2><spring:message code="reconciliation.title" /></h2>
  <p><c:out value="${report.institution}" /> | <c:out value="${report.branch}" /> | <c:out value="${appTime:display(report.parameters.from)}" /> — <c:out value="${appTime:display(report.parameters.through)}" /> | TZS</p>
  <p class="reconciliation-cutoff"><spring:message code="reconciliation.cutoff" />: <c:out value="${appTime:display(report.parameters.cutoff)}" /></p>
  <c:if test="${not empty report.selectedActivity}"><p><spring:message code="reconciliation.activity" />: <c:out value="${pageContext.response.locale.language=='sw' and not empty report.selectedActivity.nameSw?report.selectedActivity.nameSw:report.selectedActivity.name}" /></p></c:if>
  <c:if test="${not empty report.selectedActivity}"><p><spring:message code="reconciliation.activityScope" /></p></c:if>
  <c:if test="${report.parameters.unassigned}"><p><spring:message code="reconciliation.activity" />: <spring:message code="reconciliation.unassigned" /></p><p><spring:message code="reconciliation.manualScope" /></p></c:if>
  <p><spring:message code="reconciliation.exceptionsOnly" /></p>
</div>
<c:if test="${report.count==0}"><p class="reconciliation-empty"><spring:message code="reconciliation.empty" /></p></c:if>
<c:set var="hasAttribution" value="false" />
<c:forEach items="${report.groups}" var="group">
  <c:set var="attribution" value="${group.section=='ATTRIBUTION'}" />
  <c:set var="columns" value="${attribution?['group','account','reference','date','transaction','description','sourceAmount','attributedAmount','attributionVariance']:['client','account','reference','date','transaction','description','slDebit','slCredit','glDebit','glCredit','debitVariance','creditVariance']}" />
  <div class="erp-table-scroll reconciliation-document-table"><table data-table-sort-mode="none" data-table-sort-reason="document" class="erp-table reconciliation-table">
    <thead><tr><c:forEach items="${columns}" var="column"><th scope="col" data-table-identifier><spring:message code="reconciliation.column.${column}" /></th></c:forEach></tr></thead>
    <tbody><tr class="reconciliation-group"><th colspan="${attribution?9:12}" scope="rowgroup"><spring:message code="reconciliation.componentLabel" />: <spring:message code="reconciliation.component.${group.component}" /> — <spring:message code="reconciliation.section.${group.section}" /> (<c:out value="${group.count}" />)</th></tr>
      <c:forEach items="${report.rows}" var="row"><c:if test="${row.group==group.key}">
        <tr><td><c:out value="${row.client}" /></td><td><c:out value="${row.loan}" /><c:if test="${not empty row.account}"><span class="reconciliation-account"><c:out value="${row.account}" /></span></c:if></td>
          <td class="reconciliation-reference"><c:out value="${row.reference}" /></td><td><c:out value="${appTime:display(row.date)}" /></td>
          <td><spring:message code="reconciliation.event.${row.activity}" /></td><td><spring:message code="reconciliation.issue.${row.issue}" /></td>
          <c:forEach items="${row.amounts}" var="amount"><td class="reconciliation-money"><c:choose><c:when test="${amount!=null}"><fmt:formatNumber value="${amount}" minFractionDigits="2" maxFractionDigits="2" /></c:when><c:otherwise>—</c:otherwise></c:choose></td></c:forEach>
        </tr>
      </c:if></c:forEach>
      <tr class="reconciliation-total"><th colspan="6" scope="row"><spring:message code="reconciliation.total" /> <span class="reconciliation-total-context"><spring:message code="reconciliation.allPages" /></span></th>
        <c:forEach items="${group.totals}" var="amount"><td class="reconciliation-money"><c:choose><c:when test="${amount!=null}"><fmt:formatNumber value="${amount}" minFractionDigits="2" maxFractionDigits="2" /></c:when><c:otherwise>—</c:otherwise></c:choose></td></c:forEach>
      </tr>
    </tbody>
  </table></div>
  <c:if test="${attribution}"><c:set var="hasAttribution" value="true" /></c:if>
</c:forEach>
<c:if test="${hasAttribution}"><p class="reconciliation-basis"><spring:message code="reconciliation.attributionBasis" /></p></c:if>
<c:if test="${report.count>0 and empty report.rows}"><p class="reconciliation-empty"><spring:message code="reconciliation.emptyPage" /></p></c:if>
