<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../../fragments/header.jspf" %><%@ include file="../../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/reconciliation.css' />" /><main class="reconciliation-workspace"><div class="erp-page-header" data-aws-page-header><h1 class="erp-page-title"><spring:message code="reconciliation.statement" />: <c:out value="${statement.accountCode}" /></h1></div><p><c:out value="${statement.filename} ${statement.from} – ${statement.through}" /></p><p><spring:message code="reconciliation.openingTZS" />: <c:out value="${statement.opening}" />; <spring:message code="reconciliation.closingTZS" />: <c:out value="${statement.closing}" /></p><details><summary><spring:message code="reconciliation.provenance" /></summary><p><c:out value="${statement.evidence}" /></p><p><c:out value="${statement.checksum}" /></p></details>
<section class="erp-table-wrap" data-aws-table-region><h2><spring:message code="reconciliation.statementLines" /></h2><div class="erp-table-scroll" data-view-position-key="reconciliation-statement-lines"><table class="erp-table"><thead><tr><th><spring:message code="reconciliation.date" /></th><th><spring:message code="reconciliation.reference" /></th><th><spring:message code="reconciliation.amountTZS" /></th><th><spring:message code="reconciliation.matchedTZS" /></th><th><spring:message code="reconciliation.state" /></th></tr></thead><tbody><c:forEach items="${rows.rows}" var="r"><tr><td><c:out value="${r.date}" /></td><td><c:out value="${r.reference}" /></td><td class="money"><c:out value="${r.amount}" /></td><td class="money"><c:out value="${r.matched}" /></td><td><spring:message code="reconciliation.state.${r.status}" /></td></tr></c:forEach></tbody></table></div><div class="reconciliation-actions"><c:if test="${rows.page>0}"><a class="app-btn btn-neutral" href="?page=${rows.page-1}&candidatePage=${candidates.page}"><spring:message code="common.previous" /></a></c:if><c:if test="${rows.hasNext}"><a class="app-btn btn-neutral" href="?page=${rows.page+1}&candidatePage=${candidates.page}"><spring:message code="common.next" /></a></c:if></div></section>
<section class="erp-table-wrap" data-aws-table-region><h2><spring:message code="reconciliation.postedCandidates" /></h2><p><spring:message code="reconciliation.candidateHelp" /></p><div class="erp-table-scroll" data-view-position-key="reconciliation-candidates"><table class="erp-table"><thead><tr><th><spring:message code="reconciliation.date" /></th><th><spring:message code="reconciliation.reference" /></th><th><spring:message code="reconciliation.amountTZS" /></th><th><spring:message code="reconciliation.matchedTZS" /></th><th><spring:message code="common.actions" /></th></tr></thead><tbody><c:forEach items="${candidates.rows}" var="r"><tr><td><c:out value="${r.date}" /></td><td><c:out value="${r.reference}" /><c:if test="${r.reversed}"> (<spring:message code="reconciliation.kind.REVERSED" />)</c:if></td><td class="money"><c:out value="${r.amount}" /></td><td class="money"><c:out value="${r.matched}" /></td><td><sec:authorize access="@access.has(principal,'ACCOUNTING_JOURNALS_VIEW')"><a class="app-btn btn-neutral" href="<c:url value='/finance/journals/${r.journal}' />"><spring:message code="reconciliation.source" /></a></sec:authorize></td></tr></c:forEach><c:if test="${empty candidates.rows}"><tr><td colspan="5"><spring:message code="reconciliation.empty" /></td></tr></c:if></tbody></table></div><div class="reconciliation-actions"><c:if test="${candidates.page>0}"><a class="app-btn btn-neutral" href="?page=${rows.page}&candidatePage=${candidates.page-1}"><spring:message code="common.previous" /></a></c:if><c:if test="${candidates.hasNext}"><a class="app-btn btn-neutral" href="?page=${rows.page}&candidatePage=${candidates.page+1}"><spring:message code="common.next" /></a></c:if></div></section>
<sec:authorize access="@access.has(principal,'ACCOUNTING_RECONCILIATION_CREATE')"><section class="reconciliation-form"><h2><spring:message code="reconciliation.proposeMatch" /></h2><form method="post" action="<c:url value='/finance/reconciliation/statements/${statement.id}/match' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><div class="reconciliation-grid"><label><spring:message code="reconciliation.kind" /><select name="kind" class="aws-control"><c:forEach items="${['EXACT','SPLIT','BATCH','SETTLEMENT','CHARGE','REVERSAL']}" var="kind"><option value="${kind}"><spring:message code="reconciliation.kind.${kind}" /></option></c:forEach></select></label><label><spring:message code="reconciliation.evidence" /><input name="evidence" maxlength="500" class="aws-control" required /></label></div>
<div data-allocations><c:forEach items="${allocationIndexes}" var="i"><div class="reconciliation-grid" data-allocation-row><label><spring:message code="reconciliation.statementLine" /><select name="statementLine" class="aws-control"><option value=""><spring:message code="reconciliation.none" /></option><c:forEach items="${rows.rows}" var="r"><option value="${r.id}"><c:out value="${r.reference} (${r.date}) ${r.amount}" /></option></c:forEach></select></label><label><spring:message code="reconciliation.postedLine" /><select name="journalLine" class="aws-control"><option value=""><spring:message code="reconciliation.none" /></option><c:forEach items="${candidates.rows}" var="r"><option value="${r.id}"><c:out value="${r.reference} (${r.date}) ${r.amount}" /></option></c:forEach></select></label><label><spring:message code="reconciliation.allocateTZS" /><input name="amount" class="aws-control" inputmode="decimal" /></label></div></c:forEach></div><div class="reconciliation-actions"><button type="button" class="app-btn btn-neutral" data-add-allocation><spring:message code="reconciliation.addAllocation" /></button><button class="app-btn btn-primary"><spring:message code="reconciliation.proposeMatch" /></button></div></form></section>
<section class="reconciliation-form"><h2><spring:message code="reconciliation.assignException" /></h2><form method="post" action="<c:url value='/finance/reconciliation/exceptions' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><div class="reconciliation-grid"><label><spring:message code="reconciliation.statementLine" /><select name="statementLine" class="aws-control"><c:forEach items="${rows.rows}" var="r"><option value="${r.id}"><c:out value="${r.reference} ${r.amount}" /></option></c:forEach></select></label><label><spring:message code="reconciliation.kind" /><select name="kind" class="aws-control"><c:forEach items="${['UNMATCHED','DUPLICATE','PARTIAL','REVERSED','TIMING','CHANNEL_FEE']}" var="kind"><option value="${kind}"><spring:message code="reconciliation.kind.${kind}" /></option></c:forEach></select></label><label><spring:message code="reconciliation.timingPostedLine" /><select name="journalLine" class="aws-control"><option value=""><spring:message code="reconciliation.none" /></option><c:forEach items="${candidates.rows}" var="r"><option value="${r.id}"><c:out value="${r.reference} (${r.date}) ${r.amount}" /></option></c:forEach></select></label><label><spring:message code="reconciliation.assigned" /><input name="assigned" class="aws-control" required /></label><label><spring:message code="reconciliation.evidence" /><input name="evidence" maxlength="500" class="aws-control" required /></label></div><button class="app-btn btn-primary"><spring:message code="reconciliation.assignException" /></button></form></section></sec:authorize></main><script src="<c:url value='/js/reconciliation.js' />" defer></script><%@ include file="../../fragments/footer.jspf" %>
