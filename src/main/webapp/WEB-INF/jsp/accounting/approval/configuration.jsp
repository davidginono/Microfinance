<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>

<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>

<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>

<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>

<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>

<spring:htmlEscape defaultHtmlEscape="true" />

<%@ include file="../../fragments/header.jspf" %>

<%@ include file="../../fragments/sidebar.jspf" %>

<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />

<link rel="stylesheet" href="<c:url value='/css/voucher-approval.css' />" />

<div class="accounting-workspace approval-workspace approval-reference approval-config-page">
<nav class="erp-page-path"><span><spring:message code="approval.settings" /></span><span>/</span><span aria-current="page"><spring:message code="approval.configuration" /></span></nav>
<sec:authorize access="@access.has(principal, 'VOUCHER_RULE_CONFIGURE')" var="canConfigure" />
<div class="approval-page-title"><h1><spring:message code="approval.configuration" /> <span class="approval-badge"><spring:message code="${ruleForm.version==0?'approval.draft':'approval.configured'}" /></span></h1><div class="accounting-actions"><c:if test="${canConfigure}"><button form="approval-rule-form" data-form-command="VALIDATE" class="app-btn btn-neutral"><spring:message code="approval.action.VALIDATE" /></button><button form="approval-rule-form" data-form-command="SAVE" class="app-btn btn-neutral"><spring:message code="approval.save" /></button><button form="approval-rule-form" data-form-command="CLOSE" class="app-btn btn-neutral"><spring:message code="approval.saveClose" /></button></c:if><a class="app-btn btn-neutral" href="<c:url value='/finance/approval/configuration?type=${ruleForm.type}' />"><spring:message code="common.cancel" /></a></div></div>
<c:if test="${configurationSaved or configurationValid}"><p role="status" class="approval-success"><spring:message code="${configurationSaved?'approval.saved':'approval.rulesValid'}" /></p></c:if>
<form method="get" class="approval-config-context approval-panel"><label><spring:message code="approval.voucherType" /><select name="type"><c:forEach items="${['RECEIPT','PAYMENT','JOURNAL']}" var="t"><option value="${t}" ${ruleForm.type==t?'selected':''}><spring:message code="approval.type.${t}" /></option></c:forEach></select></label><label><spring:message code="approval.ruleSet" /><input readonly value="<spring:message code='approval.configuration' />" /></label><label><spring:message code="approval.scope" /><input readonly value="<spring:message code='approval.currentScope' />" /></label><button class="app-btn btn-neutral"><spring:message code="voucher.filter" /></button></form>
<c:url value="/finance/approval/configuration" var="saveUrl" />
<form:form id="approval-rule-form" modelAttribute="ruleForm" action="${saveUrl}" method="post" cssClass="approval-form accounting-create-form approval-rule-builder" data-voucher-form="true" data-approval-rules="true"><form:hidden path="type" /><input type="hidden" name="command" data-approval-command value="SAVE" /><form:hidden path="version" /><div class="accounting-error-summary" role="alert" tabindex="-1"><form:errors path="*" element="p" cssClass="coa-error" /></div>
<fieldset ${canConfigure?'':'disabled'}><legend class="sr-only"><spring:message code="approval.rules" /></legend><div class="approval-builder-toolbar"><span><spring:message code="approval.view" />: <strong><spring:message code="approval.ifThen" /></strong></span><c:if test="${canConfigure}"><button class="app-btn btn-neutral" type="button" data-rule-add><spring:message code="approval.addRule" /></button></c:if><span class="approval-builder-count"><spring:message code="approval.maximumRules" /></span></div>
<div class="approval-checks"><span><spring:message code="approval.appliesTo" />:</span><label><form:checkbox path="individuals" /><spring:message code="approval.scope.SINGLE" /></label><label><form:checkbox path="batches" /><spring:message code="approval.scope.BATCH" /></label><label><form:checkbox path="forceAllowed" /><spring:message code="approval.allowForce" /></label></div>
<div data-rule-list>
<c:forEach items="${ruleForm.rules}" var="row" varStatus="n"><details class="approval-rule" data-rule open><summary><span><spring:message code="approval.rule" /> <span data-rule-number>${n.index+1}</span></span><span data-rule-caption><c:out value="${row.name}" /></span></summary><div class="approval-rule-body"><div class="approval-rule-identity"><label><spring:message code="approval.ruleName" /><form:input path="rules[${n.index}].name" maxlength="120" /></label><c:if test="${canConfigure}"><button class="app-btn btn-neutral" type="button" data-rule-copy><spring:message code="approval.copy" /></button><button class="app-btn btn-neutral" type="button" data-rule-remove><spring:message code="approval.removeRule" /></button></c:if></div>
<h3><spring:message code="approval.when" /></h3><div class="erp-table-scroll approval-condition-scroll"><table data-table-sort-mode="none" data-table-sort-reason="editor" class="erp-table approval-condition-table"><thead><tr><th><spring:message code="approval.field" /></th><th><spring:message code="approval.comparison" /></th><th><spring:message code="approval.value" /></th></tr></thead><tbody><tr><td><spring:message code="approval.ledgerScope" /></td><td><spring:message code="approval.is" /></td><td><spring:message code="approval.currentScope" /></td></tr><tr><td><spring:message code="approval.amountField.${ruleForm.type}" /></td><td><spring:message code="approval.range" /></td><td><div class="approval-range"><label><span class="sr-only"><spring:message code="approval.minimum" /></span><form:input path="rules[${n.index}].minimum" type="number" min="0" step="0.01" /></label><span>–</span><label><span class="sr-only"><spring:message code="approval.maximum" /></span><form:input path="rules[${n.index}].maximum" type="number" min="0" step="0.01"  /></label></div></td></tr></tbody></table></div>
<h3><spring:message code="approval.thenRoute" /></h3><div class="approval-routing-options"><label class="approval-inline-check"><form:checkbox path="rules[${n.index}].automatic" data-auto-rule="true" /><spring:message code="approval.automatic" /></label><span><spring:message code="approval.responseRequired" /></span></div>
<div class="approval-stage-controls"><c:if test="${canConfigure}"><button type="button" class="app-btn btn-neutral" data-stage-edit="0"><spring:message code="approval.editFirst" /></button><button type="button" class="app-btn btn-neutral" data-stage-edit="1"><spring:message code="approval.editNext" /></button><button type="button" class="app-btn btn-neutral" data-stage-swap><spring:message code="approval.swap" /></button><button type="button" class="app-btn btn-neutral" data-stage-clear><spring:message code="approval.removeNext" /></button></c:if></div>
<div class="erp-table-scroll approval-condition-scroll"><table data-table-sort-mode="none" data-table-sort-reason="editor" class="erp-table approval-stage-table"><thead><tr><th><spring:message code="approval.sequence" /></th><th><spring:message code="approval.approver" /></th><th><spring:message code="approval.scope" /></th></tr></thead><tbody>
<c:forEach items="${['first','second']}" var="stage" varStatus="sequence"><tr><td>${sequence.index+1}</td><td><form:select path="rules[${n.index}].${stage}Claim" data-native-select="true" data-stage-claim="${sequence.index}"><c:if test="${stage=='second'}"><form:option value=""><spring:message code="approval.none" /></form:option></c:if><form:option value="VOUCHER_APPROVAL_APPROVE"><spring:message code="approval.reviewer.standard" /></form:option><form:option value="VOUCHER_APPROVAL_ESCALATED_APPROVE"><spring:message code="approval.reviewer.escalated" /></form:option></form:select><form:hidden path="rules[${n.index}].${stage}Member" data-stage-member="${sequence.index}" /><small data-stage-name="${sequence.index}"><c:if test="${not empty (stage=='first'?row.firstMember:row.secondMember)}"><spring:message code="approval.namedReviewer" /></c:if></small></td><td><spring:message code="approval.currentBranch" /></td></tr></c:forEach></tbody></table></div>
<p class="approval-policy-note"><spring:message code="approval.eligibleOnly" /></p></div></details></c:forEach></div>
<div class="approval-no-match"><span><spring:message code="approval.noMatching" /></span><strong><spring:message code="approval.requireConfiguration" /></strong><span><spring:message code="approval.amountBasis.${ruleForm.type}" /></span></div></fieldset></form:form>
<section class="approval-panel approval-rule-test"><h2><spring:message code="approval.testSaved" /></h2><form method="get" class="approval-filters"><input type="hidden" name="type" value="${ruleForm.type}" /><label><spring:message code="voucher.total" /> (TZS)<input type="number" step="0.01" min="0" name="example" value="<c:out value='${example}' />" required /></label><button class="app-btn btn-neutral"><spring:message code="approval.test" /></button></form><c:if test="${not empty exampleError}"><p role="alert"><spring:message code="${exampleError}" /></p></c:if><c:if test="${not empty matchedRule}"><p role="status"><c:out value="${matchedRule.name}" /> · <spring:message code="${matchedRule.automatic?'approval.automatic':'approval.firstReviewer'}" /></p></c:if></section>
<dialog class="approval-dialog" data-approver-dialog data-reviewer-url="<c:url value='/finance/approval/configuration/reviewers' />"><div class="approval-dialog-header"><h2><spring:message code="approval.selectApprovers" /></h2><button type="button" class="erp-icon-btn" data-dialog-close aria-label="<spring:message code='common.close' />">×</button></div><fieldset class="approval-choice"><legend><spring:message code="approval.chooseBy" /></legend><label><input type="radio" name="approverMode" value="group" checked /><spring:message code="approval.groupChoice" /></label><label><input type="radio" name="approverMode" value="staff" /><spring:message code="approval.staffChoice" /></label></fieldset><label><spring:message code="approval.approverGroup" /><select data-approver-claim data-native-select="true"><option value="VOUCHER_APPROVAL_APPROVE"><spring:message code="approval.reviewer.standard" /></option><option value="VOUCHER_APPROVAL_ESCALATED_APPROVE"><spring:message code="approval.reviewer.escalated" /></option></select></label><label><spring:message code="approval.scope" /><input readonly value="<spring:message code='approval.currentBranch' />" /></label><div data-staff-picker hidden><label><spring:message code="approval.searchStaff" /><input type="search" data-reviewer-search maxlength="100" /></label><p role="status" data-reviewer-status data-prompt="<spring:message code='approval.reviewerPrompt' />" data-empty="<spring:message code='approval.noEligible' />" data-error="<spring:message code='approval.reviewerError' />"></p><div data-reviewer-results class="approval-account-results"></div></div><div class="accounting-actions approval-footer"><button type="button" class="app-btn btn-neutral" data-approver-confirm><spring:message code="approval.ok" /></button><button type="button" class="app-btn btn-neutral" data-dialog-close><spring:message code="common.cancel" /></button></div></dialog>
</div><%@ include file="../accounting-form-support.jspf" %><script src="<c:url value='/js/voucher-approval.js' />" defer></script><%@ include file="../../fragments/footer.jspf" %>
