<sec:authorize access="@access.has(principal, 'VOUCHER_DOCUMENT_VIEW')"><details class="approval-documents"><summary><spring:message code="approval.documents" /> (${documents.size()})</summary><c:forEach items="${documents}" var="doc"><a class="app-btn btn-neutral" href="<c:url value='/finance/approval/${details.workflow.id}/documents/${doc.id}' />" data-document-open><c:out value="${doc.filename}" /></a></c:forEach></details><dialog class="approval-dialog approval-document-dialog" data-document-dialog><div class="approval-dialog-header"><h2><spring:message code="approval.documents" /></h2><button type="button" class="erp-icon-btn" data-dialog-close aria-label="<spring:message code='common.close' />">×</button></div><iframe title="<spring:message code='approval.documents' />" sandbox></iframe></dialog></sec:authorize>