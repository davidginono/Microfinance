<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>

<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>

<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>

<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>

<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>

<spring:htmlEscape defaultHtmlEscape="true" />

<%@ include file="../../fragments/header.jspf" %>

<%@ include file="../../fragments/sidebar.jspf" %>

<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />

<link rel="stylesheet" href="<c:url value='/css/voucher-approval.css' />" />

<div class="accounting-workspace approval-workspace approval-reference" data-approval-register>
<nav class="erp-page-path"><span><spring:message code="approval.office" /></span><span>/</span><span aria-current="page"><spring:message code="approval.workspace" /></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="approval.registerTitle" /></h1><span class="approval-scope-caption"><spring:message code="approval.currentBranch" /></span></div>
<div class="approval-tiles approval-five-tiles" data-table-query-state-for="voucher-approval-register">
<section class="approval-tile"><h2><spring:message code="approval.status.INCOMPLETE" /></h2><div class="approval-age-grid"><c:forEach items="${['age7','age14','age15']}" var="age"><div><strong data-table-query-value="${age}">${empty records.counts[age]?0:records.counts[age]}</strong><span><spring:message code="approval.${age}" /></span></div></c:forEach></div><div class="approval-tile-foot"></div></section>
<section class="approval-tile"><h2><spring:message code="approval.recent" /><small><spring:message code="approval.sevenDays" /></small></h2><div class="approval-recent"><strong data-table-query-value="recent_total">${empty records.counts['recent_total']?0:records.counts['recent_total']}</strong><div><c:forEach items="${['created','updated']}" var="r"><c:url value="/finance/approval" var="recentUrl"><c:if test="${not empty type}"><c:param name="type" value="${type}" /></c:if><c:param name="category" value="RECENT_${r.toUpperCase()}" /></c:url><a href="${recentUrl}" data-table-query-for="voucher-approval-register" data-table-query-param="category"><span data-table-query-value="recent_${r}">${empty records.counts['recent_'.concat(r)]?0:records.counts['recent_'.concat(r)]}</span> <spring:message code="approval.recent.${r}" /></a></c:forEach></div></div><div class="approval-tile-foot"></div></section>
<c:forEach items="${['validation','approval','posting']}" var="group"><c:set var="categories" value="${group=='validation'?['ACCOUNT_ERRORS','MISSING_DETAILS','UNBALANCED']:group=='approval'?['INITIATED','OTHERS','REJECTED']:['READY','FAILED','POSTED']}" />
<section class="approval-tile ${categories.contains(category)?'is-active':''}"><h2><spring:message code="approval.group.${group}" /></h2><c:forEach items="${categories}" var="state"><c:url value="/finance/approval" var="tileUrl"><c:if test="${not empty type}"><c:param name="type" value="${type}" /></c:if><c:param name="category" value="${state}" /></c:url><a href="${tileUrl}" data-table-query-for="voucher-approval-register" data-table-query-param="category" ${category==state?'aria-current="page"':''}><strong data-table-query-value="${state}">${empty records.counts[state]?0:records.counts[state]}</strong><span><spring:message code="approval.status.${state}" /></span></a></c:forEach><div class="approval-tile-foot"></div></section>
</c:forEach></div>
<section class="erp-table-wrap" data-resource-table="voucher-approval-register" data-table-sync-query="true" data-table-selection="single" data-table-page-size="${records.size}">
<div class="app-table-titlebar"><h2 class="erp-panel-title"><c:choose><c:when test="${empty category}"><spring:message code="approval.records" /></c:when><c:otherwise><spring:message code="approval.status.${category}" /></c:otherwise></c:choose></h2><div class="accounting-actions"><button type="button" class="app-btn btn-neutral" data-aws-table-refresh><spring:message code="common.refresh" /></button><button type="button" class="app-btn btn-neutral" data-table-command data-approval-open disabled><spring:message code="approval.openRecord" /></button><sec:authorize access="@access.hasAny(principal, 'VOUCHER_APPROVAL_APPROVE', 'VOUCHER_APPROVAL_ESCALATED_APPROVE')"><button type="button" class="app-btn btn-neutral" data-table-command data-register-action="APPROVE" data-action-label="<spring:message code='approval.action.APPROVE' />" disabled><spring:message code="approval.action.APPROVE" /></button><sec:authorize access="@access.has(principal, 'VOUCHER_APPROVAL_REJECT')"><button type="button" class="app-btn btn-neutral" data-table-command data-register-action="REJECT" data-action-label="<spring:message code='approval.action.REJECT' />" disabled><spring:message code="approval.action.REJECT" /></button></sec:authorize></sec:authorize></div></div>
<form method="get" class="approval-filters"><label class="approval-search-label"><span class="sr-only"><spring:message code="voucher.search" /></span><input name="search" type="search" class="aws-control" value="<c:out value='${search}' />" maxlength="100" placeholder="<spring:message code='approval.searchPlaceholder' />" /></label><label><span class="sr-only"><spring:message code="approval.voucherType" /></span><select name="type" class="aws-control"><option value=""><spring:message code="approval.allTypes" /></option><c:forEach items="${['RECEIPT','PAYMENT','JOURNAL']}" var="t"><option value="${t}" ${type==t?'selected':''}><spring:message code="approval.type.${t}" /></option></c:forEach></select></label><label><span class="sr-only"><spring:message code="approval.dateRange" /></span><select name="days"><c:forEach items="${[0,7,30,90]}" var="d"><option value="${d}" ${days==d?'selected':''}><spring:message code="approval.days.${d}" /></option></c:forEach></select></label><label><span class="sr-only"><spring:message code="voucher.status" /></span><select name="category"><option value=""><spring:message code="voucher.all" /></option><c:forEach items="${['INCOMPLETE','NOT_VALIDATED','VALIDATED','ERROR','REQUIRED','INITIATED','WITHDRAWN','HELD_FROM_APPROVAL','REJECTED','RESUBMIT_FOR_APPROVAL','WORKFLOW_APPROVED','MANUALLY_APPROVED','NOT_REQUIRED','NOT_POSTED','FAILED','POSTED','OTHERS','RECENT_CREATED','RECENT_UPDATED','READY','ACCOUNT_ERRORS','MISSING_DETAILS','UNBALANCED']}" var="s"><option value="${s}" ${category==s?'selected':''}><spring:message code="approval.status.${s}" /></option></c:forEach></select></label><input type="hidden" name="sort" value="<c:out value='${sort}' />" /><input type="hidden" name="size" value="${records.size}" /><button class="app-btn btn-neutral"><spring:message code="voucher.filter" /></button><a class="app-btn btn-neutral" data-table-query-for="voucher-approval-register" href="<c:url value='/finance/approval' />"><spring:message code="voucher.clear" /></a></form>
<p class="sr-only" role="status" aria-live="polite" data-approval-selection data-empty="<spring:message code='voucher.selectHelp' />" data-selected="<spring:message code='voucher.selected' />"></p>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="voucher.select" /></th><c:forEach items="${['number','type','date','count','total','owner','approval','validation','posting']}" var="column"><th data-table-sort-asc="${column}_asc" data-table-sort-desc="${column}_desc"><spring:message code="approval.column.${column}" /></th></c:forEach></tr></thead><tbody>
<c:forEach items="${records.rows}" var="w"><tr data-approval-url="<c:url value='/finance/approval/${w.id}' />" data-version="${w.version}" data-can-approve="${reviewActions[w.id].contains('APPROVE')}" data-can-reject="${reviewActions[w.id].contains('REJECT')}"><td><input type="checkbox" data-approval-select aria-label="<spring:message code='voucher.select' /> <c:out value='${w.number}' />" /></td><td><a class="resource-table-id-link" href="<c:url value='/finance/approval/${w.id}' />"><c:out value="${w.number}" /></a><small class="approval-record-scope"><spring:message code="approval.scope.${w.scope}" /></small></td><td><spring:message code="approval.type.${w.type}" /></td><td><c:out value="${appTime:display(transactionDates[w.id])}" /></td><td>${w.itemCount}</td><td><c:choose><c:when test="${w.validation=='VALIDATED'}"><fmt:formatNumber value="${w.total}" minFractionDigits="2" maxFractionDigits="2" /></c:when><c:otherwise>—</c:otherwise></c:choose></td><td><c:out value="${ownerNames[w.owner]}" /></td><c:forEach items="${[w.approval,w.validation,w.posting]}" var="status"><td><span class="approval-status" data-state="${status}"><spring:message code="approval.status.${status}" /></span></td></c:forEach></tr></c:forEach><c:if test="${empty records.rows}"><tr><td colspan="10"><spring:message code="voucher.noMatches" /></td></tr></c:if>
</tbody></table></div>
<div data-table-pagination data-page="${records.page}" data-table-for="voucher-approval-register"><c:forEach items="${['previous','next']}" var="direction"><c:url value="/finance/approval" var="pageUrl"><c:if test="${not empty type}"><c:param name="type" value="${type}" /></c:if><c:param name="search" value="${search}" /><c:param name="category" value="${category}" /><c:param name="sort" value="${sort}" /><c:param name="days" value="${days}" /><c:param name="size" value="${records.size}" /><c:param name="page" value="${records.page+(direction=='next'?1:-1)}" /></c:url><c:if test="${direction=='next'?records.hasNext:records.page>0}"><a data-page-direction="${direction}" href="${pageUrl}"><spring:message code="common.${direction}" /></a></c:if></c:forEach></div></section>
<p class="approval-register-foot" data-table-query-state-for="voucher-approval-register"><span data-table-query-value="register-foot"><spring:message code="approval.currentBranch" /> · ${empty records.counts['ALL']?0:records.counts['ALL']} <spring:message code="approval.records" /></span></p><dialog class="approval-dialog" data-register-dialog><form method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="version" /><input type="hidden" name="action" /><div class="approval-dialog-header"><h2 data-register-dialog-title></h2><button type="button" class="erp-icon-btn" data-dialog-close aria-label="<spring:message code='common.close' />">×</button></div><p data-register-reference></p><label><spring:message code="approval.comments" /><textarea name="comments" maxlength="1000" rows="3"></textarea></label><div class="accounting-actions approval-footer"><button type="button" class="app-btn btn-neutral" data-dialog-close><spring:message code="common.cancel" /></button><button class="app-btn btn-neutral" data-register-confirm><spring:message code="approval.confirm" /></button></div></form></dialog></div><script src="<c:url value='/js/voucher-approval.js' />" defer></script><%@ include file="../../fragments/footer.jspf" %>
