<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<spring:htmlEscape defaultHtmlEscape="true" />
<%@ include file="../../fragments/header.jspf" %>
<%@ include file="../../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<link rel="stylesheet" href="<c:url value='/css/voucher-approval.css' />" />
<c:set var="w" value="${details.workflow}" /><nav class="erp-page-path"><a href="<c:url value='/finance/approval' />"><spring:message code="approval.workspace" /></a><span aria-hidden="true">›</span><a href="<c:url value='/finance/approval/${w.id}' />"><c:out value="${w.number}" /></a><span aria-hidden="true">›</span><span><spring:message code="approval.correct" /></span></nav>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="${readOnly?'approval.reviewVoucher':'approval.correct'}" /></h1></div>
<div class="accounting-workspace approval-workspace"><%@ include file="documents.jspf" %>
<c:url value="/finance/approval/${w.id}/vouchers/${itemId}" var="saveUrl" /><form:form modelAttribute="voucherForm" method="post" action="${saveUrl}" data-approval-editor="true" data-account-url="${pageContext.request.contextPath}/finance/approval/${w.id}/accounts" data-readonly="${readOnly}" data-row-limit="50" cssClass="approval-form accounting-create-form" data-voucher-form="true"><form:hidden path="requestKey" /><input type="hidden" name="version" value="${w.version}" /><input type="hidden" name="itemVersion" value="${itemVersion}" />
<div class="accounting-error-summary" role="alert" tabindex="-1"><form:errors path="*" element="p" cssClass="coa-error" /></div>
<c:if test="${not empty issues}"><details class="approval-warning-summary" open><summary><spring:message code="approval.warnings" /> (${issues.size()})</summary><ul><c:forEach items="${issues}" var="issue"><li><a href="#field-${issue.field}" data-issue-field="<c:out value='${issue.field}' />"><spring:message code="${issue.code}" /></a></li></c:forEach></ul></details></c:if>
<section class="approval-editor-header"><h2><spring:message code="voucher.information" /></h2><div class="approval-fields"><label><spring:message code="voucher.date" /><input name="effectiveDate" id="effectiveDate" type="date" value="<c:out value='${voucherForm.effectiveDate}' />" <c:if test="${readOnly}">readonly</c:if> /></label><label><spring:message code="voucher.party" /><form:input path="party" maxlength="160" readonly="${readOnly}" /></label><label><spring:message code="voucher.reference" /><form:input path="reference" maxlength="160" readonly="${readOnly}" /></label>
<c:if test="${w.type!='JOURNAL'}"><label><spring:message code="voucher.moneyAccount" /><span class="approval-account"><form:hidden path="moneyAccountId" /><c:set var="chosen" value="${accounts['moneyAccountId']}" /><input readonly data-account-label value="<c:out value='${chosen.code} ${chosen.name}' />" aria-label="<spring:message code='voucher.moneyAccount' />" /><c:if test="${not readOnly}"><button type="button" class="app-btn btn-neutral" data-account-pick><spring:message code="voucher.chooseAccount" /></button></c:if></span></label></c:if><label><spring:message code="voucher.description" /><form:input path="description" maxlength="500" readonly="${readOnly}" /></label><label><spring:message code="voucher.evidence" /><form:input path="evidence" maxlength="500" readonly="${readOnly}" /></label></div></section>
<section class="erp-table-wrap" data-resource-table="approval-voucher-lines"><div class="app-table-titlebar"><h2 class="erp-panel-title"><spring:message code="voucher.transactions" /></h2><c:if test="${not readOnly}"><button type="button" class="app-btn btn-neutral" data-line-add><spring:message code="approval.addLine" /></button></c:if></div><div class="erp-table-scroll"><table class="erp-table approval-lines"><thead><tr><th>#</th><th data-table-column-required><spring:message code="voucher.description" /></th><c:if test="${w.type!='RECEIPT'}"><th data-table-column-required><spring:message code="accounting.debit" /></th></c:if><c:if test="${w.type!='PAYMENT'}"><th data-table-column-required><spring:message code="accounting.credit" /></th></c:if><th data-table-column-required><spring:message code="voucher.total" /> (TZS)</th><c:if test="${not readOnly}"><th><span class="sr-only"><spring:message code="approval.removeLine" /></span></th></c:if></tr></thead><tbody data-editor-lines>
<c:forEach items="${voucherForm.rows}" var="row" varStatus="n"><tr data-editor-line><td data-line-number>${n.index+1}<form:hidden path="rows[${n.index}].transactionId" /><form:hidden path="rows[${n.index}].templateKey" /><form:hidden path="rows[${n.index}].component" /></td><td><form:input path="rows[${n.index}].description" maxlength="500" readonly="${readOnly}" aria-label="${n.index+1}" /><c:if test="${not empty row.transactionId}"><small data-mapping-label><spring:message code="approval.configuredMapping" /><c:if test="${not readOnly}"> <button type="button" class="app-btn btn-neutral" data-mapping-clear><spring:message code="approval.manualAccounts" /></button></c:if></small></c:if></td>
<c:forEach items="${['debit','credit']}" var="side"><c:if test="${side=='debit'?w.type!='RECEIPT':w.type!='PAYMENT'}"><c:set var="fieldPath" value="rows[${n.index}].${side}AccountId" /><c:set var="chosen" value="${accounts[fieldPath]}" /><td><span class="approval-account"><form:hidden path="rows[${n.index}].${side}AccountId" /><input readonly data-account-label value="<c:out value='${chosen.code} ${chosen.name}' />" aria-label="<spring:message code='accounting.${side}' /> ${n.index+1}" /><c:if test="${not readOnly and empty row.transactionId}"><button class="erp-icon-btn" type="button" data-account-pick aria-label="<spring:message code='voucher.chooseAccount' />">…</button></c:if></span></td></c:if></c:forEach><td><form:input path="rows[${n.index}].amount" type="number" step="0.01" min="0.01" readonly="${readOnly}" aria-label="TZS ${n.index+1}" /></td><c:if test="${not readOnly}"><td><button type="button" class="erp-icon-btn" data-line-remove aria-label="<spring:message code='approval.removeLine' />">×</button></td></c:if></tr></c:forEach>
</tbody></table></div></section><p role="status" data-editor-status></p><div class="accounting-actions approval-footer"><a class="app-btn btn-neutral" href="<c:url value='/finance/approval/${w.id}' />"><spring:message code="approval.return" /></a><c:if test="${not readOnly}"><button class="app-btn btn-neutral"><spring:message code="approval.saveCorrections" /></button></c:if></div></form:form>
<dialog class="approval-dialog" data-account-dialog><div class="approval-dialog-header"><h2><spring:message code="voucher.chooseAccount" /></h2><button class="erp-icon-btn" type="button" data-dialog-close aria-label="<spring:message code='common.close' />">×</button></div><label><spring:message code="voucher.search" /><input type="search" data-account-search maxlength="100" /></label><p role="status" data-account-status data-error="<spring:message code='approval.lookupError' />" data-empty="<spring:message code='voucher.noMatches' />"></p><div class="approval-account-results" data-account-results></div><div class="accounting-actions approval-footer"><button type="button" class="app-btn btn-neutral" data-account-more><spring:message code="approval.more" /></button><button type="button" class="app-btn btn-neutral" data-dialog-close><spring:message code="common.cancel" /></button></div></dialog></div><%@ include file="../accounting-form-support.jspf" %>
<script src="<c:url value='/js/voucher-approval.js' />" defer></script>
<%@ include file="../../fragments/footer.jspf" %>