<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<spring:htmlEscape defaultHtmlEscape="true" />
<%@ include file="../../fragments/header.jspf" %>
<%@ include file="../../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<link rel="stylesheet" href="<c:url value='/css/voucher-approval.css' />" />
<c:set var="w" value="${details.workflow}" /><c:set var="itemValidation" value="NOT_VALIDATED" /><c:forEach items="${details.items}" var="currentItem"><c:if test="${currentItem.id==itemId}"><c:set var="itemValidation" value="${not empty currentItem.issues?'ERROR':empty currentItem.planHash?'NOT_VALIDATED':'VALIDATED'}" /></c:if></c:forEach><nav class="erp-page-path"><a href="<c:url value='/finance/approval' />"><spring:message code="approval.office" /></a><span>/</span><a href="<c:url value='/finance/approval/${w.id}' />"><c:out value="${w.number}" /></a><span>/</span><span><c:out value="${voucherForm.reference}" /></span></nav>
<div class="accounting-workspace approval-workspace approval-reference approval-editor-page">
<c:url value="/finance/approval/${w.id}/vouchers/${itemId}" var="saveUrl" />
<spring:message code="approval.warning.debitRequired" var="debitRequiredLabel" /><spring:message code="approval.warning.creditRequired" var="creditRequiredLabel" /><spring:message code="approval.lineLabel" var="lineLabel" />
<form:form id="voucherForm" modelAttribute="voucherForm" method="post" action="${saveUrl}" data-approval-editor="true" data-debit-required="${debitRequiredLabel}" data-credit-required="${creditRequiredLabel}" data-line-label="${lineLabel}" data-account-url="${pageContext.request.contextPath}/finance/approval/${w.id}/accounts" data-client-url="${pageContext.request.contextPath}/finance/approval/${w.id}/clients" data-readonly="${readOnly}" data-row-limit="50" cssClass="approval-form accounting-create-form" data-voucher-form="true"><form:hidden path="requestKey" /><input type="hidden" name="command" data-approval-command value="CLOSE" /><input type="hidden" name="version" value="${w.version}" /><input type="hidden" name="itemVersion" value="${itemVersion}" />
<div class="approval-editor-heading"><h1><c:choose><c:when test="${readOnly}"><spring:message code="approval.reviewVoucher" /></c:when><c:otherwise><spring:message code="approval.edit.${w.type}" /></c:otherwise></c:choose>: <c:out value="${empty voucherForm.reference?itemNumber:voucherForm.reference}" /></h1><span class="approval-status" data-state="${itemValidation}"><spring:message code="approval.status.${itemValidation}" /></span><span class="approval-status" data-state="${w.posting}"><spring:message code="approval.status.${w.posting}" /></span></div>
<div class="approval-editor-toolbar"><div class="approval-record-context"><a href="<c:url value='/finance/approval/${w.id}' />"><c:out value="${w.number}" /></a><span>· <spring:message code="approval.voucherPosition" arguments="${itemNumber},${details.items.size()}" /></span><c:forEach items="${details.items}" var="adjacent" varStatus="position"><c:if test="${position.index==itemNumber-2 or position.index==itemNumber}"><a class="app-btn btn-neutral" href="<c:url value='/finance/approval/${w.id}/vouchers/${adjacent.id}' />"><spring:message code="${position.index==itemNumber-2?'common.previous':'common.next'}" /></a></c:if></c:forEach></div><div class="accounting-actions">
<details class="approval-warning-popover" ${empty issues?'':'open'}><summary><spring:message code="approval.warnings" /> (${issues.size()})</summary><div class="approval-warning-list"><c:choose><c:when test="${empty issues}"><span><spring:message code="approval.noWarnings" /></span></c:when><c:otherwise><ul><c:forEach items="${issues}" var="issue"><li><a href="#field-${issue.field}" data-issue-field="<c:out value='${issue.field}' />"><spring:message code="${issue.code}" /></a></li></c:forEach></ul></c:otherwise></c:choose></div></details>
<c:if test="${not readOnly}"><button data-form-command="SAVE" class="app-btn btn-neutral"><spring:message code="approval.save" /></button><button data-form-command="CLOSE" class="app-btn btn-neutral"><spring:message code="approval.saveClose" /></button></c:if><a class="app-btn btn-neutral" href="<c:url value='/finance/approval/${w.id}' />"><spring:message code="common.cancel" /></a></div></div>
<div class="accounting-error-summary" role="alert" tabindex="-1"><form:errors path="*" element="p" cssClass="coa-error" /><c:if test="${not empty workflowError}"><p class="coa-error"><spring:message code="${workflowError}" /></p></c:if></div>
<sec:authorize access="@access.has(principal, 'VOUCHER_DOCUMENT_VIEW')" var="canViewEvidence" /><div class="approval-editor-grid ${canViewEvidence?'':'approval-without-evidence'}"><div class="approval-editor-main">
<details class="approval-panel approval-header-panel" open><summary><spring:message code="approval.voucherHeader" /></summary><div class="approval-fields"><label><spring:message code="voucher.date" /><input name="effectiveDate" id="effectiveDate" type="date" value="<c:out value='${voucherForm.effectiveDate}' />" <c:if test="${readOnly}">readonly</c:if> /></label><label><spring:message code="approval.party.${w.type}" /><form:input path="party" maxlength="160" readonly="${readOnly}" /></label><label><spring:message code="voucher.reference" /><form:input path="reference" maxlength="160" readonly="${readOnly}" /></label>
<label><spring:message code="voucher.client" /><span class="approval-account"><form:hidden path="clientId" /><input readonly data-account-label value="<c:out value='${voucherClient.name}' /><c:if test='${not empty voucherClient}'> · <c:out value='${voucherClient.number}' /></c:if>" aria-label="<spring:message code='voucher.client' />" /><c:if test="${not readOnly}"><button type="button" class="erp-icon-btn" data-client-pick aria-label="<spring:message code='recording.client' />"><i data-lucide="search"></i></button><button type="button" class="app-btn btn-neutral" data-client-clear><spring:message code="common.clear" /></button></c:if></span></label>
<c:if test="${w.type!='JOURNAL'}"><label><spring:message code="voucher.moneyAccount" /><span class="approval-account"><form:hidden path="moneyAccountId" /><c:set var="chosen" value="${accounts['moneyAccountId']}" /><input readonly data-account-label value="<c:out value='${chosen.code} ${chosen.name}' />" aria-label="<spring:message code='voucher.moneyAccount' />" /><c:if test="${not readOnly}"><button type="button" class="erp-icon-btn" data-account-pick aria-label="<spring:message code='voucher.chooseAccount' />"><i data-lucide="search"></i></button></c:if></span></label></c:if><label><spring:message code="approval.currency" /><input readonly value="TZS" /></label><label><spring:message code="approval.narration" /><form:input path="description" maxlength="500" readonly="${readOnly}" /></label></div></details>
<section class="erp-table-wrap" data-resource-table="approval-voucher-lines" data-table-selection="single"><div class="app-table-titlebar"><h2 class="erp-panel-title"><spring:message code="approval.voucherLines" /></h2><c:if test="${not readOnly}"><div class="accounting-actions"><button type="button" class="app-btn btn-neutral" data-line-remove-selected disabled><spring:message code="approval.removeLine" /></button><button type="button" class="app-btn btn-neutral" data-choose-selected disabled><spring:message code="voucher.chooseAccount" /></button><button type="button" class="app-btn btn-neutral" data-line-add><spring:message code="approval.addLine" /></button></div></c:if></div><div class="erp-table-scroll"><table class="erp-table approval-lines"><thead><tr><th><span class="sr-only"><spring:message code="voucher.select" /></span></th><th>#</th><th data-table-column-required><spring:message code="voucher.description" /></th><c:if test="${true}"><th data-table-column-required><spring:message code="accounting.debit" /></th></c:if><c:if test="${true}"><th data-table-column-required><spring:message code="accounting.credit" /></th></c:if><th data-table-column-required><spring:message code="voucher.total" /> (TZS)</th></tr></thead><tbody data-editor-lines>
<c:forEach items="${voucherForm.rows}" var="row" varStatus="n"><tr data-editor-line><td class="approval-line-selector"><input type="checkbox" data-line-select aria-label="<spring:message code='voucher.select' /> ${n.index+1}" /></td><td data-line-number>${n.index+1}<form:hidden path="rows[${n.index}].transactionId" /><form:hidden path="rows[${n.index}].templateKey" /><form:hidden path="rows[${n.index}].component" /></td><td><form:input path="rows[${n.index}].description" maxlength="500" readonly="${readOnly}" aria-label="${n.index+1}" /><c:if test="${not empty row.transactionId}"><small data-mapping-label><spring:message code="approval.configuredMapping" /><c:if test="${not readOnly}"> <button type="button" class="app-btn btn-neutral" data-mapping-clear><spring:message code="approval.manualAccounts" /></button></c:if></small></c:if></td>
<c:forEach items="${['debit','credit']}" var="side"><c:if test="${true}"><c:set var="fieldPath" value="rows[${n.index}].${side}AccountId" /><c:set var="moneySide" value="${(side=='debit' and w.type=='RECEIPT') or (side=='credit' and w.type=='PAYMENT')}" /><c:set var="chosen" value="${moneySide?accounts['moneyAccountId']:accounts[fieldPath]}" /><td><span class="approval-account"><form:hidden path="rows[${n.index}].${side}AccountId" /><input readonly data-account-label data-money-side="${moneySide}" value="<c:out value='${chosen.code} ${chosen.name}' />" aria-label="<spring:message code='accounting.${side}' /> ${n.index+1}" /><c:if test="${not readOnly and empty row.transactionId and not moneySide}"><button class="erp-icon-btn" type="button" data-account-pick aria-label="<spring:message code='voucher.chooseAccount' />">…</button></c:if></span></td></c:if></c:forEach><td><form:input path="rows[${n.index}].amount" type="number" step="0.01" min="0.01" readonly="${readOnly}" aria-label="TZS ${n.index+1}" /></td></tr></c:forEach>
</tbody></table></div></section>
<div class="approval-line-total"><span><spring:message code="approval.voucherAmount" /> (TZS)</span><output data-editor-total>—</output></div>
<details class="approval-panel"><summary><spring:message code="approval.additional" /></summary><div class="approval-fields"><label><spring:message code="voucher.evidence" /><form:input path="evidence" maxlength="500" readonly="${readOnly}" /></label></div></details>
<details class="approval-panel approval-editor-history"><summary><spring:message code="approval.history" /></summary><ol><c:forEach items="${details.history}" var="event"><li><spring:message code="approval.action.${event.action}" /> · <c:out value="${event.actorName}" /> · <c:out value="${appTime:display(event.time.toLocalDate())}" /></li></c:forEach></ol></details>
</div>
<c:if test="${canViewEvidence}"><aside class="approval-evidence-pane approval-panel"><h2><spring:message code="approval.supportingDocument" /></h2><sec:authorize access="@access.has(principal, 'VOUCHER_DOCUMENT_VIEW')"><c:choose><c:when test="${not empty documents}"><label><span class="sr-only"><spring:message code="approval.supportingDocument" /></span><select data-evidence-select data-native-select="true"><c:forEach items="${documents}" var="doc"><option value="<c:url value='/finance/approval/${w.id}/documents/${doc.id}' />" data-media="${doc.mediaType}"><c:out value="${doc.filename}" /></option></c:forEach></select></label><div class="approval-evidence-tools"><button type="button" class="erp-icon-btn" data-evidence-zoom="-10" aria-label="<spring:message code='approval.zoomOut' />">−</button><output data-evidence-zoom-value>100%</output><button type="button" class="erp-icon-btn" data-evidence-zoom="10" aria-label="<spring:message code='approval.zoomIn' />">+</button><a class="app-btn btn-neutral" data-evidence-open target="_blank" rel="noopener"><spring:message code="approval.openDocument" /></a></div><div class="approval-evidence-pagination" data-evidence-pagination hidden><button type="button" class="app-btn btn-neutral" data-evidence-page="-1"><spring:message code="common.previous" /></button><output data-evidence-page-value></output><button type="button" class="app-btn btn-neutral" data-evidence-page="1"><spring:message code="common.next" /></button></div><p role="status" class="approval-evidence-status" data-evidence-status data-error="<spring:message code='approval.documentPreviewError' />" data-loading="<spring:message code='approval.documentLoading' />"></p><div class="approval-evidence-view" data-evidence-view role="region" aria-label="<spring:message code='approval.supportingDocument' />" tabindex="0"><canvas data-evidence-canvas role="img" aria-label="<spring:message code='approval.supportingDocument' />" hidden></canvas><img data-evidence-image alt="<spring:message code='approval.supportingDocument' />" hidden /></div></c:when><c:otherwise><p><spring:message code="approval.noDocuments" /></p><a href="<c:url value='/finance/approval/${w.id}' />"><spring:message code="approval.upload" /></a></c:otherwise></c:choose></sec:authorize></aside></c:if></div>
<footer class="approval-editor-footer"><span><spring:message code="${w.posting=='POSTED'?'approval.status.POSTED':'approval.noMoneyPosted'}" /></span><div class="accounting-actions"><c:if test="${not readOnly}"><sec:authorize access="@access.has(principal, 'VOUCHER_WORKSPACE_VALIDATE')"><button data-form-command="VALIDATE" class="app-btn btn-neutral"><spring:message code="approval.action.VALIDATE" /></button></sec:authorize><button data-form-command="SAVE" class="app-btn btn-neutral"><spring:message code="approval.saveCorrectionsShort" /></button><c:if test="${w.scope=='SINGLE' and w.approval!='NOT_REQUIRED'}"><sec:authorize access="@access.has(principal, 'VOUCHER_APPROVAL_INITIATE')"><button data-form-command="SUBMIT" data-editor-submit class="app-btn btn-neutral" ${w.validation!='VALIDATED' or not empty issues?'disabled':''}><spring:message code="approval.submit" /></button></sec:authorize></c:if></c:if><c:if test="${w.scope=='BATCH'}"><span class="approval-footer-note"><spring:message code="approval.submitFromBatch" /></span><a class="app-btn btn-neutral" href="<c:url value='/finance/approval/${w.id}' />"><spring:message code="approval.returnBatch" /></a></c:if></div></footer></form:form>
<dialog class="approval-dialog" data-account-dialog><div class="approval-dialog-header"><h2 data-account-title="<spring:message code='voucher.chooseAccount' />" data-client-title="<spring:message code='recording.client' />"><spring:message code="voucher.chooseAccount" /></h2><button class="erp-icon-btn" type="button" data-dialog-close aria-label="<spring:message code='common.close' />">×</button></div><label><spring:message code="voucher.search" /><input type="search" data-account-search maxlength="100" /></label><p role="status" data-account-status data-error="<spring:message code='approval.lookupError' />" data-empty="<spring:message code='voucher.noMatches' />"></p><div class="approval-account-results" data-account-results></div><div class="accounting-actions approval-footer"><button type="button" class="app-btn btn-neutral" data-account-more><spring:message code="approval.more" /></button><button type="button" class="app-btn btn-neutral" data-dialog-close><spring:message code="common.cancel" /></button></div></dialog></div><%@ include file="../accounting-form-support.jspf" %><script src="<c:url value='/js/voucher-approval.js' />" defer></script><script type="module" src="<c:url value='/js/voucher-evidence.mjs' />"></script><%@ include file="../../fragments/footer.jspf" %>
