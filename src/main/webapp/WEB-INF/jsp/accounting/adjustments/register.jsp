<%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="../loans/support.jspf" %>
<div class="accounting-workspace">
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="adjustment.title" /></h1></div>
<section class="erp-table-wrap" data-resource-table="loan-adjustments" data-table-selection="single" data-budget-register>
<div class="app-table-titlebar"><h2><spring:message code="adjustment.requests" /></h2><div class="accounting-actions">
<button class="app-btn btn-neutral" data-budget-view data-url="<c:url value='/finance/loan-adjustments/' />" disabled type="button"><spring:message code="common.view" /></button>
<sec:authorize access="@access.has(principal,'LOAN_ADJUSTMENTS_CREATE')"><a class="app-btn btn-launch" href="<c:url value='/finance/loan-adjustments/new' />"><spring:message code="adjustment.create" /></a></sec:authorize></div></div>
<form method="get" class="erp-table-toolbar" action="<c:url value='/finance/loan-adjustments' />">
<label class="erp-table-toolbar__control"><spring:message code="common.search" /><input class="aws-control" name="search" maxlength="100" value="<c:out value='${search}' />" /></label>
<label class="erp-table-toolbar__control"><spring:message code="voucher.status" /><select class="aws-control" name="state"><c:forEach items="${['','PENDING','APPROVED','REJECTED']}" var="s"><option value="${s}" ${state==s?'selected':''}><spring:message code="adjustment.state.${empty s?'ALL':s}" /></option></c:forEach></select></label>
<input type="hidden" name="sort" value="<c:out value='${sort}' />" /><input type="hidden" name="direction" value="<c:out value='${direction}' />" /><div class="accounting-actions"><button class="app-btn btn-neutral"><spring:message code="coa.filter" /></button><a class="app-btn btn-neutral" href="<c:url value='/finance/loan-adjustments' />"><spring:message code="common.clear" /></a></div></form>
<span class="sr-only" role="status" data-budget-status data-empty="<spring:message code='coa.selectHint' />" data-selected="<spring:message code='coa.selected' />"></span>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><span class="sr-only"><spring:message code="coa.select" /></span></th><c:forEach items="${['number','client','kind','date','amount','state']}" var="key"><th data-table-sort-key="${key}" data-table-sort-asc="asc" data-table-sort-desc="desc"><spring:message code="adjustment.column.${key}" /></th></c:forEach></tr></thead><tbody>
<c:forEach items="${records.rows}" var="q"><tr data-budget-id="${q.id}"><td><input type="checkbox" aria-label="<c:out value='${q.number}' />" /></td><td><a class="resource-table-id-link" href="<c:url value='/finance/loan-adjustments/${q.id}' />"><c:out value="${q.number}" /></a></td><td><c:out value="${q.client}" /></td><td><spring:message code="adjustment.kind.${q.kind}" /></td><td>${appTime:display(q.date)}</td><td><fmt:formatNumber value="${q.amount}" minFractionDigits="2" maxFractionDigits="2" /></td><td><spring:message code="adjustment.state.${q.state}" /></td></tr></c:forEach>
<c:if test="${empty records.rows}"><tr><td colspan="7"><spring:message code="adjustment.empty" /></td></tr></c:if></tbody></table></div>
<div data-table-pagination data-page="${records.page}" data-table-for="loan-adjustments"><c:forEach items="${['previous','next']}" var="move"><c:if test="${move=='previous'?records.page>0:records.hasNext}"><c:url value="/finance/loan-adjustments" var="pageUrl"><c:param name="search" value="${search}" /><c:param name="state" value="${state}" /><c:param name="sort" value="${sort}" /><c:param name="direction" value="${direction}" /><c:param name="page" value="${records.page+(move=='previous'?-1:1)}" /></c:url><a data-page-direction="${move}" href="<c:out value='${pageUrl}' />"><spring:message code="common.${move}" /></a></c:if></c:forEach></div>
</section></div>
<script src="<c:url value='/js/management-reports.js' />" defer></script><%@ include file="../../fragments/footer.jspf" %>
