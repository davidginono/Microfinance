<%@ page pageEncoding="UTF-8" %>
<section class="accounting-form erp-table-wrap" aria-label="<spring:message code='charges.title' />"><div class="erp-table-scroll" tabindex="0" role="region" aria-label="<spring:message code='charges.title' />"><table class="erp-table"><thead><tr><th scope="col"><spring:message code="loan.loanId" /></th><th scope="col"><spring:message code="charges.collected" /> (TZS)</th><th scope="col"><spring:message code="charges.account.RECEIVABLE" /></th></tr></thead><tbody><c:forEach items="${receipt.rows}" var="chargeRow"><tr><td><c:out value="${chargeRow.loanNumber}" /></td><td><fmt:formatNumber value="${chargeRow.charges}" minFractionDigits="2" maxFractionDigits="2" /></td><td><c:out value="${chargeRow.chargeAccount}" /></td></tr></c:forEach></tbody></table></div></section>
