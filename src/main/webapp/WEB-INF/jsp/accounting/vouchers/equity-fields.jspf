<%@ page pageEncoding="UTF-8" %>
<label data-equity-only ${voucherForm.equity?'':'hidden'}><spring:message code="fs.setup.category" />
<form:select path="equityMovement" cssClass="aws-control" data-equity-control="true" disabled="${not voucherForm.equity or equityReadOnly eq true}" required="${voucherForm.equity?'required':null}"><form:option value=""><spring:message code="voucher.equity.choose" /></form:option><c:forEach items="${equityTypes}" var="movement"><form:option value="${movement}"><spring:message code="fs.movement.${movement}" /></form:option></c:forEach></form:select><form:errors path="equityMovement" cssClass="coa-error" /></label>
<label data-equity-only ${voucherForm.equity?'':'hidden'}><spring:message code="fs.setup.reason" /><form:textarea path="equityReason" cssClass="aws-control" rows="2" maxlength="500" data-equity-control="true" disabled="${not voucherForm.equity or equityReadOnly eq true}" required="${voucherForm.equity?'required':null}" /><form:errors path="equityReason" cssClass="coa-error" /></label>
