<%@ page pageEncoding="UTF-8" %>
<label data-equity-only ${voucherForm.equity?'':'hidden'}><spring:message code="fs.setup.category" />
<form:select path="equityChoice" cssClass="aws-control" data-equity-control="true" disabled="${not voucherForm.equity or equityReadOnly eq true}" required="${voucherForm.equity?'required':null}"><form:option value=""><spring:message code="voucher.equity.choose" /></form:option><c:forEach items="${equityTypes}" var="movement"><form:option value="${movement}"><spring:message code="fs.movement.${movement}" /></form:option></c:forEach><c:if test="${not empty equityOptions}"><spring:message code="fs.layout.movementRows" var="movementRowsLabel" /><optgroup label="${movementRowsLabel}"><c:forEach items="${equityOptions}" var="option"><form:option value="${option.value}"><c:out value="${pageContext.response.locale.language=='sw' and not empty option.row.nameSw?option.row.nameSw:option.row.name}" /></form:option></c:forEach></optgroup></c:if></form:select><form:errors path="equityChoice" cssClass="coa-error" /><form:errors path="equityMovement" cssClass="coa-error" /></label>
<label data-equity-only ${voucherForm.equity?'':'hidden'}><spring:message code="fs.setup.reason" /><form:textarea path="equityReason" cssClass="aws-control" rows="2" maxlength="500" data-equity-control="true" disabled="${not voucherForm.equity or equityReadOnly eq true}" required="${voucherForm.equity?'required':null}" /><form:errors path="equityReason" cssClass="coa-error" /></label>
