<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<article class="voucher-document">
<header class="voucher-document-header"><div><p class="voucher-institution"><c:out value="${voucher.institutionName}" /></p><p><c:out value="${voucher.branchName}" /></p></div><div><h2><spring:message code="voucher.title.${voucherType}" /></h2><p><c:out value="${voucher.number}" /></p><span class="voucher-status"><spring:message code="voucher.status.${voucher.status()}" /></span></div></header>
<dl class="voucher-metadata"><div><dt><spring:message code="voucher.date" /></dt><dd><c:out value="${voucher.effectiveDate}" /></dd></div><div><dt><spring:message code="voucher.reference" /></dt><dd><c:out value="${voucher.reference}" /></dd></div><div><dt><spring:message code="${voucherType=='RECEIPT'?'voucher.receivedFrom':voucherType=='PAYMENT'?'voucher.paidTo':'voucher.party'}" /></dt><dd><c:out value="${voucher.party}" /></dd></div><div><dt><spring:message code="voucher.transactions" /></dt><dd>${voucher.transactionCount}</dd></div></dl>
<c:if test="${not empty voucher.description}"><p><strong><spring:message code="voucher.description" />:</strong> <c:out value="${voucher.description}" /></p></c:if><c:if test="${not empty voucher.evidence}"><p><strong><spring:message code="voucher.evidence" />:</strong> <c:out value="${voucher.evidence}" /></p></c:if>
<div class="erp-table-scroll"><table class="erp-table voucher-lines"><thead><tr><th>#</th><th><spring:message code="voucher.transactions" /></th><th class="voucher-numeric"><spring:message code="voucher.amount" /> (TZS)</th></tr></thead><tbody><c:forEach items="${voucher.transactions}" var="t"><tr><td>${t.lineNo}</td><td><strong><c:out value="${t.description}" /></strong><c:if test="${not empty t.transactionName}"><p><c:out value="${t.transactionName}" /> · <spring:message code="library.component.${t.component}" /></p></c:if><p><spring:message code="accounting.debit" />: <c:out value="${t.debit.code}" /> · <c:out value="${t.debit.name}" /></p><p><spring:message code="accounting.credit" />: <c:out value="${t.credit.code}" /> · <c:out value="${t.credit.name}" /></p></td><td class="voucher-numeric"><fmt:formatNumber value="${t.amount}" minFractionDigits="2" maxFractionDigits="2" /></td></tr></c:forEach></tbody></table></div>
<div class="voucher-document-total"><spring:message code="voucher.total" /> (TZS)<strong><fmt:formatNumber value="${voucher.total}" minFractionDigits="2" maxFractionDigits="2" /></strong></div>
<dl class="voucher-metadata"><div><dt><spring:message code="voucher.postedBy" /></dt><dd><c:out value="${voucher.postedByName}" /></dd></div><div><dt><spring:message code="voucher.postedAt" /></dt><dd><c:out value="${appTime:format(voucher.postedAt)}" /></dd></div></dl>
<c:if test="${not empty voucher.reversesId}"><p><spring:message code="voucher.reversal" />: <a href="<c:url value='${base}/${voucher.reversesId}' />"><c:out value="${voucher.reference}" /></a></p></c:if>
<c:if test="${not empty voucher.reversedBy}"><p><spring:message code="voucher.reversedHelp" /> <a href="<c:url value='${base}/${voucher.reversedBy}' />"><spring:message code="common.view" /></a></p></c:if>
</article>
