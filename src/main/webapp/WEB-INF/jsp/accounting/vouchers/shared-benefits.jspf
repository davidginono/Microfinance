<c:if test="${not empty sharedReceiptRows}"><c:set var="hasSharedReceiptBenefits" value="false" /><c:forEach items="${sharedReceiptRows}" var="sharedParent"><c:if test="${not empty sharedParent.sharedBenefits}"><c:set var="hasSharedReceiptBenefits" value="true" /></c:if></c:forEach><c:if test="${hasSharedReceiptBenefits}"><section class="erp-resource-section" data-voucher-preview><h2><spring:message code="sharedReceipt.title" /></h2><p><spring:message code="sharedReceipt.rule" /></p><div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="editor"><thead><tr><th><spring:message code="group.loan" /></th><th><spring:message code="group.paidFor" /></th><th><spring:message code="recording.principal" /> (TZS)</th><th><spring:message code="recording.interest" /> (TZS)</th><th><spring:message code="charges.title" /> (TZS)</th><th><spring:message code="voucher.amount" /> (TZS)</th><c:if test="${not sharedReceiptPreview}"><th><spring:message code="${sharedReceiptReversal?'sharedReceipt.restored':'sharedReceipt.excluded'}" /> (TZS)</th></c:if></tr></thead><tbody><c:forEach items="${sharedReceiptRows}" var="sharedParent"><c:forEach items="${sharedParent.sharedBenefits}" var="benefit"><tr><td><a class="resource-table-id-link" href="<c:url value='/finance/loan-records/${sharedParent.loanId}' />"><c:out value="${sharedParent.loanNumber}" /></a></td><td><c:out value="${benefit.clientNumber}" /> &middot; <c:out value="${benefit.clientName}" /></td><c:forEach items="${['principal','interest','charges','amount']}" var="component"><td><fmt:formatNumber value="${benefit[component]}" minFractionDigits="2" maxFractionDigits="2" /></td></c:forEach><c:if test="${not sharedReceiptPreview}"><td><fmt:formatNumber value="${benefit.excludedInterest}" minFractionDigits="2" maxFractionDigits="2" /></td></c:if></tr></c:forEach></c:forEach></tbody></table></div></section></c:if></c:if>
