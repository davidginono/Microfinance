<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ include file="../../fragments/header.jspf" %>
<%@ include file="../../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<link rel="stylesheet" href="<c:url value='/css/accounting-vouchers.css' />" />

<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<spring:htmlEscape defaultHtmlEscape="true" />
<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb' />"><a class="erp-page-path__item erp-page-path__link" href="<c:url value='${base}' />"><spring:message code="voucher.register.${voucherType}" /></a><span aria-hidden="true">›</span><span class="erp-page-path__item" aria-current="page"><spring:message code="voucher.title.${voucherType}" /></span></nav>
<div class="erp-page-header" data-aws-page-header><h1 class="erp-page-title"><spring:message code="voucher.title.${voucherType}" /></h1></div>
<div class="accounting-workspace accounting-create-workspace">
<sec:authorize access="@access.has(principal, 'FINANCIAL_REPORTS_VIEW') and @access.has(principal, 'FINANCIAL_REPORTS_CONFIGURE')" var="canEquityVoucher" />
<c:url value="${base}" var="postUrl" />
<spring:message code="voucher.limit" var="voucherLimit" />
<spring:message code="voucher.chooseAccount" var="voucherChooseAccount" />
<spring:message code="voucher.loadError" var="voucherLookupError" />
<spring:message code="voucher.numberLoading" var="voucherNumberLoading" />
<spring:message code="voucher.numberError" var="voucherNumberError" />
<spring:message code="voucher.removeEntry" var="voucherRemoveEntry" />
<spring:message code="accounting.debit" var="voucherDebitLabel" />
<spring:message code="accounting.credit" var="voucherCreditLabel" />
<spring:message code="voucher.amount" var="voucherAmountLabel" />
<spring:message code="voucher.error.balance" var="voucherBalanceError" />
<form:form modelAttribute="voucherForm" method="post" action="${postUrl}" cssClass="accounting-create-form voucher-form" data-voucher-form="true" data-petty-cash="${voucherForm.pettyCash}" data-petty-account="${voucherForm.pettyCash?voucherForm.moneyAccountId:''}" data-new-voucher="${newVoucherForm eq true}" data-remove-entry-label="${voucherRemoveEntry}" data-debit-label="${voucherDebitLabel}" data-credit-label="${voucherCreditLabel}" data-amount-label="${voucherAmountLabel} (TZS)" data-balance-error="${voucherBalanceError}" data-kind="${voucherType}" data-base="${postUrl}" data-limit="${voucherLimit}" data-choose-account="${voucherChooseAccount}" data-lookup-error="${voucherLookupError}" data-number-loading="${voucherNumberLoading}" data-number-error="${voucherNumberError}" data-number-csrf-header="${_csrf.headerName}" data-number-csrf-token="${_csrf.token}">
<form:hidden path="requestKey" /><form:hidden path="pettyCash" /><form:hidden path="equity" />
<c:if test="${not empty voucherForm.payoffRefundId}"><form:hidden path="payoffRefundId" /></c:if>
<div class="accounting-error-summary" role="alert" tabindex="-1"><form:errors path="*" element="p" cssClass="coa-error" /></div>
<section class="accounting-form accounting-create-card"><h2><c:choose><c:when test="${not empty activeSaccoName}"><c:out value="${activeSaccoName}" /></c:when><c:otherwise><spring:message code="voucher.information" /></c:otherwise></c:choose></h2>
<div class="accounting-grid">
<div class="voucher-field" data-voucher-activities data-max-activities="${maxVoucherActivities}">
    <form:hidden path="receiptPurpose" data-receipt-purpose="true" />
    <label id="voucher-activities-label"><spring:message code="voucher.activities" /></label>
    <div class="voucher-activity-list" data-voucher-activity-list role="group" aria-labelledby="voucher-activities-label">
        <c:set var="activityField" value="${not empty voucherForm.activityId and empty voucherForm.activityIds?'activityId':'activityIds'}" />
        <c:forEach items="${voucherActivityIds}" var="activityId">
            <c:set var="activity" value="${voucherActivities[activityId]}" />
            <%@ include file="activity-row.jspf" %>
        </c:forEach>
    </div>
    <c:set var="activityId" value="" /><c:set var="activity" value="${null}" /><c:set var="activityField" value="activityIds" />
    <template data-voucher-activity-template><%@ include file="activity-row.jspf" %></template>
    <div class="voucher-account-choice" data-voucher-primary-activity ${not empty voucherActivityIds?'hidden':''}>
        <select id="voucher-type" class="aws-control" data-voucher-type data-voucher-select data-searchable="true" aria-labelledby="voucher-activities-label"><option value=""><spring:message code="voucher.chooseActivity" /></option><option value="OTHER"><spring:message code="voucher.manual" /></option><c:if test="${canEquityVoucher and not voucherForm.pettyCash}"><option value="EQUITY"><spring:message code="voucher.equity" /></option></c:if><c:if test="${voucherType=='RECEIPT' and canLoanReceipt}"><option value="LOAN_REPAYMENT"><spring:message code="receipt.purpose.LOAN_REPAYMENT" /></option></c:if></select>
    </div>
    <div class="voucher-account-choice" data-voucher-extra-activity ${empty voucherActivityIds?'hidden':''}>
        <select id="voucher-add-activity" class="aws-control" data-voucher-add-activity data-voucher-select data-searchable="true" aria-label="<spring:message code='voucher.addActivity' />"><option value=""><spring:message code="voucher.addActivity" /></option></select>
    </div>
    <form:errors path="activityId" cssClass="coa-error" /><form:errors path="activityIds" cssClass="coa-error" />
</div>
<%@ include file="equity-fields.jspf" %>
<label><spring:message code="voucher.date" /><input id="voucher-effective-date" name="effectiveDate" type="date" class="aws-control" value="<c:out value='${voucherForm.effectiveDate}' />" required /><form:errors path="effectiveDate" cssClass="coa-error" /></label>
<div class="voucher-field"><label for="voucher-branch"><spring:message code="voucher.branch" /></label><select id="voucher-branch" class="aws-control" data-assigned-voucher-branch><c:if test="${not empty headerStation}"><option value="<c:out value='${headerStation.stationId}' />" selected><c:out value="${not empty headerStation.stationAddressLocation ? headerStation.stationAddressLocation : headerStation.stationId}" /></option></c:if></select></div>
<div class="voucher-field"><label><spring:message code="voucher.number" /></label><span class="voucher-number-output" data-voucher-number role="status" aria-live="polite"><span class="app-loading-spinner" data-loading-size="small" data-voucher-number-spinner aria-hidden="true" hidden></span><span data-voucher-number-value></span></span><button type="button" class="app-btn btn-neutral voucher-number-retry" data-retry-voucher-number hidden><spring:message code="voucher.numberRetry" /></button></div>
<c:if test="${voucherType!='JOURNAL'}"><label data-other-only ${voucherForm.receiptPurpose eq 'LOAN_REPAYMENT'?'hidden':''}><spring:message code="${voucherType=='RECEIPT'?'voucher.receivedFrom':'voucher.paidTo'}" /><form:input path="party" cssClass="aws-control" maxlength="160" required="required" /><form:errors path="party" cssClass="coa-error" /></label></c:if>
<div class="voucher-field"><label for="voucher-client-choose"><span data-other-only><spring:message code="voucher.client" /></span><span data-loan-only><spring:message code="orgFunding.borrower" /></span></label><div class="voucher-account-choice"><form:hidden path="clientId" /><span data-account-label hidden><c:choose><c:when test="${not empty loanLabels[voucherForm.clientId]}"><c:out value="${loanLabels[voucherForm.clientId]}" /></c:when><c:when test="${not empty voucherClient}"><c:out value="${voucherClient.name}" /> · <c:out value="${voucherClient.number}" /></c:when><c:otherwise><spring:message code="voucher.noClient" /></c:otherwise></c:choose></span><select class="aws-control" id="voucher-client-choose" aria-label="<spring:message code='recording.client' />" data-voucher-client data-payer-required="${loanPayerRequired eq true}" data-choice-for="clientId" data-voucher-select data-searchable="true"><option value=""><spring:message code="voucher.choose" /></option></select><button type="button" class="app-btn btn-neutral" data-client-clear data-other-only><spring:message code="common.clear" /></button></div><form:errors path="clientId" cssClass="coa-error" /></div>
<c:if test="${voucherType=='RECEIPT'}"><label data-loan-payer ${loanPayerRequired eq true?'':'hidden'}><spring:message code="voucher.receivedFrom" /><form:input path="loanPayer" cssClass="aws-control" maxlength="160" disabled="${loanPayerRequired ne true}" /><form:errors path="loanPayer" cssClass="coa-error" /></label></c:if>
<c:if test="${voucherType!='JOURNAL'}"><div class="voucher-field" data-header-money-account><label><spring:message code="${voucherType=='RECEIPT'?'accounting.debit':'accounting.credit'}" /> · <spring:message code="voucher.moneyAccount" /></label><div class="voucher-account-choice"><form:hidden path="moneyAccountId" /><span data-account-label hidden><c:choose><c:when test="${not empty selectedAccounts[voucherForm.moneyAccountId]}"><c:out value="${selectedAccounts[voucherForm.moneyAccountId].code}" /> · <c:out value="${selectedAccounts[voucherForm.moneyAccountId].name}" /></c:when><c:otherwise><spring:message code="voucher.chooseAccount" /></c:otherwise></c:choose></span><select class="aws-control" data-account-for="moneyAccountId" data-money-only aria-label="<spring:message code='voucher.moneyAccount' />" data-voucher-select data-searchable="true"><option value=""><spring:message code="voucher.choose" /></option></select></div><form:errors path="moneyAccountId" cssClass="coa-error" /></div></c:if>
</div>
<details class="accounting-additional" ${not empty voucherForm.description or not empty voucherForm.evidence?'open':''}><summary><spring:message code="coa.additionalSettings" /></summary><div class="accounting-grid"><label><spring:message code="voucher.description" /><form:textarea path="description" rows="2" maxlength="500" cssClass="aws-control" /></label><label><spring:message code="voucher.evidence" /><form:input path="evidence" maxlength="500" cssClass="aws-control" /></label></div></details>
</section>
<section class="accounting-form accounting-create-card"><div class="voucher-toolbar"><h2><spring:message code="voucher.transactions" /></h2><button type="button" class="app-btn btn-neutral" data-add-row><spring:message code="voucher.addTransaction" /></button></div>
<c:if test="${voucherType=='RECEIPT'}"><p class="voucher-help" data-loan-only><spring:message code="receipt.loanHelp" /></p></c:if>
<div data-voucher-rows><c:forEach items="${voucherForm.rows}" var="r" varStatus="s"><fieldset class="voucher-row" data-voucher-row><legend><spring:message code="voucher.transaction" /> <span data-row-number>${s.index+1}</span></legend>
<div class="voucher-row-tools erp-form-row-tools"><span data-configured-transactions><select class="aws-control" data-mapping data-other-only aria-label="<spring:message code='voucher.transaction' />" data-voucher-select data-searchable="true"><option value=""><spring:message code="voucher.chooseTransaction" /></option></select></span><button class="app-btn btn-neutral erp-icon-btn erp-form-row-action" type="button" data-remove-row aria-label="<spring:message code='voucher.remove' />" title="<spring:message code='voucher.remove' />"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12" /></svg></button></div>
<form:hidden path="rows[${s.index}].transactionId" /><form:hidden path="rows[${s.index}].templateKey" /><form:hidden path="rows[${s.index}].component" />
<c:set var="mapping" value="${voucherMappings[s.index]}" />
<p class="voucher-help" data-mapping-label data-activity-id="<c:out value='${mapping.activity.id}' />" hidden><c:choose><c:when test="${not empty mapping}"><c:out value="${pageContext.response.locale.language=='sw' and not empty mapping.activity.nameSw?mapping.activity.nameSw:mapping.activity.name}" /> · <c:out value="${mapping.transactionName}" /> · <c:out value="${mapping.debit.name}" /> → <c:out value="${mapping.credit.name}" /></c:when><c:when test="${not empty r.transactionId}"><spring:message code="voucher.mappingSelected" /> · <spring:message code="library.component.${r.component}" /></c:when></c:choose></p>
<div class="accounting-grid"><c:if test="${voucherType=='RECEIPT'}"><div class="voucher-field" data-loan-only><label><spring:message code="loan.loanId" /></label><div class="voucher-account-choice"><form:hidden path="rows[${s.index}].loanId" /><span data-account-label hidden><c:out value="${loanLabels[r.loanId]}" /></span><select class="aws-control" data-loan-choice="loans" data-choice-for="rows[${s.index}].loanId" aria-label="<spring:message code='loan.loanId' />" data-voucher-select data-searchable="true"><option value=""><spring:message code="voucher.choose" /></option></select></div><form:errors path="rows[${s.index}].loanId" cssClass="coa-error" /></div></c:if><label><spring:message code="voucher.description" /><c:choose>
    <c:when test="${voucherForm.receiptPurpose eq 'LOAN_REPAYMENT'}"><form:input path="rows[${s.index}].description" cssClass="aws-control" maxlength="500" /></c:when>
    <c:otherwise><form:input path="rows[${s.index}].description" cssClass="aws-control" maxlength="500" required="required" /></c:otherwise>
</c:choose><form:errors path="rows[${s.index}].description" cssClass="coa-error" /></label>
<label data-transaction-amount><spring:message code="voucher.amount" /> (TZS)<form:input path="rows[${s.index}].amount" type="${empty voucherActivityIds and voucherForm.receiptPurpose ne 'LOAN_REPAYMENT' and empty r.transactionId?'hidden':'number'}" data-amount-input="${not empty voucherActivityIds or voucherForm.receiptPurpose eq 'LOAN_REPAYMENT' or not empty r.transactionId}" min="0.01" max="9999999999999999.99" step="0.01" inputmode="decimal" cssClass="aws-control" required="required" /></label><form:errors path="rows[${s.index}].amount" cssClass="coa-error" />
<form:hidden path="rows[${s.index}].debitAccountId" data-posting-label="${selectedAccounts[r.debitAccountId].code} ${selectedAccounts[r.debitAccountId].name}" /><form:hidden path="rows[${s.index}].creditAccountId" data-posting-label="${selectedAccounts[r.creditAccountId].code} ${selectedAccounts[r.creditAccountId].name}" />
</div>
<div data-manual-accounts data-split-editor>
<div data-split-list><c:forEach items="${r.entries}" var="entry" varStatus="es"><div class="voucher-split-entry accounting-grid" data-split-entry>
    <div class="voucher-field"><label><spring:message code="accounting.${entry.side=='DEBIT'?'debit':'credit'}" /></label><div class="voucher-account-choice"><form:hidden path="rows[${s.index}].entries[${es.index}].side" data-entry-side="true" /><form:hidden path="rows[${s.index}].entries[${es.index}].accountId" />
    <span data-account-label hidden><c:out value="${selectedAccounts[entry.accountId].code}" /> · <c:out value="${selectedAccounts[entry.accountId].name}" /></span>
    <select class="aws-control" data-account-for="rows[${s.index}].entries[${es.index}].accountId" data-entry-account data-voucher-select data-searchable="true" aria-label="<spring:message code='accounting.${entry.side=="DEBIT"?"debit":"credit"}' />"><option value=""><spring:message code="voucher.choose" /></option></select></div></div>
    <label><spring:message code="voucher.amount" /> (TZS)<form:input path="rows[${s.index}].entries[${es.index}].amount" type="number" data-amount-input="true" min="0.01" max="9999999999999999.99" step="0.01" inputmode="decimal" required="required" cssClass="aws-control" /><form:errors path="rows[${s.index}].entries[${es.index}].amount" cssClass="coa-error" /></label>
    <button type="button" class="app-btn btn-neutral erp-icon-btn" data-remove-entry aria-label="${voucherRemoveEntry}" title="${voucherRemoveEntry}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
</div></c:forEach></div>
<div class="voucher-split-totals" data-split-totals hidden aria-live="polite"><span><spring:message code="accounting.debit" /> (TZS): <output data-debit-total>0.00</output></span><span><spring:message code="accounting.credit" /> (TZS): <output data-credit-total>0.00</output></span><p class="coa-error" data-balance-error hidden><spring:message code="voucher.error.balance" /></p></div>
<div class="accounting-actions"><button type="button" class="app-btn btn-neutral" data-add-entry="DEBIT"><spring:message code="voucher.addDebit" /></button><button type="button" class="app-btn btn-neutral" data-add-entry="CREDIT"><spring:message code="voucher.addCredit" /></button></div>
<form:errors path="rows[${s.index}].entries*" cssClass="coa-error" />
</div><form:errors path="rows[${s.index}].transactionId" cssClass="coa-error" />
</fieldset></c:forEach></div>
<p class="voucher-total"><spring:message code="voucher.total" /> (TZS): <output data-live-total>0.00</output></p><p class="voucher-help" data-row-status role="status"></p>
</section>
<c:if test="${not empty loanPreview}"><section data-resource-table="accounting-vouchers-form-1" class="accounting-form accounting-create-card erp-table-wrap" data-voucher-preview data-aws-no-titlebar="true"><h2><spring:message code="voucher.preview" /></h2><div class="erp-table-scroll"><table data-table-sort-mode="none" data-table-sort-reason="editor" class="erp-table"><thead><tr><th><spring:message code="loan.loanId" /></th><th><spring:message code="recording.principal" /> (TZS)</th><th><spring:message code="recording.interest" /> (TZS)</th><th><spring:message code="charges.title" /> (TZS)</th><th><spring:message code="recording.balanceAfter" /> (TZS)</th></tr></thead><tbody><c:forEach items="${loanPreview}" var="r"><tr><td><c:out value="${r.loanNumber}" /></td><td><fmt:formatNumber value="${r.principal}" minFractionDigits="2" maxFractionDigits="2" /><c:if test="${r.feesRecovered gt 0}"><small class="block"><spring:message code="batch.feesRecovered" /> · <fmt:formatNumber value="${r.feesRecovered}" minFractionDigits="2" maxFractionDigits="2" /></small></c:if></td><td><fmt:formatNumber value="${r.interest}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${r.charges}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${r.principalBalance}" minFractionDigits="2" maxFractionDigits="2" /></td></tr></c:forEach></tbody></table></div></section></c:if>
<c:set var="sharedReceiptRows" value="${loanPreview}" /><c:set var="sharedReceiptPreview" value="true" /><%@ include file="shared-benefits.jspf" %>
<c:if test="${not empty preview}"><section data-resource-table="accounting-vouchers-form-2" class="accounting-form accounting-create-card erp-table-wrap" data-voucher-preview data-aws-table-region><h2><spring:message code="voucher.preview" /></h2><p><spring:message code="voucher.previewHelp" /></p><div class="erp-table-scroll"><table data-table-sort-mode="none" data-table-sort-reason="editor" class="erp-table"><thead><tr><th>#</th><th><spring:message code="accounting.debit" /></th><th><spring:message code="accounting.credit" /></th><th><spring:message code="voucher.amount" /> (TZS)</th></tr></thead><tbody><c:forEach items="${preview.rows}" var="r"><c:forEach items="${r.postings()}" var="entry"><tr><td>${r.lineNo}</td><td><c:if test="${entry.side=='DEBIT'}"><c:out value="${entry.account.code}" /> · <c:out value="${entry.account.name}" /></c:if></td><td><c:if test="${entry.side=='CREDIT'}"><c:out value="${entry.account.code}" /> · <c:out value="${entry.account.name}" /></c:if></td><td><fmt:formatNumber value="${entry.amount}" minFractionDigits="2" maxFractionDigits="2" /></td></tr></c:forEach></c:forEach></tbody></table></div><p class="voucher-preview-status"><span data-resource-status="SUCCESS" role="status"><spring:message code="voucher.balanced" /></span></p></section></c:if>
<div class="console-message" data-message-type="error" data-voucher-balance-error role="alert" hidden><spring:message code="voucher.balanceError" /></div>
<div class="accounting-actions accounting-form-actions"><a class="app-btn btn-neutral" data-native-navigation href="<c:url value='${base}' />"><spring:message code="common.cancel" /></a><c:if test="${approvalRequired}"><button class="app-btn btn-neutral" name="action" value="draft" formnovalidate><spring:message code="approval.saveDraft" /></button></c:if><button class="app-btn btn-neutral" name="action" value="preview"><spring:message code="voucher.preview" /></button><button class="app-btn btn-launch" name="action" value="post"><span data-other-only><spring:message code="${approvalRequired ? 'approval.capture' : 'voucher.post.'.concat(voucherType)}" /></span><span data-loan-only hidden><spring:message code="voucher.post.${voucherType}" /></span></button></div>
</form:form></div>
<%@ include file="../accounting-form-support.jspf" %>
<script src="<c:url value='/js/voucher-selects.js' />" defer></script>
<script src="<c:url value='/js/voucher-balance.js' />" defer></script>
<script src="<c:url value='/js/accounting-vouchers.js' />" defer></script>
<c:if test="${voucherType=='RECEIPT'}"><%@ include file="../batches/messages.jspf" %><script src="<c:url value='/js/receipt-batches.js' />" defer></script></c:if>
<%@ include file="../../fragments/footer.jspf" %>
