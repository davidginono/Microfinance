<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ include file="../../fragments/header.jspf" %>
<%@ include file="../../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<link rel="stylesheet" href="<c:url value='/css/accounting-vouchers.css' />" />
<nav class="erp-page-path"><a href="<c:url value='${base}' />"><spring:message code="voucher.register.RECEIPT" /></a><span aria-hidden="true">›</span><span aria-current="page"><c:out value="${voucher.number}" /></span></nav>
<div class="erp-page-header erp-detail-header" data-aws-page-header><h1 class="erp-page-title"><c:out value="${voucher.number}" /></h1><div class="accounting-actions" data-aws-action-pin="true"><sec:authorize access="@access.has(principal,'FINANCIAL_REPORTS_EXPORT') and @access.has(principal,'LOAN_RECORDING_EXPORT')"><a class="app-btn btn-neutral" href="<c:url value='${base}/${voucher.id}/pdf' />"><spring:message code="voucher.pdf" /></a><a class="app-btn btn-neutral" data-print-action="true" href="<c:url value='${base}/${voucher.id}/print' />"><spring:message code="voucher.print" /></a></sec:authorize></div></div>
<div class="accounting-workspace"><c:if test="${voucherPosted}"><p class="voucher-success" role="status"><spring:message code="voucher.posted" /></p></c:if>
<section class="voucher-document"><div class="voucher-document-header"><div><h2><spring:message code="voucher.title.RECEIPT" /></h2><p class="voucher-institution"><c:out value="${voucher.institutionName}" /></p><p><c:out value="${voucher.branchName}" /></p></div><div><strong><c:out value="${voucher.number}" /></strong><p><spring:message code="receipt.purpose.LOAN_REPAYMENT" /></p><span class="voucher-status"><spring:message code="voucher.status.${voucher.status()}" /></span></div></div>
<dl class="voucher-metadata"><div><dt><spring:message code="voucher.receivedFrom" /></dt><dd><c:out value="${voucher.party}" /></dd></div><div><dt><spring:message code="voucher.print.clientNumber" /></dt><dd><c:out value="${receipt.clientNumber}" /></dd></div><div><dt><spring:message code="voucher.date" /></dt><dd><c:out value="${voucher.effectiveDate}" /></dd></div><div><dt><spring:message code="voucher.reference" /></dt><dd><c:out value="${voucher.reference}" /></dd></div><div><dt><spring:message code="voucher.moneyAccount" /></dt><dd><c:out value="${receipt.rows[0].moneyAccount}" /></dd></div><div><dt><spring:message code="voucher.postedBy" /></dt><dd><c:out value="${voucher.postedByName}" /> · <c:out value="${voucher.postedAt}" /></dd></div></dl>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th>#</th><th><spring:message code="loan.loanId" /></th><th><spring:message code="voucher.description" /></th><th><spring:message code="recording.principal" /> (TZS)</th><th><spring:message code="recording.interest" /> (TZS)</th><th><spring:message code="voucher.amount" /> (TZS)</th><th><spring:message code="recording.balanceAfter" /> (TZS)</th></tr></thead><tbody><c:forEach items="${receipt.rows}" var="r"><tr><td>${r.lineNo}</td><td><a href="<c:url value='/finance/loan-records/${r.loanId}' />"><c:out value="${r.loanNumber}" /></a></td><td><c:out value="${r.description}" /><p><c:out value="${r.reference}" /></p></td><td class="voucher-numeric"><fmt:formatNumber value="${r.principal}" minFractionDigits="2" maxFractionDigits="2" /></td><td class="voucher-numeric"><fmt:formatNumber value="${r.interest}" minFractionDigits="2" maxFractionDigits="2" /></td><td class="voucher-numeric"><fmt:formatNumber value="${r.amount}" minFractionDigits="2" maxFractionDigits="2" /></td><td class="voucher-numeric"><fmt:formatNumber value="${r.principalBalance}" minFractionDigits="2" maxFractionDigits="2" /></td></tr></c:forEach></tbody></table></div>
<div class="voucher-document-total"><span><spring:message code="voucher.total" /> (TZS)</span><strong><fmt:formatNumber value="${voucher.total}" minFractionDigits="2" maxFractionDigits="2" /></strong></div>
<p><c:out value="${voucher.description}" /></p><p><spring:message code="voucher.evidence" />: <c:out value="${voucher.evidence}" /></p>
<c:if test="${not empty voucher.reversesId}"><p><spring:message code="voucher.reversal" />: <a href="<c:url value='${base}/${voucher.reversesId}' />"><c:out value="${voucher.reversesId}" /></a></p></c:if><c:if test="${not empty voucher.reversedBy}"><p><spring:message code="voucher.reversal" />: <a href="<c:url value='${base}/${voucher.reversedBy}' />"><c:out value="${voucher.reversedBy}" /></a></p></c:if></section>
<c:if test="${empty voucher.reversesId and empty voucher.reversedBy and canReverseLoanReceipt}"><sec:authorize access="@access.has(principal,'ACCOUNTING_BUSINESS_REVERSE') and @access.has(principal,'LOAN_RECORDING_REVERSE')"><section class="accounting-form"><details><summary><spring:message code="voucher.reverse" /></summary><p class="voucher-help"><spring:message code="receipt.reverseHelp" /></p><c:if test="${not empty reverseError}"><p class="coa-error" role="alert"><spring:message code="${reverseError}" /></p></c:if><form method="post" action="<c:url value='${base}/${voucher.id}/reverse' />"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="requestKey" value="${reverseKey}" /><div class="accounting-grid"><label><spring:message code="voucher.date" /><input type="date" class="aws-control" name="effectiveDate" value="<c:out value='${today}' />" required /></label><label><spring:message code="voucher.reason" /><input class="aws-control" name="reason" maxlength="500" value="<c:out value='${reason}' />" required /></label></div><div class="accounting-actions"><button class="app-btn btn-primary"><spring:message code="voucher.reverse" /></button></div></form></details></section></sec:authorize></c:if>
</div><%@ include file="loan-charge-details.jspf" %>
<%@ include file="../../fragments/footer.jspf" %>
