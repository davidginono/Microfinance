<nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb' />"><a class="erp-page-path__item erp-page-path__link" href="<c:url value='/finance/payroll' />"><spring:message code="payroll.title" /></a><span aria-hidden="true">&rsaquo;</span><a class="erp-page-path__item erp-page-path__link" href="<c:url value='/finance/payroll/${batch.id}' />"><c:out value="${batch.reference}" /></a><span aria-hidden="true">&rsaquo;</span><c:if test="${not empty feedbackPageTitle}"><a class="erp-page-path__item erp-page-path__link" href="<c:url value='/finance/payroll/${batch.id}/feedback' />"><spring:message code="payroll.feedback.title" /></a><span aria-hidden="true">&rsaquo;</span></c:if><span aria-current="page"><spring:message code="${empty feedbackPageTitle?'payroll.feedback.title':feedbackPageTitle}" /></span></nav>
