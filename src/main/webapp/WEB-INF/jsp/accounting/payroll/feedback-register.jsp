<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../../fragments/header.jspf" %><%@ include file="../../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<%@ include file="feedback-path.jspf" %>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="payroll.feedback.title" /></h1></div>
<div class="accounting-workspace"><section class="erp-table-wrap" data-resource-table="payroll-feedback"><div class="app-table-titlebar"><h2><c:out value="${batch.employer}" /></h2><div class="accounting-actions"><c:if test="${batch.state=='SENT'}"><sec:authorize access="@access.has(principal,'PAYROLL_DEDUCTIONS_IMPORT')"><a class="app-btn btn-launch" href="<c:url value='/finance/payroll/${batch.id}/feedback/new' />"><spring:message code="payroll.feedback.import" /></a></sec:authorize></c:if></div></div>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><c:forEach items="${['file','date','actor','rows','total']}" var="column"><c:url value="/finance/payroll/${batch.id}/feedback" var="sortUrl"><c:param name="sort" value="${column}" /><c:param name="direction" value="${sort==column and direction=='asc'?'desc':'asc'}" /></c:url><th aria-sort="${sort==column?(direction=='asc'?'ascending':'descending'):'none'}"><a data-table-sort href="<c:out value='${sortUrl}' />"><spring:message code="payroll.feedback.register.${column}" /></a></th></c:forEach></tr></thead><tbody>
<c:forEach items="${records.rows}" var="row"><tr><td><a class="resource-table-id-link" href="<c:url value='/finance/payroll/${batch.id}/feedback/${row.id}' />"><c:out value="${row.filename}" /></a></td><td><c:out value="${appTime:display(row.createdAt)}" /></td><td><c:out value="${row.actor}" /></td><td><c:out value="${row.rows}" /></td><td><fmt:formatNumber value="${row.total}" minFractionDigits="2" maxFractionDigits="2" /></td></tr></c:forEach>
<c:if test="${empty records.rows}"><tr><td colspan="5"><spring:message code="payroll.empty" /></td></tr></c:if></tbody></table></div>
<div data-table-pagination data-page="${records.page}" data-table-for="payroll-feedback"><c:forEach items="${['previous','next']}" var="move"><c:if test="${move=='previous'?records.page>0:records.hasNext}"><c:url value="/finance/payroll/${batch.id}/feedback" var="pageUrl"><c:param name="sort" value="${sort}" /><c:param name="direction" value="${direction}" /><c:param name="page" value="${records.page+(move=='previous'?-1:1)}" /></c:url><a data-page-direction="${move}" href="<c:out value='${pageUrl}' />"><spring:message code="common.${move}" /></a></c:if></c:forEach></div>
</section></div><%@ include file="../../fragments/footer.jspf" %>
