<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ include file="../../fragments/header.jspf" %>
<template data-resource-details-page></template><%@ include file="../../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" />
<%@ include file="feedback-path.jspf" %>
<div class="erp-page-header"><h1 class="erp-page-title"><spring:message code="payroll.feedback.title" /></h1><div class="accounting-actions"><c:if test="${feedback.receiptBatchId!=null}"><sec:authorize access="@access.has(principal,'ACCOUNTING_BUSINESS_VIEW') and @access.has(principal,'LOAN_RECORDING_VIEW')"><a class="app-btn btn-neutral" href="<c:url value='/finance/batches/receipts/${feedback.receiptBatchId}' />"><spring:message code="payroll.feedback.receipts" /></a></sec:authorize></c:if></div></div>
<div class="accounting-workspace"><%@ include file="error.jspf" %>
<c:if test="${remittance!=null}"><section class="erp-resource-section"><h2><spring:message code="payroll.feedback.remittance" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="payroll.feedback.account" /></dt><dd><c:out value="${remittance.account}" /></dd></div><div><dt><spring:message code="payroll.feedback.receivedDate" /></dt><dd><c:out value="${appTime:date(remittance.date)}" /></dd></div><div><dt><spring:message code="payroll.feedback.receivedAmount" /></dt><dd>TZS <fmt:formatNumber value="${remittance.amount}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="payroll.feedback.bankReference" /></dt><dd><c:out value="${remittance.reference}" /></dd></div><div><dt><spring:message code="payroll.feedback.bankEvidence" /></dt><dd><c:out value="${remittance.evidence}" /></dd></div></dl></section></c:if>
<section class="erp-resource-section"><h2><c:out value="${feedback.filename}" /></h2><dl class="erp-detail-facts"><div><dt><spring:message code="payroll.employer" /></dt><dd><c:out value="${batch.employer}" /></dd></div><div><dt><spring:message code="payroll.createdBy" /></dt><dd><c:out value="${feedback.actor}" /></dd></div><div><dt><spring:message code="payroll.column.date" /></dt><dd><c:out value="${appTime:display(feedback.createdAt)}" /></dd></div><div><dt><spring:message code="payroll.feedback.rows" /></dt><dd><c:out value="${feedback.rows}" /></dd></div><div><dt><spring:message code="payroll.feedback.deducted" /></dt><dd>TZS <fmt:formatNumber value="${feedback.total}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="payroll.feedback.source" /></dt><dd><c:out value="${feedback.evidence}" /></dd></div></dl><p><spring:message code="payroll.feedback.noMoney" /></p></section>
<section class="erp-table-wrap" data-resource-table="payroll-results"><div class="app-table-titlebar"><h2><spring:message code="payroll.feedback.results" /></h2></div><div class="erp-table-scroll"><table class="erp-table"><thead><tr><c:forEach items="${['employee','client','status','requested','deducted','date','employerReference','posting']}" var="column"><th data-table-order="${column}"><spring:message code="payroll.feedback.column.${column}" /></th></c:forEach></tr></thead><tbody>
<c:forEach items="${records.rows}" var="row"><tr><td><c:out value="${row.employee}" /></td><td><c:out value="${row.clientName}" /></td><td><span data-resource-status="${row.status}"><spring:message code="payroll.feedback.state.${row.status}" /></span></td><td><fmt:formatNumber value="${row.requested}" minFractionDigits="2" maxFractionDigits="2" /></td><td><fmt:formatNumber value="${row.amount}" minFractionDigits="2" maxFractionDigits="2" /></td><td><c:out value="${appTime:date(row.date)}" /></td><td><c:out value="${row.employerReference}" /></td><td><c:choose><c:when test="${row.receiptId!=null}"><sec:authorize access="@access.has(principal,'ACCOUNTING_BUSINESS_VIEW') and @access.has(principal,'LOAN_RECORDING_VIEW')" var="canReadReceipt" /><c:choose><c:when test="${canReadReceipt}"><a class="resource-table-id-link" href="<c:url value='/finance/vouchers/receipts/${row.receiptId}' />"><spring:message code="payroll.feedback.posting.${row.postingState}" /></a></c:when><c:otherwise><spring:message code="payroll.feedback.posting.${row.postingState}" /></c:otherwise></c:choose></c:when><c:otherwise><spring:message code="payroll.feedback.posting.${row.postingState}" /></c:otherwise></c:choose></td></tr></c:forEach>
</tbody></table></div><div data-table-pagination data-page="${records.page}" data-table-for="payroll-results"><c:forEach items="${['previous','next']}" var="move"><c:if test="${move=='previous'?records.page>0:records.hasNext}"><a data-page-direction="${move}" href="<c:url value='/finance/payroll/${batch.id}/feedback/${feedback.id}?page=${records.page+(move=="previous"?-1:1)}' />"><spring:message code="common.${move}" /></a></c:if></c:forEach></div></section>
<c:if test="${feedback.receiptBatchId==null and feedback.total>0}"><sec:authorize access="@access.has(principal,'PAYROLL_DEDUCTIONS_POST') and @access.has(principal,'ACCOUNTING_BUSINESS_CREATE') and @access.has(principal,'ACCOUNTING_BUSINESS_VIEW') and @access.has(principal,'LOAN_RECORDING_POST') and @access.has(principal,'LOAN_RECORDING_VIEW')">
<form:form modelAttribute="remittanceForm" method="post" action="${pageContext.request.contextPath}/finance/payroll/${batch.id}/feedback/${feedback.id}/prepare" cssClass="accounting-create-form mt-4"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" />
<section class="erp-resource-section"><h2><spring:message code="payroll.feedback.remittance" /></h2><div class="grid gap-4">
<p><spring:message code="payroll.feedback.prepareHelp" /></p>
<div data-loan-choice data-choice-url="<c:url value='/finance/payroll/${batch.id}/feedback/money' />"><label class="grid gap-2"><spring:message code="payroll.feedback.account" /><form:select path="moneyAccountId" cssClass="aws-control" data-choice-select="true" required="required"><option value=""><spring:message code="payroll.select" /></option><c:if test="${selectedMoney!=null}"><form:option value="${selectedMoney.id}"><c:out value="${selectedMoney.label}" /></form:option></c:if></form:select><form:errors path="moneyAccountId" cssClass="coa-error" /></label><span data-choice-error role="status" data-search-label="<spring:message code='common.search' />" data-error="<spring:message code='payroll.error.lookup' />"></span></div>
<label class="grid gap-2"><spring:message code="payroll.feedback.receivedDate" /><form:input path="receivedDate" type="date" max="${today}" cssClass="aws-control" required="required" /><form:errors path="receivedDate" cssClass="coa-error" /></label>
<label class="grid gap-2"><spring:message code="payroll.feedback.receivedAmount" /> (TZS)<form:input path="receivedAmount" type="number" min="0.01" step="0.01" cssClass="aws-control" required="required" /><form:errors path="receivedAmount" cssClass="coa-error" /></label>
<label class="grid gap-2"><spring:message code="payroll.feedback.bankReference" /><form:input path="reference" maxlength="80" cssClass="aws-control" required="required" /></label>
<label class="grid gap-2"><spring:message code="payroll.feedback.bankEvidence" /><form:textarea path="evidence" maxlength="500" rows="3" cssClass="aws-control" required="required" /></label>
<label><form:checkbox path="verified" required="required" /> <spring:message code="payroll.feedback.verified" /></label>
</div></section><div class="accounting-actions accounting-form-actions"><button class="app-btn btn-launch"><spring:message code="payroll.feedback.prepare" /></button></div></form:form><%@ include file="../accounting-form-support.jspf" %><script src="<c:url value='/js/loan-recording.js' />" defer></script>
</sec:authorize></c:if></div><%@ include file="../../fragments/footer.jspf" %>
