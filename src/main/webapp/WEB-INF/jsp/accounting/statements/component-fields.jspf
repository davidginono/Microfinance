<div class="fs-fields">
<label><spring:message code="fs.setup.name" /><input class="aws-control" name="components[${rowIndex}].name" value="<c:out value='${row.name}' />" maxlength="100" required /></label>
<label><spring:message code="fs.setup.nameSw" /><input class="aws-control" name="components[${rowIndex}].nameSw" value="<c:out value='${row.nameSw}' />" maxlength="100" /></label>
<label class="fs-full"><spring:message code="fs.setup.accounts" /><input class="aws-control" name="components[${rowIndex}].accounts" value="<c:out value='${row.accounts}' />" maxlength="20000" required aria-describedby="fs-account-hint" /></label>
<label class="fs-full fs-setup-check"><span><input type="checkbox" name="components[${rowIndex}].retained" value="true" ${row.retained?'checked':''} /><spring:message code="fs.setup.retained" /></span></label>
</div>
<div class="fs-setup-actions">
<button type="button" class="app-btn btn-neutral erp-icon-btn" data-setup-move="-1" aria-label="<spring:message code='fs.setup.up' />" title="<spring:message code='fs.setup.up' />"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 7-7 7 7M12 19V5" /></svg></button>
<button type="button" class="app-btn btn-neutral erp-icon-btn" data-setup-move="1" aria-label="<spring:message code='fs.setup.down' />" title="<spring:message code='fs.setup.down' />"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 7 7 7-7M12 5v14" /></svg></button>
<button type="button" class="app-btn btn-neutral erp-icon-btn" data-setup-remove aria-label="<spring:message code='fs.setup.remove' />" title="<spring:message code='fs.setup.remove' />"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
</div>
