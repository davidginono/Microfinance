<%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<script src="<c:url value='/js/statement-setup.js' />" defer></script>
<div class="accounting-workspace">
<%@ include file="feedback.jspf" %>
<c:if test="${not empty errorKey}"><div class="accounting-error-summary" role="alert"><spring:message code="${errorKey}" /></div></c:if>
<section class="erp-table-wrap" data-aws-table-region data-resource-table="equity-movements" data-table-selection="single" data-equity-movements>
<div class="app-table-titlebar"><h2 class="erp-page-title"><spring:message code="fs.movements" /></h2>
<form id="equity-classify" method="post" action="<c:url value='/reports/financial/statements/movements' />" data-equity-classify data-workspace-submit>
<input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" /><input type="hidden" name="journal" value="<c:out value='${selectedJournal}' />" /><input type="hidden" name="version" value="<c:out value='${selectedVersion}' />" /><input type="hidden" name="from" value="${from}" /><input type="hidden" name="through" value="${through}" /><input type="hidden" name="page" value="${page}" />
<label><spring:message code="fs.setup.category" /><select class="aws-control" name="category" required><c:forEach items="${categories}" var="category"><option value="${category}" ${selectedCategory==category?'selected':''}><spring:message code="fs.movement.${category}" /></option></c:forEach></select></label>
<label><spring:message code="fs.setup.reason" /><input class="aws-control" name="reason" value="<c:out value='${reason}' />" maxlength="500" required /></label>
</form><div data-table-toolbar-for="equity-movements"><button class="app-btn btn-neutral" type="submit" form="equity-classify" disabled data-table-command data-equity-save><spring:message code="fs.setup.saveCategory" /></button></div></div>
<form class="erp-table-toolbar" method="get" action="<c:url value='/reports/financial/statements/movements' />"><label><spring:message code="fs.from" /><input class="aws-control" type="date" name="from" value="${from}" required /></label><label><spring:message code="fs.through" /><input class="aws-control" type="date" name="through" value="${through}" required /></label><button class="app-btn btn-neutral"><spring:message code="fs.apply" /></button></form>
<div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="financial-statement"><thead><tr><th><spring:message code="fs.setup.select" /></th><th><spring:message code="fs.date" /></th><th><spring:message code="fs.reference" /></th><th><spring:message code="fs.description" /></th><th><spring:message code="fs.debit" /> (TZS)</th><th><spring:message code="fs.credit" /> (TZS)</th><th><spring:message code="fs.setup.category" /></th></tr></thead><tbody><c:forEach items="${journals}" var="j"><tr><td class="resource-table-selection"><input type="checkbox" data-equity-select value="${j.id}" data-version="${j.version}" data-category="${j.category}" aria-label="<c:out value='${j.reference}' /> — <c:out value='${j.description}' />" /></td><td>${appTime:display(j.date)}</td><td><c:out value="${j.reference}" /></td><td><c:out value="${j.description}" /></td><td><c:out value="${j.debit}" /></td><td><c:out value="${j.credit}" /></td><td><spring:message code="fs.movement.${j.category}" /></td></tr></c:forEach><c:if test="${empty journals}"><tr><td colspan="7"><span class="resource-table-empty-message"><spring:message code="fs.noRows" /></span></td></tr></c:if></tbody></table></div>
<div data-table-pagination data-page="${page}" data-table-for="equity-movements"><c:if test="${page>0}"><a data-page-direction="previous" href="<c:url value='/reports/financial/statements/movements?page=${page-1}&amp;from=${from}&amp;through=${through}' />"><spring:message code="fs.previousPage" /></a></c:if><span>${page+1}</span><c:if test="${hasNext}"><a data-page-direction="next" href="<c:url value='/reports/financial/statements/movements?page=${page+1}&amp;from=${from}&amp;through=${through}' />"><spring:message code="fs.nextPage" /></a></c:if></div>
<p class="sr-only" aria-live="polite" data-equity-selection-status></p>
</section></div><%@ include file="../../fragments/footer.jspf" %>
