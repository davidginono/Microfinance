<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<div class="accounting-workspace"><h1 class="erp-page-title" data-aws-page-header><spring:message code="fs.mappings" /></h1>
 <section class="erp-table-wrap" data-aws-table-region data-resource-table="statement-mappings" data-table-selection="single">
  <div class="app-table-titlebar"><h2><spring:message code="fs.accounts" /></h2></div>
  <form class="erp-table-toolbar" method="get" action="<c:url value='/reports/financial/statements/mappings' />"><input type="hidden" name="sort" value="${sort}" /><input type="hidden" name="direction" value="${direction}" /><label class="erp-table-toolbar__search"><spring:message code="fs.search" /><input class="aws-control" name="search" maxlength="100" value="<c:out value='${search}' />" /></label><button class="app-btn btn-neutral"><spring:message code="fs.apply" /></button></form>
  <div class="erp-table-scroll"><table class="erp-table"><thead><tr><c:forTokens items="code,name,line,section" delims="," var="column"><c:url value="/reports/financial/statements/mappings" var="sortUrl"><c:param name="search" value="${search}" /><c:param name="sort" value="${column}" /><c:param name="direction" value="${sort==column and direction=='asc'?'desc':'asc'}" /></c:url><th aria-sort="${sort==column?(direction=='asc'?'ascending':'descending'):'none'}"><a data-table-sort href="<c:out value='${sortUrl}' />"><spring:message code="fs.heading.${column}" /></a></th></c:forTokens><th data-table-actions-header><spring:message code="fs.open" /></th></tr></thead><tbody><c:forEach items="${accounts}" var="a"><tr><td><c:out value="${a.code}" /></td><td><c:out value="${a.name}" /></td><td><c:out value="${a.mapping.line}" /></td><td><c:choose><c:when test="${empty a.mapping}"><spring:message code="fs.section.UNCLASSIFIED" /></c:when><c:otherwise><spring:message code="fs.section.${a.mapping.section}" /></c:otherwise></c:choose></td><td><sec:authorize access="@access.has(principal, 'ACCOUNTING_ACCOUNTS_UPDATE')"><a href="<c:url value='/reports/financial/statements/mappings/${a.id}' />" class="app-btn btn-neutral"><spring:message code="fs.editMapping" /></a></sec:authorize></td></tr></c:forEach><c:if test="${empty accounts}"><tr><td colspan="5"><spring:message code="fs.noRows" /></td></tr></c:if></tbody></table></div>
  <div data-table-pagination data-page="${page}" data-table-for="statement-mappings"><c:if test="${page>0}"><c:url value="/reports/financial/statements/mappings" var="prev"><c:param name="page" value="${page-1}" /><c:param name="search" value="${search}" /><c:param name="sort" value="${sort}" /><c:param name="direction" value="${direction}" /></c:url><a data-page-direction="previous" href="<c:out value='${prev}' />"><spring:message code="fs.previousPage" /></a></c:if><span>${page+1}</span><c:if test="${hasNext}"><c:url value="/reports/financial/statements/mappings" var="next"><c:param name="page" value="${page+1}" /><c:param name="search" value="${search}" /><c:param name="sort" value="${sort}" /><c:param name="direction" value="${direction}" /></c:url><a data-page-direction="next" href="<c:out value='${next}' />"><spring:message code="fs.nextPage" /></a></c:if></div>
 </section>
</div>
<%@ include file="../../fragments/footer.jspf" %>
