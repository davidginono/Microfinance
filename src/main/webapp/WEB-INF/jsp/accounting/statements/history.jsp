<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="support.jspf" %>
<div class="accounting-workspace"><h1 class="erp-page-title" data-aws-page-header><spring:message code="fs.history" /></h1>
 <section class="erp-table-wrap" data-aws-table-region data-resource-table="statement-history" data-table-selection="single">
  <div class="app-table-titlebar"><h2><spring:message code="fs.statementSets" /></h2><a class="app-btn btn-launch" href="<c:url value='/reports/financial/statements' />"><spring:message code="fs.newSet" /></a></div>
  <form class="erp-table-toolbar" method="get" action="<c:url value='/reports/financial/statements/history' />"><label><spring:message code="fs.sort" /><select class="aws-control" name="sort"><c:forTokens items="newest,oldest,from,from_desc,through,through_desc,status,status_desc" delims="," var="s"><option value="${s}" ${sort==s?'selected':''}><spring:message code="fs.sort.${s}" /></option></c:forTokens></select></label><button class="app-btn btn-neutral"><spring:message code="fs.apply" /></button></form>
  <div class="erp-table-scroll"><table class="erp-table"><thead><tr><c:forTokens items="from,through,generated,status" delims="," var="column"><c:set var="descending" value="${column}_desc" /><c:set var="targetSort" value="${sort==column?descending:column}" /><c:set var="ariaSort" value="${sort==column?'ascending':sort==descending?'descending':'none'}" /><c:if test="${column=='generated'}"><c:set var="targetSort" value="${sort=='newest'?'oldest':'newest'}" /><c:set var="ariaSort" value="${sort=='newest'?'descending':sort=='oldest'?'ascending':'none'}" /></c:if><c:url value="/reports/financial/statements/history" var="sortUrl"><c:param name="sort" value="${targetSort}" /></c:url><th aria-sort="${ariaSort}"><a data-table-sort href="<c:out value='${sortUrl}' />"><spring:message code="fs.${column}" /></a></th></c:forTokens><th data-table-actions-header><spring:message code="fs.open" /></th></tr></thead><tbody><c:forEach items="${runs}" var="r"><tr><td>${r.from}</td><td>${r.through}</td><td><c:out value="${appTime:format(r.generated)}" /></td><td><spring:message code="${r.saved?'fs.saved':'fs.preview'}" /></td><td><a class="app-btn btn-neutral" href="<c:url value='/reports/financial/statements/${r.id}' />"><spring:message code="fs.open" /></a></td></tr></c:forEach><c:if test="${empty runs}"><tr><td colspan="5"><spring:message code="fs.noRows" /></td></tr></c:if></tbody></table></div>
  <div data-table-pagination data-page="${page}" data-table-for="statement-history"><c:if test="${page>0}"><a data-page-direction="previous" href="<c:url value='/reports/financial/statements/history?page=${page-1}&amp;sort=${sort}' />"><spring:message code="fs.previousPage" /></a></c:if><span>${page+1}</span><c:if test="${hasNext}"><a data-page-direction="next" href="<c:url value='/reports/financial/statements/history?page=${page+1}&amp;sort=${sort}' />"><spring:message code="fs.nextPage" /></a></c:if></div>
 </section>
</div>
<%@ include file="../../fragments/footer.jspf" %>
