<div id="library-rule-list"><c:forEach items="${ruleForms}" var="rule" varStatus="n"><div class="library-rule accounting-grid">
    <form:hidden path="${rulePrefix}rules[${n.index}].component" />
    <c:if test="${rule.component!='TOTAL'}"><span><spring:message code="library.component.${rule.component}" /></span></c:if>
    <c:forEach items="${['debit','credit']}" var="side"><div class="voucher-field"><label for="library-${side}-${n.index}"><spring:message code="library.${side}Account" /></label>
        <div data-library-account><form:hidden path="${rulePrefix}rules[${n.index}].${side}Code" />
        <c:set var="selectedCode" value="${side=='debit'?rule.debitCode:rule.creditCode}" />
        <span data-library-account-label hidden><c:out value="${selectedCode}" /></span>
        <select id="library-${side}-${n.index}" class="aws-control" data-library-account-select data-url="${accountLookupUrl}" data-searchable="true" data-error="<spring:message code='library.lookupUnavailable' />"><option value=""><spring:message code="voucher.choose" /></option><c:if test="${not empty selectedCode}"><option selected value="<c:out value='${selectedCode}' />"><c:out value="${selectedCode}" /></option></c:if></select></div>
        <form:errors path="${rulePrefix}rules[${n.index}].${side}Code" cssClass="coa-error" /></div></c:forEach>
</div></c:forEach></div>
