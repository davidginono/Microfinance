<div id="library-rule-list"><c:forEach items="${ruleForms}" var="rule" varStatus="n"><div class="library-rule accounting-grid">
    <label><spring:message code="library.component" /><form:select path="${rulePrefix}rules[${n.index}].component" cssClass="aws-control"><c:forEach items="${components}" var="component"><form:option value="${component}"><spring:message code="library.component.${component}" /></form:option></c:forEach></form:select><form:errors path="${rulePrefix}rules[${n.index}].component" cssClass="coa-error" /></label>
    <label><spring:message code="library.debitCode" /><form:input path="${rulePrefix}rules[${n.index}].debitCode" cssClass="aws-control" maxlength="40" list="library-account-codes" data-library-lookup="${accountLookupUrl}" required="required" /><form:errors path="${rulePrefix}rules[${n.index}].debitCode" cssClass="coa-error" /></label>
    <label><spring:message code="library.creditCode" /><form:input path="${rulePrefix}rules[${n.index}].creditCode" cssClass="aws-control" maxlength="40" list="library-account-codes" data-library-lookup="${accountLookupUrl}" required="required" /><form:errors path="${rulePrefix}rules[${n.index}].creditCode" cssClass="coa-error" /></label>
    <button type="button" class="app-btn btn-neutral library-remove erp-icon-btn erp-form-row-action" aria-label="<spring:message code='library.removeRule' />" title="<spring:message code='library.removeRule' />"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
</div></c:forEach></div>
<button type="button" class="app-btn btn-neutral" id="library-add-rule"><spring:message code="library.addRule" /></button>
