<fieldset class="accounting-form-section">
 <legend><spring:message code="coa.reporting" /></legend>
 <div class="accounting-grid">
  <label><spring:message code="coa.cashSection" />
   <form:select path="cashSection" cssClass="aws-control">
    <form:option value=""><spring:message code="coa.inherit" /></form:option>
    <c:if test="${selectedParent.type=='ASSET' or account.type=='ASSET'}"><form:option value="CASH_EQUIVALENTS"><spring:message code="fs.section.CASH_EQUIVALENTS" /></form:option></c:if>
    <c:forEach items="${['OPERATING','INVESTING','FINANCING','UNCLASSIFIED']}" var="category"><form:option value="${category}"><spring:message code="fs.section.${category}" /></form:option></c:forEach>
   </form:select>
  </label>
  <c:choose><c:when test="${selectedParent.type=='EQUITY' or account.type=='EQUITY'}"><label><spring:message code="coa.equityComponent" /><form:input path="equityComponent" cssClass="aws-control" maxlength="100" /><form:errors path="equityComponent" cssClass="coa-error" /></label></c:when><c:otherwise><form:hidden path="equityComponent" /></c:otherwise></c:choose>
 </div>
</fieldset>
