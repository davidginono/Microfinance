<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ include file="../../fragments/header.jspf" %><%@ include file="../../fragments/sidebar.jspf" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-ledger.css' />" /><link rel="stylesheet" href="<c:url value='/css/accounting-vouchers.css' />" />
<div class="accounting-workspace"><section class="erp-table-wrap" data-resource-table="petty-pending" data-table-page-size="${size}"><div class="app-table-titlebar"><h2><spring:message code="petty.pending" /></h2></div>
<form method="get" action="<c:url value='/finance/petty-cash/pending' />" class="voucher-filters"><label><spring:message code="voucher.search" /><input class="aws-control" type="search" name="search" maxlength="100" value="<c:out value='${search}' />" /></label><button class="app-btn btn-neutral"><spring:message code="voucher.filter" /></button><input type="hidden" name="sort" value="<c:out value='${sort}' />" /><input type="hidden" name="size" value="${size}" /></form><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-sort-asc="number_asc" data-table-sort-desc="number_desc"><spring:message code="petty.column.number" /></th><th data-table-sort-asc="state_asc" data-table-sort-desc="state_desc"><spring:message code="petty.column.state" /></th></tr></thead><tbody><c:forEach items="${pending}" var="p"><tr><td><a class="resource-table-id-link" href="<c:url value='/finance/approval/${p.id}' />"><c:out value="${p.number}" /></a></td><td><span data-resource-status="${p.iconState()}"><spring:message code="approval.status.${p.state}" /></span></td></tr></c:forEach><c:if test="${empty pending}"><tr><td colspan="2"><spring:message code="petty.emptyPending" /></td></tr></c:if></tbody></table></div>
<div data-table-pagination data-table-for="petty-pending" data-page="${page}"><c:forEach items="${['previous','next']}" var="move"><c:if test="${move=='previous'?page>0:hasNext}"><c:url value="/finance/petty-cash/pending" var="pageUrl"><c:param name="page" value="${page+(move=='previous'?-1:1)}" /><c:param name="size" value="${size}" /><c:param name="sort" value="${sort}" /><c:param name="search" value="${search}" /></c:url><a data-page-direction="${move}" href="<c:out value='${pageUrl}' />"><spring:message code="common.${move}" /></a></c:if></c:forEach></div>
</section></div><%@ include file="../../fragments/footer.jspf" %>
