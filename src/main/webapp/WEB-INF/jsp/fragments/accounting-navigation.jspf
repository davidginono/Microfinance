<sec:authorize access="@access.canAccessFinanceArea(principal)">
    <sec:authorize access="@access.has(principal, 'ACCOUNTING_POLICY_VIEW')">
        <a href="<c:url value='/accounting/policies' />" class="group flex items-center gap-2.5 border px-2.5 py-2 text-[0.95rem] font-semibold transition lg:gap-3 lg:px-3 lg:py-2.5 lg:text-sm ${fn:startsWith(requestUri, '/accounting/policies') ? 'shell-nav-active border-cyan-200 bg-cyan-50 text-cyan-800' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}">
            <span class="inline-flex h-6 w-6 items-center justify-center border lg:h-7 lg:w-7"><i data-lucide="check" aria-hidden="true"></i></span>
            <spring:message code="policy.title" />
        </a>
    </sec:authorize>
    <sec:authorize access="@access.has(principal, 'REPORT_TEMPLATES_VIEW')">
        <a href="<c:url value='/reports/operational' />" class="group flex items-center gap-2.5 border px-2.5 py-2 text-[0.95rem] font-semibold transition lg:gap-3 lg:px-3 lg:py-2.5 lg:text-sm ${fn:startsWith(requestUri, '/reports/operational') ? 'shell-nav-active border-cyan-200 bg-cyan-50 text-cyan-800' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}">
            <span class="inline-flex h-6 w-6 items-center justify-center border lg:h-7 lg:w-7"><i data-lucide="printer" aria-hidden="true"></i></span>
            <spring:message code="opreport.title" />
        </a>
    </sec:authorize>
</sec:authorize>
