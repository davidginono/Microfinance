<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<!DOCTYPE html>
<html lang="${pageContext.response.locale.language}" translate="no" class="notranslate">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <title><spring:message code="app.title" /></title>
    <link rel="icon" type="image/png" href="<c:url value='/images/computer-resources-logo.png' />" />
    <link rel="stylesheet" href="<c:url value='/css/tailwind.css' />" />
    <style>
        html {
            font-size: 16px;
            overflow-x: clip;
        }
        body {
            background: #eef2f5;
            overflow-x: clip;
            margin: 0;
        }
        :root {
            --shell-light: #18bfd0;
            --shell-light-soft: #15aebd;
            --shell-border: #cfd8df;
            --shell-button: #ffffff;
            --page-bg: #eef2f5;
            --panel-bg: #ffffff;
            --panel-border: #d7dde3;
            --panel-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
            --text-main: #1f2937;
            --text-muted: #64748b;
            --erp-blue: #3b82f6;
            --erp-green: #16a34a;
            --erp-amber: #f59e0b;
            --erp-red: #dc2626;
            --shell-sidebar-width: 248px;
            --shell-content-gap: 14px;
            --shell-content-max: 1320px;
            --shell-nav-height: 3.6rem;
            --shell-topbar-control-height: 2.55rem;
        }
        .text-xs {
            font-size: 0.8rem !important;
        }
        .text-sm {
            font-size: 0.92rem !important;
        }
        .app-btn,
        button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.28rem;
            padding: 0.45rem 0.8rem;
            font-size: 0.76rem;
            font-weight: 600;
            line-height: 1;
            transition: background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, color 0.18s ease, transform 0.18s ease;
            border: 1px solid transparent;
            white-space: nowrap;
        }
        .app-btn:hover,
        button:hover {
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.1);
            transform: translateY(-1px);
            filter: none;
        }
        .app-btn:active,
        button:active {
            box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.08);
            transform: translateY(0);
        }
        .btn-primary,
        .btn-approve,
        .btn-reject,
        .btn-neutral {
            background: #ffffff;
            border-color: #cbd5e1;
            color: #334155;
        }
        .btn-primary:hover,
        .btn-primary:focus-visible {
            background: #f1f8fb;
            border-color: #77b7cf;
            color: #193252;
            filter: none;
        }
        .btn-approve:hover,
        .btn-approve:focus-visible {
            background: #f0fdf4;
            border-color: #9cd5b5;
            color: #166534;
            filter: none;
        }
        .btn-reject:hover,
        .btn-reject:focus-visible {
            background: #fff5f5;
            border-color: #efc0c0;
            color: #9f1239;
            filter: none;
        }
        .btn-neutral:hover,
        .btn-neutral:focus-visible {
            background: #f8fafc;
            border-color: #9fb0c3;
            color: #1f3755;
            filter: none;
        }
        .app-input-sm {
            width: 6.25rem;
            border: 1px solid #b9c6d8;
            border-radius: 0.45rem;
            padding: 0.35rem 0.5rem;
            font-size: 0.78rem;
            color: #1e293b;
            background: #fff;
        }
        .app-input-sm:focus {
            outline: none;
            border-color: #2F348D;
            box-shadow: 0 0 0 2px rgba(47, 52, 141, 0.08);
        }
        .notification-panel {
            opacity: 0;
            pointer-events: none;
            transform: translateY(-8px);
            transition: opacity 0.18s ease, transform 0.18s ease;
        }
        .profile-panel {
            opacity: 0;
            pointer-events: none;
            transform: translateY(-8px);
            transition: opacity 0.18s ease, transform 0.18s ease;
        }
        .notification-panel.is-open {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }
        .profile-panel.is-open {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }
        .erp-dropdown {
            border: 1px solid var(--panel-border);
            border-radius: 0.4rem;
            background: #ffffff;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
            overflow: hidden;
        }
        .erp-dropdown-header {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: flex-start;
            gap: 0.75rem;
            padding: 0.8rem 0.95rem 0.7rem;
            border-bottom: 1px solid #e5e7eb;
            background: #f8fafc;
        }
        .erp-dropdown-heading {
            min-width: 0;
        }
        .erp-dropdown-title {
            color: #1f2937;
            font-size: 0.95rem;
            font-weight: 700;
            line-height: 1.2;
        }
        .erp-dropdown-subtitle {
            margin-top: 0.15rem;
            color: #64748b;
            font-size: 0.78rem;
            line-height: 1.35;
        }
        .erp-dropdown-link {
            display: inline-flex;
            align-items: center;
            justify-content: flex-end;
            white-space: nowrap;
            flex-shrink: 0;
            color: #334155;
            font-size: 0.76rem;
            font-weight: 700;
            line-height: 1.2;
        }
        .erp-notification-body {
            max-height: 22rem;
            overflow-y: auto;
            padding: 0.75rem;
        }
        .erp-notification-empty {
            border-radius: 0.4rem;
            border: 1px dashed #dbe3ec;
            padding: 1.5rem 1rem;
            text-align: center;
            font-size: 0.92rem;
            line-height: 1.45;
            color: #64748b;
            background: #ffffff;
        }
        .erp-notification-panel {
            width: min(21rem, calc(100vw - 1rem));
            max-width: calc(100vw - 1rem);
        }
        .erp-icon-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: var(--shell-topbar-control-height);
            height: var(--shell-topbar-control-height);
            padding: 0;
            border: 1px solid rgba(255,255,255,0.55);
            border-radius: 0.28rem;
            background: rgba(255,255,255,0.96);
            color: #475569;
            font-size: 1rem;
            line-height: 1;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
            transition: background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
        }
        .erp-icon-btn:hover {
            background: #f8fafc;
            box-shadow: 0 2px 4px rgba(15, 23, 42, 0.1);
        }
        .erp-topbar-btn {
            height: var(--shell-topbar-control-height);
            padding-top: 0;
            padding-bottom: 0;
        }
        .shell-powered-by {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.2rem;
            margin-top: 0.45rem;
            color: #18bfd0;
        }
        .shell-powered-by-label {
            color: #64748b;
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            white-space: nowrap;
        }
        .shell-powered-by-logo {
            width: 10.8rem;
            height: auto;
            max-width: 100%;
            flex-shrink: 0;
            display: block;
        }
        .shell-powered-by-logo text {
            fill: #18bfd0;
        }
        .erp-icon-btn svg {
            width: 1.2rem;
            height: 1.2rem;
            flex-shrink: 0;
        }
        @media (max-width: 768px) {
            :root {
                --shell-topbar-control-height: 2.35rem;
            }
            .erp-icon-btn {
                width: var(--shell-topbar-control-height);
                height: var(--shell-topbar-control-height);
            }
            .erp-icon-btn svg {
                width: 1.08rem;
                height: 1.08rem;
            }
            .erp-notification-panel {
                position: fixed;
                top: calc(var(--shell-nav-height) + 0.5rem);
                left: 50%;
                right: auto;
                width: min(22rem, calc(100vw - 1rem));
                max-width: calc(100vw - 1rem);
            }
            .notification-panel.erp-notification-panel {
                transform: translate(-50%, -8px);
            }
            .notification-panel.erp-notification-panel.is-open {
                transform: translate(-50%, 0);
            }
            .erp-notification-panel .erp-dropdown-header {
                grid-template-columns: minmax(0, 1fr);
                gap: 0.7rem;
                padding: 0.9rem 1rem 0.85rem;
            }
            .erp-notification-panel .erp-dropdown-link {
                justify-content: center;
                width: fit-content;
                min-width: 5.25rem;
                padding: 0.42rem 0.7rem;
                border: 1px solid #cbd5e1;
                border-radius: 0.32rem;
                background: #ffffff;
                box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
            }
            .erp-notification-panel .erp-dropdown-subtitle {
                max-width: 26ch;
            }
            .erp-notification-body {
                max-height: min(20rem, calc(100vh - var(--shell-nav-height) - 5.5rem));
                padding: 0.85rem;
            }
            .erp-notification-empty {
                padding: 2rem 1rem;
            }
        }
        @media (max-width: 480px) {
            :root {
                --shell-topbar-control-height: 2.2rem;
            }
            .erp-icon-btn {
                width: var(--shell-topbar-control-height);
                height: var(--shell-topbar-control-height);
            }
            .erp-icon-btn svg {
                width: 1rem;
                height: 1rem;
            }
        }
        @media (max-width: 374px) {
            :root {
                --shell-topbar-control-height: 2rem;
            }
            .erp-icon-btn {
                width: var(--shell-topbar-control-height);
                height: var(--shell-topbar-control-height);
            }
            .erp-icon-btn svg {
                width: 0.92rem;
                height: 0.92rem;
            }
            .erp-mobile-compact {
                gap: 0.35rem !important;
            }
            .erp-mobile-compact .app-btn {
                padding: 0.45rem 0.6rem;
                font-size: 0.72rem;
            }
            .erp-notification-panel {
                width: calc(100vw - 0.75rem);
                max-width: calc(100vw - 0.75rem);
            }
        }
        .erp-page-header,
        .erp-page-header-sticky {
            margin-bottom: 0.9rem;
        }
        .erp-page-header p {
            margin: 0;
        }
        .shell-page-title-rail {
            position: fixed;
            top: var(--shell-nav-height);
            left: 0;
            width: 100%;
            z-index: 38;
            pointer-events: none;
            opacity: 0;
            transform: translateY(-6px);
            transition: opacity 0.18s ease, transform 0.18s ease;
        }
        .shell-page-title-rail.is-active {
            opacity: 1;
            transform: translateY(0);
        }
        .shell-page-title-rail__inner {
            width: var(--shell-content-max);
            max-width: calc(100vw - 2rem);
            margin-left: var(--shell-page-title-left, auto);
            margin-right: auto;
            padding: 0.58rem 0 0.48rem;
            border-bottom: 1px solid rgba(207, 216, 223, 0.96);
            background: linear-gradient(180deg, rgba(238, 242, 245, 0.82) 0%, rgba(238, 242, 245, 0.68) 100%);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .shell-page-title-rail__text {
            margin: 0;
            color: var(--text-main);
            font-family: Sora, ui-sans-serif, system-ui;
            font-size: 1.32rem;
            font-weight: 700;
            line-height: 1.15;
            letter-spacing: 0.01em;
        }
        .erp-page-kicker {
            color: #64748b;
            font-size: 0.74rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }
        .erp-page-title {
            margin-top: 0.25rem;
            color: var(--text-main);
            font-family: Sora, ui-sans-serif, system-ui;
            font-size: 1.55rem;
            font-weight: 700;
            line-height: 1.2;
        }
        .erp-page-heading {
            margin-top: 0.35rem;
            color: var(--text-main);
            font-family: Sora, ui-sans-serif, system-ui;
            font-size: 1.9rem;
            font-weight: 700;
            line-height: 1.18;
        }
        .erp-page-subtitle {
            margin-top: 0.35rem;
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.45;
        }
        .erp-panel {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            border-radius: 0.4rem;
            box-shadow: var(--panel-shadow);
        }
        .erp-panel-header {
            padding: 0.85rem 1rem;
            border-bottom: 1px solid var(--panel-border);
            background: #f8fafc;
        }
        .erp-panel-title {
            color: var(--text-main);
            font-size: 0.9rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }
        .erp-panel-body {
            padding: 1rem;
        }
        .admin-filter-form input,
        .admin-filter-form select,
        .admin-filter-form .neo-select-button,
        .admin-filter-form .app-btn,
        .erp-filter-form input,
        .erp-filter-form select,
        .erp-filter-form .neo-select-button,
        .erp-filter-form .app-btn,
        .erp-filter-form button {
            min-height: 2.75rem;
        }
        .admin-filter-form input,
        .admin-filter-form select,
        .admin-filter-form .neo-select-button,
        .erp-filter-form input,
        .erp-filter-form select,
        .erp-filter-form .neo-select-button {
            padding-top: 0.7rem;
            padding-bottom: 0.7rem;
        }
        .admin-filter-form .app-btn,
        .erp-filter-form .app-btn,
        .erp-filter-form button {
            min-width: 6.5rem;
        }
        .erp-widget-title {
            color: var(--text-muted);
            font-size: 0.74rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }
        .erp-widget-heading {
            color: var(--text-main);
            font-family: Sora, ui-sans-serif, system-ui;
            font-size: 1.15rem;
            font-weight: 700;
            line-height: 1.25;
        }
        .erp-stat-grid {
            display: grid;
            gap: 0.8rem;
            grid-template-columns: repeat(1, minmax(0, 1fr));
        }
        @media (min-width: 768px) {
            .erp-stat-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }
        @media (min-width: 1280px) {
            .erp-stat-grid {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }
        }
        .erp-stat-card {
            border: 1px solid var(--panel-border);
            border-radius: 0.35rem;
            color: #ffffff;
            overflow: hidden;
        }
        .erp-stat-main {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.95rem 1rem 0.8rem;
        }
        .erp-stat-label {
            font-size: 0.74rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            opacity: 0.92;
        }
        .erp-stat-value {
            margin-top: 0.35rem;
            font-size: 1.7rem;
            font-weight: 800;
            line-height: 1;
        }
        .erp-stat-meta {
            margin-top: 0.25rem;
            font-size: 0.8rem;
            opacity: 0.92;
        }
        .erp-stat-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2rem;
            height: 2rem;
            border-radius: 0.35rem;
            background: rgba(255,255,255,0.18);
        }
        .erp-stat-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.5rem 1rem;
            border-top: 1px solid rgba(255,255,255,0.18);
            background: rgba(0,0,0,0.08);
            font-size: 0.78rem;
            font-weight: 700;
        }
        .erp-stat-blue { background: linear-gradient(180deg, #3c8ef0 0%, #2563eb 100%); }
        .erp-stat-green { background: linear-gradient(180deg, #30b85f 0%, #15803d 100%); }
        .erp-stat-amber { background: linear-gradient(180deg, #f6b83d 0%, #d97706 100%); }
        .erp-stat-red { background: linear-gradient(180deg, #ef6b63 0%, #dc2626 100%); }
        .erp-content-grid {
            display: grid;
            gap: 0.9rem;
            grid-template-columns: minmax(0, 1fr);
        }
        @media (min-width: 1280px) {
            .erp-content-grid {
                grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.95fr);
            }
        }
        .erp-table-wrap {
            background: #ffffff;
            border: 1px solid var(--panel-border);
            border-radius: 0.4rem;
            box-shadow: var(--panel-shadow);
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
        }
        .erp-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.86rem;
        }
        .erp-table thead {
            background: #f8fafc;
        }
        .erp-table th,
        .erp-table td {
            padding: 0.7rem 0.85rem;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
            vertical-align: top;
        }
        .erp-table th {
            color: #475569;
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }
        .erp-form-wrap {
            background: #ffffff;
            border: 1px solid var(--panel-border);
            border-radius: 0.4rem;
            box-shadow: var(--panel-shadow);
            padding: 1rem;
        }
        .erp-section {
            background: #ffffff;
            border: 1px solid var(--panel-border);
            border-radius: 0.4rem;
            padding: 0.9rem 1rem;
        }
        .erp-section-muted {
            background: #f8fafc;
            border: 1px solid var(--panel-border);
            border-radius: 0.4rem;
            padding: 0.9rem 1rem;
        }
        .erp-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 0.55rem;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.9rem;
        }
        .erp-breadcrumb {
            color: #64748b;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .erp-filter-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.45rem;
        }
        .erp-filter-tab {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 2rem;
            padding: 0.45rem 0.8rem;
            border: 1px solid #cbd5e1;
            border-radius: 0.32rem;
            background: #ffffff;
            color: #334155;
            font-size: 0.76rem;
            font-weight: 700;
            line-height: 1;
            transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
        }
        .erp-filter-tab:hover {
            background: #f8fafc;
            border-color: #94a3b8;
        }
        .erp-filter-tab.is-active {
            background: #e0f2fe;
            border-color: #7dd3fc;
            color: #0f172a;
        }
        @keyframes toast-in {
            0% {
                opacity: 0;
                transform: translateY(-14px) scale(0.96);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        @keyframes toast-out {
            0% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            100% {
                opacity: 0;
                transform: translateY(-10px) scale(0.96);
            }
        }
        .app-toast-enter {
            animation: toast-in 220ms ease-out;
        }
        .app-toast-exit {
            animation: toast-out 180ms ease-in forwards;
        }
        .app-toast-success {
            border-color: #bbf7d0;
            background: #f0fdf4;
            color: #166534;
        }
        .app-toast-error {
            border-color: #fecaca;
            background: #fff1f2;
            color: #b91c1c;
        }
        .app-toast-info {
            border-color: #bfdbfe;
            background: #eff6ff;
            color: #1d4ed8;
        }
        @media (max-width: 1024px) {
            .erp-page-title {
                font-size: 1.35rem;
            }
            .erp-page-subtitle {
                font-size: 0.86rem;
            }
            .shell-page-title-rail__inner {
                padding: 0.52rem 0 0.42rem;
            }
            .shell-page-title-rail__text {
                font-size: 1.14rem;
            }
            .erp-page-heading {
                font-size: 1.7rem;
            }
            .erp-table th,
            .erp-table td {
                padding: 0.6rem 0.7rem;
            }
            .erp-stat-value {
                font-size: 1.45rem;
            }
        }
        .shell-sidebar {
            width: 232px;
            overflow: hidden;
            background: linear-gradient(180deg, #dff1fb 0%, #cfe8f8 100%);
        }
        .shell-sidebar::before,
        .shell-sidebar::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
        }
        .shell-sidebar::before {
            background:
                linear-gradient(145deg,
                    rgba(255,255,255,0.32) 0%,
                    rgba(255,255,255,0.32) 24%,
                    transparent 24%,
                    transparent 46%,
                    rgba(255,255,255,0.14) 46%,
                    rgba(255,255,255,0.14) 60%,
                    transparent 60%,
                    transparent 100%);
        }
        .shell-sidebar::after {
            background:
                radial-gradient(circle at left bottom, rgba(111, 193, 241, 0.36) 0%, rgba(111, 193, 241, 0.16) 38%, rgba(111, 193, 241, 0) 74%),
                linear-gradient(25deg,
                    rgba(95, 176, 230, 0.24) 0%,
                    rgba(95, 176, 230, 0.24) 18%,
                    transparent 18%,
                    transparent 40%,
                    rgba(95, 176, 230, 0.12) 40%,
                    rgba(95, 176, 230, 0.12) 61%,
                    transparent 61%,
                    transparent 100%);
        }
        .shell-sidebar-panel {
            position: relative;
            z-index: 1;
        }
        .shell-sidebar-scroll {
            position: relative;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: none;
            -ms-overflow-style: none;
            overscroll-behavior: contain;
            padding-top: 0 !important;
        }
        .shell-sidebar-scroll::-webkit-scrollbar {
            width: 0;
            height: 0;
            display: none;
        }
        .shell-sidebar-section-header {
            padding-top: 0.42rem !important;
            padding-bottom: 0.42rem !important;
            border-radius: 0.42rem;
            border-color: rgba(214, 226, 238, 0.92) !important;
            background: rgba(255, 255, 255, 0.82) !important;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
            backdrop-filter: blur(2px);
        }
        .shell-sidebar-group {
            padding-top: 0 !important;
            padding-bottom: 0 !important;
            border-radius: 0 !important;
            border-color: transparent !important;
            background: transparent !important;
            box-shadow: none !important;
            backdrop-filter: none !important;
        }
        .shell-sidebar-scroll > a {
            gap: 0.68rem !important;
            padding: 0.58rem 0.72rem !important;
            font-size: 0.9rem !important;
        }
        .shell-sidebar-scroll > a > span {
            width: 1.55rem !important;
            height: 1.55rem !important;
        }
        .shell-sidebar-scroll > a > span svg {
            width: 0.92rem !important;
            height: 0.92rem !important;
        }
        .shell-sidebar-scroll > a,
        .shell-sidebar-scroll > button,
        .shell-sidebar-scroll > div > button {
            border-radius: 0.3rem;
            border-color: rgba(214, 226, 238, 0.95) !important;
            background: rgba(255, 255, 255, 0.96) !important;
            color: #304764 !important;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
        }
        .shell-sidebar-scroll > a:hover,
        .shell-sidebar-scroll > a:focus-visible,
        .shell-sidebar-scroll > button:hover,
        .shell-sidebar-scroll > button:focus-visible,
        .shell-sidebar-scroll > div > button:hover,
        .shell-sidebar-scroll > div > button:focus-visible {
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.1);
            transform: translateY(-1px);
        }
        .shell-sidebar-scroll > a:active,
        .shell-sidebar-scroll > button:active,
        .shell-sidebar-scroll > div > button:active {
            box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.08);
            transform: translateY(0);
        }
        .shell-sidebar-scroll > a > span:first-child,
        .shell-sidebar-scroll > button > span:first-child,
        .shell-sidebar-scroll > div > button > span:first-child {
            border-radius: 0.25rem;
            border-color: #d7e3ef !important;
            background: #ffffff !important;
            color: #516680 !important;
        }
        #memberArchivePanel > a,
        #adminSaccoPanel > a {
            border-radius: 0.25rem;
        }
        #memberArchivePanel > a:hover,
        #memberArchivePanel > a:focus-visible,
        #adminSaccoPanel > a:hover,
        #adminSaccoPanel > a:focus-visible {
            background: rgba(255, 255, 255, 0.72);
        }
        @media (min-width: 1024px) {
            .shell-sidebar-scroll > a {
                gap: 0.72rem !important;
                padding: 0.6rem 0.82rem !important;
                font-size: 0.88rem !important;
            }
            .shell-sidebar-scroll > a > span {
                width: 1.62rem !important;
                height: 1.62rem !important;
            }
        }
        .shell-main {
            width: 100%;
            max-width: 100%;
            padding-left: 1rem;
            padding-right: 1rem;
            overflow-x: clip;
        }
        .shell-content-frame {
            width: 100%;
            max-width: var(--shell-content-max);
            overflow-x: visible;
        }
        @media (min-width: 1024px) {
            .shell-sidebar {
                width: var(--shell-sidebar-width);
            }
            .shell-main {
                padding-left: calc(var(--shell-sidebar-width) + var(--shell-content-gap)) !important;
                padding-right: 2rem !important;
            }
        }
        @media (min-width: 2560px) {
            :root {
                --shell-sidebar-width: 272px;
                --shell-content-gap: 18px;
                --shell-content-max: 1760px;
            }
            html {
                font-size: 17px;
            }
        }
        @media (min-width: 3840px) {
            :root {
                --shell-sidebar-width: 296px;
                --shell-content-gap: 22px;
                --shell-content-max: 2200px;
            }
            html {
                font-size: 18px;
            }
        }
        :where(input:not([type="checkbox"]):not([type="radio"]):not([type="range"]), select, textarea) {
            border-radius: 0.32rem !important;
        }
    </style>
<%@ include file="select-enhancer.jspf" %>
</head>
<body class="min-h-screen font-sans text-sacco-ink antialiased" style="background: var(--page-bg); overflow-x: clip;">
<div class="min-h-screen w-full max-w-full" style="background: var(--page-bg); overflow-x: clip;">
<nav id="shellTopNav" class="fixed inset-x-0 top-0 z-50 border-b shadow-sm" style="min-height: var(--shell-nav-height); border-color: #8fbfdf; background: linear-gradient(145deg, rgba(255,255,255,0.24) 0%, rgba(255,255,255,0.24) 23%, rgba(255,255,255,0) 23%), linear-gradient(180deg, #abd5ef 0%, #8fc5e7 100%);">
    <div class="flex items-center justify-between gap-2 px-2.5 py-2 sm:gap-3 sm:px-3 lg:px-4">
        <div class="flex min-w-0 items-center gap-2 sm:gap-2.5">
            <button id="sidebarToggle" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded border text-slate-800 shadow-sm hover:bg-slate-50 lg:hidden" style="border-color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.96);" aria-label="Open menu">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
            <a href="${(currentMember.position eq 'ADMIN' or currentMember.position eq 'MINOR_ADMIN') ? '/admin/dashboard' : (currentMember.position eq 'MANAGER' ? '/manager/loan-applications?status=READY_FOR_MANAGER' : (currentMember.position eq 'LOAN_OFFICER' ? '/loan-officer/queue' : (currentMember.position eq 'BOARD' ? '/board/queue' : (currentMember.position eq 'ACCOUNTANT' ? '/accountant/loan-applications?filter=AWAITING_ACCOUNTANT' : (currentMember.position eq 'DISBURSEMENT_OFFICER' ? '/disbursement/loan-applications?filter=READY_FOR_DISBURSEMENT' : '/app/dashboard')))))}" class="inline-flex min-w-0 items-center gap-2 sm:gap-2.5">
                <c:choose>
                    <c:when test="${not empty activeSaccoLogoUrl}">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded border border-white/35 bg-white/95 shadow-sm sm:h-9 sm:w-9">
                            <img src="${activeSaccoLogoUrl}"
                                 alt="${not empty activeSaccoName ? activeSaccoName : 'SACCO'} logo"
                                 class="h-full w-full object-contain p-1" />
                        </span>
                    </c:when>
                    <c:otherwise>
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded border border-white/35 bg-white/95 text-[0.62rem] font-bold uppercase tracking-[0.16em] text-slate-800 shadow-sm sm:h-9 sm:w-9 sm:text-[0.68rem]">
                            ${activeSaccoLogoText}
                        </span>
                    </c:otherwise>
                </c:choose>
                <div class="min-w-0 leading-tight">
                    <p class="truncate font-display text-[0.92rem] font-semibold tracking-tight text-white sm:text-base">
                        <c:choose>
                            <c:when test="${not empty activeSaccoName}">${activeSaccoName}</c:when>
                            <c:otherwise><spring:message code="app.title" /></c:otherwise>
                        </c:choose>
                    </p>
                    <p class="hidden text-[11px] font-semibold uppercase tracking-[0.17em] text-cyan-50/90 md:block">
                        <c:choose>
                            <c:when test="${not empty activeSaccoId}">${activeSaccoId} · Loan Management System</c:when>
                            <c:otherwise><spring:message code="app.title" /></c:otherwise>
                        </c:choose>
                    </p>
                </div>
            </a>
        </div>

        <div class="erp-mobile-compact flex shrink-0 items-center gap-1.5 sm:gap-2 lg:gap-3">
            <sec:authorize access="hasAnyRole('ADMIN','MINOR_ADMIN')">
                <c:if test="${not isPlatformAdminIdentity and not empty adminScope}">
                    <div class="hidden min-[520px]:flex max-w-[13rem] items-center gap-2 rounded-md border border-white/35 bg-white/10 px-2.5 py-1.5 text-white shadow-sm lg:max-w-[15rem] xl:max-w-[18rem]">
                        <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-white/15 text-cyan-50">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2l8 4v8l-8 4-8-4V6l8-4zm0 2.236L4 7v6l6 3 6-3V7l-6-2.764z"/></svg>
                        </span>
                        <div class="min-w-0">
                            <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-cyan-50/85"><spring:message code="header.currentStation" text="Current Station" /></p>
                            <p class="truncate text-xs font-semibold text-white">${adminScope.stationId}</p>
                            <p class="truncate text-[10px] font-medium text-cyan-50/85">${adminScope.stationAddressLocation}</p>
                        </div>
                    </div>
                    <div class="flex min-[520px]:hidden items-center rounded-md border border-white/35 bg-white/10 px-2.5 py-1 text-[11px] font-semibold text-white shadow-sm">
                        ${adminScope.stationId}
                    </div>
                </c:if>
            </sec:authorize>
            <div class="relative">
                <button id="notificationToggle" type="button" class="erp-icon-btn" aria-label="<spring:message code='notifications.title' text='Notifications' />">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10 2a4 4 0 00-4 4v1.172c0 .53-.211 1.039-.586 1.414L4.293 9.707A1 1 0 004 10.414V12a2 2 0 002 2h8a2 2 0 002-2v-1.586a1 1 0 00-.293-.707l-1.121-1.121A2 2 0 0114 7.172V6a4 4 0 00-4-4zm0 16a2.5 2.5 0 002.45-2h-4.9A2.5 2.5 0 0010 18z"/>
                    </svg>
                </button>
                <c:if test="${notificationCount gt 0}">
                    <span class="pointer-events-none absolute -right-1 -top-1 z-10 inline-flex min-h-[1.1rem] min-w-[1.1rem] items-center justify-center rounded-full bg-red-500 px-1 text-[10px] font-bold leading-none text-white shadow-sm sm:-right-1.5 sm:-top-1.5 sm:min-h-[1.35rem] sm:min-w-[1.35rem] sm:text-[11px] max-[374px]:min-h-[1rem] max-[374px]:min-w-[1rem] max-[374px]:text-[9px]">
                        <c:choose>
                            <c:when test="${notificationCount gt 99}">99+</c:when>
                            <c:otherwise>${notificationCount}</c:otherwise>
                        </c:choose>
                    </span>
                </c:if>
                <div id="notificationPanel" class="notification-panel erp-dropdown erp-notification-panel absolute right-0 top-[calc(100%+0.55rem)] z-50">
                    <div class="erp-dropdown-header">
                        <div class="erp-dropdown-heading">
                            <p class="erp-dropdown-title"><spring:message code="notifications.title" text="Notifications" /></p>
                            <p class="erp-dropdown-subtitle">${notificationPanelSubtitle}</p>
                        </div>
                        <a href="${notificationTargetUrl}" class="erp-dropdown-link"><spring:message code="common.viewAll" text="View all" /></a>
                    </div>
                    <div class="erp-notification-body space-y-2">
                        <c:choose>
                            <c:when test="${not empty headerNotifications}">
                                <c:forEach items="${headerNotifications}" var="notification">
                                    <c:url var="headerNotificationHref" value="${notificationTargetUrl}${fn:contains(notificationTargetUrl, '?') ? '&amp;' : '?'}highlight=${notification.id}#notification-${notification.id}" />
                                    <c:if test="${not empty currentMember and (currentMember.position eq 'ADMIN' or currentMember.position eq 'MINOR_ADMIN') and notification.incidentId ne null}">
                                        <c:url var="headerNotificationHref" value="/admin/notifications/${notification.id}/open" />
                                    </c:if>
                                    <a href="${headerNotificationHref}" class="block rounded-md border px-3 py-3 transition hover:border-slate-300 hover:bg-slate-50 ${notification.unread ? 'border-slate-300 bg-slate-50' : 'border-slate-200 bg-white'}">
                                        <div class="flex items-start justify-between gap-3">
                                            <div>
                                                <p class="text-sm font-semibold text-slate-800">${notification.subject}</p>
                                                <p class="mt-1 text-xs text-slate-600">${notification.message}</p>
                                            </div>
                                            <span class="shrink-0 rounded-sm border border-slate-200 bg-white px-2 py-1 text-[11px] font-semibold text-slate-600">${notification.source}</span>
                                        </div>
                                        <p class="mt-2 text-[11px] text-slate-400">${notification.createdAtLabel}</p>
                                    </a>
                                </c:forEach>
                            </c:when>
                            <c:otherwise>
                                <div class="erp-notification-empty">${notificationPanelEmptyState}</div>
                            </c:otherwise>
                        </c:choose>
                    </div>
                </div>
            </div>
            <div class="hidden lg:flex items-center px-2 py-0 text-right">
                <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-white">
                        <c:choose>
                            <c:when test="${not empty currentMember and not empty currentMember.fullName}">${currentMember.fullName}</c:when>
                            <c:otherwise><sec:authentication property="principal.username" /></c:otherwise>
                        </c:choose>
                    </p>
                    <p class="mt-0.5 text-xs font-medium text-white/85">
                        <c:choose>
                            <c:when test="${not empty currentMember and currentMember.memberAccess}">
                                <spring:message code="profile.memberNo" />
                            </c:when>
                            <c:otherwise><spring:message code="profile.userId" text="User ID" /></c:otherwise>
                        </c:choose>:
                        <span class="font-semibold text-white"><sec:authentication property="principal.username" /></span>
                    </p>
                </div>
            </div>
            <div class="relative">
                <button id="profileToggle" type="button" class="erp-icon-btn" aria-label="<spring:message code='profile.openDetails' text='Open profile details' />">
                    <svg xmlns="http://www.w3.org/2000/svg" class="text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 21a8 8 0 0 0-16 0"/>
                        <circle cx="12" cy="8" r="4"/>
                    </svg>
                </button>
                <div id="profilePanel" class="profile-panel erp-dropdown absolute right-0 top-[calc(100%+0.55rem)] z-50 w-[16.5rem] max-w-[calc(100vw-1rem)] sm:w-[19rem] max-[374px]:right-[-0.2rem] max-[374px]:w-[15rem]">
                    <div class="erp-dropdown-header">
                        <div class="erp-dropdown-heading">
                            <p class="erp-dropdown-title"><spring:message code="profile.title" text="Profile" /></p>
                            <p class="erp-dropdown-subtitle"><spring:message code="profile.accountDetails" text="Your account details" /></p>
                        </div>
                    </div>
                    <div class="p-3">
                    <div class="flex items-start gap-3">
                        <div class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-sm font-semibold uppercase text-slate-700">
                            <c:choose>
                                <c:when test="${not empty currentMember and not empty currentMember.fullName}">
                                    ${fn:substring(fn:toUpperCase(currentMember.fullName), 0, 1)}
                                </c:when>
                                <c:otherwise>U</c:otherwise>
                            </c:choose>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-semibold text-slate-900">
                                <c:choose>
                                    <c:when test="${not empty currentMember and not empty currentMember.fullName}">${currentMember.fullName}</c:when>
                                    <c:otherwise><sec:authentication property="principal.username" /></c:otherwise>
                                </c:choose>
                            </p>
                            <p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-500"><sec:authentication property="principal.position" /></p>
                            <c:if test="${not empty currentMember and not empty currentMember.email}">
                                <p class="mt-1 truncate text-xs text-slate-500">${currentMember.email}</p>
                            </c:if>
                            <c:if test="${not isPlatformAdminIdentity and not empty adminScope}">
                                <p class="mt-1 text-[11px] font-medium text-slate-500">${adminScope.saccoId} / ${adminScope.stationId}</p>
                            </c:if>
                        </div>
                    </div>
                    <div class="mt-3 grid gap-3 rounded-md border border-slate-200 bg-slate-50 p-3 text-sm">
                        <div class="flex items-center justify-between gap-4">
                            <span class="text-slate-500">
                                <c:choose>
                                    <c:when test="${not empty currentMember and currentMember.memberAccess}">
                                        <spring:message code="profile.memberNo" />
                                    </c:when>
                                    <c:otherwise><spring:message code="profile.userId" text="User ID" /></c:otherwise>
                                </c:choose>
                            </span>
                            <span class="font-semibold text-slate-800"><sec:authentication property="principal.username" /></span>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <span class="text-slate-500"><spring:message code="profile.role" /></span>
                            <span class="font-semibold text-slate-800"><sec:authentication property="principal.position" /></span>
                        </div>
                        <c:if test="${not empty currentMember and currentMember.memberAccess}">
                            <div class="flex items-center justify-between gap-4">
                                <span class="text-slate-500"><spring:message code="profile.memberId" /></span>
                                <span class="font-semibold text-slate-800">${currentMember.memberNo}</span>
                            </div>
                        </c:if>
                    </div>
                    </div>
                </div>
            </div>
            <form action="/logout" method="post" class="m-0 shrink-0">
                <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" />
                <button type="submit" class="app-btn erp-topbar-btn btn-primary px-3 text-[0.78rem] sm:px-4 max-[374px]:px-2.5 max-[374px]:text-[0.72rem]"><spring:message code="nav.logout" /></button>
            </form>
        </div>
    </div>
</nav>
<div id="shellPageTitleRail" class="shell-page-title-rail" aria-hidden="true">
    <div class="shell-page-title-rail__inner">
        <p id="shellPageTitleRailText" class="shell-page-title-rail__text"></p>
    </div>
</div>
<div id="appToastContainer" class="pointer-events-none fixed right-4 top-[calc(var(--shell-nav-height)+0.75rem)] z-[90] flex w-[min(100vw-1rem,24rem)] max-w-full flex-col gap-3 sm:right-5 sm:top-[calc(var(--shell-nav-height)+1rem)]"></div>

<div id="sidebarOverlay" class="fixed inset-0 z-40 hidden bg-slate-900/45 lg:hidden"></div>
<div class="relative min-h-screen" style="padding-top: var(--shell-nav-height); overflow-x: clip;">
<script id="adminScopeOptionsData" type="application/json">${adminScopeOptionsJson}</script>
<script>
    (function () {
        const shellTopNav = document.getElementById('shellTopNav');
        const toastContainer = document.getElementById('appToastContainer');
        const pageTitleRail = document.getElementById('shellPageTitleRail');
        const pageTitleRailText = document.getElementById('shellPageTitleRailText');
        let titleRailTicking = false;
        const syncShellNavHeight = function () {
            if (!shellTopNav) {
                return;
            }
            const measuredHeight = Math.max(Math.ceil(shellTopNav.getBoundingClientRect().height), 58);
            document.documentElement.style.setProperty('--shell-nav-height', measuredHeight + 'px');
        };
        const resolveStickyTitleSource = function () {
            return document.querySelector('[data-sticky-title-source]') || document.querySelector('.erp-page-title');
        };
        const updatePageTitleRail = function () {
            if (!pageTitleRail || !pageTitleRailText) {
                return;
            }
            const source = resolveStickyTitleSource();
            const contentFrame = document.querySelector('.shell-content-frame');
            if (!source || !contentFrame) {
                pageTitleRail.classList.remove('is-active');
                pageTitleRailText.textContent = '';
                return;
            }
            const navHeight = Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--shell-nav-height')) || 58;
            const titleText = (source.getAttribute('data-sticky-title') || source.textContent || '').trim();
            const sourceRect = source.getBoundingClientRect();
            const frameRect = contentFrame.getBoundingClientRect();
            const shouldShow = sourceRect.top <= navHeight;
            if (!titleText || !shouldShow) {
                pageTitleRail.classList.remove('is-active');
                pageTitleRailText.textContent = '';
                return;
            }
            document.documentElement.style.setProperty('--shell-page-title-left', Math.round(frameRect.left) + 'px');
            pageTitleRailText.textContent = titleText;
            pageTitleRail.classList.add('is-active');
        };
        const schedulePageTitleRailUpdate = function () {
            if (titleRailTicking) {
                return;
            }
            titleRailTicking = true;
            window.requestAnimationFrame(function () {
                titleRailTicking = false;
                updatePageTitleRail();
            });
        };

        window.showToast = function (type, message, options) {
            if (!toastContainer || !message || !String(message).trim()) {
                return null;
            }
            const settings = options || {};
            const variant = type === 'error' ? 'error' : (type === 'success' ? 'success' : 'info');
            const duration = Number.isFinite(settings.duration) ? settings.duration : (variant === 'error' ? 5200 : 3600);
            const toast = document.createElement('div');
            toast.className = 'app-toast-enter pointer-events-auto relative overflow-hidden rounded-xl border px-4 py-3 shadow-lg backdrop-blur-sm ' +
                (variant === 'success' ? 'app-toast-success' : variant === 'error' ? 'app-toast-error' : 'app-toast-info');
            toast.setAttribute('role', variant === 'error' ? 'alert' : 'status');
            toast.innerHTML =
                '<div class="flex items-start gap-3">' +
                    '<div class="mt-0.5 shrink-0">' +
                        (variant === 'success'
                            ? '<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.42l-7.25 7.25a1 1 0 01-1.415 0l-3.25-3.25a1 1 0 111.414-1.42l2.543 2.544 6.543-6.544a1 1 0 011.415 0z" clip-rule="evenodd"/></svg>'
                            : variant === 'error'
                                ? '<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-11.5a.75.75 0 00-1.5 0v4.25a.75.75 0 001.5 0V6.5zm0 7a.75.75 0 00-1.5 0v.25a.75.75 0 001.5 0v-.25z" clip-rule="evenodd"/></svg>'
                                : '<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10A8 8 0 112 10a8 8 0 0116 0zm-7.25-3.75a.75.75 0 10-1.5 0v.25a.75.75 0 001.5 0V6.25zm0 2.5a.75.75 0 00-1.5 0v5a.75.75 0 001.5 0v-5z" clip-rule="evenodd"/></svg>') +
                    '</div>' +
                    '<div class="min-w-0 flex-1 pr-6">' +
                        '<p class="text-sm font-semibold leading-5">' + String(message) + '</p>' +
                    '</div>' +
                    '<button type="button" class="absolute right-2 top-2 inline-flex h-7 w-7 items-center justify-center rounded-lg text-current/70 transition hover:bg-black/5 hover:text-current" aria-label="Dismiss notification">' +
                        '<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.22 4.22a.75.75 0 011.06 0L10 8.94l4.72-4.72a.75.75 0 011.06 1.06L11.06 10l4.72 4.72a.75.75 0 11-1.06 1.06L10 11.06l-4.72 4.72a.75.75 0 11-1.06-1.06L8.94 10 4.22 5.28a.75.75 0 010-1.06z" clip-rule="evenodd"/></svg>' +
                    '</button>' +
                '</div>';

            const dismiss = function () {
                if (!toast.isConnected || toast.classList.contains('app-toast-exit')) {
                    return;
                }
                toast.classList.remove('app-toast-enter');
                toast.classList.add('app-toast-exit');
                window.setTimeout(function () {
                    toast.remove();
                }, 190);
            };

            const closeButton = toast.querySelector('button');
            closeButton?.addEventListener('click', dismiss);
            toastContainer.appendChild(toast);

            if (duration > 0) {
                window.setTimeout(dismiss, duration);
            }
            return { dismiss: dismiss, element: toast };
        };

        window.scrollToFeedback = function (element) {
            if (!element || !element.textContent || !element.textContent.trim()) {
                return;
            }
            const isHidden = element.classList && element.classList.contains('hidden');
            if (isHidden) {
                return;
            }
            const navHeightValue = getComputedStyle(document.documentElement).getPropertyValue('--shell-nav-height');
            const navHeight = Number.parseFloat(navHeightValue) || 58;
            window.requestAnimationFrame(function () {
                const rect = element.getBoundingClientRect();
                const top = Math.max(window.scrollY + rect.top - navHeight - 18, 0);
                window.scrollTo({ top: top, behavior: 'smooth' });
                element.setAttribute('tabindex', '-1');
                if (typeof element.focus === 'function') {
                    try {
                        element.focus({ preventScroll: true });
                    } catch (ignored) {
                        element.focus();
                    }
                }
            });
        };

        window.addEventListener('load', function () {
            syncShellNavHeight();
            schedulePageTitleRailUpdate();
            document.querySelectorAll('[data-toast-message]').forEach(function (element) {
                const message = element.getAttribute('data-toast-message');
                if (!message) {
                    return;
                }
                window.showToast(
                    element.getAttribute('data-toast-type') || 'info',
                    message,
                    { duration: element.getAttribute('data-toast-persist') === 'true' ? 0 : undefined }
                );
            });
            const initialAlert = Array.from(document.querySelectorAll('[data-auto-scroll-message]')).find(function (element) {
                return !element.classList.contains('hidden') && element.textContent && element.textContent.trim();
            });
            if (initialAlert) {
                window.scrollToFeedback(initialAlert);
            }
        });

        window.addEventListener('resize', function () {
            syncShellNavHeight();
            schedulePageTitleRailUpdate();
        });
        window.addEventListener('scroll', schedulePageTitleRailUpdate, { passive: true });
        window.requestAnimationFrame(function () {
            syncShellNavHeight();
            schedulePageTitleRailUpdate();
        });

        const notificationToggle = document.getElementById('notificationToggle');
        const notificationPanel = document.getElementById('notificationPanel');
        const profileToggle = document.getElementById('profileToggle');
        const profilePanel = document.getElementById('profilePanel');
        if (!notificationToggle || !notificationPanel || !profileToggle || !profilePanel) {
            return;
        }

        function closePanels() {
            notificationPanel.classList.remove('is-open');
            profilePanel.classList.remove('is-open');
        }

        notificationToggle.addEventListener('click', function (event) {
            event.stopPropagation();
            const willOpen = !notificationPanel.classList.contains('is-open');
            closePanels();
            if (willOpen) {
                notificationPanel.classList.add('is-open');
            }
        });

        profileToggle.addEventListener('click', function (event) {
            event.stopPropagation();
            const willOpen = !profilePanel.classList.contains('is-open');
            closePanels();
            if (willOpen) {
                profilePanel.classList.add('is-open');
            }
        });

        document.addEventListener('click', function (event) {
            const insideNotification = notificationPanel.contains(event.target) || notificationToggle.contains(event.target);
            const insideProfile = profilePanel.contains(event.target) || profileToggle.contains(event.target);
            if (!insideNotification && !insideProfile) {
                closePanels();
            }
        });

        window.addEventListener('load', function () {
            const adminScopeOptionsNode = document.getElementById('adminScopeOptionsData');
            const adminScopeSaccoSelect = document.getElementById('adminScopeSaccoSelect');
            const adminScopeStationSelect = document.getElementById('adminScopeStationSelect');
            if (!adminScopeOptionsNode || !adminScopeSaccoSelect || !adminScopeStationSelect) {
                return;
            }
            const adminScopeOptions = JSON.parse(adminScopeOptionsNode.textContent || '[]');
            const syncStationOptions = function () {
                const selectedSacco = adminScopeSaccoSelect.value;
                const scopeOption = adminScopeOptions.find(function (option) { return option.saccoId === selectedSacco; });
                const stations = scopeOption && Array.isArray(scopeOption.stationIds) ? scopeOption.stationIds : [];
                const currentStation = adminScopeStationSelect.value || '${not empty adminScope ? adminScope.stationId : ""}';
                adminScopeStationSelect.innerHTML = '';
                stations.forEach(function (stationId) {
                    const option = document.createElement('option');
                    option.value = stationId;
                    option.textContent = stationId;
                    if (stationId === currentStation) {
                        option.selected = true;
                    }
                    adminScopeStationSelect.appendChild(option);
                });
                if (!stations.includes(currentStation) && stations.length > 0) {
                    adminScopeStationSelect.value = stations[0];
                }
                if (typeof window.refreshEnhancedSelects === 'function') {
                    window.refreshEnhancedSelects(adminScopeStationSelect.parentElement);
                }
            };
            adminScopeSaccoSelect.addEventListener('change', syncStationOptions);
            syncStationOptions();
        });
    }());
</script>
