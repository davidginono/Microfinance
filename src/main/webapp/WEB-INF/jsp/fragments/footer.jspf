    </div>
</main>
</div>
<script>
    (function () {
        const sidebar = document.getElementById("appSidebar");
        const overlay = document.getElementById("sidebarOverlay");
        const openBtn = document.getElementById("sidebarToggle");

        if (!sidebar || !overlay || !openBtn) {
            return;
        }

        function isSidebarOpen() {
            return !sidebar.classList.contains("-translate-x-full");
        }

        function openSidebar() {
            sidebar.classList.remove("-translate-x-full");
            overlay.classList.remove("hidden");
        }

        function closeSidebar() {
            sidebar.classList.add("-translate-x-full");
            overlay.classList.add("hidden");
        }

        openBtn.addEventListener("click", function () {
            if (isSidebarOpen()) {
                closeSidebar();
            } else {
                openSidebar();
            }
        });
        overlay.addEventListener("click", closeSidebar);

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                closeSidebar();
            }
        });

        const adminScopeToggle = document.getElementById("adminScopeToggle");
        const adminScopePanel = document.getElementById("adminScopePanel");
        const adminScopeChevron = document.getElementById("adminScopeChevron");
        const memberArchiveToggle = document.getElementById("memberArchiveToggle");
        const memberArchivePanel = document.getElementById("memberArchivePanel");
        const memberArchiveChevron = document.getElementById("memberArchiveChevron");
        const memberSupportToggle = document.getElementById("memberSupportToggle");
        const memberSupportPanel = document.getElementById("memberSupportPanel");
        const memberSupportChevron = document.getElementById("memberSupportChevron");
        const adminSaccoToggle = document.getElementById("adminSaccoToggle");
        const adminSaccoPanel = document.getElementById("adminSaccoPanel");
        const adminSaccoChevron = document.getElementById("adminSaccoChevron");
        const adminSupportToggle = document.getElementById("adminSupportToggle");
        const adminSupportPanel = document.getElementById("adminSupportPanel");
        const adminSupportChevron = document.getElementById("adminSupportChevron");
        const adminSettingsToggle = document.getElementById("adminSettingsToggle");
        const adminSettingsPanel = document.getElementById("adminSettingsPanel");
        const adminSettingsChevron = document.getElementById("adminSettingsChevron");
        const memberSettingsToggle = document.getElementById("memberSettingsToggle");
        const memberSettingsPanel = document.getElementById("memberSettingsPanel");
        const memberSettingsChevron = document.getElementById("memberSettingsChevron");
        const staffSettingsToggle = document.getElementById("staffSettingsToggle");
        const staffSettingsPanel = document.getElementById("staffSettingsPanel");
        const staffSettingsChevron = document.getElementById("staffSettingsChevron");
        const staffDashboardToggle = document.getElementById("staffDashboardToggle");
        const staffDashboardPanel = document.getElementById("staffDashboardPanel");
        const staffDashboardChevron = document.getElementById("staffDashboardChevron");
        const managerOfficeToggle = document.getElementById("managerOfficeToggle");
        const managerOfficePanel = document.getElementById("managerOfficePanel");
        const managerOfficeChevron = document.getElementById("managerOfficeChevron");
        const boardOfficeToggle = document.getElementById("boardOfficeToggle");
        const boardOfficePanel = document.getElementById("boardOfficePanel");
        const boardOfficeChevron = document.getElementById("boardOfficeChevron");
        const loanOfficerOfficeToggle = document.getElementById("loanOfficerOfficeToggle");
        const loanOfficerOfficePanel = document.getElementById("loanOfficerOfficePanel");
        const loanOfficerOfficeChevron = document.getElementById("loanOfficerOfficeChevron");
        const accountantOfficeToggle = document.getElementById("accountantOfficeToggle");
        const accountantOfficePanel = document.getElementById("accountantOfficePanel");
        const accountantOfficeChevron = document.getElementById("accountantOfficeChevron");
        const disbursementOfficeToggle = document.getElementById("disbursementOfficeToggle");
        const disbursementOfficePanel = document.getElementById("disbursementOfficePanel");
        const disbursementOfficeChevron = document.getElementById("disbursementOfficeChevron");
        const sidebarStateScope = "${pageContext.session.id}";

        function sidebarStateKey(name) {
            return "sidebar:" + sidebarStateScope + ":" + name;
        }

        function registerExpandableMenu(toggle, panel, chevron, keyName) {
            if (!toggle || !panel) {
                return;
            }
            const storageKey = sidebarStateKey(keyName);
            const applyExpanded = function (expanded) {
                toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
                panel.classList.toggle("hidden", !expanded);
                if (chevron) {
                    chevron.classList.toggle("rotate-180", expanded);
                }
            };
            const stored = window.sessionStorage.getItem(storageKey);
            const activeState = toggle.getAttribute("aria-expanded") === "true";
            const storedState = activeState || (stored === null ? false : stored === "true");
            applyExpanded(storedState);
            toggle.addEventListener("click", function () {
                const isExpanded = toggle.getAttribute("aria-expanded") === "true";
                const nextExpanded = !isExpanded;
                applyExpanded(nextExpanded);
                window.sessionStorage.setItem(storageKey, String(nextExpanded));
            });
        }

        if (adminScopeToggle && adminScopePanel) {
            adminScopeToggle.addEventListener("click", function () {
                const isExpanded = adminScopeToggle.getAttribute("aria-expanded") === "true";
                adminScopeToggle.setAttribute("aria-expanded", isExpanded ? "false" : "true");
                adminScopePanel.classList.toggle("hidden", isExpanded);
                if (adminScopeChevron) {
                    adminScopeChevron.classList.toggle("rotate-180", !isExpanded);
                }
            });
        }

        registerExpandableMenu(memberSettingsToggle, memberSettingsPanel, memberSettingsChevron, "memberSettingsExpanded");
        registerExpandableMenu(staffDashboardToggle, staffDashboardPanel, staffDashboardChevron, "staffDashboardExpanded");
        registerExpandableMenu(staffSettingsToggle, staffSettingsPanel, staffSettingsChevron, "staffSettingsExpanded");
        registerExpandableMenu(memberArchiveToggle, memberArchivePanel, memberArchiveChevron, "memberArchiveExpanded");
        registerExpandableMenu(memberSupportToggle, memberSupportPanel, memberSupportChevron, "memberSupportExpanded");
        registerExpandableMenu(adminSaccoToggle, adminSaccoPanel, adminSaccoChevron, "adminSaccoExpanded");
        registerExpandableMenu(adminSupportToggle, adminSupportPanel, adminSupportChevron, "adminSupportExpanded");
        registerExpandableMenu(adminSettingsToggle, adminSettingsPanel, adminSettingsChevron, "adminSettingsExpanded");
        registerExpandableMenu(managerOfficeToggle, managerOfficePanel, managerOfficeChevron, "managerOfficeExpanded");
        registerExpandableMenu(boardOfficeToggle, boardOfficePanel, boardOfficeChevron, "boardOfficeExpanded");
        registerExpandableMenu(loanOfficerOfficeToggle, loanOfficerOfficePanel, loanOfficerOfficeChevron, "loanOfficerOfficeExpanded");
        registerExpandableMenu(accountantOfficeToggle, accountantOfficePanel, accountantOfficeChevron, "accountantOfficeExpanded");
        registerExpandableMenu(disbursementOfficeToggle, disbursementOfficePanel, disbursementOfficeChevron, "disbursementOfficeExpanded");
    })();
</script>
</div>
</body>
</html>
