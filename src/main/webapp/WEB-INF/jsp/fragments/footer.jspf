    </div>
</main>
</div>
<script>
    (function () {
        const sidebar = document.getElementById("appSidebar");
        const overlay = document.getElementById("sidebarOverlay");
        const openBtn = document.getElementById("sidebarToggle");
        const desktopToggle = document.getElementById("desktopSidebarToggle");

        if (!sidebar || !overlay || !openBtn) {
            return;
        }

        function isSidebarOpen() {
            return !sidebar.classList.contains("-translate-x-full");
        }

        function openSidebar() {
            sidebar.classList.remove("-translate-x-full");
            overlay.classList.remove("hidden");
        }

        function closeSidebar() {
            sidebar.classList.add("-translate-x-full");
            overlay.classList.add("hidden");
        }

        const desktopCollapseKey = "shell:desktopSidebarCollapsed";
        const desktopSidebarMedia = window.matchMedia("(min-width: 1024px)");
        let collapsedSidebarTooltip = null;
        let collapsedSidebarFlyout = null;
        let collapsedSidebarFlyoutOwner = null;

        function storedDesktopSidebarCollapsed() {
            try {
                return window.localStorage.getItem(desktopCollapseKey) === "true";
            } catch (ignored) {
                return false;
            }
        }

        function storeDesktopSidebarCollapsed(collapsed) {
            try {
                window.localStorage.setItem(desktopCollapseKey, String(collapsed));
            } catch (ignored) {
                // Storage can be blocked in private browsing modes.
            }
        }

        function applyDesktopSidebarCollapsed(collapsed) {
            const shouldCollapse = collapsed && desktopSidebarMedia.matches;
            document.documentElement.classList.toggle("shell-sidebar-collapsed", shouldCollapse);
            if (!shouldCollapse) {
                hideCollapsedSidebarTooltip();
                hideCollapsedSidebarFlyout();
            }
            if (desktopToggle) {
                desktopToggle.setAttribute("aria-pressed", shouldCollapse ? "true" : "false");
                desktopToggle.setAttribute("aria-label", shouldCollapse ? "Expand sidebar" : "Collapse sidebar");
                desktopToggle.setAttribute("title", shouldCollapse ? "Expand sidebar" : "Collapse sidebar");
            }
            window.requestAnimationFrame(function () {
                window.dispatchEvent(new Event("resize"));
                window.setTimeout(function () {
                    window.dispatchEvent(new Event("resize"));
                }, 240);
            });
        }

        openBtn.addEventListener("click", function () {
            if (isSidebarOpen()) {
                closeSidebar();
            } else {
                openSidebar();
            }
        });
        overlay.addEventListener("click", closeSidebar);

        applyDesktopSidebarCollapsed(storedDesktopSidebarCollapsed());
        if (desktopToggle) {
            desktopToggle.addEventListener("click", function () {
                const nextCollapsed = !document.documentElement.classList.contains("shell-sidebar-collapsed");
                storeDesktopSidebarCollapsed(nextCollapsed);
                applyDesktopSidebarCollapsed(nextCollapsed);
            });
        }
        const handleDesktopSidebarMediaChange = function () {
            applyDesktopSidebarCollapsed(storedDesktopSidebarCollapsed());
        };
        if (typeof desktopSidebarMedia.addEventListener === "function") {
            desktopSidebarMedia.addEventListener("change", handleDesktopSidebarMediaChange);
        } else if (typeof desktopSidebarMedia.addListener === "function") {
            desktopSidebarMedia.addListener(handleDesktopSidebarMediaChange);
        }

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                closeSidebar();
                hideCollapsedSidebarFlyout();
            }
        });

        const adminScopeToggle = document.getElementById("adminScopeToggle");
        const adminScopePanel = document.getElementById("adminScopePanel");
        const adminScopeChevron = document.getElementById("adminScopeChevron");
        const memberArchiveToggle = document.getElementById("memberArchiveToggle");
        const memberArchivePanel = document.getElementById("memberArchivePanel");
        const memberArchiveChevron = document.getElementById("memberArchiveChevron");
        const memberSupportToggle = document.getElementById("memberSupportToggle");
        const memberSupportPanel = document.getElementById("memberSupportPanel");
        const memberSupportChevron = document.getElementById("memberSupportChevron");
        const adminSaccoToggle = document.getElementById("adminSaccoToggle");
        const adminSaccoPanel = document.getElementById("adminSaccoPanel");
        const adminSaccoChevron = document.getElementById("adminSaccoChevron");
        const adminSupportToggle = document.getElementById("adminSupportToggle");
        const adminSupportPanel = document.getElementById("adminSupportPanel");
        const adminSupportChevron = document.getElementById("adminSupportChevron");
        const adminSettingsToggle = document.getElementById("adminSettingsToggle");
        const adminSettingsPanel = document.getElementById("adminSettingsPanel");
        const adminSettingsChevron = document.getElementById("adminSettingsChevron");
        const memberSettingsToggle = document.getElementById("memberSettingsToggle");
        const memberSettingsPanel = document.getElementById("memberSettingsPanel");
        const memberSettingsChevron = document.getElementById("memberSettingsChevron");
        const staffSettingsToggle = document.getElementById("staffSettingsToggle");
        const staffSettingsPanel = document.getElementById("staffSettingsPanel");
        const staffSettingsChevron = document.getElementById("staffSettingsChevron");
        const staffSupportToggle = document.getElementById("staffSupportToggle");
        const staffSupportPanel = document.getElementById("staffSupportPanel");
        const staffSupportChevron = document.getElementById("staffSupportChevron");
        const staffDashboardToggle = document.getElementById("staffDashboardToggle");
        const staffDashboardPanel = document.getElementById("staffDashboardPanel");
        const staffDashboardChevron = document.getElementById("staffDashboardChevron");
        const managerOfficeToggle = document.getElementById("managerOfficeToggle");
        const managerOfficePanel = document.getElementById("managerOfficePanel");
        const managerOfficeChevron = document.getElementById("managerOfficeChevron");
        const boardOfficeToggle = document.getElementById("boardOfficeToggle");
        const boardOfficePanel = document.getElementById("boardOfficePanel");
        const boardOfficeChevron = document.getElementById("boardOfficeChevron");
        const loanOfficerOfficeToggle = document.getElementById("loanOfficerOfficeToggle");
        const loanOfficerOfficePanel = document.getElementById("loanOfficerOfficePanel");
        const loanOfficerOfficeChevron = document.getElementById("loanOfficerOfficeChevron");
        const accountantOfficeToggle = document.getElementById("accountantOfficeToggle");
        const accountantOfficePanel = document.getElementById("accountantOfficePanel");
        const accountantOfficeChevron = document.getElementById("accountantOfficeChevron");
        const disbursementOfficeToggle = document.getElementById("disbursementOfficeToggle");
        const disbursementOfficePanel = document.getElementById("disbursementOfficePanel");
        const disbursementOfficeChevron = document.getElementById("disbursementOfficeChevron");
        const sidebarStateScope = "${pageContext.session.id}";

        function sidebarStateKey(name) {
            return "sidebar:" + sidebarStateScope + ":" + name;
        }

        const sidebarScroll = sidebar.querySelector(".shell-sidebar-scroll");
        const lastClickedSidebarKey = sidebarStateKey("lastClickedLink");

        function prepareCollapsedSidebarLabels() {
            if (!sidebarScroll) {
                return;
            }
            sidebarScroll.querySelectorAll("a[href], button").forEach(function (item) {
                const label = (item.textContent || "").replace(/\s+/g, " ").trim();
                if (!label) {
                    return;
                }
                if (!item.getAttribute("title")) {
                    item.setAttribute("title", label);
                }
                if (!item.getAttribute("aria-label")) {
                    item.setAttribute("aria-label", label);
                }
                item.dataset.sidebarLabel = label;
            });
        }

        function ensureCollapsedSidebarTooltip() {
            if (!collapsedSidebarTooltip) {
                collapsedSidebarTooltip = document.createElement("div");
                collapsedSidebarTooltip.className = "shell-sidebar-tooltip";
                collapsedSidebarTooltip.setAttribute("role", "tooltip");
                document.body.appendChild(collapsedSidebarTooltip);
            }
            return collapsedSidebarTooltip;
        }

        function sidebarTooltipTarget(event) {
            const eventTarget = event.target instanceof Element ? event.target : null;
            if (!eventTarget || !isDesktopSidebarCollapsed() || isCollapsedSidebarFlyoutVisible()) {
                return null;
            }
            return eventTarget.closest(".shell-sidebar-scroll a[href], .shell-sidebar-scroll button");
        }

        function showCollapsedSidebarTooltip(target) {
            if (!target || !target.dataset.sidebarLabel) {
                return;
            }
            const tooltip = ensureCollapsedSidebarTooltip();
            tooltip.textContent = target.dataset.sidebarLabel;
            const rect = target.getBoundingClientRect();
            const top = Math.min(Math.max(rect.top + rect.height / 2, 36), window.innerHeight - 36);
            tooltip.style.left = Math.round(rect.right + 10) + "px";
            tooltip.style.top = Math.round(top) + "px";
            tooltip.classList.add("is-visible");
        }

        function hideCollapsedSidebarTooltip() {
            if (collapsedSidebarTooltip) {
                collapsedSidebarTooltip.classList.remove("is-visible");
            }
        }

        function isDesktopSidebarCollapsed() {
            return document.documentElement.classList.contains("shell-sidebar-collapsed") && desktopSidebarMedia.matches;
        }

        function ensureCollapsedSidebarFlyout() {
            if (!collapsedSidebarFlyout) {
                collapsedSidebarFlyout = document.createElement("div");
                collapsedSidebarFlyout.className = "shell-sidebar-flyout";
                collapsedSidebarFlyout.setAttribute("role", "menu");
                document.body.appendChild(collapsedSidebarFlyout);
            }
            return collapsedSidebarFlyout;
        }

        function hideCollapsedSidebarFlyout() {
            collapsedSidebarFlyoutOwner = null;
            if (collapsedSidebarFlyout) {
                collapsedSidebarFlyout.classList.remove("is-visible");
            }
        }

        function isCollapsedSidebarFlyoutVisible() {
            return !!collapsedSidebarFlyout && collapsedSidebarFlyout.classList.contains("is-visible");
        }

        function positionCollapsedSidebarFlyout(owner) {
            if (!collapsedSidebarFlyout || !owner) {
                return;
            }
            const rect = owner.getBoundingClientRect();
            const flyoutWidth = collapsedSidebarFlyout.offsetWidth || 224;
            const flyoutHeight = collapsedSidebarFlyout.offsetHeight || 120;
            const left = Math.min(rect.right + 10, Math.max(10, window.innerWidth - flyoutWidth - 10));
            const top = Math.min(Math.max(rect.top, 10), Math.max(10, window.innerHeight - flyoutHeight - 10));
            collapsedSidebarFlyout.style.left = Math.round(left) + "px";
            collapsedSidebarFlyout.style.top = Math.round(top) + "px";
        }

        function sourceLinkIsActive(source) {
            return Array.from(source.classList).some(function (className) {
                return className === "text-cyan-800"
                    || className === "text-blue-800"
                    || className === "text-green-800"
                    || className === "text-amber-800"
                    || className === "text-teal-800"
                    || className === "text-emerald-800"
                    || className === "text-sacco-blue"
                    || className === "text-sacco-green"
                    || className === "text-sacco-brown";
            });
        }

        function showCollapsedSidebarFlyout(toggle, panel) {
            if (!toggle || !panel) {
                return;
            }
            const links = Array.from(panel.querySelectorAll("a[href]"));
            if (links.length === 0) {
                return;
            }

            hideCollapsedSidebarTooltip();
            const flyout = ensureCollapsedSidebarFlyout();
            flyout.textContent = "";

            const title = document.createElement("div");
            title.className = "shell-sidebar-flyout-title";
            title.textContent = toggle.dataset.sidebarLabel || (toggle.textContent || "").replace(/\s+/g, " ").trim();
            flyout.appendChild(title);

            const list = document.createElement("div");
            list.className = "shell-sidebar-flyout-list";
            links.forEach(function (source) {
                const link = document.createElement("a");
                link.className = "shell-sidebar-flyout-link";
                if (sourceLinkIsActive(source)) {
                    link.classList.add("is-active");
                }
                link.href = source.getAttribute("href") || source.href;
                link.textContent = (source.textContent || "").replace(/\s+/g, " ").trim();
                link.setAttribute("role", "menuitem");
                list.appendChild(link);
            });
            flyout.appendChild(list);

            collapsedSidebarFlyoutOwner = toggle;
            flyout.classList.add("is-visible");
            positionCollapsedSidebarFlyout(toggle);
        }

        function normalizeSidebarUrl(url) {
            try {
                const parsed = new URL(url, window.location.origin);
                return parsed.pathname + parsed.search;
            } catch (ignored) {
                return "";
            }
        }

        function rememberSidebarClick(event) {
            const eventTarget = event.target instanceof Element ? event.target : null;
            const link = eventTarget ? eventTarget.closest(".shell-sidebar-scroll a[href]") : null;
            if (!link) {
                return;
            }
            try {
                window.sessionStorage.setItem(lastClickedSidebarKey, JSON.stringify({
                    href: normalizeSidebarUrl(link.href),
                    at: Date.now()
                }));
            } catch (ignored) {
                // Storage can be blocked in private browsing modes.
            }
        }

        function restoreLastClickedSidebarLink() {
            if (!sidebarScroll) {
                return;
            }

            const currentHref = window.location.pathname + window.location.search;
            let savedHref = "";
            try {
                const saved = JSON.parse(window.sessionStorage.getItem(lastClickedSidebarKey) || "null");
                if (saved && Date.now() - Number(saved.at || 0) <= 24 * 60 * 60 * 1000) {
                    savedHref = saved.href || "";
                }
            } catch (ignored) {
                savedHref = "";
            }

            const links = Array.from(sidebarScroll.querySelectorAll("a[href]"));
            const activeTokens = new Set([
                "text-cyan-800",
                "text-blue-800",
                "text-green-800",
                "text-amber-800",
                "text-teal-800",
                "text-emerald-800",
                "text-sacco-blue",
                "text-sacco-green",
                "text-sacco-brown"
            ]);
            const isActiveLink = function (link) {
                return Array.from(link.classList).some(function (className) {
                    return activeTokens.has(className);
                });
            };
            const exactCurrentLink = links.find(function (link) {
                return normalizeSidebarUrl(link.href) === currentHref;
            });
            const savedLink = savedHref
                ? links.find(function (link) {
                    const linkHref = normalizeSidebarUrl(link.href);
                    return linkHref === savedHref || (currentHref.indexOf(savedHref.split("?")[0]) === 0 && linkHref === savedHref);
                })
                : null;
            const activeLink = links.find(isActiveLink);
            const target = exactCurrentLink || savedLink || activeLink;
            if (!target) {
                return;
            }

            const behavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
            window.requestAnimationFrame(function () {
                window.setTimeout(function () {
                    const scrollRect = sidebarScroll.getBoundingClientRect();
                    const targetRect = target.getBoundingClientRect();
                    const targetTop = sidebarScroll.scrollTop
                        + targetRect.top
                        - scrollRect.top
                        - Math.max(12, (sidebarScroll.clientHeight - target.offsetHeight) / 2);
                    sidebarScroll.scrollTo({
                        top: Math.max(targetTop, 0),
                        behavior: behavior
                    });
                }, 80);
            });
        }

        function registerExpandableMenu(toggle, panel, chevron, keyName) {
            if (!toggle || !panel) {
                return;
            }
            const storageKey = sidebarStateKey(keyName);
            const applyExpanded = function (expanded) {
                toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
                panel.classList.toggle("hidden", !expanded);
                if (chevron) {
                    chevron.classList.toggle("rotate-180", expanded);
                }
            };
            const stored = window.sessionStorage.getItem(storageKey);
            const activeState = toggle.getAttribute("aria-expanded") === "true";
            const storedState = activeState || (stored === null ? false : stored === "true");
            applyExpanded(storedState);
            toggle.addEventListener("click", function () {
                if (isDesktopSidebarCollapsed()) {
                    showCollapsedSidebarFlyout(toggle, panel);
                    return;
                }
                const isExpanded = toggle.getAttribute("aria-expanded") === "true";
                const nextExpanded = !isExpanded;
                applyExpanded(nextExpanded);
                window.sessionStorage.setItem(storageKey, String(nextExpanded));
            });
        }

        if (sidebarScroll) {
            sidebarScroll.addEventListener("click", rememberSidebarClick);
            prepareCollapsedSidebarLabels();
            sidebarScroll.addEventListener("mouseover", function (event) {
                const target = sidebarTooltipTarget(event);
                if (target) {
                    showCollapsedSidebarTooltip(target);
                } else {
                    hideCollapsedSidebarTooltip();
                }
            });
            sidebarScroll.addEventListener("mousemove", function (event) {
                const target = sidebarTooltipTarget(event);
                if (target) {
                    showCollapsedSidebarTooltip(target);
                } else {
                    hideCollapsedSidebarTooltip();
                }
            });
            sidebarScroll.addEventListener("mouseout", function (event) {
                const related = event.relatedTarget instanceof Element ? event.relatedTarget : null;
                if (!related || !sidebarScroll.contains(related)) {
                    hideCollapsedSidebarTooltip();
                }
            });
            sidebarScroll.addEventListener("focusin", function (event) {
                showCollapsedSidebarTooltip(sidebarTooltipTarget(event));
            });
            sidebarScroll.addEventListener("focusout", hideCollapsedSidebarTooltip);
            sidebarScroll.addEventListener("scroll", function () {
                hideCollapsedSidebarTooltip();
                hideCollapsedSidebarFlyout();
            }, { passive: true });
        }

        document.addEventListener("click", function (event) {
            const target = event.target instanceof Element ? event.target : null;
            if (!target || !collapsedSidebarFlyout || !collapsedSidebarFlyout.classList.contains("is-visible")) {
                return;
            }
            if (collapsedSidebarFlyout.contains(target) || (collapsedSidebarFlyoutOwner && collapsedSidebarFlyoutOwner.contains(target))) {
                return;
            }
            hideCollapsedSidebarFlyout();
        });

        window.addEventListener("resize", function () {
            if (!collapsedSidebarFlyout || !collapsedSidebarFlyout.classList.contains("is-visible")) {
                return;
            }
            if (isDesktopSidebarCollapsed() && collapsedSidebarFlyoutOwner) {
                positionCollapsedSidebarFlyout(collapsedSidebarFlyoutOwner);
            } else {
                hideCollapsedSidebarFlyout();
            }
        });

        if (adminScopeToggle && adminScopePanel) {
            adminScopeToggle.addEventListener("click", function () {
                const isExpanded = adminScopeToggle.getAttribute("aria-expanded") === "true";
                adminScopeToggle.setAttribute("aria-expanded", isExpanded ? "false" : "true");
                adminScopePanel.classList.toggle("hidden", isExpanded);
                if (adminScopeChevron) {
                    adminScopeChevron.classList.toggle("rotate-180", !isExpanded);
                }
            });
        }

        registerExpandableMenu(memberSettingsToggle, memberSettingsPanel, memberSettingsChevron, "memberSettingsExpanded");
        registerExpandableMenu(staffDashboardToggle, staffDashboardPanel, staffDashboardChevron, "staffDashboardExpanded");
        registerExpandableMenu(staffSettingsToggle, staffSettingsPanel, staffSettingsChevron, "staffSettingsExpanded");
        registerExpandableMenu(staffSupportToggle, staffSupportPanel, staffSupportChevron, "staffSupportExpanded");
        registerExpandableMenu(memberArchiveToggle, memberArchivePanel, memberArchiveChevron, "memberArchiveExpanded");
        registerExpandableMenu(memberSupportToggle, memberSupportPanel, memberSupportChevron, "memberSupportExpanded");
        registerExpandableMenu(adminSaccoToggle, adminSaccoPanel, adminSaccoChevron, "adminSaccoExpanded");
        registerExpandableMenu(adminSupportToggle, adminSupportPanel, adminSupportChevron, "adminSupportExpanded");
        registerExpandableMenu(adminSettingsToggle, adminSettingsPanel, adminSettingsChevron, "adminSettingsExpanded");
        registerExpandableMenu(managerOfficeToggle, managerOfficePanel, managerOfficeChevron, "managerOfficeExpanded");
        registerExpandableMenu(boardOfficeToggle, boardOfficePanel, boardOfficeChevron, "boardOfficeExpanded");
        registerExpandableMenu(loanOfficerOfficeToggle, loanOfficerOfficePanel, loanOfficerOfficeChevron, "loanOfficerOfficeExpanded");
        registerExpandableMenu(accountantOfficeToggle, accountantOfficePanel, accountantOfficeChevron, "accountantOfficeExpanded");
        registerExpandableMenu(disbursementOfficeToggle, disbursementOfficePanel, disbursementOfficeChevron, "disbursementOfficeExpanded");
        restoreLastClickedSidebarLink();
    })();
</script>
<spring:message code="session.timeout.progressLabel" text="Session time remaining" var="sessionTimeoutProgressLabel" />
<spring:message code="session.timeout.refreshed" text="Session refreshed." var="sessionTimeoutRefreshedMessage" />
<spring:message code="session.timeout.refreshFailed" text="We could not refresh your session. Please sign in again if this continues." var="sessionTimeoutRefreshFailedMessage" />
<style>
    html.session-timeout-active,
    body.session-timeout-active {
        overflow: hidden;
    }

    .session-timeout-overlay {
        position: fixed !important;
        inset: 0 !important;
        z-index: 2147483000 !important;
        display: none;
        opacity: 0;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        min-height: 100vh;
        min-height: 100dvh;
        padding: clamp(0.75rem, 2vw, 1.5rem);
        background: rgba(15, 23, 42, 0.62);
        -webkit-backdrop-filter: blur(3px);
        backdrop-filter: blur(3px);
        isolation: isolate;
        overscroll-behavior: contain;
    }

    .session-timeout-overlay.is-open {
        display: flex !important;
        animation: session-timeout-overlay-in 180ms ease-out both;
    }

    .session-timeout-overlay.hidden:not(.is-open) {
        display: none !important;
    }

    .session-timeout-panel {
        position: relative;
        z-index: 1;
        width: min(100%, 28rem);
        overflow: hidden;
        border: 1px solid #d8e0e8;
        border-radius: 0.5rem;
        background: #ffffff;
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.24);
        transform-origin: center;
    }

    .session-timeout-overlay.is-open .session-timeout-panel {
        animation: session-timeout-panel-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .session-timeout-header {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        padding: 0.9rem 1rem;
    }

    .session-timeout-icon {
        display: flex;
        width: 2.25rem;
        height: 2.25rem;
        flex: 0 0 2.25rem;
        align-items: center;
        justify-content: center;
        border: 1px solid #d8e0e8;
        border-radius: 0.375rem;
        background: #ffffff;
        color: #0369a1;
    }

    .session-timeout-body {
        padding: 1rem;
    }

    .session-timeout-countdown {
        font-size: 3rem;
        line-height: 1;
        font-weight: 700;
        color: #172033;
    }

    .session-timeout-progress-track {
        margin-top: 1rem;
        height: 0.5rem;
        overflow: hidden;
        border-radius: 0.125rem;
        background: #f1f5f9;
    }

    .session-timeout-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
        border-top: 1px solid #e2e8f0;
        background: #ffffff;
        padding: 0.75rem 1rem;
    }

    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .session-timeout-overlay {
            background: rgba(15, 23, 42, 0.72);
        }
    }

    @keyframes session-timeout-overlay-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @keyframes session-timeout-panel-in {
        from {
            opacity: 0;
            transform: translateY(0.75rem) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .session-timeout-overlay.is-open,
        .session-timeout-overlay.is-open .session-timeout-panel {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }

    @media (max-width: 640px) {
        .session-timeout-panel {
            width: min(100%, 26rem);
        }

        .session-timeout-actions {
            align-items: stretch;
            flex-direction: column-reverse;
        }

        .session-timeout-actions form,
        .session-timeout-actions button {
            width: 100%;
        }
    }
</style>
<div id="sessionInactivityPrompt"
     class="session-timeout-overlay hidden"
     role="alertdialog"
     aria-modal="true"
     aria-hidden="true"
     aria-labelledby="sessionInactivityTitle"
     aria-describedby="sessionInactivityMessage"
     data-prompt-ms="${sessionInactivityPromptMs}"
     data-grace-ms="${sessionInactivityGraceMs}"
     data-keepalive-url="<c:url value='/session/keepalive' />"
     data-csrf-header="${_csrf.headerName}"
     data-csrf-token="${_csrf.token}"
     data-refresh-success-message="${fn:escapeXml(sessionTimeoutRefreshedMessage)}"
     data-refresh-error-message="${fn:escapeXml(sessionTimeoutRefreshFailedMessage)}">
    <div class="session-timeout-panel">
        <div class="session-timeout-header">
            <span class="session-timeout-icon">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 2a8 8 0 100 16 8 8 0 000-16zm.75 4.25a.75.75 0 00-1.5 0v4.25a.75.75 0 001.5 0V6.25zm0 6.75a.75.75 0 00-1.5 0v.25a.75.75 0 001.5 0V13z" clip-rule="evenodd" />
                </svg>
            </span>
            <div class="min-w-0 flex-1">
                <p class="erp-widget-title"><spring:message code="session.timeout.eyebrow" text="Session Security" /></p>
                <h2 id="sessionInactivityTitle" class="mt-1 text-base font-bold text-sacco-ink"><spring:message code="session.timeout.title" text="Session Expiring Soon" /></h2>
            </div>
        </div>
        <div class="session-timeout-body">
            <p id="sessionInactivityMessage" class="text-sm leading-5 text-slate-600"><spring:message code="session.timeout.message" text="You have been inactive for a while. For your security, you will be automatically logged out in:" /></p>
            <div class="mt-4 text-center" aria-live="polite" aria-atomic="true">
                <p id="sessionInactivityCountdown" class="session-timeout-countdown font-display">--</p>
                <p class="mt-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500"><spring:message code="session.timeout.seconds" text="Seconds" /></p>
            </div>
            <div class="session-timeout-progress-track"
                 role="progressbar"
                 aria-label="${fn:escapeXml(sessionTimeoutProgressLabel)}"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="100">
                <div id="sessionInactivityProgress" class="h-full rounded-sm bg-sky-600 transition-[width] duration-200 ease-linear" style="width: 100%;"></div>
            </div>
            <p class="mt-3 text-center text-xs leading-5 text-slate-500"><spring:message code="session.timeout.helper" text="Select Stay Logged In to continue your session, or Logout Now to end it." /></p>
        </div>
        <div class="session-timeout-actions">
            <form id="sessionInactivityLogoutForm" action="/logout" method="post" class="shrink-0 max-sm:w-full">
                <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" />
                <button type="submit" class="app-btn btn-reject min-w-[8rem] max-sm:w-full" style="height: 2.5rem;"><spring:message code="session.timeout.logout" text="Logout Now" /></button>
            </form>
            <button id="sessionInactivityStayButton" type="button" class="app-btn btn-primary min-w-[8rem] shrink-0 max-sm:w-full" style="height: 2.5rem;"><spring:message code="session.timeout.stay" text="Stay Logged In" /></button>
        </div>
    </div>
</div>
</div>
</body>
</html>
