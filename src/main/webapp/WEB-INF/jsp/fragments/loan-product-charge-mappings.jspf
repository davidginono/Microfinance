<%@ page pageEncoding="UTF-8" %>
<c:forEach items="${['APPLICATION','PROCESSING','RECEIVABLE','INSURANCE']}" var="mappedChargeKind">
    <c:set var="mappingLabel" value="${currentChargeMappings[mappedChargeKind]}" />
    <c:set var="mappingState" value="" />
    <c:if test="${empty mappingLabel}">
        <c:forEach items="${generatedChargeAccounts}" var="generated">
            <c:if test="${generated.component == mappedChargeKind}">
                <c:set var="mappingLabel" value="${generated.label}" />
                <c:set var="mappingState" value="${generated.state}" />
            </c:if>
        </c:forEach>
    </c:if>
    <label class="block min-w-0"><spring:message code="charges.account.${mappedChargeKind}" />
        <input type="text" readonly class="aws-control min-w-0 max-w-full" value="<c:out value='${empty mappingLabel ? "—" : mappingLabel}' />" />
        <c:if test="${not empty mappingState}"><span><spring:message code="coav.state.${mappingState}" text="${mappingState}" /></span></c:if>
    </label>
</c:forEach>
<c:if test="${not empty currentChargeMappings.MANAGEMENT}">
    <label class="block min-w-0"><spring:message code="charges.recoveryHolding" />
        <input type="text" readonly class="aws-control min-w-0 max-w-full" value="<c:out value='${currentChargeMappings.MANAGEMENT}' />" />
    </label>
</c:if>
