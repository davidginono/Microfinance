<%@ page pageEncoding="UTF-8" %>
<template id="resource-table-labels"
    data-actions="<spring:message code='common.actions' />"
    data-records="<spring:message code='table.records' />"
    data-search-page="<spring:message code='table.searchPage' />"
    data-no-matches="<spring:message code='table.noMatches' />"
    data-refresh="<spring:message code='common.refresh' />"
    data-pagination="<spring:message code='table.pagination' />"
    data-page="<spring:message code='voucher.page' />"
    data-previous="<spring:message code='table.previous' />"
    data-next="<spring:message code='table.next' />"
    data-preferences="<spring:message code='table.preferences' />"
    data-columns="<spring:message code='table.columns' />"
    data-compact="<spring:message code='table.compact' />"
    data-wrap="<spring:message code='table.wrap' />"
    data-striped="<spring:message code='table.striped' />"
    data-sticky="<spring:message code='table.sticky' />"
    data-none="<spring:message code='table.none' />"
    data-first-column="<spring:message code='table.firstColumn' />"
    data-first-two-columns="<spring:message code='table.firstTwoColumns' />"
    data-page-size="<spring:message code='table.pageSize' />"
    data-reorder="<spring:message code='table.reorder' />"
    data-details="<spring:message code='table.details' />"
    data-show-details="<spring:message code='table.showDetails' />"
    data-panel-position="<spring:message code='table.panelPosition' />"
    data-bottom="<spring:message code='table.bottom' />"
    data-side="<spring:message code='table.side' />"
    data-resize="<spring:message code='table.resize' />"
    data-select-record="<spring:message code='table.selectRecord' />"
    data-clear-selection="<spring:message code='table.clearSelection' />"
    data-select-first="<spring:message code='table.selectFirst' />"
    data-select="<spring:message code='voucher.select' />"
    data-view="<spring:message code='common.view' />"
    data-close="<spring:message code='common.close' />"
    data-cancel="<spring:message code='common.cancel' />"
    data-confirm="<spring:message code='table.confirm' />"></template>
