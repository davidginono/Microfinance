<%@ taglib prefix="appTime" uri="https://sacco.local/tags/time" %>
<%@ page pageEncoding="UTF-8" %>
<link rel="stylesheet" href="<c:url value='/css/loan-recording.css' />" />
<spring:message code="voucher.choose" var="chooseLabel" />
<c:if test="${not empty topUpUnavailable}"><div class="md:col-span-2 loan-error-summary" role="alert"><spring:message code="${topUpUnavailable}" /></div></c:if>
<c:if test="${not empty topUpQuote}">
<div class="md:col-span-2 loan-topup-summary" data-ui-loading-region data-topup-summary data-topup-posting data-confirmation="<spring:message code='recording.topUp.confirm' />" data-source-number="${fn:escapeXml(topUpQuote.sourceNumber)}" data-error="<spring:message code='recording.error.topUpUnavailable' />" aria-live="polite">
    <h3><spring:message code="recording.topUp.breakdown" /></h3><p><spring:message code="recording.topUp.source" />: <c:out value="${topUpQuote.sourceNumber}" /> · <span data-topup-date><c:out value="${appTime:display(topUpQuote.date)}" /></span></p>
    <dl class="loan-topup-facts"><div><dt><spring:message code="recording.topUp.newPrincipal" /> (TZS)</dt><dd><fmt:formatNumber value="${app.amount}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.outstandingPrincipal" /> (TZS)</dt><dd data-topup-principal></dd></div><div><dt><spring:message code="recording.dueInterest" /> (TZS)</dt><dd data-topup-interest></dd></div><div><dt><spring:message code="charges.sourceSettlement" /> (TZS)</dt><dd data-topup-charges><fmt:formatNumber value="${topUpQuote.charges}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt><spring:message code="recording.topUp.settlement" /> (TZS)</dt><dd data-topup-total></dd></div><div><dt><spring:message code="recording.topUp.excluded" /> (TZS)</dt><dd data-topup-excluded></dd></div><div><dt><spring:message code="recording.topUp.cash" /> (TZS)</dt><dd data-topup-cash></dd></div></dl>
    <p><spring:message code="recording.topUp.explanation" /></p><p data-topup-error role="alert"></p>
    <input type="hidden" name="settlementCharges" value="${topUpQuote.charges}" /><input type="hidden" name="settlementChargeSequence" value="${topUpQuote.chargeSequence}" /><input type="hidden" name="settlementSequence" value="${topUpQuote.sequence}" /><input type="hidden" name="settlementPrincipal" value="${topUpQuote.principal}" /><input type="hidden" name="settlementInterest" value="${topUpQuote.interest}" />

    <label><spring:message code="recording.topUp.agreement" /><input class="aws-control" name="settlementEvidence" maxlength="500" value="${fn:escapeXml(postingSettlementEvidence)}" required /></label>
    <label><input type="checkbox" name="settlementConfirmed" value="true" required /> <spring:message code="recording.topUp.confirm" /></label>
</div>
</c:if>
<c:if test="${not empty fundingCharges.plan.terms}">
<div class="md:col-span-2 erp-detail-card" data-funding-charges>
<h3><spring:message code="charges.title" /></h3>
<fieldset id="funding-charge-picker" class="funding-charge-picker" hidden><legend><spring:message code="charges.chooseDeductions" /></legend>
<c:forEach items="${fundingCharges.plan.terms}" var="term"><c:if test="${not feeRecoveryFunding or term.kind=='INSURANCE'}"><label><input type="checkbox" value="${term.id}" ${term.timing=='DEDUCT'?'checked disabled':''} <c:if test="${term.timing=='SEPARATE'}">name="deductChargeIds" ${not empty postingDeductChargeIds and postingDeductChargeIds.contains(term.id)?'checked':''}</c:if> /><span><spring:message code="charges.kind.${term.kind}" /> · TZS <fmt:formatNumber value="${term.amount}" minFractionDigits="2" maxFractionDigits="2" /></span></label></c:if></c:forEach>
</fieldset>
<dl class="loan-topup-facts" aria-live="polite">
    <c:if test="${not feeRecoveryFunding and empty topUpQuote}">
        <div><dt><spring:message code="charges.principalToRepay" /> (TZS)</dt><dd><fmt:formatNumber value="${app.amount}" minFractionDigits="2" maxFractionDigits="2" /></dd></div>
    </c:if>
    <div><dt><spring:message code="charges.deductions" /> (TZS)</dt><dd data-funding-deductions><fmt:formatNumber value="${fundingQuote.deductions}" minFractionDigits="2" maxFractionDigits="2" /></dd></div>
    <div><dt><spring:message code="charges.separate" /> (TZS)</dt><dd data-funding-separate><fmt:formatNumber value="${fundingQuote.separate}" minFractionDigits="2" maxFractionDigits="2" /></dd></div>
    <div><dt><spring:message code="recording.topUp.cash" /> (TZS)</dt><dd data-funding-cash><fmt:formatNumber value="${disbursementBaseAmount}" minFractionDigits="2" maxFractionDigits="2" /></dd></div>
</dl>
<c:choose><c:when test="${feeRecoveryFunding}">
    <dl class="loan-topup-facts" aria-live="polite">
        <div><dt><spring:message code="charges.fullPayout" /> (TZS)</dt><dd><fmt:formatNumber value="${app.amount}" minFractionDigits="2" maxFractionDigits="2" /></dd></div>
        <div><dt><spring:message code="charges.reducedPayout" /> (TZS)</dt><dd data-funding-reduced><fmt:formatNumber value="${fundingQuote.reducedCash}" minFractionDigits="2" maxFractionDigits="2" /></dd></div>
        <div><dt><spring:message code="charges.fundingManagementFees" /> (TZS)</dt><dd><fmt:formatNumber value="${fundingQuote.recoveryFees}" minFractionDigits="2" maxFractionDigits="2" /></dd></div>
    </dl>
    <div data-loan-choice data-category="money" data-choice-url="${pageContext.request.contextPath}/disbursement/loan-applications/${app.id}/posting-accounts/fee-money">
        <label><spring:message code="charges.fullPayoutFeeAccount" /><select name="feeReceivingAccountId" class="aws-control" data-choice-select="true">
            <option value="">${chooseLabel}</option><c:if test="${not empty postingFeeReceivingAccount}"><option value="${postingFeeReceivingAccount.id}" selected><c:out value="${postingFeeReceivingAccount.label}" /></option></c:if>
        </select></label>
        <%@ include file="../accounting/loans/choice-search.jspf" %>
    </div>
    <label><spring:message code="charges.fullPayoutFeeReference" /><input name="feePaymentReference" class="aws-control" maxlength="80" value="${fn:escapeXml(postingFeePaymentReference)}" /></label>
</c:when><c:otherwise><p><spring:message code="charges.notPaid" /></p></c:otherwise></c:choose>
</div></c:if>
<div class="md:col-span-2"><label><spring:message code="recording.paymentReference" />
    <input name="disbursementReference" class="aws-control" required maxlength="100" value="${fn:escapeXml(postingDisbursementReference)}" />
</label></div>
<div data-loan-choice data-category="money" data-choice-url="${pageContext.request.contextPath}/disbursement/loan-applications/${app.id}/posting-accounts/money">
    <label><spring:message code="recording.moneyAccount" /><select name="moneyAccountId" class="aws-control" data-choice-select="true" data-empty-message="<spring:message code='recording.noFundingAccounts' htmlEscape='true' />" required><option value="">${chooseLabel}</option><c:if test="${not empty postingMoneyAccount}"><option value="${postingMoneyAccount.id}" selected><c:out value="${postingMoneyAccount.label}" /></option></c:if></select></label>
    <%@ include file="../accounting/loans/choice-search.jspf" %>
</div>

<div class="md:col-span-2"><label><spring:message code="recording.attachments" /> (<spring:message code="${disbursementProofRequired?'common.required':'common.optional'}" />)
    <span class="attachment-dropzone" data-attachment-dropzone><input type="file" name="attachments" multiple accept=".pdf,.png,.jpg,.jpeg" class="attachment-dropzone-input" data-attachment-input ${disbursementProofRequired?'required':''} /><span class="attachment-dropzone-main"><span class="attachment-dropzone-copy"><span class="attachment-dropzone-title"><spring:message code="recording.attachments.drop" /></span><span class="attachment-dropzone-files" data-attachment-files><spring:message code="attachments.dropzone.none" /></span></span><span class="attachment-dropzone-action"><spring:message code="attachments.dropzone.chooseOne" text="Choose files" /></span></span></span>
</label></div>

<script src="<c:url value='/js/loan-topup.js' />" defer></script>
