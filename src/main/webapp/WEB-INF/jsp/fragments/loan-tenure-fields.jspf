<%@ page pageEncoding="UTF-8" %>
<div data-tenure-config class="loan-tenure-config">
    <label class="block text-xs font-semibold text-slate-500"><spring:message code="recording.tenureUnit" />
        <select name="tenureUnit" class="aws-control" required data-tenure-unit>
            <option value=""><spring:message code="recording.choose" /></option>
            <c:forEach items="${['DAYS','MONTHS','YEARS']}" var="tenureOption"><option value="${tenureOption}" ${tenureProduct.resolvedTenureUnit eq tenureOption ? 'selected' : ''}><spring:message code="recording.tenure.${tenureOption}" /></option></c:forEach>
        </select>
    </label>
    <div data-tenure-values ${empty tenureProduct ? 'hidden' : ''} class="loan-tenure-values">
        <label class="block text-xs font-semibold text-slate-500"><spring:message code="recording.minimumTenure" /><input name="minRepaymentMonths" type="number" min="1" step="1" required class="aws-control" value="${empty tenureProduct ? 1 : tenureProduct.resolvedMinimumTenure}" /></label>
        <label class="block text-xs font-semibold text-slate-500"><spring:message code="recording.maximumTenure" /><input name="maxRepaymentMonths" type="number" min="1" step="1" required class="aws-control" value="${empty tenureProduct ? 12 : tenureProduct.resolvedMaximumTenure}" /></label>
    </div>
</div>
