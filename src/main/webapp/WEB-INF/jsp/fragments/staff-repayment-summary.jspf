<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<c:if test="${not empty repaymentSummary}">
    <section class="erp-panel mt-5 overflow-hidden" data-staff-repayment-summary>
        <div class="flex items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3">
            <div>
                <div class="text-sm font-semibold uppercase tracking-wide text-slate-700"><spring:message code="loan.repayment.schedule" text="Repayment Schedule" /></div>
                <div class="mt-1 text-sm text-slate-500">
                    <c:choose>
                        <c:when test="${repaymentSummaryEstimated}"><spring:message code="loan.repayment.estimatedHelp" text="This is a calculated repayment schedule based on the applied loan amount." /></c:when>
                        <c:otherwise><spring:message code="loan.repayment.actualHelp" text="Actual repayment details recorded after disbursement." /></c:otherwise>
                    </c:choose>
                </div>
            </div>
            <div class="flex flex-wrap items-center justify-end gap-2">
                <c:if test="${repaymentSummaryEstimated}">
                    <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-800"><spring:message code="common.estimated" text="Estimated" /></span>
                </c:if>
                <c:if test="${not empty repaymentCountdown}">
                    <span class="rounded-full bg-sacco-blue/10 px-3 py-1 text-sm font-semibold text-sacco-blue">${repaymentCountdown}</span>
                </c:if>
            </div>
        </div>
        <div class="space-y-4 px-4 py-4">
            <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                <c:forEach items="${repaymentSummary}" var="entry">
                    <div class="erp-section-muted">
                        <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">${entry.key}</div>
                        <div class="mt-2 text-sm font-semibold text-slate-800">${entry.value}</div>
                    </div>
                </c:forEach>
            </div>

            <c:if test="${not empty calculatedRepaymentRows}">
                <details class="expected-schedule-details border border-slate-200 bg-white" open>
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-900">
                        <span>
                            <c:choose>
                                <c:when test="${not empty app.disbursementDate}">
                                    <spring:message code="loan.repayment.actualSchedule" text="Actual Repayment Schedule" />
                                </c:when>
                                <c:otherwise>
                                    <spring:message code="loan.repayment.calculatedSchedule" text="Calculated Repayment Schedule" />
                                </c:otherwise>
                            </c:choose>
                        </span>
                        <svg class="expected-schedule-chevron h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                        </svg>
                    </summary>
                    <div class="erp-table-wrap rounded-none border-0">
                        <div class="erp-table-scroll">
                        <table class="erp-table">
                            <thead>
                                <tr>
                                    <th class="px-3 py-2 text-left"><spring:message code="repayment.pmtNo" text="Pmt No." /></th>
                                    <th class="px-3 py-2 text-left"><spring:message code="repayment.month" text="Month" /></th>
                                    <th class="px-3 py-2 text-left"><spring:message code="repayment.beginningBalance" text="Beginning Balance" /></th>
                                    <th class="px-3 py-2 text-left"><spring:message code="repayment.amountToPay" text="Amount to Pay" /></th>
                                    <th class="px-3 py-2 text-left"><spring:message code="loan.amount.label" text="Loan Amount" /></th>
                                    <th class="px-3 py-2 text-left"><spring:message code="repayment.interest" text="Interest" /></th>
                                    <th class="px-3 py-2 text-left"><spring:message code="repayment.endingBalance" text="Ending Balance" /></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                            <c:forEach items="${calculatedRepaymentRows}" var="row">
                                <tr>
                                    <td class="px-3 py-2 font-medium text-slate-700">${row.pmtNo}</td>
                                    <td class="px-3 py-2">${row.month}</td>
                                    <td class="px-3 py-2">${row.beginningBalance}</td>
                                    <td class="px-3 py-2 font-medium text-slate-900">${row.payment}</td>
                                    <td class="px-3 py-2">${row.loanAmount}</td>
                                    <td class="px-3 py-2">${row.interest}</td>
                                    <td class="px-3 py-2">${row.endingBalance}</td>
                                </tr>
                            </c:forEach>
                            </tbody>
                        </table>
                    </div>
        </div>
                </details>
            </c:if>
        </div>
    </section>
</c:if>
