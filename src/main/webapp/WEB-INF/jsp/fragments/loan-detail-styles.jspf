        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
    }
    .guarantor-financial-modal-overlay.hidden {
        display: none !important;
    }
    .guarantor-financial-modal {
        width: min(100%, 28rem);
        border: 1px solid #d7e1ea;
        border-radius: 0.4rem;
        background: #ffffff;
        box-shadow: 0 18px 45px -22px rgba(23, 32, 51, 0.32);
        overflow: hidden;
    }
    .guarantor-financial-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.95rem 1rem 0.85rem;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
    }
    .guarantor-financial-modal-title {
