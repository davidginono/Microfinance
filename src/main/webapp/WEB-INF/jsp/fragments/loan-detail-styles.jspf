<style>
    .loan-view-hero-summary {
        border: 1px solid var(--panel-border);
        border-radius: 0.35rem;
        background: #ffffff;
        box-shadow: var(--panel-shadow);
        overflow: hidden;
    }
    .loan-view-summary-card {
        border: 1px solid #d7e1ea;
        border-radius: 0.35rem;
        background: #ffffff;
        box-shadow: none;
    }
    .loan-simple-progress {
        border: 1px solid #d7e1ea;
        border-radius: 0.35rem;
        background: #ffffff;
        padding: 1.2rem 1.3rem;
    }
    .loan-simple-progress-list {
        margin-top: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.95rem;
    }
    .loan-simple-progress-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        color: #1f3755;
        font-family: inherit;
        font-size: 0.92rem;
        line-height: 1.45;
    }
    .loan-simple-progress-dot {
        width: 0.95rem;
        height: 0.95rem;
        border-radius: 9999px;
        background: #cbd5e1;
        flex-shrink: 0;
    }
    .loan-simple-progress-item.is-active {
        font-weight: 600;
        color: #193252;
    }
    .loan-simple-progress-item.is-active .loan-simple-progress-dot {
        background: #1497b8;
    }
    .loan-simple-progress-item.is-current {
        font-weight: 700;
        color: #0f172a;
    }
    .loan-simple-progress-item.is-current .loan-simple-progress-dot {
        background: #0f172a;
    }
    .loan-simple-progress-item.is-pending {
        color: #64748b;
        font-weight: 400;
    }
    .loan-simple-progress-content {
        min-width: 0;
    }
    .loan-simple-progress-label,
    .loan-simple-progress-state {
        display: block;
    }
    .loan-simple-progress-pill {
        display: none;
    }
    .loan-staff-review-template {
        border-color: #dfe5eb;
        border-radius: 0.35rem;
        background: #ffffff;
        box-shadow: 0 14px 35px -28px rgba(15, 23, 42, 0.32);
    }
    .loan-staff-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
        gap: 0.75rem;
    }
    .loan-staff-kpi-card {
        min-height: 5.55rem;
        display: grid;
        grid-template-columns: 2.45rem minmax(0, 1fr);
        align-items: center;
        gap: 0.75rem;
        padding: 0.95rem 1rem;
    }
    .loan-staff-kpi-icon {
        display: inline-flex;
        grid-row: 1 / span 2;
        width: 2.45rem;
        height: 2.45rem;
        align-items: center;
        justify-content: center;
        border: 1px solid #bde8cf;
        border-radius: 9999px;
        background: #eaf8ef;
        color: #16a45d;
        box-shadow: inset 0 0 0 0.35rem rgba(255, 255, 255, 0.38);
    }
    .loan-staff-kpi-icon svg {
        width: 1.2rem;
        height: 1.2rem;
    }
    .loan-staff-review-template .loan-stat-label {
        grid-column: 2;
        min-width: 0;
        letter-spacing: 0.14em;
        color: #5f6b7a;
        font-size: 0.78rem;
        line-height: 1.25;
        overflow-wrap: anywhere;
    }
    .loan-staff-review-template .loan-stat-value {
        grid-column: 2;
        min-width: 0;
        margin-top: 0.35rem;
        color: #0f172a;
        font-size: 1.02rem;
        font-weight: 700;
        letter-spacing: 0;
        overflow-wrap: anywhere;
    }
    .loan-staff-review-template .loan-simple-progress {
        margin-top: 1.35rem;
        padding: 1.15rem 1.25rem 1.25rem;
        border-color: #dfe5eb;
        border-radius: 0.35rem;
        box-shadow: 0 10px 24px -28px rgba(15, 23, 42, 0.18);
    }
    .loan-staff-review-template .loan-simple-progress h3 {
        margin-bottom: 0.8rem;
        color: #0f172a;
        font-size: 1.1rem;
        font-weight: 700;
    }
    .loan-staff-review-template .loan-simple-progress-list {
        gap: 0;
        margin-top: 0;
    }
    .loan-staff-review-template .loan-simple-progress-item {
        position: relative;
        min-height: 3.25rem;
        display: grid;
        grid-template-columns: 2rem minmax(0, 1fr);
        align-items: start;
        gap: 0.75rem;
        padding: 0.15rem 0 0.8rem;
        color: #0f172a;
        font-size: 0.94rem;
    }
    .loan-staff-review-template .loan-simple-progress-item::before {
        content: "";
        position: absolute;
        left: 0.93rem;
        top: 1.85rem;
        bottom: -0.18rem;
        width: 2px;
        background: #2bbd72;
    }
    .loan-staff-review-template .loan-simple-progress-item::after {
        content: "";
        position: absolute;
        left: 2.75rem;
        right: 0;
        bottom: 0;
        height: 1px;
        background: #e2e8f0;
    }
    .loan-staff-review-template .loan-simple-progress-item:last-child {
        min-height: 2.2rem;
        padding-bottom: 0;
    }
    .loan-staff-review-template .loan-simple-progress-item:last-child::before,
    .loan-staff-review-template .loan-simple-progress-item:last-child::after {
        display: none;
    }
    .loan-staff-review-template .loan-simple-progress-item.is-current::before {
        background: #0b5faf;
    }
    .loan-staff-review-template .loan-simple-progress-item.is-pending::before {
        background: repeating-linear-gradient(to bottom, #cbd5e1 0, #cbd5e1 0.45rem, transparent 0.45rem, transparent 0.82rem);
    }
    .loan-staff-review-template .loan-simple-progress-dot {
        position: relative;
        z-index: 1;
        width: 1.85rem;
        height: 1.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #27b96d;
        background: #2bbd72;
        color: #ffffff;
        box-shadow: 0 8px 16px -10px rgba(15, 23, 42, 0.45);
    }
    .loan-staff-review-template .loan-simple-progress-item.is-active .loan-simple-progress-dot {
        background: #2bbd72;
    }
    .loan-staff-review-template .loan-simple-progress-item.is-active:not(.is-current) .loan-simple-progress-dot::before {
        content: "";
        width: 0.7rem;
        height: 0.38rem;
        border-left: 0.16rem solid currentColor;
        border-bottom: 0.16rem solid currentColor;
        transform: rotate(-45deg) translate(0.03rem, -0.04rem);
    }
    .loan-staff-review-template .loan-simple-progress-item.is-current {
        margin: 0 -0.65rem 0.75rem;
        min-height: 3.05rem;
        align-items: center;
        border-radius: 0.35rem;
        background: #f1f8ff;
        padding: 0.65rem;
        color: #0b5faf;
    }
    .loan-staff-review-template .loan-simple-progress-item.is-current .loan-simple-progress-dot {
        width: 1.85rem;
        height: 1.85rem;
        border: 0.24rem solid #0b5faf;
        background: #ffffff;
        box-shadow: inset 0 0 0 0.25rem #ffffff;
    }
    .loan-staff-review-template .loan-simple-progress-item.is-pending {
        color: #0f172a;
        font-weight: 500;
    }
    .loan-staff-review-template .loan-simple-progress-item.is-pending .loan-simple-progress-dot {
        border-color: #cbd5e1;
        background: #ffffff;
        box-shadow: none;
    }
    .loan-staff-review-template .loan-simple-progress-content {
        position: relative;
        min-height: 1.9rem;
        padding-top: 0.08rem;
        padding-right: 9rem;
    }
    .loan-staff-review-template .loan-simple-progress-label {
        color: inherit;
        font-size: 0.93rem;
        font-weight: 700;
        line-height: 1.25;
        text-transform: uppercase;
    }
    .loan-staff-review-template .loan-simple-progress-state {
        margin-top: 0.22rem;
        color: #334155;
        font-size: 0.84rem;
        font-weight: 500;
        text-transform: none;
    }
    .loan-staff-review-template .loan-simple-progress-item.is-current .loan-simple-progress-state {
        color: #0b5faf;
    }
    .loan-staff-review-template .loan-simple-progress-pill {
        position: absolute;
        right: 0;
        top: 50%;
        display: inline-flex;
        transform: translateY(-50%);
        align-items: center;
        justify-content: center;
        border: 1px solid #a8cdf4;
        border-radius: 9999px;
        background: #dff0ff;
        padding: 0.32rem 0.75rem;
        color: #0b5faf;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
    }
    @media (max-width: 640px) {
        .loan-staff-kpi-grid {
            grid-template-columns: 1fr;
        }
        .loan-staff-review-template .loan-simple-progress {
            padding: 1.2rem 1rem;
        }
        .loan-staff-review-template .loan-simple-progress-item {
            grid-template-columns: 2.5rem minmax(0, 1fr);
            gap: 0.75rem;
        }
        .loan-staff-review-template .loan-simple-progress-item::before {
            left: 1.2rem;
        }
        .loan-staff-review-template .loan-simple-progress-item::after {
            left: 3.25rem;
        }
        .loan-staff-review-template .loan-simple-progress-dot,
        .loan-staff-review-template .loan-simple-progress-item.is-current .loan-simple-progress-dot {
            width: 2.4rem;
            height: 2.4rem;
        }
        .loan-staff-review-template .loan-simple-progress-content {
            padding-right: 0;
        }
        .loan-staff-review-template .loan-simple-progress-pill {
            position: static;
            margin-top: 0.7rem;
            transform: none;
        }
    }
    .loan-hero-primary-grid {
        display: grid;
        gap: 0.9rem 1.35rem;
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
    .loan-hero-inline-fact {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-wrap: wrap;
