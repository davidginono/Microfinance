<script>
    (window.WorkspaceNavigation?.onReady || (callback => callback()))(() => {

        document.querySelectorAll('[data-product-modal]').forEach((modal) => {
            modal.style.position = 'fixed';
            modal.style.inset = '0';
            modal.style.zIndex = '90';
            document.body.appendChild(modal);
        });

        function normalizeMoneyValue(value) {
            return String(value || '')
                .replace(/,/g, '')
                .replace(/[^\d.]/g, '')
                .replace(/(\..*)\./g, '$1');
        }

        function trimMoneyDecimalZeros(value) {
            if (!value || !value.includes('.')) {
                return value || '';
            }
            return value.replace(/(\.\d*?)0+$/, '$1').replace(/\.$/, '');
        }

        function formatMoneyValue(value, trimDecimals) {
            const raw = normalizeMoneyValue(value);
            if (raw === '') {
                return '';
            }
            const normalized = trimDecimals ? trimMoneyDecimalZeros(raw) : raw;
            const parts = normalized.split('.');
            const grouped = parts[0].replace(/^0+(?=\d)/, '').replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            return parts.length > 1 ? grouped + '.' + parts.slice(1).join('') : grouped;
        }

        function loanProductDraftValues(form) {
            const draft = form.querySelector('[data-loan-product-form-draft]');
            const valuesByName = new Map();
            if (!draft) {
                return valuesByName;
            }
            draft.querySelectorAll('[data-loan-product-form-value]').forEach((node) => {
                const name = node.getAttribute('data-loan-product-form-value');
                if (!name) {
                    return;
                }
                const values = valuesByName.get(name) || [];
                values.push(node.textContent || '');
                valuesByName.set(name, values);
            });
            return valuesByName;
        }

        function restoreLoanProductAttachmentRows(form, valuesByName) {
            const list = form.querySelector('[data-required-attachments-list]');
            const attachmentNames = valuesByName.get('requiredAttachmentName') || [];
            if (!list || !attachmentNames.length) {
                return;
            }
            const attachmentSizes = valuesByName.get('requiredAttachmentMaxSizeMb') || [];
            list.innerHTML = '';
            attachmentNames.forEach((name, index) => {
                list.appendChild(requiredAttachmentRow(name, attachmentSizes[index] || '5.00'));
            });
        }

        function restoreLoanProductFormDraft(form) {
            const valuesByName = loanProductDraftValues(form);
            if (!valuesByName.size) {
                return;
            }
            restoreLoanProductAttachmentRows(form, valuesByName);
            valuesByName.forEach((values, name) => {
                const fields = Array.from(form.elements).filter((field) => field.name === name);
                if (!fields.length) {
                    return;
                }
                const checkboxes = fields.filter((field) => field.type === 'checkbox');
                if (checkboxes.length) {
                    checkboxes.forEach((field) => {
                        field.checked = values.includes(field.value);
                    });
                    return;
                }
                const radios = fields.filter((field) => field.type === 'radio');
                if (radios.length) {
                    radios.forEach((field) => {
                        field.checked = values.includes(field.value);
                    });
                    return;
                }
                fields.forEach((field, index) => {
                    if (field.type === 'file') {
                        return;
                    }
                    field.value = values[index] !== undefined ? values[index] : (values[0] || '');
                });
            });
        }

        document.querySelectorAll('[data-loan-product-form-draft]').forEach((draft) => {
            const form = draft.closest('form');
            if (form) {
                restoreLoanProductFormDraft(form);
            }
        });

        function syncMoneyInput(input, trimDecimals) {
            input.value = formatMoneyValue(input.value, trimDecimals);
        }

        function trimDecimalZeros(value) {
            const raw = String(value || '').trim();
            if (raw === '') {
                return '';
            }
            const numericValue = Number(raw);
            return Number.isFinite(numericValue) ? String(numericValue) : raw;
        }

        document.querySelectorAll('[data-money-input="true"]').forEach((input) => {
            syncMoneyInput(input, true);
            input.addEventListener('input', () => syncMoneyInput(input, false));
            input.addEventListener('blur', () => syncMoneyInput(input, true));
        });

        document.querySelectorAll('[data-trim-decimal-input="true"]').forEach((input) => {
            input.value = trimDecimalZeros(input.value);
            input.addEventListener('blur', () => {
                input.value = trimDecimalZeros(input.value);
            });
        });

        document.querySelectorAll('form').forEach((form) => {
            if (!form.querySelector('[data-money-input="true"]')) {
                return;
            }
            form.addEventListener('submit', () => {
                form.querySelectorAll('[data-money-input="true"]').forEach((input) => {
                    input.value = normalizeMoneyValue(input.value);
                });
            });
        });

        function enforceNumericTextLength(input) {
            if (!input || typeof input.value !== 'string') {
                return;
            }
            const maxLength = Number(input.getAttribute('data-numeric-maxlength') || 15);
            if (!Number.isFinite(maxLength) || maxLength <= 0 || input.value.length <= maxLength) {
                return;
            }
            input.value = input.value.slice(0, maxLength);
        }

        function enforceNumberRange(input) {
            if (!input || input.value === '') {
                return;
            }
            const value = Number(input.value);
            if (!Number.isFinite(value)) {
                return;
            }
            const minValue = input.hasAttribute('min') ? Number(input.getAttribute('min')) : Number.NaN;
            const maxValue = Number(input.getAttribute('data-number-range-max') || input.getAttribute('max'));
            if (Number.isFinite(minValue) && value < minValue) {
                input.value = String(minValue);
            } else if (Number.isFinite(maxValue) && value > maxValue) {
                input.value = String(maxValue);
            }
        }

        document.querySelectorAll('input[type="number"], input[inputmode="decimal"], input[data-money-input="true"]').forEach((input) => {
            input.setAttribute('maxlength', input.getAttribute('maxlength') || '15');
            input.setAttribute('data-numeric-maxlength', input.getAttribute('data-numeric-maxlength') || '15');
            enforceNumericTextLength(input);
            input.addEventListener('input', () => enforceNumericTextLength(input));
            input.addEventListener('change', () => enforceNumericTextLength(input));
        });

        document.querySelectorAll('input[data-number-range-max]').forEach((input) => {
            enforceNumberRange(input);
            input.addEventListener('input', () => enforceNumberRange(input));
            input.addEventListener('change', () => enforceNumberRange(input));
        });

        function resolveFieldTargets(form, key) {
            const field = Array.from(form.elements).find(field => field.name === key);
            return field ? [field] : [];
        }

        function fieldErrorContainer(target) {
            if (!target) {
                return null;
            }
            if (target.hasAttribute && target.hasAttribute('data-field-group')) {
                return target;
            }
            return target.closest('label')
                || target.parentElement
                || target;
        }

        function applyFieldError(form, key, message) {
            const targets = resolveFieldTargets(form, key);
            if (!targets.length) {
                return;
            }
            targets.forEach((target, index) => {
                const container = fieldErrorContainer(target);
                if (!container) {
                    return;
                }
                if (target.matches && target.matches('input, select, textarea')) {
                    target.classList.add('field-error-input');
                    target.setAttribute('aria-invalid', 'true');
                }
                container.classList.add('field-error-container');
                if (index > 0 || container.querySelector('[data-field-error-for="' + key + '"]')) {
                    return;
                }
                const note = document.createElement('p');
                note.className = 'field-error-text';
                note.setAttribute('data-field-error-for', key);
                note.textContent = message;
                container.appendChild(note);
            });
        }

        function revealFieldErrorTarget(target) {
            if (!target) {
                return;
            }
            let disclosure = target.closest('details');
            while (disclosure) {
                disclosure.open = true;
                disclosure = disclosure.parentElement ? disclosure.parentElement.closest('details') : null;
            }
            const container = fieldErrorContainer(target) || target;
            const scrollBox = target.closest('.app-modal-scroll');
            if (scrollBox) {
                const targetRect = container.getBoundingClientRect();
                const scrollRect = scrollBox.getBoundingClientRect();
                const desiredTop = scrollBox.scrollTop + targetRect.top - scrollRect.top - Math.max(24, scrollBox.clientHeight * 0.25);
                scrollBox.scrollTo({
                    top: Math.max(0, desiredTop),
                    behavior: 'instant'
                });
            } else if (typeof container.scrollIntoView === 'function') {
                container.scrollIntoView({ behavior: 'instant', block: 'center' });
            }
            if (target.matches && target.matches('input, select, textarea')) {
                target.focus({ preventScroll: true });
            }
        }

        function applyServerFieldErrors(form) {
            const errorNodes = form.querySelectorAll('[data-modal-field-error]');
            errorNodes.forEach((node) => {
                const key = node.getAttribute('data-modal-field-error');
                const message = node.textContent.trim();
                if (key && message) {
                    applyFieldError(form, key, message);
                }
            });
        }

        function numericValue(input, fallback) {
            if (!input) {
                return fallback;
            }
            const value = Number(input.value);
            return Number.isFinite(value) ? value : fallback;
        }

        function generateProductCode(name) {
            if (!name) {
                return '';
            }
            return name
                .toUpperCase()
                .replace(/[^A-Z0-9]+/g, '_')
                .replace(/^_+|_+$/g, '')
                .slice(0, 64);
        }

        document.querySelectorAll('[data-workflow-form]').forEach((form) => {
            const code=form.querySelector('[data-product-code-field]'), name=form.querySelector('[data-product-name-field]');
            if(code?.hasAttribute('data-product-code-generated') && name){
                const sync=()=>{code.value=generateProductCode(name.value);};name.addEventListener('input',sync);sync();
            }
            applyServerFieldErrors(form);
        });
        function requiredAttachmentRow(name, maxSizeMb) {
            const row = document.createElement('div');
            row.className = 'grid gap-2 rounded border border-slate-200 bg-slate-50 p-2 sm:grid-cols-[minmax(0,1fr)_8rem_auto]';
            row.setAttribute('data-required-attachment-row', 'true');
            row.innerHTML =
                '<label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Name' +
                '<input name="requiredAttachmentName" type="text" maxlength="120" class="mt-1 w-full rounded border border-slate-300 px-3 py-2 text-sm text-slate-800" /></label>' +
                '<label class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Max MB' +
                '<input name="requiredAttachmentMaxSizeMb" type="number" min="0.01" max="100" step="0.01" class="mt-1 w-full rounded border border-slate-300 px-3 py-2 text-sm text-slate-800" /></label>' +
                '<button type="button" class="app-btn btn-neutral self-end" data-remove-required-attachment>Remove</button>';
            row.querySelector('[name="requiredAttachmentName"]').value = name || '';
            row.querySelector('[name="requiredAttachmentMaxSizeMb"]').value = maxSizeMb || '5.00';
            return row;
        }

        function syncRequiredAttachmentPanel(form) {
            const toggle = form.querySelector('[data-required-attachments-toggle]');
            const panel = form.querySelector('[data-required-attachments-panel]');
            const list = form.querySelector('[data-required-attachments-list]');
            if (!toggle || !panel) {
                return;
            }
            if (list) {
                const render = () => {
                    const enabled = toggle.checked;
                    panel.classList.toggle('hidden', !enabled);
                    if (enabled && !list.querySelector('[data-required-attachment-row]')) {
                        list.appendChild(requiredAttachmentRow('', '5.00'));
                    }
                };
                toggle.addEventListener('change', render);
                form.querySelectorAll('[data-add-required-attachment]').forEach((button) => {
                    button.addEventListener('click', () => {
                        list.appendChild(requiredAttachmentRow('', '5.00'));
                    });
                });
                list.addEventListener('click', (event) => {
                    const button = event.target.closest('[data-remove-required-attachment]');
                    if (!button) {
                        return;
                    }
                    const row = button.closest('[data-required-attachment-row]');
                    if (row) {
                        row.remove();
                    }
                });
                render();
                return;
            }

            const addButton = form.querySelector('[data-required-attachment-add]');
            const attachmentForm = form.querySelector('[data-required-attachment-form]');
            const cancelButton = form.querySelector('[data-required-attachment-cancel]');
            const hideEntryForm = () => {
                attachmentForm?.classList.add('hidden');
                addButton?.classList.remove('hidden');
            };
            const render = () => {
                panel.classList.toggle('hidden', !toggle.checked);
                if (!toggle.checked) {
                    hideEntryForm();
                }
            };
            addButton?.addEventListener('click', () => {
                attachmentForm?.classList.remove('hidden');
                addButton.classList.add('hidden');
                attachmentForm?.querySelector('input[name="attachmentName"]')?.focus();
            });
            cancelButton?.addEventListener('click', hideEntryForm);
            document.getElementById('requiredAttachmentCreateForm')?.addEventListener('submit', hideEntryForm);
            toggle.addEventListener('change', render);
            render();
        }

        document.querySelectorAll('form').forEach(syncRequiredAttachmentPanel);

        let productModalScrollState = null;
        let productModalOpener = null;
        function closeAllProductModals() {
            document.querySelectorAll('[data-product-modal]').forEach((modal) => {
                modal.classList.add('hidden');
                modal.classList.remove('is-open');
                modal.setAttribute('aria-hidden', 'true');
            });
            if (productModalScrollState) {
                body.style.overflow = productModalScrollState.body;
                document.documentElement.style.overflow = productModalScrollState.root;
                body.classList.toggle('overflow-hidden', productModalScrollState.locked);
                productModalScrollState = null;
                productModalOpener?.focus({preventScroll: true});
            } else if (!document.querySelector('.app-modal-overlay.is-open')) {
                // The shared navigation restorer can reopen a dialog without its opener.
                body.classList.remove('overflow-hidden');
            }
        }

        function openProductModal(modal, opener) {
            productModalOpener = opener || document.activeElement;
            productModalScrollState = {body: body.style.overflow, root: document.documentElement.style.overflow, locked: body.classList.contains('overflow-hidden')};
            modal.classList.remove('hidden');
            modal.classList.add('is-open');
            modal.setAttribute('aria-hidden', 'false');
            const panel = modal.querySelector('.app-modal-panel');
            panel.setAttribute('role', 'dialog');
            panel.setAttribute('aria-modal', 'true');
            const title = modal.querySelector('.app-modal-header h2');
            if (title) { title.id ||= 'product-modal-title-' + modal.dataset.productModal; panel.setAttribute('aria-labelledby', title.id); }
            body.classList.add('overflow-hidden');
            body.style.overflow = 'hidden';
            document.documentElement.style.overflow = 'hidden';
            modal.querySelector('input:not([type=hidden]),select,button')?.focus({preventScroll: true});
        }

        document.querySelectorAll('[data-product-modal-open]').forEach((button) => {
            button.addEventListener('click', () => {
                const key = button.getAttribute('data-product-modal-open');
                closeAllProductModals();
                const modal = document.querySelector('[data-product-modal="' + key + '"]');
                if (modal) {
                    openProductModal(modal, button);
                    modal.querySelectorAll('[data-product-workflow-builder="true"]').forEach((form) => {
                        form.dispatchEvent(new Event('workflow:refresh'));
                    });
                }
            });
        });

        document.querySelectorAll('[data-product-modal-close]').forEach((button) => {
            button.addEventListener('click', closeAllProductModals);
        });

        const initialModalTarget = document.querySelector('[data-open-product-modal]');
        if (initialModalTarget) {
            const key = initialModalTarget.getAttribute('data-open-product-modal');
            const modal = key ? document.querySelector('[data-product-modal="' + key + '"]') : null;
            if (modal) {
                closeAllProductModals();
                openProductModal(modal);
                const modalScroll = modal.querySelector('.app-modal-scroll');
                const firstServerError = modal.querySelector('.field-error-input');
                if (firstServerError) {
                    window.setTimeout(() => revealFieldErrorTarget(firstServerError), 80);
                } else if (modalScroll) {
                    modalScroll.scrollTop = 0;
                }
            }
        }

        document.querySelectorAll('[data-product-modal]').forEach(modal => {
            modal.addEventListener('keydown', event => {
                if (event.defaultPrevented || !modal.classList.contains('is-open')) return;
                if (event.key === 'Escape') { event.preventDefault(); modal.querySelector('[data-product-modal-close]')?.click(); }
                if (event.key !== 'Tab') return;
                const controls = [...modal.querySelectorAll('a[href],button,input:not([type=hidden]),select,textarea,[tabindex="0"]')]
                    .filter(control => !control.disabled && !control.closest('[hidden],.hidden') && control.getClientRects().length);
                if (!controls.length) return;
                const first = controls[0], last = controls.at(-1);
                if (event.shiftKey && document.activeElement === first) {event.preventDefault();last.focus();}
                else if (!event.shiftKey && document.activeElement === last) {event.preventDefault();first.focus();}
            });
        });

        const createdLoanProductTarget = document.querySelector('[data-created-loan-product-target="true"]');
        if (createdLoanProductTarget) {
            closeAllProductModals();
            createdLoanProductTarget.scrollIntoView({block:'center'});
            createdLoanProductTarget.focus({ preventScroll: true });
        }

        document.querySelectorAll('[data-product-card-toggle]').forEach((button) => {
            const card = button.closest('[data-product-config-card]');
            const label = button.querySelector('[data-product-card-toggle-label]');
            if (!card) {
                return;
            }
            button.addEventListener('click', () => {
                const expanded = button.getAttribute('aria-expanded') !== 'true';
                button.setAttribute('aria-expanded', String(expanded));
                card.classList.toggle('is-expanded', expanded);
                if (label) {
                    label.textContent = expanded ? 'Show less' : 'See more';
                }
            });
        });

        document.querySelectorAll('[data-product-config-workspace]').forEach((workspace) => {
            const form = workspace.querySelector('[data-product-config-form]');
            const navButtons = Array.from(workspace.querySelectorAll('[data-product-config-nav]'));
            const stepOrder = navButtons.map((button) => button.getAttribute('data-product-config-nav'));
            const steps = Array.from(workspace.querySelectorAll('[data-product-config-step]'))
                .sort((a, b) => stepOrder.indexOf(a.getAttribute('data-product-config-step')) - stepOrder.indexOf(b.getAttribute('data-product-config-step')));
            const previousButton = workspace.querySelector('[data-product-config-previous]');
            const nextButton = workspace.querySelector('[data-product-config-next]');
            const saveState = workspace.querySelector('[data-product-config-save-state]');
            const storageKey = workspace.getAttribute('data-product-config-storage-key');
            const tabList = workspace.querySelector('[data-product-config-tabs]');

            if (!form || !steps.length) {
                return;
            }

            workspace.classList.add('is-enhanced');

            const stepIndex = (key) => steps.findIndex((step) => step.getAttribute('data-product-config-step') === key);
            const stepLabel = (index) => {
                if (index < 0 || index >= steps.length) {
                    return 'section';
                }
                const key = steps[index].getAttribute('data-product-config-step');
                const nav = navButtons.find((button) => button.getAttribute('data-product-config-nav') === key);
                return nav?.querySelector('strong')?.textContent.trim() || 'section';
            };
            const workflowScrollTarget = (step) => {
                return step.getAttribute('data-product-config-step') === 'evidence'
                    ? step.querySelector('.product-config-subsection')
                    : null;
            };
            const workflowScrollOffset = () => {
                const workspaceNav = workspace.querySelector('.product-config-workspace-nav');
                if (workspaceNav && window.getComputedStyle) {
                    const navStyle = window.getComputedStyle(workspaceNav);
                    if (navStyle.position === 'sticky') {
                        const stickyTop = Number.parseFloat(navStyle.top);
                        const resolvedTop = Number.isFinite(stickyTop)
                            ? stickyTop
                            : Math.max(0, workspaceNav.getBoundingClientRect().top);
                        return Math.ceil(resolvedTop + workspaceNav.offsetHeight + 12);
                    }
                }

                const pageHeader = document.querySelector('.erp-page-header[data-aws-page-header]');
                return pageHeader ? Math.ceil(Math.max(0, pageHeader.getBoundingClientRect().bottom) + 12) : 12;
            };
            const scrollStepIntoView = (step, behavior = 'instant') => {
                const target = workflowScrollTarget(step) || step;
                if (typeof window.scrollTo === 'function') {
                    const scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
                    const targetTop = target.getBoundingClientRect().top + scrollY - workflowScrollOffset();
                    window.scrollTo({ top: Math.max(0, targetTop), behavior });
                    return;
                }
                target.scrollIntoView({ behavior, block: 'start' });
            };

            const activateStep = (key, options = {}) => {
                let activeIndex = stepIndex(key);
                if (activeIndex < 0) {
                    activeIndex = 0;
                }
                const productActions = workspace.querySelector('.product-config-actionbar');
                if (productActions) productActions.hidden = steps[activeIndex].getAttribute('data-product-config-step') === 'workflow';

                steps.forEach((step, index) => {
                    const active = index === activeIndex;
                    const panel = step.querySelector('[data-product-config-panel]');
                    step.classList.toggle('is-active', active);
                    if (tabList) {
                        step.hidden = !active;
                        step.setAttribute('role', 'tabpanel');
                        step.id ||= 'product-section-' + step.getAttribute('data-product-config-step');
                        step.setAttribute('aria-labelledby', 'product-tab-' + step.getAttribute('data-product-config-step'));
                    }
                    if (panel) {
                        panel.hidden = !active;
                    }
                });

                navButtons.forEach((button) => {
                    if (tabList) {
                        const key = button.getAttribute('data-product-config-nav');
                        const selected = key === steps[activeIndex].getAttribute('data-product-config-step');
                        button.id = 'product-tab-' + key;
                        button.setAttribute('role', 'tab');
                        button.setAttribute('aria-controls', 'product-section-' + key);
                        button.setAttribute('aria-selected', String(selected));
                        button.tabIndex = selected ? 0 : -1;
                    }
                    if (button.getAttribute('data-product-config-nav') === steps[activeIndex].getAttribute('data-product-config-step')) {
                        button.setAttribute('aria-current', 'step');
                    } else {
                        button.removeAttribute('aria-current');
                    }
                });

                if (previousButton) {
                    previousButton.disabled = activeIndex === 0;
                    previousButton.textContent = activeIndex === 0 ? 'Previous section' : 'Back to ' + stepLabel(activeIndex - 1);
                }
                if (nextButton) {
                    nextButton.disabled = activeIndex === steps.length - 1;
                    nextButton.textContent = activeIndex === steps.length - 1 ? 'All sections reviewed' : 'Continue to ' + stepLabel(activeIndex + 1);
                }

                if (storageKey) {
                    try {
                        window.sessionStorage.setItem(storageKey, steps[activeIndex].getAttribute('data-product-config-step'));
                    } catch (ignored) {
                        // Storage can be unavailable in privacy-restricted browser contexts.
                    }
                }

                if (options.scroll) {
                    window.requestAnimationFrame(() => scrollStepIntoView(steps[activeIndex]));
                }
                if (options.focus) {
                    navButtons.find((button) => button.getAttribute('aria-current') === 'step')?.focus({ preventScroll: true });
                }
            };

            const activeIndex = () => steps.findIndex((step) => step.classList.contains('is-active'));
            const moveStep = (offset) => {
                const targetIndex = Math.min(steps.length - 1, Math.max(0, activeIndex() + offset));
                activateStep(steps[targetIndex].getAttribute('data-product-config-step'), { scroll: true, focus: true });
            };

            navButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    activateStep(button.getAttribute('data-product-config-nav'), { scroll: true, focus: true });
                });
                if (tabList) button.addEventListener('keydown', (event) => {
                    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
                    event.preventDefault();
                    const index = navButtons.indexOf(button);
                    const next = event.key === 'Home' ? 0 : event.key === 'End' ? navButtons.length - 1
                        : (index + (event.key === 'ArrowRight' ? 1 : -1) + navButtons.length) % navButtons.length;
                    activateStep(navButtons[next].getAttribute('data-product-config-nav'), { focus: true });
                });
            });
            previousButton?.addEventListener('click', () => moveStep(-1));
            nextButton?.addEventListener('click', () => moveStep(1));

            form.addEventListener('invalid', (event) => {
                const disclosure = event.target.closest('details.product-config-subsection');
                if (disclosure) {
                    disclosure.open = true;
                }
                const step = event.target.closest('[data-product-config-step]');
                if (step) {
                    activateStep(step.getAttribute('data-product-config-step'));
                }
            }, true);

            form.addEventListener('input', () => {
                if (saveState) {
                    saveState.textContent = saveState.dataset.unsavedLabel || 'Unsaved changes';
                    saveState.classList.add('is-dirty');
                }
            });

            form.addEventListener('submit', (event) => {
                if (!event.defaultPrevented) {
                    return;
                }
                const firstError = form.querySelector('.field-error-input, [aria-invalid="true"]');
                const errorStep = firstError?.closest('[data-product-config-step]');
                if (errorStep) {
                    activateStep(errorStep.getAttribute('data-product-config-step'));
                }
            });

            const firstServerError = form.querySelector('.field-error-input, [aria-invalid="true"]');
            let initialKey = workspace.querySelector('[data-product-approval-form] [role="alert"]') || new URL(window.location.href).searchParams.get('tab') === 'workflow'
                ? 'workflow' : firstServerError?.closest('[data-product-config-step]')?.getAttribute('data-product-config-step');
            if (workspace.querySelector('[data-product-config-step="accounts"] [role="alert"]') || new URL(window.location.href).searchParams.get('tab') === 'accounts') initialKey = 'accounts';
            if (!initialKey && storageKey) {
                try {
                    initialKey = window.sessionStorage.getItem(storageKey);
                } catch (ignored) {
                    initialKey = null;
                }
            }
            const resolvedInitialKey = initialKey || steps[0].getAttribute('data-product-config-step');
            activateStep(resolvedInitialKey);
        });
    });
</script>
