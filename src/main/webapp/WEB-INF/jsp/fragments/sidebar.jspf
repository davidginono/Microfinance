<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<c:set var="requestUri" value="${empty requestScope['jakarta.servlet.forward.request_uri']?pageContext.request.requestURI:requestScope['jakarta.servlet.forward.request_uri']}" />

<c:set var="staffWorkspace" value="${not empty currentMember and currentMember.staffSession}" />
<aside id="appSidebar" class="app-sidebar shell-sidebar fixed bottom-0 left-0 z-40 -translate-x-full border-r transition-transform duration-300 ease-out lg:translate-x-0">
    <div class="shell-sidebar-panel flex h-full flex-col overflow-hidden border-r border-slate-200/60 bg-transparent">
        <div class="shell-sidebar-toggle-row hidden lg:flex">

            <c:if test="${staffWorkspace}">
                <sec:authorize access="@access.isAdminScope(principal)">
                    <span class="shell-sidebar-toggle-label"><spring:message code="admin.tools" text="Admin Tools" /></span>
                </sec:authorize>
                <sec:authorize access="!@access.isAdminScope(principal)">
                    <span class="shell-sidebar-toggle-label"><spring:message code="menu.staffWorkspace" text="Staff Workspace" /></span>
                </sec:authorize>
            </c:if>
            <button id="desktopSidebarToggle" type="button" class="desktop-sidebar-toggle" aria-controls="shellSidebarNavigation" aria-label="<spring:message code='shell.navigation.expand' />" aria-expanded="false" data-expand-label="<spring:message code='shell.navigation.expand' />" data-collapse-label="<spring:message code='shell.navigation.collapse' />" title="<spring:message code='shell.navigation.expand' />">
                <svg class="desktop-sidebar-toggle__collapse" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="m5.3 4.2 4.7 4.7 4.7-4.7 1.1 1.1-4.7 4.7 4.7 4.7-1.1 1.1-4.7-4.7-4.7 4.7-1.1-1.1 4.7-4.7-4.7-4.7z"/>
                </svg>
                <svg class="desktop-sidebar-toggle__expand" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
        </div>
        <nav id="shellSidebarNavigation" class="shell-sidebar-scroll flex-1 space-y-1.5 px-2 pb-2 pt-0 lg:space-y-2 lg:px-3 lg:pb-3 lg:pt-0" data-view-position-key="sidebar-navigation">
            <c:if test="${staffWorkspace}">
                <%@ include file="staff-offices.jspf" %>
                <sec:authorize access="@access.has(principal,'GUARANTOR_CAPACITY_VIEW')"><a href="<c:url value='/finance/credit/guarantors'/>" class="shell-sidebar-subitem block px-3 py-2 text-sm font-semibold ${fn:startsWith(requestUri,'/finance/credit/guarantors')?'shell-nav-active':''}"><spring:message code="credit.title.guarantors"/></a></sec:authorize>
                <sec:authorize access="@access.has(principal,'COLLATERAL_VIEW')"><a href="<c:url value='/finance/credit/collateral'/>" class="shell-sidebar-subitem block px-3 py-2 text-sm font-semibold ${fn:startsWith(requestUri,'/finance/credit/collateral')?'shell-nav-active':''}"><spring:message code="credit.title.collateral"/></a></sec:authorize>
                <sec:authorize access="@access.has(principal,'COLLECTIONS_VIEW')"><a href="<c:url value='/finance/credit/collections'/>" class="shell-sidebar-subitem block px-3 py-2 text-sm font-semibold ${fn:startsWith(requestUri,'/finance/credit/collections')?'shell-nav-active':''}"><spring:message code="credit.title.collections"/></a></sec:authorize>

                <sec:authorize access="@access.has(principal, 'LOAN_REPAYMENTS_VIEW')">
                    <a href="<c:url value='/repayments' />" class="group flex items-center gap-2.5 border px-2.5 py-2 text-[0.95rem] font-semibold transition lg:gap-3 lg:px-3 lg:py-2.5 lg:text-sm ${fn:startsWith(requestUri, '/repayments') ? 'shell-nav-active border-cyan-200 bg-cyan-50 text-cyan-800' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}">
                        <span class="inline-flex h-6 w-6 items-center justify-center border lg:h-7 lg:w-7"><i data-lucide="receipt" aria-hidden="true"></i></span>
                        <spring:message code="repayment.title" />
                    </a>
                </sec:authorize>
            </c:if>



            <c:if test="${staffWorkspace}">
                <sec:authorize access="@access.isAdminScope(principal)">
                    <c:if test="${isPlatformAdminIdentity}">
                        <c:set var="platformSaccosActive" value="${requestUri eq '/admin/saccos' or (fn:startsWith(requestUri, '/admin/saccos/') and requestUri ne '/admin/saccos/registry' and not fn:startsWith(requestUri, '/admin/saccos/minor-admins'))}" />
                        <c:set var="platformSettingsActive" value="${fn:startsWith(requestUri, '/admin/platform-settings')}" />
                        <c:set var="saccoRegistryActive" value="${requestUri eq '/admin/saccos/registry' or requestUri eq '/admin/saccos/new' or fn:startsWith(requestUri, '/admin/saccos/minor-admins')}" />
                        <div class="shell-sidebar-nav-heading"><span>Overview</span></div>
                        <a href="/admin/dashboard" class="group flex items-center gap-3 border px-3 py-2.5 text-sm font-semibold transition ${requestUri eq '/admin/dashboard' ? 'border-cyan-200 bg-cyan-50 text-cyan-800 shadow-sm' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}">
                            <span class="inline-flex h-7 w-7 items-center justify-center border ${requestUri eq '/admin/dashboard' ? 'border-cyan-200 bg-cyan-100 text-cyan-700' : 'border-slate-200 bg-white text-slate-500'}"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 3l7 4v6l-7 4-7-4V7l7-4z"/></svg></span>
                            <spring:message code="menu.dashboard" text="Dashboard" />
                        </a>
                        <div class="shell-sidebar-nav-heading"><span>Administration</span></div>
                        <a href="/admin/saccos" class="group flex items-center gap-3 border px-3 py-2.5 text-sm font-semibold transition ${platformSaccosActive ? 'border-cyan-200 bg-cyan-50 text-cyan-800 shadow-sm' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}">
                            <span class="inline-flex h-7 w-7 items-center justify-center border ${platformSaccosActive ? 'border-cyan-200 bg-cyan-100 text-cyan-700' : 'border-slate-200 bg-white text-slate-500'}"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 2l8 4v8l-8 4-8-4V6l8-4zm0 2.236L4 7v6l6 3 6-3V7l-6-2.764z"/><path d="M10 6a3 3 0 100 6 3 3 0 000-6z"/></svg></span>
                            <spring:message code="menu.admin.saccos" text="Institutions" />
                        </a>
                        <div class="shell-sidebar-group space-y-1">
                            <button type="button"
                                    id="adminSaccoToggle"
                                    class="group flex w-full items-center gap-3 border px-3 py-2.5 text-left text-sm font-semibold transition ${saccoRegistryActive ? 'border-cyan-200 bg-cyan-50 text-cyan-800 shadow-sm' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}"
                                    aria-expanded="true" data-menu-active="false"
                                    aria-controls="adminSaccoPanel">
                                <span class="inline-flex h-7 w-7 items-center justify-center border ${saccoRegistryActive ? 'border-cyan-200 bg-cyan-100 text-cyan-700' : 'border-slate-200 bg-white text-slate-500'}"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M4 3a1 1 0 011-1h10a1 1 0 011 1v14l-3-2-3 2-3-2-3 2V3z"/><path d="M6 6h8v1.5H6zm0 3.5h8V11H6zm0 3.5h5V14.5H6z"/></svg></span>
                                <span class="min-w-0 flex-1"><spring:message code="menu.admin.saccoRegistration" text="Institution Registry" /></span>
                                <svg id="adminSaccoChevron" xmlns="http://www.w3.org/2000/svg" class="rotate-180 h-4 w-4 transition-transform duration-200 ${saccoRegistryActive ? 'text-cyan-600' : 'text-slate-400'}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.512a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                            <div id="adminSaccoPanel" class="mt-1 space-y-1 border border-slate-200 bg-slate-50/70 px-2 py-2 shadow-inner">
                                <a href="/admin/saccos/registry" class="block px-3 py-2 text-sm font-semibold transition ${requestUri eq '/admin/saccos/registry' or requestUri eq '/admin/saccos/new' ? 'bg-white text-cyan-800 ring-1 ring-cyan-100 shadow-sm' : 'text-slate-600 hover:bg-white hover:text-slate-900'}">
                                    <spring:message code="admin.saccoRegistry.registration" text="Registration" />
                                </a>
                                <a href="/admin/saccos/minor-admins" class="block px-3 py-2 text-sm font-semibold transition ${fn:startsWith(requestUri, '/admin/saccos/minor-admins') ? 'bg-white text-cyan-800 ring-1 ring-cyan-100 shadow-sm' : 'text-slate-600 hover:bg-white hover:text-slate-900'}">
                                    <spring:message code="admin.minorAdmins.title" text="Institution Admins Registration" />
                                </a>
                            </div>
                        </div>
                        <a href="/admin/outbox" class="group flex items-center gap-3 border px-3 py-2.5 text-sm font-semibold transition ${requestUri eq '/admin/outbox' ? 'border-cyan-200 bg-cyan-50 text-cyan-800 shadow-sm' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}">
                            <span class="inline-flex h-7 w-7 items-center justify-center border ${requestUri eq '/admin/outbox' ? 'border-cyan-200 bg-cyan-100 text-cyan-700' : 'border-slate-200 bg-white text-slate-500'}"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M3 3h14v4H3V3zm0 6h14v8H3V9zm3 2v4h2v-4H6z"/></svg></span>
                            Outbox Monitor
                        </a>
                        <a href="/admin/sms-usage" class="group flex items-center gap-3 border px-3 py-2.5 text-sm font-semibold transition ${requestUri eq '/admin/sms-usage' ? 'border-cyan-200 bg-cyan-50 text-cyan-800 shadow-sm' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}">
                            <span class="inline-flex h-7 w-7 items-center justify-center border ${requestUri eq '/admin/sms-usage' ? 'border-cyan-200 bg-cyan-100 text-cyan-700' : 'border-slate-200 bg-white text-slate-500'}"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M3 4a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2H9.5L5 18v-4a2 2 0 01-2-2V4zm3 2v1.5h8V6H6zm0 3v1.5h6V9H6z"/></svg></span>
                            SMS Usage
                        </a>
                        <sec:authorize access="@access.has(principal, 'PLATFORM_SETTINGS_VIEW')">
                            <a href="/admin/platform-settings" class="group flex items-center gap-3 border px-3 py-2.5 text-sm font-semibold transition ${platformSettingsActive ? 'border-cyan-200 bg-cyan-50 text-cyan-800 shadow-sm' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}">
                                <span class="inline-flex h-7 w-7 items-center justify-center border ${platformSettingsActive ? 'border-cyan-200 bg-cyan-100 text-cyan-700' : 'border-slate-200 bg-white text-slate-500'}"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M11.3 1.046a1 1 0 00-2.6 0l-.16.59a1 1 0 01-.95.74l-.61.024a1 1 0 00-.82.51l-.3.52a1 1 0 01-1.13.46l-.58-.16a1 1 0 00-1.3 1.3l.16.58a1 1 0 01-.46 1.13l-.52.3a1 1 0 00-.51.82l-.024.61a1 1 0 01-.74.95l-.59.16a1 1 0 000 2.6l.59.16a1 1 0 01.74.95l.024.61a1 1 0 00.51.82l.52.3a1 1 0 01.46 1.13l-.16.58a1 1 0 001.3 1.3l.58-.16a1 1 0 011.13.46l.3.52a1 1 0 00.82.51l.61.024a1 1 0 01.95.74l.16.59a1 1 0 002.6 0l.16-.59a1 1 0 01.95-.74l.61-.024a1 1 0 00.82-.51l.3-.52a1 1 0 011.13-.46l.58.16a1 1 0 001.3-1.3l-.16-.58a1 1 0 01.46-1.13l.52-.3a1 1 0 00.51-.82l.024-.61a1 1 0 01.74-.95l.59-.16a1 1 0 000-2.6l-.59-.16a1 1 0 01-.74-.95l-.024-.61a1 1 0 00-.51-.82l-.52-.3a1 1 0 01-.46-1.13l.16-.58a1 1 0 00-1.3-1.3l-.58.16a1 1 0 01-1.13-.46l-.3-.52a1 1 0 00-.82-.51l-.61-.024a1 1 0 01-.95-.74l-.16-.59zM10 13a3 3 0 100-6 3 3 0 000 6z"/></svg></span>
                                Platform Settings
                            </a>
                        </sec:authorize>
                        <a href="/admin/events" class="group flex items-center gap-3 border px-3 py-2.5 text-sm font-semibold transition ${requestUri eq '/admin/events' ? 'border-cyan-200 bg-cyan-50 text-cyan-800 shadow-sm' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}">
                            <span class="inline-flex h-7 w-7 items-center justify-center border ${requestUri eq '/admin/events' ? 'border-cyan-200 bg-cyan-100 text-cyan-700' : 'border-slate-200 bg-white text-slate-500'}"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M5 3a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2V8.414A2 2 0 0016.414 7L13 3.586A2 2 0 0011.586 3H5z"/></svg></span>
                            Event Log
                        </a>
                        <a href="/admin/incidents" class="group flex items-center gap-3 border px-3 py-2.5 text-sm font-semibold transition ${fn:startsWith(requestUri, '/admin/incidents') ? 'border-cyan-200 bg-cyan-50 text-cyan-800 shadow-sm' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}">
                            <span class="inline-flex h-7 w-7 items-center justify-center border ${fn:startsWith(requestUri, '/admin/incidents') ? 'border-cyan-200 bg-cyan-100 text-cyan-700' : 'border-slate-200 bg-white text-slate-500'}"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M9 2a1 1 0 012 0v1.07A7.002 7.002 0 0117 10a7 7 0 11-14 0 7.002 7.002 0 016-6.93V2zm1 4a1 1 0 00-1 1v4a1 1 0 102 0V7a1 1 0 00-1-1z"/></svg></span>
                            <spring:message code="menu.admin.incidents" text="Incidents" />
                        </a>
                    </c:if>
                </sec:authorize>
            </c:if>

            <c:if test="${staffWorkspace}">

            <sec:authorize access="@access.hasAny(principal, 'GROUP_LENDING_VIEW', 'LOAN_RECORDING_VIEW', 'LOAN_ADJUSTMENTS_VIEW', 'ACCOUNTING_ACCOUNTS_VIEW', 'ACCOUNTING_JOURNALS_VIEW', 'FINANCIAL_REPORTS_VIEW', 'ACCOUNTING_BUSINESS_VIEW', 'ACCOUNTING_RECONCILIATION_VIEW', 'VOUCHER_WORKSPACE_VIEW', 'VOUCHER_RULE_VIEW', 'ACCOUNTING_ACCOUNT_RULES_VIEW', 'PAYROLL_DEDUCTIONS_VIEW', 'APPROVAL_FLOW_VIEW')">
                <%@ include file="finance-navigation.jspf" %>
            </sec:authorize>
            </c:if>

            <c:if test="${staffWorkspace}">
                <sec:authorize access="@access.hasAny(principal, 'WORKSPACE_SETTINGS_VIEW', 'LOAN_PRODUCTS_VIEW', 'APPROVAL_FLOW_VIEW')" var="settingsAdminScope" />
                <c:if test="${settingsAdminScope and not isPlatformAdminIdentity}">
                        <c:set var="adminSettingsActive" value="${fn:startsWith(requestUri, '/admin/settings-controls') or requestUri eq '/admin/loan-products'}" />
                        <div class="shell-sidebar-group space-y-1">
                            <button type="button"
                                    id="adminSettingsToggle"
                                    class="group flex w-full items-center gap-3 border px-3 py-2.5 text-left text-sm font-semibold transition ${adminSettingsActive ? 'border-cyan-200 bg-cyan-50 text-cyan-800 shadow-sm' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}"
                                    aria-expanded="true" data-menu-active="${adminSettingsActive ? 'true' : 'false'}"
                                    aria-controls="adminSettingsPanel">
                                <span class="inline-flex h-7 w-7 items-center justify-center border ${adminSettingsActive ? 'border-cyan-200 bg-cyan-100 text-cyan-700' : 'border-slate-200 bg-white text-slate-500'}"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M11.3 1.046a1 1 0 00-2.6 0l-.16.59a1 1 0 01-.95.74l-.61.024a1 1 0 00-.82.51l-.3.52a1 1 0 01-1.13.46l-.58-.16a1 1 0 00-1.3 1.3l.16.58a1 1 0 01-.46 1.13l-.52.3a1 1 0 00-.51.82l-.024.61a1 1 0 01-.74.95l-.59.16a1 1 0 000 2.6l.59.16a1 1 0 01.74.95l.024.61a1 1 0 00.51.82l.52.3a1 1 0 01.46 1.13l-.16.58a1 1 0 001.3 1.3l.58-.16a1 1 0 011.13.46l.3.52a1 1 0 00.82.51l.61.024a1 1 0 01.95.74l.16.59a1 1 0 002.6 0l.16-.59a1 1 0 01.95-.74l.61-.024a1 1 0 00.82-.51l.3-.52a1 1 0 011.13-.46l.58.16a1 1 0 001.3-1.3l-.16-.58a1 1 0 01.46-1.13l.52-.3a1 1 0 00.51-.82l.024-.61a1 1 0 01.74-.95l.59-.16a1 1 0 000-2.6l-.59-.16a1 1 0 01-.74-.95l-.024-.61a1 1 0 00-.51-.82l-.52-.3a1 1 0 01-.46-1.13l.16-.58a1 1 0 00-1.3-1.3l-.58.16a1 1 0 01-1.13-.46l-.3-.52a1 1 0 00-.82-.51l-.61-.024a1 1 0 01-.95-.74l-.16-.59zM10 13a3 3 0 100-6 3 3 0 000 6z"/></svg></span>
                                <span class="min-w-0 flex-1"><spring:message code="menu.admin.settingsControls" text="Settings & Controls" /></span>
                                <svg id="adminSettingsChevron" xmlns="http://www.w3.org/2000/svg" class="rotate-180 h-4 w-4 transition-transform duration-200 ${adminSettingsActive ? 'text-cyan-600' : 'text-slate-400'}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.512a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                            <div id="adminSettingsPanel" class="mt-1 space-y-1 border border-slate-200 bg-slate-50/70 px-2 py-2 shadow-inner">
                                <sec:authorize access="@access.hasAny(principal,'LOAN_PRODUCTS_VIEW','APPROVAL_FLOW_VIEW')">
                                <a href="/admin/settings-controls?section=loan" class="shell-sidebar-subitem block ${((requestUri eq '/admin/settings-controls' and (empty param.section or param.section eq 'loan') and param.custom ne 'true') or requestUri eq '/admin/loan-products' or (fn:startsWith(requestUri, '/admin/settings-controls/loan-products/'))) ? 'shell-nav-active' : ''}"><spring:message code="menu.admin.settings.loanProducts" /></a>
                                <sec:authorize access="@access.has(principal,'APPROVAL_FLOW_VIEW')">
                                <a href="/admin/settings-controls?section=loan&amp;custom=true" class="shell-sidebar-subitem block ${(requestUri eq '/admin/settings-controls' and param.custom eq 'true') ? 'shell-nav-active' : ''}"><spring:message code="menu.admin.settings.customisedLoan" /></a>
                                </sec:authorize>
                                </sec:authorize>
                                <sec:authorize access="@access.has(principal,'WORKSPACE_SETTINGS_VIEW')">
                                <a href="/admin/settings-controls?section=guarantor" class="block px-3 py-2 text-sm font-semibold transition ${requestUri eq '/admin/settings-controls' and param.section eq 'guarantor' ? 'bg-white text-cyan-800 ring-1 ring-cyan-100 shadow-sm' : 'text-slate-600 hover:bg-white hover:text-slate-900'}"><spring:message code="menu.admin.settings.applicantGuarantor" text="Applicant & Guarantor Settings" /></a>
                                <a href="/admin/settings-controls?section=otp" class="block px-3 py-2 text-sm font-semibold transition ${requestUri eq '/admin/settings-controls' and param.section eq 'otp' ? 'bg-white text-cyan-800 ring-1 ring-cyan-100 shadow-sm' : 'text-slate-600 hover:bg-white hover:text-slate-900'}"><spring:message code="admin.settings.otp.title" text="OTP Delivery" /></a>
                                </sec:authorize>
                            </div>
                        </div>
                </c:if>
                        <c:set var="staffSettingsActive" value="${requestUri eq '/account/security' or requestUri eq '/profile'}" />
                        <div class="shell-sidebar-group space-y-1">
                            <button type="button"
                                    id="staffSettingsToggle"
                                    class="group flex w-full items-center gap-3 border px-3 py-2.5 text-left text-sm font-semibold transition ${staffSettingsActive ? 'border-cyan-200 bg-cyan-50 text-cyan-800 shadow-sm' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}"
                                    aria-expanded="true" data-menu-active="${staffSettingsActive ? 'true' : 'false'}"
                                    aria-controls="staffSettingsPanel">
                                <span class="inline-flex h-7 w-7 items-center justify-center border ${staffSettingsActive ? 'border-cyan-200 bg-cyan-100 text-cyan-700' : 'border-slate-200 bg-white text-slate-500'}">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M11.3 1.046a1 1 0 00-2.6 0l-.16.59a1 1 0 01-.95.74l-.61.024a1 1 0 00-.82.51l-.3.52a1 1 0 01-1.13.46l-.58-.16a1 1 0 00-1.3 1.3l.16.58a1 1 0 01-.46 1.13l-.52.3a1 1 0 00-.51.82l-.024.61a1 1 0 01-.74.95l-.59.16a1 1 0 000 2.6l.59.16a1 1 0 01.74.95l.024.61a1 1 0 00.51.82l.52.3a1 1 0 01.46 1.13l-.16.58a1 1 0 001.3 1.3l.58-.16a1 1 0 011.13.46l.3.52a1 1 0 00.82.51l.61.024a1 1 0 01.95.74l.16.59a1 1 0 002.6 0l.16-.59a1 1 0 01.95-.74l.61-.024a1 1 0 00.82-.51l.3-.52a1 1 0 011.13-.46l.58.16a1 1 0 001.3-1.3l-.16-.58a1 1 0 01.46-1.13l.52-.3a1 1 0 00.51-.82l.024-.61a1 1 0 01.74-.95l.59-.16a1 1 0 000-2.6l-.59-.16a1 1 0 01-.74-.95l-.024-.61a1 1 0 00-.51-.82l-.52-.3a1 1 0 01-.46-1.13l.16-.58a1 1 0 00-1.3-1.3l-.58.16a1 1 0 01-1.13-.46l-.3-.52a1 1 0 00-.82-.51l-.61-.024a1 1 0 01-.95-.74l-.16-.59zM10 13a3 3 0 100-6 3 3 0 000 6z"/></svg>
                                </span>
                                <span class="min-w-0 flex-1"><spring:message code="menu.settings" /></span>
                                <svg id="staffSettingsChevron" xmlns="http://www.w3.org/2000/svg" class="rotate-180 h-4 w-4 transition-transform duration-200 ${staffSettingsActive ? 'text-cyan-600' : 'text-slate-400'}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.512a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                            <div id="staffSettingsPanel" class="mt-1 space-y-1 border border-slate-200 bg-slate-50/70 px-2 py-2 shadow-inner">
                                <a href="/account/security"
                                   class="shell-sidebar-subitem ${requestUri eq '/account/security' ? 'shell-nav-active' : ''}"
                                   <c:if test="${requestUri eq '/account/security'}">aria-current="page"</c:if>>
                                    <span class="shell-sidebar-subitem-label">OTP Security</span>
                                </a>
                                <a href="/profile"
                                   class="shell-sidebar-subitem ${requestUri eq '/profile' ? 'shell-nav-active' : ''}"
                                   <c:if test="${requestUri eq '/profile'}">aria-current="page"</c:if>>
                                    <span class="shell-sidebar-subitem-label"><spring:message code="menu.profile" text="Profile" /></span>
                                </a>
                            </div>
                        </div>
            </c:if>

            <c:if test="${staffWorkspace}">
                <sec:authorize access="@access.isAdminScope(principal)">
                        <c:set var="adminSupportActive" value="${fn:startsWith(requestUri, '/admin/support')}" />
                        <div class="shell-sidebar-group space-y-1">
                            <button type="button"
                                    id="adminSupportToggle"
                                    class="group flex w-full items-center gap-3 border px-3 py-2.5 text-left text-sm font-semibold transition ${adminSupportActive ? 'border-cyan-200 bg-cyan-50 text-cyan-800 shadow-sm' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900'}"
                                    aria-expanded="true" data-menu-active="false"
                                    aria-controls="adminSupportPanel">
                                <span class="inline-flex h-7 w-7 items-center justify-center border ${adminSupportActive ? 'border-cyan-200 bg-cyan-100 text-cyan-700' : 'border-slate-200 bg-white text-slate-500'}"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M2 5a2 2 0 012-2h12a2 2 0 012 2v7a2 2 0 01-2 2H8l-4 3v-3H4a2 2 0 01-2-2V5z"/></svg></span>
                                <span class="min-w-0 flex-1"><spring:message code="menu.admin.support" text="Support" /></span>
                                <svg id="adminSupportChevron" xmlns="http://www.w3.org/2000/svg" class="rotate-180 h-4 w-4 transition-transform duration-200 ${adminSupportActive ? 'text-cyan-600' : 'text-slate-400'}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.512a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                            <div id="adminSupportPanel" class="mt-1 space-y-1 border border-slate-200 bg-slate-50/70 px-2 py-2 shadow-inner">
                                <sec:authorize access="@authz.workspaceAdminOnly(principal) and @access.has(principal, 'SUPPORT_VIEW')">
                                <a href="/admin/support" class="block px-3 py-2 text-sm font-semibold transition ${requestUri eq '/admin/support' ? 'bg-white text-cyan-800 ring-1 ring-cyan-100 shadow-sm' : 'text-slate-600 hover:bg-white hover:text-slate-900'}"><spring:message code="support.newMessage" text="New Message" /></a>
                                <a href="/admin/support/archive" class="block px-3 py-2 text-sm font-semibold transition ${requestUri eq '/admin/support/archive' ? 'bg-white text-cyan-800 ring-1 ring-cyan-100 shadow-sm' : 'text-slate-600 hover:bg-white hover:text-slate-900'}"><spring:message code="support.sentArchive" text="Sent Archive" /></a>
                                <a href="/admin/support/replies" class="block px-3 py-2 text-sm font-semibold transition ${requestUri eq '/admin/support/replies' ? 'bg-white text-cyan-800 ring-1 ring-cyan-100 shadow-sm' : 'text-slate-600 hover:bg-white hover:text-slate-900'}"><spring:message code="support.replies" text="Replies" /></a>
                                </sec:authorize>
                                <%@ include file="platform-support-contact-sidebar.jspf" %>
                            </div>
                        </div>
                </sec:authorize>
                <sec:authorize access="!@access.isAdminScope(principal)">
                <c:if test="${not empty platformSupportContact}">
                    <div class="shell-sidebar-group space-y-1">
                        <button type="button"
                                id="staffSupportToggle"
                                class="group flex w-full items-center gap-3 border px-3 py-2.5 text-left text-sm font-semibold transition border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900"
                                aria-expanded="true" data-menu-active="false"
                                aria-controls="staffSupportPanel">
                            <span class="inline-flex h-7 w-7 items-center justify-center border border-slate-200 bg-white text-slate-500">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M18 10c0 3.866-3.582 7-8 7a8.84 8.84 0 01-4.083-.97L2 17l1.338-3.122A6.48 6.48 0 012 10c0-3.866 3.582-7 8-7s8 3.134 8 7z"/></svg>
                            </span>
                            <span class="min-w-0 flex-1"><spring:message code="menu.support" text="Support" /></span>
                            <svg id="staffSupportChevron" xmlns="http://www.w3.org/2000/svg" class="rotate-180 h-4 w-4 transition-transform duration-200 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.512a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
                            </svg>
                        </button>
                        <div id="staffSupportPanel" class="mt-1 space-y-1 border border-slate-200 bg-slate-50/70 px-2 py-2 shadow-inner">
                            <%@ include file="platform-support-contact-sidebar.jspf" %>
                        </div>
                    </div>
                </c:if>
                </sec:authorize>
            </c:if>
        </nav>

        <div class="aws-sidebar-footer border-t px-4 py-3 text-xs font-medium text-slate-600">
            <div><spring:message code="app.title" /> &middot; 2026</div>
            <div class="shell-powered-by">
                <span class="shell-powered-by-brand" aria-label="Computer Resources (T) Limited">
                    <img class="shell-powered-by-logo"
                         src="<c:url value='/images/computer-resources-mark-orange.svg' />"
                         alt=""
                         aria-hidden="true" />
                    <span class="shell-powered-by-copy">
                        <span class="shell-powered-by-label"><spring:message code="shell.poweredBy" text="Powered by" /></span>
                        <span class="shell-powered-by-wordmark" aria-hidden="true">
                            <span>Computer Resources</span>
                            <span>(T) Limited</span>
                        </span>
                    </span>
                </span>
            </div>
        </div>
    </div>
</aside>
<main id="main-content" class="app-main shell-main box-border" tabindex="-1">
    <script>window.WorkspaceNavigation?.prepare(document.getElementById('main-content'));</script>
    <div class="shell-content-frame mx-auto min-w-0 space-y-4">
        <%@ include file="office-return.jspf" %>
