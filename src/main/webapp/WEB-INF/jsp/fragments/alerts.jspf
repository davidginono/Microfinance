<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<sec:authorize access="@authz.platformAdminIdentity(principal)" var="platformFormFeedback" />
<c:if test="${platformFormFeedback}">
    <div class="workspace-flashbar" data-workspace-flashbar></div>
</c:if>
<c:if test="${not suppressToastMessages}">
    <c:if test="${not empty message}">
        <div hidden data-toast-message="${fn:escapeXml(message)}" data-toast-type="success" data-toast-placement="${platformFormFeedback ? 'workspace' : 'page'}"></div>
    </c:if>
    <c:if test="${not empty infoMessage}"><div hidden data-toast-message="${fn:escapeXml(infoMessage)}" data-toast-type="info" data-toast-placement="${platformFormFeedback ? 'workspace' : 'page'}"></div></c:if>
    <c:if test="${not empty error}">
        <c:choose>
            <c:when test="${platformFormFeedback}"><div class="console-message" data-message-type="error" data-workspace-response-error role="alert" tabindex="-1"><c:out value="${error}" /></div></c:when>
            <c:otherwise><div hidden data-toast-message="${fn:escapeXml(error)}" data-toast-type="error"></div></c:otherwise>
        </c:choose>
    </c:if>
</c:if>
