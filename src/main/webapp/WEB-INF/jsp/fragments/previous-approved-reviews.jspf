<c:if test="${not empty previousApprovedReviews}">
    <div class="erp-table-wrap mt-5" data-resource-table="previous-approved-reviews">
        <div class="app-table-titlebar"><h2><spring:message code="review.previousApprovals" text="Previous Review Decisions" /></h2></div>
            <div class="erp-table-scroll">
            <table class="erp-table" data-table-sort-mode="local">
                <thead>
                <tr>
                    <th class="px-3 py-2 text-left"><spring:message code="review.stage" text="Stage" /></th>
                    <th class="px-3 py-2 text-left"><spring:message code="review.reviewer" text="Reviewer" /></th>
                    <th class="px-3 py-2 text-left"><spring:message code="Member.memberNo" text="Client No" /></th>
                    <th class="px-3 py-2 text-left"><spring:message code="review.decision" text="Decision" /></th>
                    <th class="px-3 py-2 text-left"><spring:message code="review.note" text="Note" /></th>
                    <th class="px-3 py-2 text-left"><spring:message code="review.submitted" text="Submitted" /></th>
                </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                <c:forEach items="${previousApprovedReviews}" var="previousReview">
                    <tr>
                        <td class="px-3 py-2 font-medium text-slate-900"><c:out value="${previousReview.stageLabel}" /></td>
                        <td class="px-3 py-2 text-slate-700"><c:out value="${previousReview.reviewerName}" /></td>
                        <td class="px-3 py-2 text-slate-700"><c:out value="${previousReview.reviewerMemberNo}" /></td>
                        <td class="px-3 py-2">
                            <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"><span data-resource-status='<c:out value="${previousReview.decisionLabel}" />'><c:out value="${previousReview.decisionLabel}" /></span>
                            </span>
                        </td>
                        <td class="px-3 py-2 text-slate-700"><c:out value="${previousReview.note}" /></td>
                        <td class="px-3 py-2 text-slate-700"><c:out value="${previousReview.decidedAtLabel}" /></td>
                    </tr>
                </c:forEach>
                </tbody>
            </table>
        </div>
    </div>
</c:if>
