<style>
    .neo-select {
        position: relative;
        width: 100%;
        isolation: isolate;
        z-index: 1;
    }
    .neo-select--open {
        z-index: 40;
    }
    .neo-select-native {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        pointer-events: none;
    }
    .neo-select-button {
        position: relative;
        display: flex;
        width: 100%;
        min-height: 3.2rem;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #ffffff;
        padding: 0.82rem 1rem 0.82rem 1.05rem;
        color: #172033;
        box-shadow: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    .neo-select-button:hover,
    .neo-select-button:focus-visible {
        transform: none;
        filter: none;
        background: #ffffff;
        border-color: #b7c5d6;
        box-shadow: none;
    }
    .neo-select-button:active {
        transform: none;
        box-shadow: none;
    }
    .neo-select-button:focus-visible {
        outline: none;
        border-color: #2F348D;
        box-shadow: 0 0 0 2px rgba(47, 52, 141, 0.1);
    }
    .neo-select--open .neo-select-button {
        border-color: #2F348D;
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
        box-shadow: none;
    }
    .neo-select--invalid .neo-select-button {
        border-color: rgba(190, 24, 93, 0.55);
        box-shadow: 0 0 0 3px rgba(251, 113, 133, 0.12);
    }
    .neo-select-button.is-disabled {
        cursor: not-allowed;
        opacity: 0.7;
    }
    .neo-select-button-text {
        min-width: 0;
        flex: 1;
        overflow: hidden;
        color: #172033;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.96rem;
        font-weight: 500;
        line-height: 1.3;
        letter-spacing: 0;
    }
    .neo-select-button.is-placeholder .neo-select-button-text {
        color: #7b8798;
    }
    .neo-select-chevron {
        flex-shrink: 0;
        color: #64748b;
        transition: transform 0.2s ease, color 0.2s ease;
    }
    .neo-select--open .neo-select-chevron {
        transform: rotate(180deg);
        color: #2F348D;
    }
    .neo-select-menu {
        position: absolute;
        top: calc(100% - 2px);
        left: 0;
        right: 0;
        z-index: 80;
        max-height: 17rem;
        overflow-y: auto;
        overflow-x: hidden;
        border: 1px solid #2F348D;
        border-top: none;
        border-radius: 0 0 6px 6px;
        background: #ffffff;
        padding: 0;
        box-shadow: 0 14px 28px rgba(15, 23, 42, 0.1);
        opacity: 0;
        pointer-events: none;
        transform: translateY(5px);
        transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .neo-select--open .neo-select-menu {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }
    .neo-select-menu::-webkit-scrollbar {
        width: 8px;
    }
    .neo-select-menu::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: rgba(100, 116, 139, 0.25);
    }
    .neo-select-empty {
        padding: 0.9rem 1rem;
        color: #64748b;
        font-size: 0.92rem;
        text-align: center;
    }
    .neo-select-option {
        display: block;
        width: 100%;
        border: none;
        border-radius: 0;
        background: #ffffff;
        padding: 1rem 1.2rem;
        color: #374151;
        font-size: 0.95rem;
        font-weight: 500;
        line-height: 1.35;
        text-align: left;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
        transition: background 0.2s ease, color 0.2s ease;
    }
    .neo-select-option:hover,
    .neo-select-option:focus-visible {
        transform: none;
        filter: none;
        outline: none;
        background: #e5e7eb;
        color: #374151;
    }
    .neo-select-option:active {
        transform: none;
        background: #d9dde3;
    }
    .neo-select-option.is-selected {
        background: #43699d;
        color: #ffffff;
    }
    .neo-select-option.is-selected:hover,
    .neo-select-option.is-selected:focus-visible {
        background: #3d6191;
        color: #ffffff;
    }
    .neo-select-option.is-disabled {
        cursor: not-allowed;
        opacity: 0.45;
        pointer-events: none;
    }
    @media (max-width: 640px) {
        .neo-select-button {
            min-height: 3rem;
            padding: 0.75rem 0.9rem;
        }
        .neo-select-menu {
            border-radius: 0 0 6px 6px;
        }
        .neo-select-option {
            padding: 0.92rem 1rem;
        }
        .neo-select-button-text {
            font-size: 0.92rem;
        }
        .neo-select-option,
        .neo-select-empty {
            font-size: 0.9rem;
        }
    }
</style>
<script>
    (function () {
        if (window.__neoSelectEnhancerLoaded) {
            return;
        }
        window.__neoSelectEnhancerLoaded = true;

        const enhancedStates = new WeakMap();
        let globalObserver = null;
        let globalHandlersBound = false;

        function closeEnhancedSelect(state) {
            if (!state || !state.wrapper.classList.contains('neo-select--open')) {
                return;
            }
            state.wrapper.classList.remove('neo-select--open');
            state.button.setAttribute('aria-expanded', 'false');
        }

        function closeAllEnhancedSelects(exceptState) {
            document.querySelectorAll('.neo-select').forEach(function (wrapper) {
                const nativeSelect = wrapper.querySelector('select[data-neo-enhanced="true"]');
                if (!nativeSelect) {
                    return;
                }
                const state = enhancedStates.get(nativeSelect);
                if (state && state !== exceptState) {
                    closeEnhancedSelect(state);
                }
            });
        }

        function focusOption(state, direction) {
            const items = Array.from(state.menu.querySelectorAll('.neo-select-option:not(.is-disabled)'));
            if (!items.length) {
                return;
            }
            const selectedItem = state.menu.querySelector('.neo-select-option.is-selected:not(.is-disabled)');
            let index = selectedItem ? items.indexOf(selectedItem) : 0;
            if (direction === 'first') {
                index = 0;
            } else if (direction === 'last') {
                index = items.length - 1;
            } else if (direction === 'next') {
                index = Math.min(index + 1, items.length - 1);
            } else if (direction === 'prev') {
                index = Math.max(index - 1, 0);
            }
            const target = items[index];
            if (target) {
                target.focus({ preventScroll: true });
                target.scrollIntoView({ block: 'nearest' });
            }
        }

        function dispatchSelectionEvents(select) {
            select.dispatchEvent(new Event('input', { bubbles: true }));
            select.dispatchEvent(new Event('change', { bubbles: true }));
        }

        function renderEnhancedSelect(select) {
            const state = enhancedStates.get(select);
            if (!state) {
                return;
            }

            const options = Array.from(select.options);
            const selectedOption = options[select.selectedIndex] || options.find(function (option) {
                return option.selected;
            }) || options[0] || null;
            const selectedLabel = selectedOption ? selectedOption.textContent.trim() : '';
            const placeholderSelected = selectedOption != null && selectedOption.value === '' && !select.value;
            const visibleOptions = options.filter(function (option) {
                return option.dataset.placeholder !== 'true';
            });

            state.button.classList.toggle('is-placeholder', placeholderSelected);
            state.button.classList.toggle('is-disabled', select.disabled);
            state.button.disabled = select.disabled;
            state.buttonText.textContent = selectedLabel || 'Select an option';
            state.menu.innerHTML = '';

            if (!visibleOptions.length) {
                const emptyState = document.createElement('div');
                emptyState.className = 'neo-select-empty';
                emptyState.textContent = 'No options available';
                state.menu.appendChild(emptyState);
                return;
            }

            visibleOptions.forEach(function (option) {
                const index = options.indexOf(option);
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'neo-select-option';
                item.setAttribute('role', 'option');
                item.setAttribute('data-option-index', String(index));
                item.textContent = option.textContent.trim();
                item.disabled = option.disabled;
                if (option.disabled) {
                    item.classList.add('is-disabled');
                }
                if (option.selected) {
                    item.classList.add('is-selected');
                    item.setAttribute('aria-selected', 'true');
                } else {
                    item.setAttribute('aria-selected', 'false');
                }
                item.addEventListener('click', function () {
                    if (option.disabled) {
                        return;
                    }
                    select.selectedIndex = index;
                    state.wrapper.classList.remove('neo-select--invalid');
                    renderEnhancedSelect(select);
                    dispatchSelectionEvents(select);
                    closeEnhancedSelect(state);
                    state.button.focus({ preventScroll: true });
                });
                item.addEventListener('keydown', function (event) {
                    if (event.key === 'ArrowDown') {
                        event.preventDefault();
                        focusOption(state, 'next');
                    } else if (event.key === 'ArrowUp') {
                        event.preventDefault();
                        focusOption(state, 'prev');
                    } else if (event.key === 'Home') {
                        event.preventDefault();
                        focusOption(state, 'first');
                    } else if (event.key === 'End') {
                        event.preventDefault();
                        focusOption(state, 'last');
                    } else if (event.key === 'Escape') {
                        event.preventDefault();
                        closeEnhancedSelect(state);
                        state.button.focus({ preventScroll: true });
                    }
                });
                state.menu.appendChild(item);
            });
        }

        function openEnhancedSelect(state) {
            if (!state || state.button.disabled) {
                return;
            }
            closeAllEnhancedSelects(state);
            state.wrapper.classList.add('neo-select--open');
            state.button.setAttribute('aria-expanded', 'true');
            window.requestAnimationFrame(function () {
                focusOption(state, 'selected');
            });
        }

        function toggleEnhancedSelect(state) {
            if (!state) {
                return;
            }
            if (state.wrapper.classList.contains('neo-select--open')) {
                closeEnhancedSelect(state);
                return;
            }
            openEnhancedSelect(state);
        }

        function enhanceSelect(select) {
            if (!select || select.dataset.neoEnhanced === 'true' || select.multiple || select.size > 1 || select.closest('.neo-select') || select.type === 'hidden' || select.dataset.nativeSelect === 'true') {
                return;
            }

            const wrapper = document.createElement('div');
            wrapper.className = 'neo-select';
            select.parentNode.insertBefore(wrapper, select);
            wrapper.appendChild(select);

            select.dataset.neoEnhanced = 'true';
            select.classList.add('neo-select-native');

            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'neo-select-button';
            button.setAttribute('aria-haspopup', 'listbox');
            button.setAttribute('aria-expanded', 'false');
            button.innerHTML =
                '<span class="neo-select-button-text"></span>' +
                '<svg class="neo-select-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">' +
                    '<path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>' +
                '</svg>';

            const menu = document.createElement('div');
            menu.className = 'neo-select-menu';
            menu.setAttribute('role', 'listbox');

            wrapper.appendChild(button);
            wrapper.appendChild(menu);

            const state = {
                select: select,
                wrapper: wrapper,
                button: button,
                buttonText: button.querySelector('.neo-select-button-text'),
                menu: menu
            };
            enhancedStates.set(select, state);

            if (select.id) {
                document.querySelectorAll('label[for="' + select.id + '"]').forEach(function (label) {
                    label.addEventListener('click', function (event) {
                        event.preventDefault();
                        if (!button.disabled) {
                            button.focus({ preventScroll: true });
                            toggleEnhancedSelect(state);
                        }
                    });
                });
            }

            button.addEventListener('click', function () {
                toggleEnhancedSelect(state);
            });
            button.addEventListener('keydown', function (event) {
                if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    openEnhancedSelect(state);
                } else if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    openEnhancedSelect(state);
                    window.requestAnimationFrame(function () {
                        focusOption(state, 'last');
                    });
                } else if (event.key === 'Escape') {
                    event.preventDefault();
                    closeEnhancedSelect(state);
                }
            });

            select.addEventListener('change', function () {
                state.wrapper.classList.remove('neo-select--invalid');
                renderEnhancedSelect(select);
            });
            select.addEventListener('invalid', function (event) {
                event.preventDefault();
                state.wrapper.classList.add('neo-select--invalid');
                state.button.focus({ preventScroll: true });
            });

            const observer = new MutationObserver(function () {
                renderEnhancedSelect(select);
            });
            observer.observe(select, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['disabled', 'label', 'selected', 'value']
            });
            state.observer = observer;

            renderEnhancedSelect(select);
        }

        function initEnhancedSelects(root) {
            const scope = root || document;
            scope.querySelectorAll('select').forEach(function (select) {
                enhanceSelect(select);
            });
        }

        function bindGlobalHandlers() {
            if (globalHandlersBound) {
                return;
            }
            globalHandlersBound = true;

            document.addEventListener('click', function (event) {
                if (!event.target.closest('.neo-select')) {
                    closeAllEnhancedSelects();
                }
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeAllEnhancedSelects();
                }
            });
        }

        function observeNewSelects() {
            if (globalObserver || !document.body) {
                return;
            }
            globalObserver = new MutationObserver(function (records) {
                records.forEach(function (record) {
                    record.addedNodes.forEach(function (node) {
                        if (!(node instanceof HTMLElement)) {
                            return;
                        }
                        if (node.matches && node.matches('select')) {
                            enhanceSelect(node);
                        }
                        if (node.querySelectorAll) {
                            initEnhancedSelects(node);
                        }
                    });
                });
            });
            globalObserver.observe(document.body, { childList: true, subtree: true });
        }

        window.refreshEnhancedSelects = function (root) {
            initEnhancedSelects(root || document);
            document.querySelectorAll('select[data-neo-enhanced="true"]').forEach(function (select) {
                renderEnhancedSelect(select);
            });
        };

        window.addEventListener('load', function () {
            bindGlobalHandlers();
            initEnhancedSelects(document);
            observeNewSelects();
        });
    }());
</script>
