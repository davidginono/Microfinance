<script>
    (() => {
        const LIVE_ACCOUNT_STATUS_TIMEOUT_MS = 10000;
        const unknownLabel = "<spring:message code='common.notAvailable' javaScriptEscape='true' />";
        const activeRequests = new WeakMap();
        const creditProfileUnavailable = "<spring:message code='creditProfile.unavailable' javaScriptEscape='true' />";
        const creditProfileTimeout = "<spring:message code='creditProfile.timeout' javaScriptEscape='true' />";

        function applyLiveAccountStatus(container, payload) {
            if (!container || !payload) {
                return;
            }
            const activeExposure = container.querySelector("[data-live-account-status-active-exposure]");
            const riskHistory = container.querySelector("[data-live-account-status-risk-history]");

            if (activeExposure) {
                activeExposure.textContent = payload.available || payload.pending ? payload.activeExposureLabel || unknownLabel : unknownLabel;
                activeExposure.title = payload.statusMessage || "";
            }
            if (riskHistory) {
                riskHistory.textContent = payload.available || payload.pending ? payload.riskHistoryLabel || unknownLabel : unknownLabel;
                riskHistory.title = payload.statusMessage || "";
            }

        }

        function cancelLiveAccountStatusRequest(container) {
            const request = activeRequests.get(container);
            if (request) {
                request.cancel();
            }
        }

        function hydrateLiveAccountStatus(container) {
            const url = container.getAttribute("data-live-account-status-url");
            if (!url) {
                return;
            }
            cancelLiveAccountStatusRequest(container);
            const controller = typeof AbortController === "function" ? new AbortController() : null;
            let settled = false;
            let timeoutId = null;

            const cancel = () => {
                if (settled) {
                    return;
                }
                settled = true;
                if (timeoutId !== null) {
                    window.clearTimeout(timeoutId);
                }
                if (controller) {
                    controller.abort();
                }
                activeRequests.delete(container);
            };
            const finish = (payload) => {
                if (settled) {
                    return;
                }
                settled = true;
                if (timeoutId !== null) {
                    window.clearTimeout(timeoutId);
                }
                activeRequests.delete(container);
                applyLiveAccountStatus(container, payload);
            };

            activeRequests.set(container, { cancel });
            timeoutId = window.setTimeout(() => {
                if (controller) {
                    controller.abort();
                }
                finish({
                    available: false,
                    pending: false,
                    activeExposureLabel: "-",
                    riskHistoryLabel: "-",
                    statusMessage: creditProfileTimeout
                });
            }, LIVE_ACCOUNT_STATUS_TIMEOUT_MS);

            fetch(url, {
                headers: {
                    "Accept": "application/json"
                },
                credentials: "same-origin",
                signal: controller ? controller.signal : undefined
            })
                .then((response) => response.json().then((payload) => ({ ok: response.ok, payload })))
                .then(({ ok, payload }) => {
                    if (!ok) {
                        throw new Error((payload && payload.message) || creditProfileUnavailable);
                    }
                    finish(payload);
                })
                .catch((error) => {
                    if (settled) {
                        return;
                    }
                    finish({
                        available: false,
                        pending: false,
                        activeExposureLabel: "-",
                        riskHistoryLabel: "-",
                        statusMessage: error && error.message
                            ? error.message
                            : creditProfileUnavailable
                    });
                });
        }

        function hydrateAllLiveAccountStatuses() {
            document.querySelectorAll("[data-live-account-status-url]").forEach(hydrateLiveAccountStatus);
        }

        window.SaccosLiveAccountStatus = {
            hydrate: hydrateLiveAccountStatus,
            hydrateAll: hydrateAllLiveAccountStatuses,
            cancel: cancelLiveAccountStatusRequest
        };

        if (window.WorkspaceNavigation) {
            window.WorkspaceNavigation.onReady(hydrateAllLiveAccountStatuses);
        } else if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", hydrateAllLiveAccountStatuses, { once: true });
        } else {
            hydrateAllLiveAccountStatuses();
        }
        window.addEventListener("pagehide", () => {
            document.querySelectorAll("[data-live-account-status-url]").forEach(cancelLiveAccountStatusRequest);
        });
        window.addEventListener("pageshow", (event) => {
            if (event.persisted) {
                hydrateAllLiveAccountStatuses();
            }
        });
    })();
</script>
