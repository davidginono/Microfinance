<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<div class="${applicantExternalAccountStatus.available ? 'hidden ' : ''}aws-inline-notice loan-detail-notice live-account-status-message${applicantExternalAccountStatus.pending ? ' is-loading' : ' is-unavailable'}"
     data-live-account-status-box
     aria-live="polite">
    <span class="live-account-status-spinner" aria-hidden="true"></span>
    <span data-live-account-status-message><c:out value="${applicantExternalAccountStatus.statusMessage}" /></span>
</div>
