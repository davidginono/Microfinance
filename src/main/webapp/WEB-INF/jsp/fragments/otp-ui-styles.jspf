<script>
    (function () {
        function cleanDigits(value) {
            return String(value || "").replace(/\D/g, "").slice(0, 6);
        }

        function findBoxes(input) {
            if (!input || !input.dataset.otpBoxGroupId) {
                return [];
            }
            return Array.from(document.querySelectorAll('[data-otp-box-group="' + input.dataset.otpBoxGroupId + '"] .otp-digit-box'));
        }

        function syncBoxesFromInput(input) {
            const code = cleanDigits(input.value);
            const boxes = findBoxes(input);
            boxes.forEach(function (box, index) {
                box.value = code[index] || "";
            });
        }

        function setInputValue(input, boxes) {
            input.value = cleanDigits(boxes.map(function (box) { return box.value; }).join(""));
            input.dispatchEvent(new Event("input", { bubbles: true }));
        }

        function initOtpInput(input) {
            if (!input || input.dataset.otpBound === "true") {
                return;
            }
            input.dataset.otpBound = "true";
            const groupId = input.id || input.name || ("otp-" + Math.random().toString(36).slice(2));
            input.dataset.otpBoxGroupId = groupId;
            input.type = "hidden";

            const group = document.createElement("div");
            group.className = "otp-box-group";
            group.dataset.otpBoxGroup = groupId;
            group.setAttribute("role", "group");
            group.setAttribute("aria-label", input.dataset.otpLabel || "OTP code");

            const boxes = [];
            for (let index = 0; index < 6; index += 1) {
                const box = document.createElement("input");
                box.type = "text";
                box.inputMode = "numeric";
                box.autocomplete = index === 0 ? "one-time-code" : "off";
                box.maxLength = 1;
                box.className = "otp-digit-box";
                box.setAttribute("aria-label", "OTP digit " + (index + 1));
                box.addEventListener("input", function () {
                    const digits = cleanDigits(box.value);
                    if (digits.length > 1) {
                        digits.split("").forEach(function (digit, offset) {
                            const target = boxes[index + offset];
                            if (target) {
                                target.value = digit;
                            }
                        });
                    } else {
                        box.value = digits;
                    }
                    setInputValue(input, boxes);
                    const nextIndex = Math.min(index + Math.max(digits.length, 1), boxes.length - 1);
                    if (digits && index < boxes.length - 1) {
                        boxes[nextIndex].focus();
                    }
                });
                box.addEventListener("keydown", function (event) {
                    if (event.key === "Backspace" && !box.value && index > 0) {
                        boxes[index - 1].focus();
                    }
                });
                box.addEventListener("paste", function (event) {
                    event.preventDefault();
                    const pasted = cleanDigits(event.clipboardData ? event.clipboardData.getData("text") : "");
                    pasted.split("").forEach(function (digit, offset) {
                        const target = boxes[index + offset];
                        if (target) {
                            target.value = digit;
                        }
                    });
                    setInputValue(input, boxes);
                    const focusIndex = Math.min(index + pasted.length, boxes.length) - 1;
                    boxes[Math.max(focusIndex, 0)].focus();
                });
                boxes.push(box);
                group.appendChild(box);
            }

            input.insertAdjacentElement("afterend", group);
            syncBoxesFromInput(input);
            input.addEventListener("input", function () {
                syncBoxesFromInput(input);
                const invalid = input.validationMessage && input.validationMessage.length > 0;
                findBoxes(input).forEach(function (box) {
                    box.classList.toggle("is-invalid", invalid);
                });
            });
        }

        function startCooldown(button, payload, labels) {
            if (!button || !payload) {
                return;
            }
            window.clearInterval(button._otpCooldownTimer);
            window.clearTimeout(button._otpCooldownTimeout);
            const label = button.querySelector(".otp-button-label");
            const idleLabel = labels && labels.idle ? labels.idle : "Send OTP Code";
            const maxResends = Number.isFinite(Number(payload.maxResends)) ? Number(payload.maxResends) : 3;
            const resendCount = Number.isFinite(Number(payload.resendCount)) ? Number(payload.resendCount) : 0;
            const remainingResends = Number.isFinite(Number(payload.resendAttemptsRemaining))
                ? Math.max(0, Number(payload.resendAttemptsRemaining))
                : Math.max(0, maxResends - resendCount);
            let secondsUntilExpiry = Number(payload.secondsUntilExpiry || 0);
            if (!secondsUntilExpiry && payload.expiresAt) {
                secondsUntilExpiry = Math.ceil((new Date(payload.expiresAt).getTime() - Date.now()) / 1000);
            }
            secondsUntilExpiry = Math.max(0, secondsUntilExpiry);

            if (remainingResends > 0) {
                button.disabled = false;
                button.classList.remove("is-loading");
                button.classList.add("is-sent");
                if (label) {
                    label.textContent = "Code not received? Resend (" + remainingResends + " left)";
                }
                return;
            }

            button.disabled = true;
            button.classList.remove("is-loading");
            button.classList.add("is-sent");
            if (label) {
                label.textContent = "Resend limit reached";
            }
            if (secondsUntilExpiry > 0) {
                button._otpCooldownTimeout = window.setTimeout(function () {
                    button.disabled = false;
                    button.classList.remove("is-sent");
                    if (label) {
                        label.textContent = idleLabel;
                    }
                }, secondsUntilExpiry * 1000);
            }
        }

        function focusBoxes(input) {
            const boxes = findBoxes(input);
            const firstEmpty = boxes.find(function (box) { return !box.value; });
            (firstEmpty || boxes[0])?.focus();
        }

        window.SaccosOtp = {
            initOtpInput: initOtpInput,
            initAll: function () {
                document.querySelectorAll("[data-otp-hidden='true']").forEach(initOtpInput);
            },
            startCooldown: startCooldown,
            focusBoxes: focusBoxes
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", window.SaccosOtp.initAll);
        } else {
            window.SaccosOtp.initAll();
        }
    })();
</script>
