<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>

<div class="erp-page-header loan-detail-heading-row" data-aws-page-header>
    <p class="erp-breadcrumb">${reviewPanelBreadcrumb}</p>
    <h1 class="erp-page-title">${reviewPanelTitle}</h1>
    <c:if test="${showLoanExportAction}">
        <div class="loan-detail-action-row">
            <button type="button"
                    data-aws-action-pin="true"
                    data-loan-export-url="${pageContext.request.contextPath}/documents/loan-applications/${reviewDocumentLoanId}/print"
                    class="app-btn btn-primary">
                <spring:message code="common.export" text="Export" />
            </button>
        </div>
    </c:if>
</div>
