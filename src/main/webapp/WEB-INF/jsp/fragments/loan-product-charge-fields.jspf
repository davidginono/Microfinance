<%@ page pageEncoding="UTF-8" %>
<div class="md:col-span-2"><h3><spring:message code="${creatingLoanProduct ? 'charges.postingSetup' : 'charges.policySetup'}" /></h3></div>
<c:if test="${creatingLoanProduct}">
    <p class="md:col-span-2"><spring:message code="charges.generatedOnCreate" /></p>
    <label class="md:col-span-2"><input form="${chargeFormId}" type="checkbox" name="saveChargePolicy" value="true" ${chargePolicy.saveChargePolicy ? 'checked' : ''} /> <spring:message code="charges.saveWithProduct" /></label>
</c:if>
<input form="${chargeFormId}" type="hidden" name="requestKey" value="<c:out value='${chargePolicy.requestKey}' />" />
<input form="${chargeFormId}" type="hidden" name="expectedVersion" value="<c:out value='${chargePolicy.expectedVersion}' />" />
<label><spring:message code="charges.effectiveFrom" /><input form="${chargeFormId}" name="effectiveFrom" type="date" value="<c:out value='${chargePolicy.effectiveFrom}' />" class="aws-control" /></label>
<c:forEach items="${['policyReference','agreementReference']}" var="chargeField">
    <label><spring:message code="charges.${chargeField}" /><input form="${chargeFormId}" name="${chargeField}" value="<c:out value='${chargePolicy[chargeField]}' />" maxlength="500" class="aws-control" /></label>
</c:forEach>
<c:forEach items="${['managementTiming','insuranceTiming']}" var="chargeTiming">
    <label><spring:message code="charges.${chargeTiming}" /><select form="${chargeFormId}" name="${chargeTiming}" class="aws-control">
        <c:forEach items="${['SEPARATE','DEDUCT']}" var="chargeTimingValue"><option value="${chargeTimingValue}" ${chargePolicy[chargeTiming] == chargeTimingValue ? 'selected' : ''}><spring:message code="charges.timing.${chargeTimingValue}" /></option></c:forEach>
    </select></label>
</c:forEach>
<c:if test="${creatingLoanProduct}"><%@ include file="loan-product-charge-account-fields.jspf" %></c:if>
<div data-loan-choice data-category="MANAGEMENT" data-choice-url="<c:url value='/admin/settings-controls/loan-charge-accounts/MANAGEMENT' />">
    <label><spring:message code="charges.recoveryHolding" />
        <select form="${chargeFormId}" name="feeRecoveryAccountId" class="aws-control" data-choice-select data-searchable="true">
            <option value=""><spring:message code="charges.recoveryDisabled" /></option>
            <c:forEach items="${chargeAccounts.MANAGEMENT}" var="holding">
                <option value="${holding.id}" ${chargePolicy.feeRecoveryAccountId eq holding.id?'selected':''}><c:out value="${holding.label}" /></option>
            </c:forEach>
        </select>
    </label>
    <%@ include file="../accounting/loans/choice-search.jspf" %>
</div>
<c:forEach items="${['insurer','insurerVerification']}" var="chargeField">
    <label><spring:message code="charges.${chargeField}" /><input form="${chargeFormId}" name="${chargeField}" value="<c:out value='${chargePolicy[chargeField]}' />" maxlength="500" class="aws-control" /></label>
</c:forEach>
<label><spring:message code="charges.customLimit" /> (TZS)<input form="${chargeFormId}" name="customManagementLimit" value="<c:out value='${chargePolicy.customManagementLimit}' />" type="number" data-amount-input="true" min="0" step="0.01" class="aws-control" /></label>
<label><input form="${chargeFormId}" type="checkbox" name="allowCustom" value="true" ${chargePolicy.allowCustom ? 'checked' : ''} /> <spring:message code="charges.allowCustom" /></label>
<label><input form="${chargeFormId}" type="checkbox" name="enabled" value="true" ${chargePolicy.enabled ? 'checked' : ''} /> <spring:message code="charges.enable" /></label>
<c:if test="${not empty chargeError}"><div class="console-message md:col-span-2" data-message-type="error" role="alert" tabindex="-1"><spring:message code="${chargeError}" /></div></c:if>
