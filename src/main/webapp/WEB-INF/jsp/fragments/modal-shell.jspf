<style>
    .app-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 90;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        background: rgba(15, 23, 42, 0.16);
        backdrop-filter: blur(3px);
    }

    .app-modal-overlay.is-open {
        display: flex;
    }

    .app-modal-panel {
        width: min(100%, 54rem);
        max-height: min(88vh, 52rem);
        overflow: hidden;
        border: 1px solid #d8e0e8;
        border-radius: 1rem;
        background: #ffffff;
        box-shadow: 0 22px 56px rgba(15, 23, 42, 0.14);
    }

    .app-modal-panel--compact {
        width: min(100%, 39rem);
    }

    .app-modal-panel--wide {
        width: min(100%, 68rem);
    }

    .app-modal-scroll {
        max-height: min(88vh, 52rem);
        overflow-y: auto;
        scrollbar-gutter: stable;
        scrollbar-color: #94a3b8 #f1f5f9;
        scrollbar-width: thin;
    }

    .app-modal-scroll::-webkit-scrollbar {
        width: 0.65rem;
    }

    .app-modal-scroll::-webkit-scrollbar-track {
        background: #f1f5f9;
    }

    .app-modal-scroll::-webkit-scrollbar-thumb {
        border: 2px solid #f1f5f9;
        border-radius: 9999px;
        background: #94a3b8;
    }

    .app-modal-scroll::-webkit-scrollbar-thumb:hover {
        background: #64748b;
    }

    .app-modal-header {
        position: sticky;
        top: 0;
        z-index: 6;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.25rem;
        background: rgba(255, 255, 255, 0.98);
        padding: 1.6rem 1.7rem 0.7rem;
        backdrop-filter: blur(10px);
    }

    .app-modal-header .erp-panel-title {
        font-size: 1.02rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.25;
    }

    .app-modal-close {
        display: inline-flex;
        height: 2rem;
        width: 2rem;
        min-height: 2rem;
        min-width: 2rem;
        flex: 0 0 2rem;
        padding: 0;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        border-radius: 0.65rem;
        background: transparent;
        color: #4b5563;
        line-height: 1;
        cursor: pointer;
        transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
    }

    .app-modal-close svg {
        display: block;
        width: 1rem;
        height: 1rem;
        flex: 0 0 auto;
    }

    .app-modal-close:hover,
    .app-modal-close:focus-visible {
        background: #f8fafc;
        border-color: #d8e0e8;
        color: #111827;
    }

    .app-modal-body {
        padding: 0.8rem 1.7rem 1.7rem;
    }

    .app-modal-section {
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        background: #fafcff;
        padding: 1rem 1.1rem;
    }

    .app-modal-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.7rem;
        padding-top: 0.35rem;
    }

    .app-modal-actions .app-btn {
        min-width: 7rem;
        border-radius: 0.72rem;
        padding: 0.72rem 1.05rem;
    }

    @media (max-width: 640px) {
        .app-modal-overlay {
            padding: 0.75rem;
        }

        .app-modal-panel {
            border-radius: 0.9rem;
        }

        .app-modal-header {
            padding: 1.1rem 1.1rem 0.55rem;
        }

        .app-modal-body {
            padding: 0.65rem 1.1rem 1.1rem;
        }

        .app-modal-section {
            padding: 0.95rem;
            border-radius: 0.7rem;
        }

        .app-modal-actions .app-btn {
            width: 100%;
        }
    }
</style>
