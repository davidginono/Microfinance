<c:choose>
    <c:when test="${processedLoanDetail}">
        <c:set var="reviewApplicationId" value="${loan.applicationId}" />
        <c:set var="reviewDisbursedLoanId" value="${loan.loanId}" />
        <c:set var="reviewLoanStatus" value="${loan.status}" />
        <c:set var="reviewApplicantId" value="${loan.applicantId}" />
        <c:set var="reviewApplicantName" value="${loan.applicantName}" />
        <c:set var="reviewApplicantMemberNo" value="${loan.memberNo}" />
        <c:set var="reviewLoanProductName" value="${loan.productName}" />
        <c:set var="reviewLoanPurpose" value="${loan.formFields['Loan Purpose']}" />
        <c:set var="reviewLoanAmount" value="${loan.amount}" />
        <c:set var="reviewLoanTenorMonths" value="${loan.tenorMonths}" />
        <c:set var="reviewActiveExposureLabel" value="-" />
        <c:set var="reviewRiskHistoryLabel" value="-" />
        <c:set var="reviewLiveStatusUrl" value="" />
    </c:when>
    <c:otherwise>
        <c:set var="reviewApplicationId" value="${loanIdShort}" />
        <c:set var="reviewDisbursedLoanId" value="${disbursedLoanId}" />
        <c:set var="reviewLoanStatus" value="${app.status}" />
        <c:set var="reviewApplicantId" value="${borrower.clientId}" />
        <c:set var="reviewApplicantName" value="${borrower.name}" />
        <c:set var="reviewApplicantMemberNo" value="${borrower.number}" />
        <c:set var="reviewLoanProductName" value="${loanProductName}" />
        <c:set var="reviewLoanPurpose" value="${formFields['Loan Purpose']}" />
        <c:set var="reviewLoanAmount" value="${app.amount}" />
        <c:set var="reviewLoanTenorMonths" value="${app.tenorMonths}" />
        <c:set var="reviewActiveExposureLabel" value="${applicantExternalAccountStatus.activeExposureLabel}" />
        <c:set var="reviewRiskHistoryLabel" value="${applicantExternalAccountStatus.riskHistoryLabel}" />
        <c:set var="reviewLiveStatusUrl" value="${pageContext.request.contextPath}${reviewBasePath}/loan-applications/${app.id}/applicant-financial-status" />
        <c:if test="${not empty borrower and not borrower.person}"><c:set var="reviewLiveStatusUrl" value="" /><c:set var="reviewActiveExposureLabel" value="${empty activeApplicantLoanTotalAmount?'-':activeApplicantLoanTotalAmount}" /><spring:message code="common.notAvailable" var="reviewRiskHistoryLabel" /></c:if>
    </c:otherwise>
</c:choose>

<section class="loan-view-hero-summary loan-staff-review-template" data-staff-review-page="true">
    <h2 class="erp-resource-heading"><spring:message code="loan.detail" /></h2>
    <div class="loan-staff-review-overview">
        <div class="loan-hero-with-photo">
            <dl class="erp-detail-facts">
                <div>
                    <dt><spring:message code="loan.applicationId" text="Loan Application ID" /></dt>
                    <dd><c:out value="${reviewApplicationId}" /></dd>
                </div>
                <div>
                    <dt><c:choose><c:when test="${not empty borrower and not borrower.person}"><spring:message code="group.code" /></c:when><c:otherwise><spring:message code="member.memberNo" /></c:otherwise></c:choose></dt>
                    <dd><c:out value="${empty reviewApplicantMemberNo ? '-' : reviewApplicantMemberNo}" /></dd>
                </div>
                <div>
                    <dt><spring:message code="loan.loanId" text="Loan ID" /></dt>
                    <dd><c:out value="${empty reviewDisbursedLoanId ? '-' : reviewDisbursedLoanId}" /></dd>
                </div>
                <div>
                    <dt><spring:message code="common.status" text="Status" /></dt>
                    <dd>
                        <span class="loan-status-badge ${reviewStatusBadgeClass}">
                            <span data-resource-status="${reviewLoanStatus}"><spring:message code="loan.status.${reviewLoanStatus}" text="${reviewLoanStatus}" /></span>
                        </span>
                    </dd>
                </div>
                <div>
                    <dt><spring:message code="loan.applicantName" text="Applicant Name" /></dt>
                    <dd><c:out value="${reviewApplicantName}" /></dd>
                </div>
                <div>
                    <dt><spring:message code="reports.loanProduct" text="Loan Product" /></dt>
                    <dd><c:out value="${reviewLoanProductName}" /></dd>
                </div>
                <div>
                    <dt><spring:message code="loan.purpose" text="Loan Purpose" /></dt>
                    <dd><c:out value="${empty reviewLoanPurpose ? '-' : reviewLoanPurpose}" /></dd>
                </div>
            </dl>
            <c:if test="${not empty reviewApplicantId}">
            <div class="loan-applicant-photo-card">
                <div class="loan-applicant-photo-frame" title="<spring:message code='profile.photo.applicant' text='Applicant profile photo' />">
                    <img src="<c:url value='/profile/image/members/${reviewApplicantId}' />"
                         alt="<spring:message code='profile.photo.applicantAlt' text='Applicant profile photo' />"
                         onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');" />
                    <svg xmlns="http://www.w3.org/2000/svg" class="hidden h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 21a8 8 0 0 0-16 0"/>
                        <circle cx="12" cy="8" r="4"/>
                    </svg>
                </div>
            </div>
            </c:if>
        </div>
    </div>

    <div class="loan-staff-review-financials" data-live-account-status-url="${reviewLiveStatusUrl}">
        <h2 class="loan-staff-review-section-title"><spring:message code="review.loanSummary" text="Loan Summary" /></h2>
        <dl class="loan-staff-kpi-grid">
            <div class="loan-staff-kpi-card">
                <span class="loan-staff-kpi-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h15a3 3 0 0 1 3 3v8H6a3 3 0 0 1-3-3V7Z"/><path d="M3 7a3 3 0 0 1 3-3h11v3"/><path d="M16 13h2"/></svg>
                </span>
                <dt class="loan-stat-label"><spring:message code="loan.amount.label" text="Loan Amount" /></dt>
                <dd class="loan-stat-value" data-disbursement-loan-amount-display>TSh <fmt:formatNumber value="${reviewLoanAmount}" minFractionDigits="0" maxFractionDigits="2" /></dd>
            </div>
            <div class="loan-staff-kpi-card">
                <span class="loan-staff-kpi-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/></svg>
                </span>
                <dt class="loan-stat-label"><spring:message code="loan.tenor.label" text="Tenor" /></dt>
                <spring:message code="newloan.calculation.tenure" var="reviewTenureLabel" />
                <c:set var="reviewTenureSummary" value="${processedLoanDetail ? loan.repaymentSummary : repaymentSummary}" />
                <dd class="loan-stat-value"><c:choose><c:when test="${not empty reviewTenureSummary[reviewTenureLabel]}"><c:out value="${reviewTenureSummary[reviewTenureLabel]}" /></c:when><c:otherwise><c:out value="${reviewLoanTenorMonths}" /> <spring:message code="common.months" text="month(s)" /></c:otherwise></c:choose></dd>
            </div>
            <div class="loan-staff-kpi-card">
                <span class="loan-staff-kpi-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9h12a4 4 0 0 1 0 8h-1l-1 3h-3l-1-3H9l-1 3H5l1-3H5a4 4 0 0 1 0-8h1Z"/><path d="M9 9V6a3 3 0 0 1 5.5-1.7"/><path d="M18 12h.01"/></svg>
                </span>
                <dt class="loan-stat-label"><c:choose><c:when test="${not empty borrower and not borrower.person}"><spring:message code="group.localExposure" /></c:when><c:otherwise><spring:message code="loan.currentSavings" text="Active Loan Exposure" /></c:otherwise></c:choose></dt>
                <dd class="loan-stat-value" data-live-account-status-active-exposure><c:out value="${reviewActiveExposureLabel}" /></dd>
            </div>
            <div class="loan-staff-kpi-card">
                <span class="loan-staff-kpi-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9v9h9Z"/><path d="M15 3.5A9 9 0 0 1 20.5 9H15V3.5Z"/></svg>
                </span>
                <dt class="loan-stat-label"><spring:message code="loan.currentShares" text="PAR/Default History" /></dt>
                <dd class="loan-stat-value" data-live-account-status-risk-history><c:out value="${reviewRiskHistoryLabel}" /></dd>
            </div>
        </dl>
        <c:if test="${not processedLoanDetail}">
            <div class="loan-staff-review-live-status">
                <c:choose><c:when test="${not empty borrower and not borrower.person}"><div class="console-message" data-message-type="info" role="status"><spring:message code="group.creditHistoryUnavailable" /></div></c:when><c:otherwise><%@ include file="live-account-status-message.jspf" %></c:otherwise></c:choose>
            </div>
        </c:if>
    </div>

    <c:set var="topUpReviewSummary" value="${processedLoanDetail ? loan.repaymentSummary : repaymentSummary}" />
    <spring:message code="newloan.calculation.topUpSource" var="topUpSourceLabel" />
    <c:if test="${not empty topUpReviewSummary[topUpSourceLabel]}">
    <div class="loan-staff-review-financials"><h2 class="loan-staff-review-section-title"><spring:message code="recording.topUp.breakdown" /></h2><dl class="erp-detail-facts">
        <c:forEach items="${['topUpSource','topUpSettlement','topUpCash','topUpQuoteDate']}" var="topUpField"><spring:message code="newloan.calculation.${topUpField}" var="topUpFieldLabel" /><div><dt><c:out value="${topUpFieldLabel}" /></dt><dd><c:out value="${topUpReviewSummary[topUpFieldLabel]}" /></dd></div></c:forEach>
    </dl></div>
    </c:if>
    <spring:message code="charges.policyReference" var="chargePolicyLabel" />
    <c:if test="${not empty topUpReviewSummary[chargePolicyLabel]}"><div class="loan-staff-review-financials"><h2 class="loan-staff-review-section-title"><spring:message code="charges.title" /></h2><dl class="erp-detail-facts">
    <c:forEach items="${['policyReference','agreementReference','kind.APPLICATION','kind.PROCESSING','kind.INSURANCE','provider','total','contractTotal','sourceSettlement','deductions']}" var="chargeKey"><spring:message code="charges.${chargeKey}" var="chargeLabel" /><c:if test="${not empty topUpReviewSummary[chargeLabel]}"><div><dt><c:out value="${chargeLabel}" /></dt><dd><c:out value="${topUpReviewSummary[chargeLabel]}" /></dd></div></c:if></c:forEach>
    </dl><p><spring:message code="charges.notPaid" /></p></div></c:if>
    <div class="loan-staff-review-progress">
        <%@ include file="loan-application-progress.jspf" %>
    </div>
</section>
