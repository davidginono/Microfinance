<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ include file="head.jspf" %>
<div class="portal-entry" data-resource-form-page><h1 class="erp-page-title"><spring:message code="portal.title"/></h1><nav class="portal-entry-links"><a href="<c:url value='/'/>"><spring:message code="home.back"/></a><a href="<c:url value='/client-portal/register'/>"><spring:message code="portal.register"/></a><a href="<c:url value='/client-portal'/>"><spring:message code="portal.existing"/></a><a href="<c:url value='/login'/>"><spring:message code="portal.fullAccount"/></a></nav>
<form:form modelAttribute="entryForm" action="${pageContext.request.contextPath}/client-portal/request-code" method="post" cssClass="kyc-client-form" data-accounting-dirty-form="true"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/>
<section class="erp-resource-section"><h2><spring:message code="${entryForm.intent=='REGISTER'?'portal.register':'portal.existing'}"/></h2><div class="kyc-profile-grid">
<c:choose><c:when test="${entryForm.intent=='REGISTER'}"><form:hidden path="intent"/>
<c:forEach items="${['firstName','middleName','lastName','phone','email']}" var="field"><label class="kyc-field"><span><spring:message code="kyc.field.${field}"/></span><c:choose><c:when test="${field=='firstName' or field=='lastName' or field=='phone'}"><form:input path="registration.profile.${field}" cssClass="aws-control" maxlength="80" required="required"/></c:when><c:otherwise><form:input path="registration.profile.${field}" type="${field=='email'?'email':'text'}" cssClass="aws-control" maxlength="255"/></c:otherwise></c:choose></label></c:forEach>
<label class="kyc-field"><span><spring:message code="portal.institution"/></span><form:select path="institution" cssClass="aws-control" required="required" data-portal-institution="true"><form:option value=""><spring:message code="applications.select"/></form:option><c:if test="${not empty entryForm.institution}"><form:option value="${entryForm.institution}"><c:out value="${entryForm.institution}"/></form:option></c:if></form:select></label>
<label class="kyc-field"><span><spring:message code="portal.branch"/></span><form:select path="branch" cssClass="aws-control" required="required" data-portal-branch="true"><form:option value=""><spring:message code="applications.select"/></form:option><c:if test="${not empty entryForm.branch}"><form:option value="${entryForm.branch}"><c:out value="${entryForm.branch}"/></form:option></c:if></form:select></label>
</c:when><c:otherwise><label class="kyc-field"><span><spring:message code="kyc.field.clientNumber"/></span><form:input path="clientNumber" cssClass="aws-control" maxlength="80" required="true" autocomplete="username"/></label><label class="kyc-field"><span><spring:message code="portal.task"/></span><form:select path="intent" cssClass="aws-control"><form:option value="PROFILE"><spring:message code="kyc.form.self"/></form:option><form:option value="LOAN"><spring:message code="portal.apply"/></form:option></form:select></label></c:otherwise></c:choose>
</div></section><form:errors path="*" cssClass="field-error" element="p" role="alert"/><div class="accounting-form-actions"><button class="app-btn btn-launch"><spring:message code="portal.sendCode"/></button></div></form:form></div>
<%@ include file="../accounting/accounting-form-support.jspf" %><%@ include file="foot.jspf" %>
