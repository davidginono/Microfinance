<c:if test="${canEnableClientAccess}">
    <section class="erp-panel admin-user-edit-panel">
        <div class="erp-panel-header"><h2 class="erp-panel-title"><spring:message code="staffClient.title" /></h2></div>
        <div class="erp-panel-body">
            <p><spring:message code="staffClient.onboarding" /></p>
            <form action="<c:url value='/admin/users/${user.accountId}/enable-client-access' />" method="post" data-workspace-submit="recover">
                <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" />
                <div class="admin-user-edit-actions">
                    <button type="submit" class="app-btn btn-launch"><spring:message code="staffClient.enable" /></button>
                </div>
            </form>
        </div>
    </section>
</c:if>
